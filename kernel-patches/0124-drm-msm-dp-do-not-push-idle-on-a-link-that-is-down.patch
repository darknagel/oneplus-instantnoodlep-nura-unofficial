From 261bac462ecd3a11fd11a0a388fa37b758b7abeb Mon Sep 17 00:00:00 2001
From: Roman Kuraev <naoru.desu@gmail.com>
Date: Thu, 12 Nov 2026 15:26:09 +0000
Subject: [PATCH] drm/msm/dp: do not push idle on a link that is down

When link training fails in msm_dp_bridge_atomic_enable(),
msm_dp_ctrl_on_link() has already switched the link clocks off again and
power_on stays unset, but the bridge remains enabled as far as the atomic
state is concerned. The following msm_dp_bridge_atomic_disable() writes
DP_STATE_CTRL_PUSH_IDLE to a link register without a link clock.

On SM8250 the SoC resets in the modeset that takes such an output down: the
last messages are the failed link training and the encoder being disabled,
with no panic.

Only push idle patterns on a link that was brought up.
---
 drivers/gpu/drm/msm/dp/dp_display.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
index 9c0ee32..873adb3 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -1481,6 +1481,13 @@ void msm_dp_bridge_atomic_disable(struct drm_bridge *drm_bridge,
 
 	msm_dp_display = container_of(dp, struct msm_dp_display_private, msm_dp_display);
 
+	/*
+	 * Without a trained link the link clocks are off, and the link
+	 * registers must not be accessed.
+	 */
+	if (!dp->power_on)
+		return;
+
 	msm_dp_ctrl_push_idle(msm_dp_display->ctrl);
 }
 
