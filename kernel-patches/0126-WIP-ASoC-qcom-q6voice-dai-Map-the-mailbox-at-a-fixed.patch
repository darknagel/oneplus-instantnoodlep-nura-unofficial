From 6e314644d812bb43696ac55eefcfa9af3f8bfdad Mon Sep 17 00:00:00 2001
From: Timo <1788603+darknagel@users.noreply.github.com>
Date: Tue, 3 Nov 2026 21:11:20 +0100
Subject: [PATCH 126/137] WIP: ASoC: qcom: q6voice-dai: Map the mailbox at a
 fixed low PCIe address

Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
(cherry picked from commit ccc63fe2e6d420da8602ccdaed61898d6fed3f8a)
---
 sound/soc/qcom/qdsp6/q6voice-dai.c | 18 +++++++++---------
 1 file changed, 9 insertions(+), 9 deletions(-)

diff --git a/sound/soc/qcom/qdsp6/q6voice-dai.c b/sound/soc/qcom/qdsp6/q6voice-dai.c
index 7431fac0c..8787f5ed1 100644
--- a/sound/soc/qcom/qdsp6/q6voice-dai.c
+++ b/sound/soc/qcom/qdsp6/q6voice-dai.c
@@ -37,9 +37,9 @@ struct q6voice_mailbox {
 	struct mutex lock;
 };
 
-static bool pcie_identity;
-module_param(pcie_identity, bool, 0444);
-MODULE_PARM_DESC(pcie_identity, "Give the modem the physical mailbox address");
+static unsigned long pcie_iova = 0x20000000;
+module_param(pcie_iova, ulong, 0444);
+MODULE_PARM_DESC(pcie_iova, "PCIe address of the mailbox, 0 = from the DMA API");
 
 static struct q6voice_mailbox q6voice_mbox = {
 	.lock = __MUTEX_INITIALIZER(q6voice_mbox.lock),
@@ -133,17 +133,17 @@ static int q6voice_mhi_probe(struct mhi_device *mhi_dev,
 		goto out;
 	}
 
-	if (pcie_identity) {
+	if (pcie_iova) {
 		struct iommu_domain *dom = iommu_get_domain_for_dev(pcie_dev);
 
-		/* The modem may expect the physical address of the mailbox */
+		/* Downstream keeps MHI addresses in 0x20000000..0x3fffffff */
 		if (dom) {
-			ret = iommu_map(dom, mb->phys, mb->phys, mb->size,
+			ret = iommu_map(dom, pcie_iova, mb->phys, mb->size,
 					IOMMU_READ | IOMMU_WRITE, GFP_KERNEL);
 			if (ret)
 				goto out;
 		}
-		mb->pcie_addr = mb->phys;
+		mb->pcie_addr = pcie_iova;
 	} else {
 		mb->pcie_addr = dma_map_resource(pcie_dev, mb->phys, mb->size,
 						 DMA_BIDIRECTIONAL, 0);
@@ -167,12 +167,12 @@ static void q6voice_mhi_remove(struct mhi_device *mhi_dev)
 	struct q6voice_mailbox *mb = &q6voice_mbox;
 
 	mutex_lock(&mb->lock);
-	if (pcie_identity) {
+	if (pcie_iova) {
 		struct iommu_domain *dom =
 			iommu_get_domain_for_dev(mhi_dev->mhi_cntrl->cntrl_dev);
 
 		if (dom)
-			iommu_unmap(dom, mb->phys, mb->size);
+			iommu_unmap(dom, pcie_iova, mb->size);
 	} else {
 		dma_unmap_resource(mhi_dev->mhi_cntrl->cntrl_dev, mb->pcie_addr,
 				   mb->size, DMA_BIDIRECTIONAL, 0);
-- 
