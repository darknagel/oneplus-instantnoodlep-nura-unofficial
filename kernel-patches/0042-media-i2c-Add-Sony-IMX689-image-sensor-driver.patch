+
+static int imx689_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx689 *imx689 = container_of(ctrl->handler, struct imx689,
+					     ctrl_handler);
+	const struct imx689_mode *mode = imx689->mode;
+	s64 exposure_max;
+	int ret;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		/* Update max exposure while meeting expected vblanking */
+		exposure_max = mode->height + ctrl->val - IMX689_EXPOSURE_MARGIN;
+		__v4l2_ctrl_modify_range(imx689->exposure,
+					 imx689->exposure->minimum,
+					 exposure_max,
+					 imx689->exposure->step,
+					 imx689->exposure->default_value);
+	}
+
+	/* V4L2 controls are applied, when sensor is powered up for streaming */
+	if (!pm_runtime_get_if_active(imx689->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(imx689->regmap, IMX689_REG_AGAIN,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(imx689->regmap, IMX689_REG_EXPOSURE,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(imx689->regmap, IMX689_REG_VTS,
+				ctrl->val + mode->height, NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = cci_write(imx689->regmap, IMX689_REG_TEST_PATTERN,
+				ctrl->val, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(imx689->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops imx689_ctrl_ops = {
+	.s_ctrl = imx689_set_ctrl,
+};
+
+static int imx689_init_controls(struct imx689 *imx689)
+{
+	struct v4l2_ctrl_handler *ctrl_hdlr = &imx689->ctrl_handler;
+	const struct imx689_mode *mode = imx689->mode;
+	s64 hblank, vblank, exposure_max;
+	struct v4l2_fwnode_device_properties props;
+	int ret;
+
+	v4l2_ctrl_handler_init(ctrl_hdlr, 9);
+
+	imx689->link_freq = v4l2_ctrl_new_int_menu(ctrl_hdlr, &imx689_ctrl_ops,
+						   V4L2_CID_LINK_FREQ,
+						   ARRAY_SIZE(imx689_link_freq_menu) - 1,
+						   mode->link_freq_index,
+						   imx689_link_freq_menu);
+	if (imx689->link_freq)
+		imx689->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	imx689->pixel_rate = v4l2_ctrl_new_std(ctrl_hdlr, &imx689_ctrl_ops,
+					       V4L2_CID_PIXEL_RATE,
+					       imx689_supported_modes[0].pixel_rate,
+					       imx689_supported_modes[0].pixel_rate,
+					       1, mode->pixel_rate);
+	if (imx689->pixel_rate)
+		imx689->pixel_rate->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	hblank = mode->hts - mode->width;
+	imx689->hblank = v4l2_ctrl_new_std(ctrl_hdlr, &imx689_ctrl_ops,
+					   V4L2_CID_HBLANK, hblank,
+					   hblank, 1, hblank);
+	if (imx689->hblank)
+		imx689->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->vts - mode->height;
+	imx689->vblank = v4l2_ctrl_new_std(ctrl_hdlr, &imx689_ctrl_ops,
+					   V4L2_CID_VBLANK, vblank,
+					   IMX689_VTS_MAX - mode->height, 1,
+					   vblank);
+
+	v4l2_ctrl_new_std(ctrl_hdlr, &imx689_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  IMX689_AGAIN_MIN, IMX689_AGAIN_MAX,
+			  IMX689_AGAIN_STEP, IMX689_AGAIN_DEFAULT);
+
+	exposure_max = mode->vts - IMX689_EXPOSURE_MARGIN;
+	imx689->exposure = v4l2_ctrl_new_std(ctrl_hdlr, &imx689_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     IMX689_EXPOSURE_MIN,
+					     exposure_max,
+					     IMX689_EXPOSURE_STEP,
+					     IMX689_EXPOSURE_DEFAULT);
+
+	v4l2_ctrl_new_std_menu_items(ctrl_hdlr, &imx689_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(imx689_test_pattern_menu) - 1,
+				     0, 0, imx689_test_pattern_menu);
+
+	ret = v4l2_fwnode_device_parse(imx689->dev, &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &imx689_ctrl_ops,
+					      &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	if (ctrl_hdlr->error) {
+		ret = ctrl_hdlr->error;
+		goto error_free_hdlr;
+	}
+
+	imx689->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+error_free_hdlr:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+
+	return ret;
+}
+
+static int imx689_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct imx689 *imx689 = to_imx689(sd);
+	const struct imx689_reg_list *reg_list = &imx689->mode->reg_list;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(imx689->dev);
+	if (ret)
+		return ret;
+
+	ret = cci_multi_reg_write(imx689->regmap, imx689_init_regs,
+				  ARRAY_SIZE(imx689_init_regs), NULL);
+	cci_multi_reg_write(imx689->regmap, reg_list->regs,
+			    reg_list->num_regs, &ret);
+	if (ret)
+		goto error;
+
+	ret = __v4l2_ctrl_handler_setup(imx689->sd.ctrl_handler);
+	if (ret)
+		goto error;
+
+	ret = cci_write(imx689->regmap, IMX689_REG_MODE_SELECT,
+			IMX689_MODE_STREAMING, NULL);
+	if (ret)
+		goto error;
+
+	return 0;
+
+error:
+	dev_err(imx689->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put_autosuspend(imx689->dev);
+
+	return ret;
+}
+
+static int imx689_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct imx689 *imx689 = to_imx689(sd);
+	int ret;
+
+	ret = cci_write(imx689->regmap, IMX689_REG_MODE_SELECT,
+			IMX689_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(imx689->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(imx689->dev);
+
+	return ret;
+}
+
+static void imx689_update_pad_format(const struct imx689_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int imx689_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct imx689 *imx689 = to_imx689(sd);
+	s64 hblank, vblank, exposure_max;
+	const struct imx689_mode *mode;
+
+	mode = v4l2_find_nearest_size(imx689_supported_modes,
+				      ARRAY_SIZE(imx689_supported_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	imx689_update_pad_format(mode, &fmt->format);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY || imx689->mode == mode)
+		goto set_format;
+
+	__v4l2_ctrl_s_ctrl(imx689->link_freq, mode->link_freq_index);
+	__v4l2_ctrl_s_ctrl_int64(imx689->pixel_rate, mode->pixel_rate);
+
+	hblank = mode->hts - mode->width;
+	__v4l2_ctrl_modify_range(imx689->hblank, hblank, hblank, 1, hblank);
+
+	vblank = mode->vts - mode->height;
+	__v4l2_ctrl_modify_range(imx689->vblank, vblank,
+				 IMX689_VTS_MAX - mode->height, 1, vblank);
+	__v4l2_ctrl_s_ctrl(imx689->vblank, vblank);
+
+	exposure_max = mode->vts - IMX689_EXPOSURE_MARGIN;
+	__v4l2_ctrl_modify_range(imx689->exposure, IMX689_EXPOSURE_MIN,
+				 exposure_max, IMX689_EXPOSURE_STEP,
+				 IMX689_EXPOSURE_DEFAULT);
+
+	if (imx689->sd.ctrl_handler->error)
+		return imx689->sd.ctrl_handler->error;
+
+	imx689->mode = mode;
+
+set_format:
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+
+	return 0;
+}
+
+static int imx689_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+
+	return 0;
+}
+
+static int imx689_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(imx689_supported_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+		return -EINVAL;
+
+	fse->min_width = imx689_supported_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = imx689_supported_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int imx689_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_selection *sel)
+{
+	struct imx689 *imx689 = to_imx689(sd);
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = imx689->mode->crop;
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = IMX689_NATIVE_WIDTH;
+		sel->r.height = IMX689_NATIVE_HEIGHT;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int imx689_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct imx689 *imx689 = to_imx689(sd);
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.width = imx689->mode->width,
+			.height = imx689->mode->height,
+		},
+	};
+
+	imx689_set_pad_format(sd, state, &fmt);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops imx689_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops imx689_pad_ops = {
+	.set_fmt = imx689_set_pad_format,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.get_selection = imx689_get_selection,
+	.enum_mbus_code = imx689_enum_mbus_code,
+	.enum_frame_size = imx689_enum_frame_size,
+	.enable_streams = imx689_enable_streams,
+	.disable_streams = imx689_disable_streams,
+};
+
+static const struct v4l2_subdev_ops imx689_subdev_ops = {
+	.video = &imx689_video_ops,
+	.pad = &imx689_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops imx689_internal_ops = {
+	.init_state = imx689_init_state,
+};
+
+static const struct media_entity_operations imx689_subdev_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static int imx689_identify_sensor(struct imx689 *imx689)
+{
+	u64 val;
+	int ret;
+
+	ret = cci_read(imx689->regmap, IMX689_REG_CHIP_ID, &val, NULL);
+	if (ret) {
+		dev_err(imx689->dev, "failed to read chip id: %d\n", ret);
+		return ret;
+	}
+
+	if (val != IMX689_CHIP_ID) {
+		dev_err(imx689->dev, "chip id mismatch: %x!=%llx\n",
+			IMX689_CHIP_ID, val);
+		return -ENODEV;
+	}
+
+	return 0;
+}
+
+static int imx689_check_hwcfg(struct imx689 *imx689)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(imx689->dev), *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_CPHY,
+	};
+	unsigned long freq_bitmap;
+	int ret;
+
+	if (!fwnode)
+		return -ENODEV;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -EINVAL;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != IMX689_DATA_LANES) {
+		dev_err(imx689->dev, "Invalid number of data lanes: %u\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto endpoint_free;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(imx689->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       imx689_link_freq_menu,
+				       ARRAY_SIZE(imx689_link_freq_menu),
+				       &freq_bitmap);
+	if (ret)
+		goto endpoint_free;
+
+	/* The link frequencies of all modes are needed */
+	if (freq_bitmap != GENMASK(ARRAY_SIZE(imx689_link_freq_menu) - 1, 0)) {
+		dev_err(imx689->dev, "Not all link frequencies are supported\n");
+		ret = -EINVAL;
+	}
+
+endpoint_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+static int imx689_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx689 *imx689 = to_imx689(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(IMX689_NUM_SUPPLIES, imx689->supplies);
+	if (ret)
+		return ret;
+
+	/* Let the supplies settle before the clock is enabled */
+	usleep_range(2 * USEC_PER_MSEC, 3 * USEC_PER_MSEC);
+
+	ret = clk_prepare_enable(imx689->mclk);
+	if (ret)
+		goto disable_regulators;
+
+	usleep_range(2 * USEC_PER_MSEC, 3 * USEC_PER_MSEC);
+	gpiod_set_value_cansleep(imx689->reset_gpio, 0);
+	usleep_range(10 * USEC_PER_MSEC, 15 * USEC_PER_MSEC);
+
+	return 0;
+
+disable_regulators:
+	regulator_bulk_disable(IMX689_NUM_SUPPLIES, imx689->supplies);
+
+	return ret;
+}
+
+static int imx689_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx689 *imx689 = to_imx689(sd);
+
+	gpiod_set_value_cansleep(imx689->reset_gpio, 1);
+
+	clk_disable_unprepare(imx689->mclk);
+
+	regulator_bulk_disable(IMX689_NUM_SUPPLIES, imx689->supplies);
+
+	return 0;
+}
+
+static int imx689_probe(struct i2c_client *client)
+{
+	struct imx689 *imx689;
+	unsigned long freq;
+	unsigned int i;
+	int ret;
+
+	imx689 = devm_kzalloc(&client->dev, sizeof(*imx689), GFP_KERNEL);
+	if (!imx689)
+		return -ENOMEM;
+
+	imx689->dev = &client->dev;
+	v4l2_i2c_subdev_init(&imx689->sd, client, &imx689_subdev_ops);
+
+	imx689->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(imx689->regmap))
+		return dev_err_probe(imx689->dev, PTR_ERR(imx689->regmap),
+				     "failed to init CCI\n");
+
+	imx689->mclk = devm_v4l2_sensor_clk_get(imx689->dev, NULL);
+	if (IS_ERR(imx689->mclk))
+		return dev_err_probe(imx689->dev, PTR_ERR(imx689->mclk),
+				     "failed to get MCLK clock\n");
+
+	freq = clk_get_rate(imx689->mclk);
+	if (freq != IMX689_MCLK_FREQ)
+		return dev_err_probe(imx689->dev, -EINVAL,
+				     "MCLK clock frequency %lu is not supported\n",
+				     freq);
+
+	ret = imx689_check_hwcfg(imx689);
+	if (ret)
+		return dev_err_probe(imx689->dev, ret,
+				     "failed to check HW configuration\n");
+
+	imx689->reset_gpio = devm_gpiod_get_optional(imx689->dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(imx689->reset_gpio))
+		return dev_err_probe(imx689->dev, PTR_ERR(imx689->reset_gpio),
+				     "cannot get reset GPIO\n");
+
+	for (i = 0; i < IMX689_NUM_SUPPLIES; i++)
+		imx689->supplies[i].supply = imx689_supply_names[i];
+
+	ret = devm_regulator_bulk_get(imx689->dev, IMX689_NUM_SUPPLIES,
+				      imx689->supplies);
+	if (ret)
+		return dev_err_probe(imx689->dev, ret,
+				     "failed to get supply regulators\n");
+
+	/* The sensor must be powered on to read the CHIP_ID register */
+	ret = imx689_power_on(imx689->dev);
+	if (ret)
+		return ret;
+
+	ret = imx689_identify_sensor(imx689);
+	if (ret) {
+		dev_err_probe(imx689->dev, ret, "failed to find sensor\n");
+		goto power_off;
+	}
+
+	imx689->mode = &imx689_supported_modes[0];
+	ret = imx689_init_controls(imx689);
+	if (ret) {
+		dev_err_probe(imx689->dev, ret, "failed to init controls\n");
+		goto power_off;
+	}
+
+	imx689->sd.state_lock = imx689->ctrl_handler.lock;
+	imx689->sd.internal_ops = &imx689_internal_ops;
+	imx689->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	imx689->sd.entity.ops = &imx689_subdev_entity_ops;
+	imx689->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	imx689->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&imx689->sd.entity, 1, &imx689->pad);
+	if (ret) {
+		dev_err_probe(imx689->dev, ret,
+			      "failed to init media entity pads\n");
+		goto v4l2_ctrl_handler_free;
+	}
+
+	ret = v4l2_subdev_init_finalize(&imx689->sd);
+	if (ret < 0) {
+		dev_err_probe(imx689->dev, ret,
+			      "failed to finalize subdev init\n");
+		goto media_entity_cleanup;
+	}
+
+	pm_runtime_set_active(imx689->dev);
+	pm_runtime_enable(imx689->dev);
+
+	ret = v4l2_async_register_subdev_sensor(&imx689->sd);
+	if (ret < 0) {
+		dev_err_probe(imx689->dev, ret,
+			      "failed to register V4L2 subdev\n");
+		goto subdev_cleanup;
+	}
+
+	pm_runtime_set_autosuspend_delay(imx689->dev, 1000);
+	pm_runtime_use_autosuspend(imx689->dev);
+	pm_runtime_idle(imx689->dev);
+
+	return 0;
+
+subdev_cleanup:
+	v4l2_subdev_cleanup(&imx689->sd);
+	pm_runtime_disable(imx689->dev);
+	pm_runtime_set_suspended(imx689->dev);
+
+media_entity_cleanup:
+	media_entity_cleanup(&imx689->sd.entity);
+
+v4l2_ctrl_handler_free:
+	v4l2_ctrl_handler_free(imx689->sd.ctrl_handler);
+
+power_off:
+	imx689_power_off(imx689->dev);
+
+	return ret;
+}
+
+static void imx689_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx689 *imx689 = to_imx689(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	pm_runtime_disable(imx689->dev);
+
+	if (!pm_runtime_status_suspended(imx689->dev)) {
+		imx689_power_off(imx689->dev);
+		pm_runtime_set_suspended(imx689->dev);
+	}
+}
+
+static const struct dev_pm_ops imx689_pm_ops = {
+	SET_RUNTIME_PM_OPS(imx689_power_off, imx689_power_on, NULL)
+};
+
+static const struct of_device_id imx689_of_match[] = {
+	{ .compatible = "sony,imx689" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, imx689_of_match);
+
+static struct i2c_driver imx689_i2c_driver = {
+	.driver = {
+		.name = "imx689",
+		.pm = &imx689_pm_ops,
+		.of_match_table = imx689_of_match,
+	},
+	.probe = imx689_probe,
+	.remove = imx689_remove,
+};
+
+module_i2c_driver(imx689_i2c_driver);
