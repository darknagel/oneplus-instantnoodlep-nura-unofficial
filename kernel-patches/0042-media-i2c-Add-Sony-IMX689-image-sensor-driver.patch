From a668ecde3ed199cb27167bb66f355a1fb620379d Mon Sep 17 00:00:00 2001
From: Timo <1788603+darknagel@users.noreply.github.com>
Date: Mon, 2 Nov 2026 23:00:50 +0100
Subject: [PATCH 42/45] media: i2c: Add Sony IMX689 image sensor driver

Add a driver for the Sony IMX689, the main camera of the OnePlus 8 Pro.
It is connected through three C-PHY trios and runs from a 19.2 MHz clock.
The register settings come from the camera module data of the phone.

Only the 2x2 binned 4000x3000 mode at 30 fps is supported. The pixel rate
is the output rate of the sensor, not its internal 1100.8 MHz clock, and
the line length is scaled to match, so that the frame timing is correct
and CAMSS picks its clocks from the data that really arrives.

Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
---
 drivers/media/i2c/Kconfig  |   10 +
 drivers/media/i2c/Makefile |    1 +
 drivers/media/i2c/imx689.c | 4067 ++++++++++++++++++++++++++++++++++++
 3 files changed, 4078 insertions(+)
 create mode 100644 drivers/media/i2c/imx689.c

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 079478217..6b3dd4115 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -297,6 +297,16 @@ config VIDEO_IMX471
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx471.
 
+config VIDEO_IMX689
+	tristate "Sony IMX689 sensor support"
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the Sony
+	  IMX689 camera.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called imx689.
+
 config VIDEO_MAX9271_LIB
 	tristate
 
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index d2e98542c..99d321e41 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -62,6 +62,7 @@ obj-$(CONFIG_VIDEO_IMX355) += imx355.o
 obj-$(CONFIG_VIDEO_IMX412) += imx412.o
 obj-$(CONFIG_VIDEO_IMX415) += imx415.o
 obj-$(CONFIG_VIDEO_IMX471) += imx471.o
+obj-$(CONFIG_VIDEO_IMX689) += imx689.o
 obj-$(CONFIG_VIDEO_IR_I2C) += ir-kbd-i2c.o
 obj-$(CONFIG_VIDEO_ISL7998X) += isl7998x.o
 obj-$(CONFIG_VIDEO_KS0127) += ks0127.o
diff --git a/drivers/media/i2c/imx689.c b/drivers/media/i2c/imx689.c
