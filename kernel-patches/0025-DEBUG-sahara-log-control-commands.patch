From 172be8e1f2bac3767e18e0f20bb900a476c3c0f4 Mon Sep 17 00:00:00 2001
From: Timo <1788603+darknagel@users.noreply.github.com>
Date: Tue, 27 Oct 2026 19:45:01 +0100
Subject: [PATCH 25/30] DEBUG: sahara: log control commands

Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
---
 drivers/bus/mhi/host/sahara.c | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/drivers/bus/mhi/host/sahara.c b/drivers/bus/mhi/host/sahara.c
index 58b39b9ea..bca2b62b7 100644
--- a/drivers/bus/mhi/host/sahara.c
+++ b/drivers/bus/mhi/host/sahara.c
@@ -458,8 +458,8 @@ static void sahara_end_of_image(struct sahara_context *context)
 {
 	int ret;
 
-	dev_dbg(&context->mhi_dev->dev,
-		"END_OF_IMAGE cmd received. length:%d image:%d status:%d\n",
+	dev_info(&context->mhi_dev->dev,
+		"DEBUG END_OF_IMAGE length:%d image:%d status:%d\n",
 		le32_to_cpu(context->rx->length),
 		le32_to_cpu(context->rx->end_of_image.image),
 		le32_to_cpu(context->rx->end_of_image.status));
@@ -559,6 +559,11 @@ static void sahara_processing(struct work_struct *work)
 
 	switch (le32_to_cpu(context->rx->cmd)) {
 	case SAHARA_HELLO_CMD:
+		dev_info(&context->mhi_dev->dev, "DEBUG HELLO version:%d compat:%d max_len:%d mode:%d\n",
+			 le32_to_cpu(context->rx->hello.version),
+			 le32_to_cpu(context->rx->hello.version_compat),
+			 le32_to_cpu(context->rx->hello.max_length),
+			 le32_to_cpu(context->rx->hello.mode));
 		sahara_hello(context);
 		break;
 	case SAHARA_READ_DATA_CMD:
@@ -569,6 +574,9 @@ static void sahara_processing(struct work_struct *work)
 		break;
 	case SAHARA_DONE_RESP_CMD:
 		/* Intentional do nothing as we don't need to exit an app */
+		dev_info(&context->mhi_dev->dev, "DEBUG DONE_RESP length:%d mode:%d\n",
+			 le32_to_cpu(context->rx->length),
+			 le32_to_cpu(context->rx->hello.version));
 		break;
 	case SAHARA_RESET_RESP_CMD:
 		/* Intentional do nothing as we don't need to exit an app */
@@ -577,7 +585,7 @@ static void sahara_processing(struct work_struct *work)
 		sahara_memory_debug64(context);
 		break;
 	default:
-		dev_err(&context->mhi_dev->dev, "Unknown command %d\n",
+		dev_err(&context->mhi_dev->dev, "DEBUG unknown command %d\n",
 			le32_to_cpu(context->rx->cmd));
 		break;
 	}
-- 
