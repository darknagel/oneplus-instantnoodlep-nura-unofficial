Date: Tue, 3 Nov 2026 23:19:07 +0100
Subject: [PATCH 130/137] WIP: bus: mhi: host: pci_generic: SDX55 window
 0..0x3fffffff like downstream

Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
(cherry picked from commit 1bf53000e72bd925d045a81ee14d1be1b45c2350)
---
 drivers/bus/mhi/host/pci_generic.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/bus/mhi/host/pci_generic.c b/drivers/bus/mhi/host/pci_generic.c
index 156bf44b7..c967ee502 100644
--- a/drivers/bus/mhi/host/pci_generic.c
+++ b/drivers/bus/mhi/host/pci_generic.c
@@ -1564,7 +1564,7 @@ static int mhi_pci_probe(struct pci_dev *pdev, const struct pci_device_id *id)
 		 * modem a 512 MiB DDR window. The SDX55 maps host memory for
 		 * voice (ADSP mailbox) only inside this window.
 		 */
-		mhi_cntrl->iova_start = 0x20000000;
+		mhi_cntrl->iova_start = 0;
 		mhi_cntrl->iova_stop = 0x3fffffff;
 	}
 	mhi_cntrl->edl_image = info->edl;
