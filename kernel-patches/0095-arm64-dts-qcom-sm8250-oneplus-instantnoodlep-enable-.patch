From 11c71516746b9640e63e7d25d4989f04fca5959a Mon Sep 17 00:00:00 2001
From: Roman Kuraev <naoru.desu@gmail.com>
Date: Mon, 9 Nov 2026 20:23:50 +0000
Subject: [PATCH] arm64: dts: qcom: sm8250-oneplus-instantnoodlep: enable
 DisplayPort

Enable the DP controller and connect it to the USB/DP combo PHY and
Type-C connector. Advertise DP Alt Mode, enable PHY mode switching, and
allow all four DP lanes. Retain the existing FSA4480 SBU routing.

Make the USB controller a mode switch as well, and list its port first
so that its USB2 clock mux registers before the high-speed PHY mux and
four-lane DP keeps USB2 alive.

Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
---
 .../qcom/sm8250-oneplus-instantnoodlep.dts    | 48 ++++++++++++++++---
 1 file changed, 42 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
index 6c3ae98fe..aac72c44c 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
@@ -1285,6 +1285,15 @@ &mdss {
 	status = "okay";
 };
 
+&mdss_dp {
+	status = "okay";
+};
+
+&mdss_dp_out {
+	data-lanes = <0 1 2 3>;
+	remote-endpoint = <&usb_1_qmpphy_dp_in>;
+};
+
 &mdss_dsi0 {
 	vdda-supply = <&vreg_l9a_1p2>;
 
@@ -1443,10 +1452,33 @@ PDO_FIXED_DUAL_ROLE |
                                       PDO_FIXED_USB_COMM |
                                       PDO_FIXED_DATA_SWAP)>;
 
+		altmodes {
+			displayport {
+				svid = /bits/ 16 <0xff01>;
+				vdo = <0x00001c46>;
+			};
+		};
+
                ports {
                        #address-cells = <1>;
                        #size-cells = <0>;
 
+			port@0 {
+				reg = <0>;
+
+				pm8150b_hs_in: endpoint {
+					remote-endpoint = <&usb_1_dwc3_hs_out>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+				pm8150b_ss_in: endpoint {
+					data-lanes = <0 1 2 3>;
+					remote-endpoint = <&usb_1_qmpphy_out>;
+				};
+			};
+
 			port@2 {
 				reg = <2>;
 				pm8150b_sbu: endpoint {
@@ -1454,13 +1486,7 @@ pm8150b_sbu: endpoint {
 				};
 			};
 
-                       port@0 {
-                               reg = <0>;
 
-                               pm8150b_hs_in: endpoint {
-                                       remote-endpoint = <&usb_1_dwc3_hs_out>;
-                               };
-                       };
                };
        };
 };
@@ -1795,6 +1821,7 @@ &usb_1 {
 &usb_1_dwc3 {
 	dr_mode = "otg";
 	usb-role-switch;
+	mode-switch;
 };
 
 &usb_1_hsphy {
@@ -1809,11 +1836,20 @@ &usb_1_dwc3_hs_out {
 };
 
 &usb_1_qmpphy {
+	mode-switch;
        status = "okay";
        vdda-phy-supply = <&vreg_l9a_1p2>;
        vdda-pll-supply = <&vreg_l18a_0p92>;
 };
 
+&usb_1_qmpphy_out {
+	remote-endpoint = <&pm8150b_ss_in>;
+};
+
+&usb_1_qmpphy_dp_in {
+	remote-endpoint = <&mdss_dp_out>;
+};
+
 &usb_2 {
 	status = "okay";
 };
-- 
