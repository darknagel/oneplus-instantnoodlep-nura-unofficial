From 135c4a0b6864fa9f5b09cf842d4a0c32f49264a2 Mon Sep 17 00:00:00 2001
From: Timo <1788603+darknagel@users.noreply.github.com>
Date: Mon, 9 Nov 2026 20:29:16 +0100
Subject: [PATCH 62/63] arm64: dts: qcom: sm8250-oneplus-instantnoodlep: Use
 the default sensor layout

The phone now runs the SLPI firmware from its own modem partition, which
on current OxygenOS reads the 3-chip layout. Older bootloaders create the
item themselves, and the driver keeps their layout.

Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
---
 arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
index dfd9ab7f2..ed8053b85 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
@@ -389,8 +389,7 @@ vreg_cam_tele_avdd: regulator-cam-tele-avdd {
 
 	sensor-devinfo {
 		compatible = "oneplus,sensor-devinfo";
-		/* The SLPI firmware reads the layout of older OxygenOS */
-		oneplus,sources-per-sensor = <2>;
+		/* The SLPI firmware of this phone reads the 3-source layout */
 
 		/* LSM6DSM */
 		gsensor-0 {
-- 
2.43.0

