From 129179a8c805833053a3d7fbab84c718fef3293a Mon Sep 17 00:00:00 2001
From: Timo <1788603+darknagel@users.noreply.github.com>
Date: Sun, 25 Oct 2026 23:40:26 +0100
Subject: [PATCH 07/13] soc: qcom: Add OnePlus sensor device info driver

The sensor DSP (SLPI) firmware of OnePlus devices reads which sensor
chips are fitted, how they are oriented and some tuning parameters from
SMEM item 130. The bootloader allocates the item and leaves it empty,
the vendor kernel fills it from the device tree. Without it, the
firmware does not bring up sensors like the accelerometer and the
magnetometer.

Fill the item from the device tree like the vendor driver does. The
number of chips per sensor type differs between firmware versions and is
detected from the size of the item.

The item must be filled before the sensor DSP is started, so the driver
should be built in.

Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
---
 drivers/soc/qcom/Kconfig                  |  12 +
 drivers/soc/qcom/Makefile                 |   1 +
 drivers/soc/qcom/oneplus-sensor-devinfo.c | 385 ++++++++++++++++++++++
 3 files changed, 398 insertions(+)
 create mode 100755 drivers/soc/qcom/oneplus-sensor-devinfo.c

diff --git a/drivers/soc/qcom/Kconfig b/drivers/soc/qcom/Kconfig
index 2caadbbcf..a0ce7ff5c 100644
--- a/drivers/soc/qcom/Kconfig
+++ b/drivers/soc/qcom/Kconfig
@@ -72,6 +72,18 @@ config QCOM_OCMEM
 	  requirements. This is typically used by the GPU, camera/video, and
 	  audio components on some Snapdragon SoCs.
 
+config QCOM_ONEPLUS_SENSOR_DEVINFO
+	tristate "OnePlus sensor device info"
+	depends on QCOM_SMEM
+	depends on ARCH_QCOM || COMPILE_TEST
+	help
+	  Fill the SMEM item that describes the fitted sensor chips for the
+	  sensor DSP of OnePlus devices from the device tree. The DSP firmware
+	  needs it to bring up sensors like the accelerometer. It must be
+	  filled before the sensor DSP is started.
+
+	  Say Y here if you have a OnePlus device with a Qualcomm SoC.
+
 config QCOM_PD_MAPPER
 	tristate "Qualcomm Protection Domain Mapper"
 	select QCOM_QMI_HELPERS
diff --git a/drivers/soc/qcom/Makefile b/drivers/soc/qcom/Makefile
index b7f1d2a57..436f490cf 100644
--- a/drivers/soc/qcom/Makefile
+++ b/drivers/soc/qcom/Makefile
@@ -7,6 +7,7 @@ obj-$(CONFIG_QCOM_COMMAND_DB) += cmd-db.o
 obj-$(CONFIG_QCOM_GSBI)	+=	qcom_gsbi.o
 obj-$(CONFIG_QCOM_MDT_LOADER)	+= mdt_loader.o
 obj-$(CONFIG_QCOM_OCMEM)	+= ocmem.o
+obj-$(CONFIG_QCOM_ONEPLUS_SENSOR_DEVINFO)	+= oneplus-sensor-devinfo.o
 obj-$(CONFIG_QCOM_PD_MAPPER)	+= qcom_pd_mapper.o
 obj-$(CONFIG_QCOM_PDR_HELPERS)	+= pdr_interface.o
 obj-$(CONFIG_QCOM_PDR_MSG)	+= qcom_pdr_msg.o
diff --git a/drivers/soc/qcom/oneplus-sensor-devinfo.c b/drivers/soc/qcom/oneplus-sensor-devinfo.c
new file mode 100755
index 000000000..6e1625b0b
--- /dev/null
+++ b/drivers/soc/qcom/oneplus-sensor-devinfo.c
@@ -0,0 +1,385 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * OnePlus sensor device info
+ *
+ * The sensor DSP (SLPI) firmware of OnePlus devices reads which sensor chips
+ * are fitted, how they are oriented and some tuning parameters from SMEM item
+ * 130. The bootloader allocates the item and the kernel has to fill it from
+ * the device tree, otherwise the firmware does not bring up sensors like the
+ * accelerometer and the magnetometer.
+ *
+ * The device tree properties and the layout of the item follow the downstream
+ * oplus,sensor-devinfo driver, Copyright (C) 2018-2020 Oplus.
+ */
+
+#include <linux/err.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/soc/qcom/smem.h>
+#include <linux/string.h>
+
+#define SMEM_SENSOR		130
+
+#define REG_NUM			10
+#define PARAMETER_NUM		25
+#define FEATURE_NUM		10
+#define ALGO_PARAMETER_NUM	15
+#define ALGO_FEATURE_NUM	5
+#define SENSORS_NUM		11
+#define SENSOR_ALGO_NUM		8
+#define SAR_MAX_CH_NUM		5
+#define DEFAULT_CONFIG		0xff
+
+struct sensor_feature {
+	s32 reg[REG_NUM];
+	s32 parameter[PARAMETER_NUM];
+	s32 feature[FEATURE_NUM];
+};
+
+struct sensor_hw {
+	u8 sensor_name;
+	u8 bus_number;
+	u8 direction;
+	u8 irq_number;
+	struct sensor_feature feature;
+};
+
+struct sensor_algorithm {
+	s32 sensor_id;
+	s32 parameter[ALGO_PARAMETER_NUM];
+	s32 feature[ALGO_FEATURE_NUM];
+};
+
+/*
+ * The item contains a magic number, one vector per sensor type with the
+ * hardware of each source and one entry per virtual sensor. Older firmware
+ * uses 2 sources per sensor, newer firmware 3, which is detected from the
+ * size of the item.
+ */
+struct oneplus_sensor_devinfo {
+	void *info;
+	unsigned int n_sources;
+};
+
+static size_t vector_size(unsigned int n_sources)
+{
+	return sizeof(s32) + n_sources * sizeof(struct sensor_hw);
+}
+
+static size_t info_size(unsigned int n_sources)
+{
+	return sizeof(s32) + SENSORS_NUM * vector_size(n_sources)
+	     + SENSOR_ALGO_NUM * sizeof(struct sensor_algorithm);
+}
+
+static struct sensor_hw *get_hw(struct oneplus_sensor_devinfo *di,
+				unsigned int type, unsigned int index)
+{
+	char *vec = (char *)di->info + sizeof(s32) + type * vector_size(di->n_sources);
+
+	*(s32 *)vec = type;
+
+	return (struct sensor_hw *)(vec + sizeof(s32)) + index;
+}
+
+static struct sensor_algorithm *get_algo(struct oneplus_sensor_devinfo *di,
+					 unsigned int type)
+{
+	struct sensor_algorithm *algos;
+
+	algos = (void *)((char *)di->info + sizeof(s32)
+			 + SENSORS_NUM * vector_size(di->n_sources));
+	algos[type].sensor_id = type;
+
+	return &algos[type];
+}
+
+static void read_s32(struct device_node *np, const char *name, s32 *val)
+{
+	u32 tmp;
+
+	if (!of_property_read_u32(np, name, &tmp))
+		*val = tmp;
+}
+
+static void read_s32_list(struct device_node *np, const char *const *names,
+			  unsigned int n_names, s32 *vals)
+{
+	unsigned int i;
+
+	for (i = 0; i < n_names; i++)
+		read_s32(np, names[i], &vals[i]);
+}
+
+/* Read "parameter-number" values of the property into the array */
+static int read_counted_array(struct device_node *np, const char *name,
+			      s32 *vals, unsigned int max)
+{
+	u32 n;
+
+	if (of_property_read_u32(np, "parameter-number", &n) || !n || n >= max)
+		return 0;
+
+	if (of_property_read_u32_array(np, name, (u32 *)vals, n))
+		return 0;
+
+	return n;
+}
+
+static u8 read_u8_default(struct device_node *np, const char *name, u8 def)
+{
+	u32 tmp;
+
+	return of_property_read_u32(np, name, &tmp) ? def : tmp;
+}
+
+static void parse_accel(struct sensor_hw *hw, struct device_node *np)
+{
+	static const char *const features[] = { "use-sois", "single-acc" };
+
+	read_s32_list(np, features, ARRAY_SIZE(features), hw->feature.feature);
+}
+
+static void parse_mag(struct sensor_hw *hw, struct device_node *np)
+{
+	/* Identity soft iron matrix unless the device tree has one */
+	hw->feature.parameter[0] = 10000;
+	hw->feature.parameter[8] = 10000;
+	hw->feature.parameter[16] = 10000;
+
+	read_counted_array(np, "soft-mag-parameter", hw->feature.parameter,
+			   PARAMETER_NUM);
+}
+
+static void parse_prox(struct sensor_hw *hw, struct device_node *np)
+{
+	static const char *const params[] = {
+		"low_step", "high_step", "low_limit", "high_limit",
+		"dirty_low_step", "dirty_high_step", "ps_dirty_limit",
+		"ps_ir_limit", "ps_adjust_min", "ps_adjust_max",
+		"sampling_count", "step_max", "step_min", "step_div",
+		"anti_shake_delta", "dynamic_cali_max", "raw2offset_radio",
+		"offset_max", "offset_range_min", "offset_range_max",
+		"force_cali_limit", "cali_jitter_limit", "cal_offset_margin",
+		"esd_gpio_use",
+	};
+	s32 close_pd = 0;
+	int n;
+
+	read_s32(np, "ps-type", &hw->feature.feature[0]);
+	read_s32(np, "ps_saturation", &hw->feature.feature[1]);
+	read_s32(np, "is_need_close_pd", &close_pd);
+	hw->feature.feature[2] = close_pd == 1;
+	read_s32(np, "ps_factory_cali_max", &hw->feature.feature[3]);
+
+	read_s32_list(np, params, ARRAY_SIZE(params), hw->feature.parameter);
+
+	n = read_counted_array(np, "sensor-reg", &hw->feature.reg[1], REG_NUM - 1);
+	hw->feature.reg[0] = n;
+}
+
+static void parse_light(struct sensor_hw *hw, struct device_node *np)
+{
+	static const char *const features[] = {
+		"als-type", "is-unit-device", "is-als-dri", "als-factor",
+		"is_als_initialed", "als_buffer_length", "normalization_value",
+		"use_lb_algo", "para-matrix", "als_ratio_type",
+	};
+	static const char *const params[] = {
+		"coef_a", "coef_b", "coef_c", "coef_d", "coef_e",
+		"coef_ratio", "gold-reset-scale", "lcd_type",
+		"linear_comp_scope", "linear_comp_intercept", "temp_lux",
+		"coef", "bal_coef", "ir_coef_stage_0", "ir_coef_stage_1",
+		"ir_coef_stage_2", "ir_coef_stage_3", "ir_coef_val_0",
+		"ir_coef_val_1", "ir_coef_val_2", "ir_coef_val_3",
+		"ir_coef_val_4", "lb-dbv-coefs-id", "light-cut",
+	};
+
+	hw->feature.feature[6] = 1057;	/* normalization_value */
+	hw->feature.parameter[6] = 1001;	/* gold-reset-scale */
+
+	read_s32_list(np, features, ARRAY_SIZE(features), hw->feature.feature);
+	read_s32_list(np, params, ARRAY_SIZE(params), hw->feature.parameter);
+}
+
+static void parse_light_rear(struct sensor_hw *hw, struct device_node *np)
+{
+	read_s32(np, "als-factor", &hw->feature.feature[0]);
+}
+
+static void parse_sar(struct sensor_hw *hw, struct device_node *np)
+{
+	static const s32 dc_offset_default[SAR_MAX_CH_NUM * 2] = {
+		0, 0, 0, 0, 0, 30000, 30000, 30000, 30000, 30000,
+	};
+	s32 dc_offset = 0;
+	u32 channels;
+	int n;
+
+	n = read_counted_array(np, "sensor-reg", hw->feature.parameter,
+			       PARAMETER_NUM);
+
+	/* The downstream driver stores the channel count after the register pairs */
+	if (!of_property_read_u32(np, "channel-num", &channels) &&
+	    channels < SAR_MAX_CH_NUM)
+		hw->feature.feature[n / 2] = channels;
+
+	read_s32(np, "is-dc-offset", &dc_offset);
+	if (dc_offset == 1) {
+		memcpy(hw->feature.reg, dc_offset_default, sizeof(dc_offset_default));
+		of_property_read_u32_array(np, "dc-offset", (u32 *)hw->feature.reg,
+					   ARRAY_SIZE(dc_offset_default));
+	}
+}
+
+static void parse_down_sar(struct sensor_hw *hw, struct device_node *np)
+{
+	read_counted_array(np, "sensor-reg", hw->feature.parameter, PARAMETER_NUM);
+}
+
+static void parse_cct(struct sensor_hw *hw, struct device_node *np, bool rear)
+{
+	static const char *const features[] = {
+		"decoupled-driver", "publish-sensors", "is-ch-dri",
+		"timer-size", "fac-cali-sensor",
+	};
+	static const char *const params[] = {
+		"para-matrix", "atime", "first-atime", "fac-cali-atime",
+		"first-again", "fac-cali-again", "fd-time", "fac-cali-fd-time",
+		"first-fd-gain", "fac-cali-fd-gain", "algo-flag",
+	};
+
+	/* Use the decoupled driver unless the device tree says otherwise */
+	hw->feature.feature[0] = 1;
+
+	read_s32_list(np, features, ARRAY_SIZE(features), hw->feature.feature);
+	read_s32_list(np, params, ARRAY_SIZE(params) - rear, hw->feature.parameter);
+}
+
+static void parse_physical(struct oneplus_sensor_devinfo *di,
+			   struct device_node *np, unsigned int type)
+{
+	struct sensor_hw *hw;
+	u32 index;
+
+	if (of_property_read_u32(np, "sensor-index", &index) ||
+	    index >= di->n_sources)
+		return;
+
+	hw = get_hw(di, type, index);
+
+	hw->sensor_name = read_u8_default(np, "sensor-name", 0);
+	hw->bus_number = read_u8_default(np, "bus-number", DEFAULT_CONFIG);
+	hw->direction = read_u8_default(np, "sensor-direction", DEFAULT_CONFIG);
+	hw->irq_number = read_u8_default(np, "irq-number", DEFAULT_CONFIG);
+
+	if (of_node_name_prefix(np, "gsensor"))
+		parse_accel(hw, np);
+	else if (of_node_name_prefix(np, "msensor"))
+		parse_mag(hw, np);
+	else if (of_node_name_prefix(np, "psensor"))
+		parse_prox(hw, np);
+	else if (of_node_name_prefix(np, "lsensor"))
+		parse_light(hw, np);
+	else if (of_node_name_prefix(np, "lrsensor"))
+		parse_light_rear(hw, np);
+	else if (of_node_name_prefix(np, "ssensor"))
+		parse_sar(hw, np);
+	else if (of_node_name_prefix(np, "sdsensor"))
+		parse_down_sar(hw, np);
+	else if (of_node_name_prefix(np, "cctsensor"))
+		parse_cct(hw, np, false);
+	else if (of_node_name_prefix(np, "cctrsensor"))
+		parse_cct(hw, np, true);
+}
+
+static void parse_virtual(struct oneplus_sensor_devinfo *di,
+			  struct device_node *np, unsigned int type)
+{
+	struct sensor_algorithm *algo = get_algo(di, type);
+
+	if (of_node_name_prefix(np, "pickup")) {
+		read_s32(np, "is-need-prox", &algo->feature[0]);
+		read_s32(np, "prox-type", &algo->parameter[0]);
+	} else if (of_node_name_prefix(np, "lux_aod")) {
+		read_s32(np, "thrd-low", &algo->parameter[0]);
+		read_s32(np, "thrd-high", &algo->parameter[1]);
+		read_s32(np, "als-type", &algo->parameter[2]);
+		read_s32(np, "fold-feature", &algo->feature[0]);
+	} else if (of_node_name_prefix(np, "fp_display")) {
+		read_s32(np, "prox-type", &algo->parameter[0]);
+	} else if (of_node_name_prefix(np, "mag_fusion")) {
+		read_s32(np, "fusion-type", &algo->feature[0]);
+		read_s32(np, "mag-type", &algo->feature[1]);
+	} else if (of_node_name_prefix(np, "oplus_measurement")) {
+		read_s32(np, "acc-range", &algo->parameter[0]);
+		read_s32(np, "gyro-range", &algo->parameter[1]);
+	}
+}
+
+static int oneplus_sensor_devinfo_probe(struct platform_device *pdev)
+{
+	struct oneplus_sensor_devinfo di;
+	struct device *dev = &pdev->dev;
+	size_t size = 0;
+	u32 type;
+	int ret;
+
+	di.info = qcom_smem_get(QCOM_SMEM_HOST_ANY, SMEM_SENSOR, &size);
+	if (PTR_ERR(di.info) == -ENOENT) {
+		ret = qcom_smem_alloc(QCOM_SMEM_HOST_ANY, SMEM_SENSOR, info_size(3));
+		if (ret && ret != -EEXIST)
+			return dev_err_probe(dev, ret, "failed to allocate SMEM item\n");
+
+		di.info = qcom_smem_get(QCOM_SMEM_HOST_ANY, SMEM_SENSOR, &size);
+	}
+	if (IS_ERR(di.info))
+		return dev_err_probe(dev, PTR_ERR(di.info), "failed to get SMEM item\n");
+
+	if (size == info_size(3))
+		di.n_sources = 3;
+	else if (size == info_size(2))
+		di.n_sources = 2;
+	else
+		return dev_err_probe(dev, -EINVAL, "unexpected SMEM item size %zu\n", size);
+
+	memset(di.info, 0, size);
+
+	for_each_available_child_of_node_scoped(dev->of_node, np) {
+		bool is_virtual = of_property_read_bool(np, "is-virtual-sensor");
+
+		if (of_property_read_u32(np, "sensor-type", &type))
+			continue;
+
+		if (is_virtual && type < SENSOR_ALGO_NUM)
+			parse_virtual(&di, np, type);
+		else if (!is_virtual && type < SENSORS_NUM)
+			parse_physical(&di, np, type);
+		else
+			dev_warn(dev, "%pOFn: invalid sensor type %u\n", np, type);
+	}
+
+	dev_dbg(dev, "filled SMEM item (%u sources per sensor)\n", di.n_sources);
+
+	return 0;
+}
+
+static const struct of_device_id oneplus_sensor_devinfo_of_match[] = {
+	{ .compatible = "oneplus,sensor-devinfo" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, oneplus_sensor_devinfo_of_match);
+
+static struct platform_driver oneplus_sensor_devinfo_driver = {
+	.probe = oneplus_sensor_devinfo_probe,
+	.driver = {
+		.name = "oneplus-sensor-devinfo",
+		.of_match_table = oneplus_sensor_devinfo_of_match,
+	},
+};
+module_platform_driver(oneplus_sensor_devinfo_driver);
+
+MODULE_DESCRIPTION("OnePlus sensor device info for the sensor DSP");
+MODULE_LICENSE("GPL");
-- 
2.43.0

