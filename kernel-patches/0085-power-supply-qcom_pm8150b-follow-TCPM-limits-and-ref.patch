 	case POWER_SUPPLY_PROP_CHARGING_ENABLED:
 		return smb5_get_prop_charging_enabled(chip, &val->intval);
 	default:
@@ -642,9 +822,18 @@ static int smb5_set_property(struct power_supply *psy,
 {
