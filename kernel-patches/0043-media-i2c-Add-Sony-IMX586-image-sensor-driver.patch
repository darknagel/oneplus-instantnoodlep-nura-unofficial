From 5ea39a0d76f28395cf938a60acf7b678b890978b Mon Sep 17 00:00:00 2001
From: Timo <1788603+darknagel@users.noreply.github.com>
Date: Mon, 2 Nov 2026 23:00:50 +0100
Subject: [PATCH 43/45] media: i2c: Add Sony IMX586 image sensor driver

Add a driver for the Sony IMX586, the ultrawide camera of the OnePlus 8
Pro. It is connected through three C-PHY trios and runs from a 19.2 MHz
clock. The register settings come from the camera module data of the
phone. Only the 2x2 binned 4000x3000 mode at 30 fps is supported.

Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
---
 drivers/media/i2c/Kconfig  |   10 +
 drivers/media/i2c/Makefile |    1 +
 drivers/media/i2c/imx586.c | 2567 ++++++++++++++++++++++++++++++++++++
 3 files changed, 2578 insertions(+)
 create mode 100644 drivers/media/i2c/imx586.c

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 6b3dd4115..9d7764ad4 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -297,6 +297,16 @@ config VIDEO_IMX471
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx471.
 
+config VIDEO_IMX586
+	tristate "Sony IMX586 sensor support"
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the Sony
+	  IMX586 camera.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called imx586.
+
 config VIDEO_IMX689
 	tristate "Sony IMX689 sensor support"
 	select V4L2_CCI_I2C
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index 99d321e41..eb984cfc0 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -63,6 +63,7 @@ obj-$(CONFIG_VIDEO_IMX412) += imx412.o
 obj-$(CONFIG_VIDEO_IMX415) += imx415.o
 obj-$(CONFIG_VIDEO_IMX471) += imx471.o
 obj-$(CONFIG_VIDEO_IMX689) += imx689.o
+obj-$(CONFIG_VIDEO_IMX586) += imx586.o
 obj-$(CONFIG_VIDEO_IR_I2C) += ir-kbd-i2c.o
 obj-$(CONFIG_VIDEO_ISL7998X) += isl7998x.o
 obj-$(CONFIG_VIDEO_KS0127) += ks0127.o
diff --git a/drivers/media/i2c/imx586.c b/drivers/media/i2c/imx586.c
new file mode 100644
index 000000000..16d77e0e8
--- /dev/null
+++ b/drivers/media/i2c/imx586.c
@@ -0,0 +1,2567 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sony IMX586 image sensor driver
+ *
+ * The register settings are taken from the camera module data of the
+ * OnePlus 8 Pro, which uses the IMX586 as ultrawide camera with a 19.2 MHz
+ * MCLK and three CSI-2 C-PHY trios.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+
+#define IMX586_MCLK_FREQ		(19200 * HZ_PER_KHZ)
+#define IMX586_DATA_LANES		3
+
+#define IMX586_REG_CHIP_ID		CCI_REG16(0x0016)
+#define IMX586_CHIP_ID			0x0586
+
+#define IMX586_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define IMX586_MODE_STANDBY		0x00
+#define IMX586_MODE_STREAMING		0x01
+
+#define IMX586_REG_EXPOSURE		CCI_REG16(0x0202)
+#define IMX586_EXPOSURE_MIN		4
+#define IMX586_EXPOSURE_STEP		1
+#define IMX586_EXPOSURE_MARGIN		48
+#define IMX586_EXPOSURE_DEFAULT		1000
+
+/* Analogue gain = 1024 / (1024 - code), up to 16x */
+#define IMX586_REG_AGAIN		CCI_REG16(0x0204)
+#define IMX586_AGAIN_MIN		0
+#define IMX586_AGAIN_MAX		960
+#define IMX586_AGAIN_STEP		1
+#define IMX586_AGAIN_DEFAULT		0
+
+#define IMX586_REG_VTS			CCI_REG16(0x0340)
+#define IMX586_VTS_MAX			0xffff
+
+#define IMX586_REG_TEST_PATTERN		CCI_REG16(0x0600)
+
+#define IMX586_NATIVE_WIDTH		8000
+#define IMX586_NATIVE_HEIGHT		6000
+
+#define to_imx586(_sd)			container_of(_sd, struct imx586, sd)
+
+static const s64 imx586_link_freq_menu[] = {
+	421200000,
+};
+
+struct imx586_reg_list {
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+struct imx586_mode {
+	u32 width;			/* Frame width in pixels */
+	u32 height;			/* Frame height in pixels */
+	u32 hts;			/* Horizontal timing size */
+	u32 vts;			/* Default vertical timing size */
+	u32 link_freq_index;		/* Index into imx586_link_freq_menu */
+	u64 pixel_rate;			/* Pixel rate matching hts and vts */
+	struct v4l2_rect crop;		/* Analogue crop rectangle */
+
+	const struct imx586_reg_list reg_list;	/* Sensor register setting */
+};
+
+static const char * const imx586_test_pattern_menu[] = {
+	"Disabled",
+	"Solid colour",
+	"Colour bars",
+	"Fade to grey colour bars",
+	"PN9",
+};
+
+static const char * const imx586_supply_names[] = {
+	"avdd",		/* Analog power */
+	"avdd2",	/* Second analog power */
+	"dvdd",		/* Digital core power */
+	"dovdd",	/* Digital I/O power */
+};
+
+#define IMX586_NUM_SUPPLIES	ARRAY_SIZE(imx586_supply_names)
+
+struct imx586 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[IMX586_NUM_SUPPLIES];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+
+	const struct imx586_mode *mode;
+};
