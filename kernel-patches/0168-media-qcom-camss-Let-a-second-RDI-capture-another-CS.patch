From a8ec5f60c9437153c07e482fb6a8b65b4e7f9190 Mon Sep 17 00:00:00 2001
From: Timo <1788603+darknagel@users.noreply.github.com>
Date: Sat, 14 Nov 2026 20:51:11 +0100
Subject: [PATCH] media: qcom: camss: Let a second RDI capture another CSI-2
 stream

Phase detection sensors send their phase data as a second stream on its
own virtual channel and data type (the IMX689 of the OnePlus 8 Pro uses
virtual channel 1, data type 0x30). The gen2 CSID gave every RDI virtual
channel 0 and the data type of the pad format, so that stream was dropped.

Add the module parameters rdi_vc and rdi_dt to pick the virtual channel
and data type per RDI, and let several RDI video nodes of one CSID share
the running CSID, CSIPHY and sensor: only the first to start streams them
and only the last to stop stops them.

Stopping one VFE line reset the whole VFE, which stopped the other lines
as well. Reset it only when the last line stops; otherwise wait for the
reg update that latches the stopped write master, so that it no longer
writes to the buffers that are released next.
---
 .../platform/qcom/camss/camss-csid-gen2.c     | 17 ++++++++--
 .../media/platform/qcom/camss/camss-csid.h    |  2 ++
 drivers/media/platform/qcom/camss/camss-vfe.c | 24 +++++++++++++-
 .../media/platform/qcom/camss/camss-video.c   | 31 +++++++++++++++++++
 4 files changed, 71 insertions(+), 3 deletions(-)

diff --git a/drivers/media/platform/qcom/camss/camss-csid-gen2.c b/drivers/media/platform/qcom/camss/camss-csid-gen2.c
index 52ef730b1..225837c32 100644
--- a/drivers/media/platform/qcom/camss/camss-csid-gen2.c
+++ b/drivers/media/platform/qcom/camss/camss-csid-gen2.c
@@ -171,6 +171,19 @@
 #define		TPG_COLOR_BOX_CFG_MODE		0
 #define		TPG_COLOR_BOX_PATTERN_SEL	2
 
+/*
+ * Virtual channel and data type per RDI. A data type of 0 takes the one of
+ * the pad format, so by default every RDI gets virtual channel 0 and the
+ * pixel data. Setting them lets a second RDI pick up another stream of the
+ * sensor, for example phase detection data on virtual channel 1.
+ */
+static int rdi_vc[MSM_CSID_MAX_SRC_STREAMS];
+static int rdi_dt[MSM_CSID_MAX_SRC_STREAMS];
+module_param_array(rdi_vc, int, NULL, 0644);
+MODULE_PARM_DESC(rdi_vc, "CSI-2 virtual channel per RDI");
+module_param_array(rdi_dt, int, NULL, 0644);
+MODULE_PARM_DESC(rdi_dt, "CSI-2 data type per RDI, 0 for the one of the format");
+
 static void __csid_configure_rx(struct csid_device *csid,
 				struct csid_phy_config *phy, int vc)
 {
@@ -282,7 +295,7 @@ static void __csid_configure_rdi_stream(struct csid_device *csid, u8 enable, u8
 	val |= 1 << RDI_CFG0_TIMESTAMP_EN;
 	/* note: for non-RDI path, this should be format->decode_format */
 	val |= DECODE_FORMAT_PAYLOAD_ONLY << RDI_CFG0_DECODE_FORMAT;
-	val |= format->data_type << RDI_CFG0_DATA_TYPE;
+	val |= (rdi_dt[port] ? rdi_dt[port] & 0x3f : format->data_type) << RDI_CFG0_DATA_TYPE;
 	val |= vc << RDI_CFG0_VIRTUAL_CHANNEL;
 	val |= dt_id << RDI_CFG0_DT_ID;
 	writel_relaxed(val, csid->base + CSID_RDI_CFG0(port));
@@ -334,7 +347,7 @@ static void csid_configure_stream(struct csid_device *csid, u8 enable)
 			if (tg->enabled)
 				__csid_configure_testgen(csid, enable, i, 0);
 
-			__csid_configure_rdi_stream(csid, enable, i, 0);
+			__csid_configure_rdi_stream(csid, enable, i, rdi_vc[i] & 0x1f);
 			__csid_configure_rx(csid, &csid->phy, 0);
 			__csid_ctrl_rdi(csid, enable, i);
 		}
diff --git a/drivers/media/platform/qcom/camss/camss-csid.h b/drivers/media/platform/qcom/camss/camss-csid.h
index 00e2669db..31ee3248e 100644
--- a/drivers/media/platform/qcom/camss/camss-csid.h
+++ b/drivers/media/platform/qcom/camss/camss-csid.h
@@ -70,6 +70,8 @@ struct csid_phy_config {
 	u32 lane_assign;
 	u32 en_vc;
 	u8 need_vc_update;
+	/* RDI video nodes streaming from this CSID */
+	unsigned int stream_count;
 	bool cphy;
 };
 
diff --git a/drivers/media/platform/qcom/camss/camss-vfe.c b/drivers/media/platform/qcom/camss/camss-vfe.c
index 8d3cffc28..9ab1677c5 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe.c
@@ -814,14 +814,36 @@ static int vfe_disable_output(struct vfe_line *line)
 	struct vfe_output *output = &line->output;
 	unsigned long flags;
 	unsigned int i;
+	bool last;
+
+	/* A reset stops all lines, so leave it to the last one */
+	mutex_lock(&vfe->stream_lock);
+	last = vfe->stream_count <= 1;
+	mutex_unlock(&vfe->stream_lock);
 
 	spin_lock_irqsave(&vfe->output_lock, flags);
 	for (i = 0; i < output->wm_num; i++)
 		vfe->res->hw_ops->vfe_wm_stop(vfe, output->wm_idx[i]);
 	output->gen2.active_num = 0;
+	if (!last) {
+		/*
+		 * The write master registers are latched at the next reg
+		 * update, so wait for it before the buffers are released.
+		 */
+		output->wait_reg_update = 1;
+		reinit_completion(&output->reg_update);
+		vfe->res->hw_ops->reg_update(vfe, line->id);
+	}
 	spin_unlock_irqrestore(&vfe->output_lock, flags);
 
-	return vfe_reset(vfe);
+	if (last)
+		return vfe_reset(vfe);
+
+	if (!wait_for_completion_timeout(&output->reg_update,
+					 msecs_to_jiffies(500)))
+		dev_warn(vfe->camss->dev, "VFE line %d stop timeout\n", line->id);
+
+	return 0;
 }
 
 /*
diff --git a/drivers/media/platform/qcom/camss/camss-video.c b/drivers/media/platform/qcom/camss/camss-video.c
index 0852eb6f1..117cae8ff 100644
--- a/drivers/media/platform/qcom/camss/camss-video.c
+++ b/drivers/media/platform/qcom/camss/camss-video.c
@@ -249,12 +249,29 @@ static int video_prepare_streaming(struct vb2_queue *q)
 	return ret;
 }
 
+/*
+ * Several RDIs of one CSID share the CSID, the CSIPHY and the sensor. Only
+ * the first video node to start streams them and only the last one to stop
+ * stops them.
+ */
+static struct csid_device *video_csid(struct camss *camss, struct v4l2_subdev *sd)
+{
+	unsigned int i;
+
+	for (i = 0; i < camss->res->csid_num; i++)
+		if (&camss->csid[i].subdev == sd)
+			return &camss->csid[i];
+
+	return NULL;
+}
+
 static int video_start_streaming(struct vb2_queue *q, unsigned int count)
 {
 	struct camss_video *video = vb2_get_drv_priv(q);
 	struct video_device *vdev = &video->vdev;
 	struct media_entity *entity;
 	struct media_pad *pad;
+	struct csid_device *csid, *counted = NULL;
 	struct v4l2_subdev *subdev;
 	int ret;
 
@@ -281,6 +298,13 @@ static int video_start_streaming(struct vb2_queue *q, unsigned int count)
 		entity = pad->entity;
 		subdev = media_entity_to_v4l2_subdev(entity);
 
+		csid = video_csid(video->camss, subdev);
+		if (csid) {
+			if (csid->phy.stream_count++)
+				break;
+			counted = csid;
+		}
+
 		ret = v4l2_subdev_call(subdev, video, s_stream, 1);
 		if (ret < 0 && ret != -ENOIOCTLCMD)
 			goto error;
@@ -289,6 +313,8 @@ static int video_start_streaming(struct vb2_queue *q, unsigned int count)
 	return 0;
 
 error:
+	if (counted)
+		counted->phy.stream_count--;
 	video_device_pipeline_stop(vdev);
 
 flush_buffers:
@@ -303,6 +329,7 @@ static void video_stop_streaming(struct vb2_queue *q)
 	struct video_device *vdev = &video->vdev;
 	struct media_entity *entity;
 	struct media_pad *pad;
+	struct csid_device *csid;
 	struct v4l2_subdev *subdev;
 	int ret;
 
@@ -319,6 +346,10 @@ static void video_stop_streaming(struct vb2_queue *q)
 		entity = pad->entity;
 		subdev = media_entity_to_v4l2_subdev(entity);
 
+		csid = video_csid(video->camss, subdev);
+		if (csid && csid->phy.stream_count && --csid->phy.stream_count)
+			break;
+
 		ret = v4l2_subdev_call(subdev, video, s_stream, 0);
 
 		if (ret) {
-- 
2.43.0

