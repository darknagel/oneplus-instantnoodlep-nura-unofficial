From fa61ac3a878ba9a2ad4656e3180bf786e1c9ce34 Mon Sep 17 00:00:00 2001
From: Timo <1788603+darknagel@users.noreply.github.com>
Date: Tue, 27 Oct 2026 23:06:49 +0100
Subject: [PATCH 28/30] DEBUG: mhi: pci_generic: collect SDX55 RAM dumps

Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
---
 drivers/bus/mhi/host/boot.c        |  3 +-
 drivers/bus/mhi/host/pci_generic.c | 49 ++++++++++++++++++++++++++++++
 2 files changed, 51 insertions(+), 1 deletion(-)

diff --git a/drivers/bus/mhi/host/boot.c b/drivers/bus/mhi/host/boot.c
index 19c84913c..095e627e3 100644
--- a/drivers/bus/mhi/host/boot.c
+++ b/drivers/bus/mhi/host/boot.c
@@ -429,7 +429,8 @@ static enum mhi_fw_load_type mhi_fw_load_type_get(const struct mhi_controller *m
 	if (mhi_cntrl->fbc_download) {
 		return MHI_FW_LOAD_FBC;
 	} else {
-		if (mhi_cntrl->seg_len)
+		/* DEBUG: seg_len set only for the RDDM table keeps BHI */
+		if (mhi_cntrl->seg_len && !mhi_cntrl->rddm_size)
 			return MHI_FW_LOAD_BHIE;
 		else
 			return MHI_FW_LOAD_BHI;
diff --git a/drivers/bus/mhi/host/pci_generic.c b/drivers/bus/mhi/host/pci_generic.c
index 4ded7d965..bc6932b82 100644
--- a/drivers/bus/mhi/host/pci_generic.c
+++ b/drivers/bus/mhi/host/pci_generic.c
@@ -13,6 +13,9 @@
 #include <linux/mhi.h>
 #include <linux/module.h>
 #include <linux/of.h>
+#include <linux/devcoredump.h>
+#include <linux/vmalloc.h>
+#include <linux/sizes.h>
 #include <linux/pci.h>
 #include <linux/pm_runtime.h>
 #include <linux/timer.h>
@@ -1131,6 +1134,7 @@ struct mhi_pci_device {
 	struct mhi_controller mhi_cntrl;
 	struct pci_saved_state *pci_state;
 	struct work_struct recovery_work;
+	struct work_struct rddm_work;
 	struct timer_list health_check_timer;
 	unsigned long status;
 	bool reset_on_remove;
@@ -1161,6 +1165,12 @@ static void mhi_pci_status_cb(struct mhi_controller *mhi_cntrl,
 		dev_warn(&pdev->dev, "firmware crashed (%u)\n", cb);
 		pm_runtime_forbid(&pdev->dev);
 		break;
+	case MHI_CB_EE_RDDM:
+		dev_warn(&pdev->dev, "firmware crashed, collecting RAM dump\n");
+		pm_runtime_forbid(&pdev->dev);
+		schedule_work(&container_of(mhi_cntrl, struct mhi_pci_device,
+					    mhi_cntrl)->rddm_work);
+		break;
 	case MHI_CB_EE_MISSION_MODE:
 		pm_runtime_allow(&pdev->dev);
 		break;
@@ -1169,6 +1179,39 @@ static void mhi_pci_status_cb(struct mhi_controller *mhi_cntrl,
 	}
 }
 
+static void mhi_pci_rddm_work(struct work_struct *work)
+{
+	struct mhi_pci_device *mhi_pdev = container_of(work, struct mhi_pci_device, rddm_work);
+	struct mhi_controller *mhi_cntrl = &mhi_pdev->mhi_cntrl;
+	struct image_info *img = mhi_cntrl->rddm_image;
+	size_t size = 0, off = 0;
+	unsigned int i;
+	void *buf;
+	int ret;
+
+	ret = mhi_download_rddm_image(mhi_cntrl, false);
+	if (ret) {
+		dev_err(mhi_cntrl->cntrl_dev, "RAM dump download failed: %d\n", ret);
+		return;
+	}
+
+	/* The last entry holds the vector table */
+	for (i = 0; i < img->entries - 1; i++)
+		size += img->mhi_buf[i].len;
+
+	buf = vmalloc(size);
+	if (!buf)
+		return;
+
+	for (i = 0; i < img->entries - 1; i++) {
+		memcpy(buf + off, img->mhi_buf[i].buf, img->mhi_buf[i].len);
+		off += img->mhi_buf[i].len;
+	}
+
+	dev_info(mhi_cntrl->cntrl_dev, "RAM dump of %zu bytes collected\n", size);
+	dev_coredumpv(mhi_cntrl->cntrl_dev, buf, size, GFP_KERNEL);
+}
+
 static void mhi_pci_wake_get_nop(struct mhi_controller *mhi_cntrl, bool force)
 {
 	/* no-op */
@@ -1424,6 +1467,7 @@ static int mhi_pci_probe(struct pci_dev *pdev, const struct pci_device_id *id)
 		return -ENOMEM;
 
 	INIT_WORK(&mhi_pdev->recovery_work, mhi_pci_recovery_work);
+	INIT_WORK(&mhi_pdev->rddm_work, mhi_pci_rddm_work);
 
 	if (pdev->is_virtfn && info->vf_config)
 		mhi_cntrl_config = info->vf_config;
@@ -1443,6 +1487,11 @@ static int mhi_pci_probe(struct pci_dev *pdev, const struct pci_device_id *id)
 	mhi_cntrl->iova_start = 0;
 	mhi_cntrl->iova_stop = (dma_addr_t)DMA_BIT_MASK(dma_data_width);
 	mhi_cntrl->fw_image = info->fw;
+	if (info == &mhi_qcom_sdx55_flashless_info) {
+		/* RDDM is collected through a BHIe table of 512 KiB segments */
+		mhi_cntrl->rddm_size = SZ_64M;
+		mhi_cntrl->seg_len = SZ_512K;
+	}
 	mhi_cntrl->edl_image = info->edl;
 
 	mhi_cntrl->read_reg = mhi_pci_read_reg;
-- 
2.43.0

