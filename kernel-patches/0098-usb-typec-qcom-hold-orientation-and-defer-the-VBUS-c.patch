From 592bf3e455027c62fdb409847c9f87253f01e45f Mon Sep 17 00:00:00 2001
From: Roman Kuraev <naoru.desu@gmail.com>
Date: Tue, 10 Nov 2026 03:30:54 +0000
Subject: [PATCH] usb: typec: qcom: hold orientation and defer the VBUS check
 during PR_SWAP

Preserve PD transmit orientation while a power-role swap changes the CC
termination, then release the override on completion, reset or detach.
The override covers only the actual swap; holding it for a whole
attachment masked unplug detection.

During a source-to-sink power-role swap, the external VBUS switch
turns off before the PMIC leaves its source state. VSAFE0V stays
unset until Rd is applied, so polling it before changing CC always
expires on the OnePlus 8 Pro.

For this PR_SWAP path, defer the existing VSAFE0V check until Rd or
recovery OPEN has been applied, before TCPM sends PS_RDY. Preserve
immediate polling for other transitions and retain the warning when
the deferred voltage-status check really times out. The deferral
applies to every board that names its VBUS supply in the connector
node, not only to external switches.

Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
---
 .../typec/tcpm/qcom/qcom_pmic_typec_port.c    | 109 ++++++++++++++----
 1 file changed, 88 insertions(+), 21 deletions(-)

diff --git a/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port.c b/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port.c
index 29d9f4c8b..8ce5bba06 100644
--- a/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port.c
+++ b/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port.c
@@ -174,6 +174,9 @@ struct pmic_typec_port {
 
 	struct regulator		*vdd_vbus;
 	bool				vbus_enabled;
+	bool				external_vbus;
+	bool				power_role_swap;
+	bool				vbus_off_pending;
 	struct mutex			vbus_lock;		/* VBUS state serialization */
 
 	int				cc;
@@ -290,34 +293,40 @@ static int qcom_pmic_typec_port_vbus_detect(struct pmic_typec_port *pmic_typec_p
 	return !!(misc & TYPEC_VBUS_DETECT);
 }
 
-static int qcom_pmic_typec_port_vbus_toggle(struct pmic_typec_port *pmic_typec_port, bool on)
+static void qcom_pmic_typec_port_wait_vbus(struct pmic_typec_port *port, bool on)
 {
+	u32 val = on ? TYPEC_SM_VBUS_VSAFE5V : TYPEC_SM_VBUS_VSAFE0V;
 	u32 sm_stat;
-	u32 val;
 	int ret;
 
-	if (on) {
-		ret = regulator_enable(pmic_typec_port->vdd_vbus);
-		if (ret)
-			return ret;
-
-		val = TYPEC_SM_VBUS_VSAFE5V;
-	} else {
-		ret = regulator_disable(pmic_typec_port->vdd_vbus);
-		if (ret)
-			return ret;
+	ret = regmap_read_poll_timeout(port->regmap, port->base + TYPEC_SM_STATUS_REG,
+				       sm_stat, sm_stat & val, 100, 250000);
+	if (ret)
+		dev_warn(port->dev, "vbus vsafe%dv fail\n", on ? 5 : 0);
+}
 
-		val = TYPEC_SM_VBUS_VSAFE0V;
-	}
+static int qcom_pmic_typec_port_vbus_toggle(struct pmic_typec_port *port, bool on)
+{
+	int ret;
 
-	/* Poll waiting for transition to required vSafe5V or vSafe0V */
-	ret = regmap_read_poll_timeout(pmic_typec_port->regmap,
-				       pmic_typec_port->base + TYPEC_SM_STATUS_REG,
-				       sm_stat, sm_stat & val,
-				       100, 250000);
+	ret = on ? regulator_enable(port->vdd_vbus) : regulator_disable(port->vdd_vbus);
 	if (ret)
-		dev_warn(pmic_typec_port->dev, "vbus vsafe%dv fail\n", on ? 5 : 0);
+		return ret;
+
+	port->vbus_off_pending = false;
+	/*
+	 * With an external VBUS switch, the PMIC can retain its source-state
+	 * VSAFE indication until Rp is removed. During PR_SWAP, check VSAFE0V
+	 * after applying Rd (or opening CC during recovery), before PS_RDY.
+	 */
+	if (!on && port->external_vbus && port->power_role_swap &&
+	    (port->cc == TYPEC_CC_RP_DEF || port->cc == TYPEC_CC_RP_1_5 ||
+	     port->cc == TYPEC_CC_RP_3_0)) {
+		port->vbus_off_pending = true;
+		return 0;
+	}
 
+	qcom_pmic_typec_port_wait_vbus(port, on);
 	return 0;
 }
 
@@ -514,6 +523,15 @@ static int qcom_pmic_typec_port_set_cc(struct tcpc_dev *tcpc,
 	if (ret)
 		goto done;
 
+	/* Let hardware detect the orientation of the next attachment. */
+	if (cc == TYPEC_CC_OPEN) {
+		ret = regmap_update_bits(pmic_typec_port->regmap,
+					 pmic_typec_port->base + TYPEC_CCOUT_CONTROL_REG,
+					 TYPEC_CCOUT_SRC, 0);
+		if (ret)
+			goto done;
+	}
+
 	pmic_typec_port->cc = cc;
 	qcom_pmic_set_cc_debounce(pmic_typec_port);
 	ret = 0;
@@ -521,6 +539,15 @@ static int qcom_pmic_typec_port_set_cc(struct tcpc_dev *tcpc,
 done:
 	spin_unlock_irqrestore(&pmic_typec_port->lock, flags);
 
+	if (!ret && (cc == TYPEC_CC_RD || cc == TYPEC_CC_OPEN)) {
+		mutex_lock(&pmic_typec_port->vbus_lock);
+		if (pmic_typec_port->vbus_off_pending && !pmic_typec_port->vbus_enabled) {
+			qcom_pmic_typec_port_wait_vbus(pmic_typec_port, false);
+			pmic_typec_port->vbus_off_pending = false;
+		}
+		mutex_unlock(&pmic_typec_port->vbus_lock);
+	}
+
 	dev_dbg(dev, "set_cc: currsrc=%x %s mode %s debounce %d attached %d cc=%s\n",
 		currsrc, rp_sel_to_name(currsrc),
 		mode == EN_SRC_ONLY ? "EN_SRC_ONLY" :
@@ -534,10 +561,42 @@ static int qcom_pmic_typec_port_set_cc(struct tcpc_dev *tcpc,
 static int qcom_pmic_typec_port_set_polarity(struct tcpc_dev *tcpc,
 					     enum typec_cc_polarity pol)
 {
-	/* Polarity is set separately by phy-qcom-qmp.c */
+	/* The USB/DP PHY controls orientation outside a PD power-role swap. */
 	return 0;
 }
 
+static int qcom_pmic_typec_port_set_power_role_swap(struct tcpc_dev *tcpc,
+						 bool active,
+						 enum typec_cc_polarity pol)
+{
+	struct pmic_typec *tcpm = tcpc_to_tcpm(tcpc);
+	struct pmic_typec_port *port = tcpm->pmic_typec_port;
+	unsigned int mask = TYPEC_CCOUT_SRC;
+	unsigned int value = 0;
+	unsigned long flags;
+	int ret;
+
+	/* Preserve the PD channel only while the CC terminations change. */
+	if (active) {
+		mask |= TYPEC_CCOUT_BUFFER_EN | TYPEC_CCOUT_VALUE;
+		value = TYPEC_CCOUT_BUFFER_EN | TYPEC_CCOUT_SRC;
+		if (pol == TYPEC_POLARITY_CC2)
+			value |= TYPEC_CCOUT_VALUE;
+	}
+
+	spin_lock_irqsave(&port->lock, flags);
+	ret = regmap_update_bits(port->regmap, port->base + TYPEC_CCOUT_CONTROL_REG,
+				 mask, value);
+	spin_unlock_irqrestore(&port->lock, flags);
+	if (!ret) {
+		mutex_lock(&port->vbus_lock);
+		port->power_role_swap = active;
+		mutex_unlock(&port->vbus_lock);
+	}
+
+	return ret;
+}
+
 static int qcom_pmic_typec_port_set_vconn(struct tcpc_dev *tcpc, bool on)
 {
 	struct pmic_typec *tcpm = tcpc_to_tcpm(tcpc);
@@ -613,6 +672,12 @@ static int qcom_pmic_typec_port_start_toggling(struct tcpc_dev *tcpc,
 
 	qcom_pmic_set_cc_debounce(pmic_typec_port);
 
+	ret = regmap_update_bits(pmic_typec_port->regmap,
+				 pmic_typec_port->base + TYPEC_CCOUT_CONTROL_REG,
+				 TYPEC_CCOUT_SRC, 0);
+	if (ret)
+		goto done;
+
 	/* force it to toggle at least once */
 	ret = regmap_write(pmic_typec_port->regmap,
 			   pmic_typec_port->base + TYPEC_MODE_CFG_REG,
@@ -736,6 +801,7 @@ int qcom_pmic_typec_port_probe(struct platform_device *pdev,
 	pmic_typec_port->vdd_vbus = devm_of_regulator_get_optional(dev,
 								   to_of_node(connector),
 								   "vbus");
+	pmic_typec_port->external_vbus = !IS_ERR(pmic_typec_port->vdd_vbus);
 	if (pmic_typec_port->vdd_vbus == ERR_PTR(-ENODEV))
 		pmic_typec_port->vdd_vbus = devm_regulator_get(dev, "vdd-vbus");
 	if (IS_ERR(pmic_typec_port->vdd_vbus))
@@ -778,6 +844,7 @@ int qcom_pmic_typec_port_probe(struct platform_device *pdev,
 	tcpm->tcpc.set_cc = qcom_pmic_typec_port_set_cc;
 	tcpm->tcpc.get_cc = qcom_pmic_typec_port_get_cc;
 	tcpm->tcpc.set_polarity = qcom_pmic_typec_port_set_polarity;
+	tcpm->tcpc.set_power_role_swap = qcom_pmic_typec_port_set_power_role_swap;
 	tcpm->tcpc.set_vconn = qcom_pmic_typec_port_set_vconn;
 	tcpm->tcpc.start_toggling = qcom_pmic_typec_port_start_toggling;
 
-- 
2.51.2

