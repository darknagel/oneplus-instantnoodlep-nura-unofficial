From 9ed2046be20039597997e415b597a4d8959c4f35 Mon Sep 17 00:00:00 2001
From: Timo <1788603+darknagel@users.noreply.github.com>
Date: Sun, 25 Oct 2026 17:43:50 +0100
Subject: [PATCH 04/15] arm64: dts: qcom: sm8250-oneplus-instantnoodlep: Enable
 GPU

Enable the Adreno 650 GPU and point the zap shader to the OnePlus
signed firmware.

Tested with Mesa freedreno: OpenGL ES 3.2, kmscube at 120 Hz.

Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
---
 arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
index ed9550880..0b599fbea 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
@@ -617,7 +617,11 @@ &gpi_dma2 {
 };
 
 &gpu {
-	status = "disabled";
+	status = "okay";
+};
+
+&gpu_zap_shader {
+	firmware-name = "qcom/sm8250/OnePlus/instantnoodlep/a650_zap.mbn";
 };
 
 &i2c1 {
-- 
2.43.0

