From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Timo <1788603+darknagel@users.noreply.github.com>
Date: Mon, 23 Nov 2026 22:31:32 +0100
Subject: [PATCH] wifi: ath11k: let only SA Query action frames wake the host
 in WoW

Without a filter the firmware wakes the host from WoW for every action
frame it receives, Block Ack and BSS transition included, a few
seconds into every suspend (WOW_REASON_ACTION_FRAME_RECV).

Send WMI_WOW_SET_ACTION_WAKE_UP_CMDID for station interfaces and let
only SA Query (category 8) wake the host, as the vendor driver does
for protected management frames.
---
 drivers/net/wireless/ath/ath11k/wmi.c | 32 +++++++++++++++++++++++++++
 drivers/net/wireless/ath/ath11k/wmi.h | 17 ++++++++++++++
 drivers/net/wireless/ath/ath11k/wow.c | 17 ++++++++++++++
 3 files changed, 66 insertions(+)

diff --git a/drivers/net/wireless/ath/ath11k/wmi.c b/drivers/net/wireless/ath/ath11k/wmi.c
index 7b6980f225..5ce59d422a 100644
--- a/drivers/net/wireless/ath/ath11k/wmi.c
+++ b/drivers/net/wireless/ath/ath11k/wmi.c
@@ -9429,6 +9429,38 @@ int ath11k_wmi_scan_prob_req_oui(struct ath11k *ar,
 	return ret;
 }
 
+int ath11k_wmi_wow_set_action_wake_up(struct ath11k *ar, u32 vdev_id,
+				       u32 operation, const u32 *category_map)
+{
+	struct wmi_wow_set_action_wake_up_cmd *cmd;
+	struct sk_buff *skb;
+	int ret, i;
+
+	skb = ath11k_wmi_alloc_skb(ar->wmi->wmi_ab, sizeof(*cmd));
+	if (!skb)
+		return -ENOMEM;
+
+	cmd = (struct wmi_wow_set_action_wake_up_cmd *)skb->data;
+	cmd->tlv_header = FIELD_PREP(WMI_TLV_TAG, WMI_TAG_WOW_SET_ACTION_WAKE_UP_CMD) |
+			  FIELD_PREP(WMI_TLV_LEN, sizeof(*cmd) - TLV_HDR_SIZE);
+	cmd->vdev_id = vdev_id;
+	cmd->operation = operation;
+	for (i = 0; i < WMI_WOW_ACTION_CATEGORY_WORDS; i++)
+		cmd->action_category_map[i] = category_map ? category_map[i] : 0;
+
+	ath11k_dbg(ar->ab, ATH11K_DBG_WMI,
+		   "tlv wow set action wake up vdev_id %d operation %d map0 0x%08x\n",
+		   vdev_id, operation, cmd->action_category_map[0]);
+
+	ret = ath11k_wmi_cmd_send(ar->wmi, skb, WMI_WOW_SET_ACTION_WAKE_UP_CMDID);
+	if (ret) {
+		ath11k_warn(ar->ab, "failed to send WMI_WOW_SET_ACTION_WAKE_UP_CMDID\n");
+		dev_kfree_skb(skb);
+	}
+
+	return ret;
+}
+
 int ath11k_wmi_wow_add_wakeup_event(struct ath11k *ar, u32 vdev_id,
 				    enum wmi_wow_wakeup_event event,
 				u32 enable)
diff --git a/drivers/net/wireless/ath/ath11k/wmi.h b/drivers/net/wireless/ath/ath11k/wmi.h
index 546546050f..efc5f6de31 100644
--- a/drivers/net/wireless/ath/ath11k/wmi.h
+++ b/drivers/net/wireless/ath/ath11k/wmi.h
@@ -6061,6 +6061,21 @@ enum wmi_tlv_pattern_type {
 #define WOW_MAX_REDUCE	(WOW_HDR_LEN - sizeof(struct ethhdr) - \
 	offsetof(struct ieee80211_hdr_3addr, addr1))
 
+#define WMI_WOW_ACTION_CATEGORY_WORDS	8
+
+enum wmi_wow_action_wakeup_operation {
+	WMI_WOW_ACTION_WAKEUP_OPERATION_RESET = 0,
+	WMI_WOW_ACTION_WAKEUP_OPERATION_SET = 1,
+};
+
+/* Which 802.11 action frame categories may wake the host in WoW */
+struct wmi_wow_set_action_wake_up_cmd {
+	u32 tlv_header;
+	u32 vdev_id;
+	u32 operation;
+	u32 action_category_map[WMI_WOW_ACTION_CATEGORY_WORDS];
+} __packed;
+
 struct wmi_wow_add_del_event_cmd {
 	u32 tlv_header;
 	u32 vdev_id;
@@ -6604,6 +6619,8 @@ int ath11k_wmi_wow_del_pattern(struct ath11k *ar, u32 vdev_id, u32 pattern_id);
 int ath11k_wmi_wow_add_pattern(struct ath11k *ar, u32 vdev_id, u32 pattern_id,
 			       const u8 *pattern, const u8 *mask,
 			       int pattern_len, int pattern_offset);
+int ath11k_wmi_wow_set_action_wake_up(struct ath11k *ar, u32 vdev_id,
+				       u32 operation, const u32 *category_map);
 int ath11k_wmi_wow_add_wakeup_event(struct ath11k *ar, u32 vdev_id,
 				    enum wmi_wow_wakeup_event event,
 				    u32 enable);
diff --git a/drivers/net/wireless/ath/ath11k/wow.c b/drivers/net/wireless/ath/ath11k/wow.c
index 1bbcd2914f..8bf3790923 100644
--- a/drivers/net/wireless/ath/ath11k/wow.c
+++ b/drivers/net/wireless/ath/ath11k/wow.c
@@ -451,6 +451,23 @@ static int ath11k_vif_wow_set_wakeups(struct ath11k_vif *arvif,
 		__set_bit(WOW_PATTERN_MATCH_EVENT, &wow_mask);
 	}
 
+	/*
+	 * Without a filter the firmware wakes the host for every action frame,
+	 * Block Ack or BSS transition included, a few seconds into every
+	 * suspend. Let only SA Query (category 8) wake it, as the vendor driver
+	 * does for protected management frames.
+	 */
+	if (arvif->vdev_type == WMI_VDEV_TYPE_STA) {
+		u32 map[WMI_WOW_ACTION_CATEGORY_WORDS] = { BIT(8) };
+
+		ret = ath11k_wmi_wow_set_action_wake_up(ar, arvif->vdev_id,
+							WMI_WOW_ACTION_WAKEUP_OPERATION_SET,
+							map);
+		if (ret)
+			ath11k_warn(ar->ab, "failed to set action frame wakeups on vdev %i: %d\n",
+				    arvif->vdev_id, ret);
+	}
+
 	for (i = 0; i < WOW_EVENT_MAX; i++) {
 		if (!test_bit(i, &wow_mask))
 			continue;
