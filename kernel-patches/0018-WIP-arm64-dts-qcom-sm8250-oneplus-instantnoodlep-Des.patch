From: Timo <1788603+darknagel@users.noreply.github.com>
Date: Tue, 27 Oct 2026 18:46:31 +0100
Subject: [PATCH 18/30] WIP: arm64: dts: qcom: sm8250-oneplus-instantnoodlep:
 Describe the SDX55 modem

Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
---
 .../boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts      | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
index 42b9d2313..f5bcbdc35 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
@@ -1082,6 +1082,15 @@ &pcie1_phy {
 
 &pcie2 {
 	status = "okay";
+
+	pcie@0 {
+		/* SDX55 modem, without flash: firmware is loaded by the host */
+		modem@0,0 {
+			compatible = "pci17cb,306";
+			reg = <0x10000 0x0 0x0 0x0 0x0>;
+			qcom,flashless;
+		};
+	};
 };
 
 &pcie2_phy {
