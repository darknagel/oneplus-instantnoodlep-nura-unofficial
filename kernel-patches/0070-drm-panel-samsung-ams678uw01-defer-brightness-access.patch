From 9838910fc4eeb5f7c44263f4f5fb80c33b4a6592 Mon Sep 17 00:00:00 2001
From: Roman Kuraev <naoru.desu@gmail.com>
Date: Tue, 10 Nov 2026 10:00:31 +0000
Subject: [PATCH] drm/panel: samsung-ams678uw01: defer brightness access until
 prepared

Backlight sysfs can be accessed as soon as the device is registered,
before the DSI host and panel are ready. Cache early brightness writes
and let drm_panel_enable apply them through the backlight core. Return
the cached brightness while unprepared instead of issuing a DCS read.

Restore the original DSI mode flags after both successful and failed
brightness transfers; a failed transfer must not leave LPM disabled.

Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
---
 .../gpu/drm/panel/panel-samsung-ams678uw01.c  | 23 +++++++++++--------
 1 file changed, 14 insertions(+), 9 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-samsung-ams678uw01.c b/drivers/gpu/drm/panel/panel-samsung-ams678uw01.c
index 6229e41a7..200774717 100644
--- a/drivers/gpu/drm/panel/panel-samsung-ams678uw01.c
+++ b/drivers/gpu/drm/panel/panel-samsung-ams678uw01.c
@@ -330,34 +330,39 @@ static const struct drm_panel_funcs ams678uw01_panel_funcs = {
 static int ams678uw01_bl_update_status(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct ams678uw01 *ctx = mipi_dsi_get_drvdata(dsi);
+	unsigned long mode_flags = dsi->mode_flags;
 	u16 brightness = backlight_get_brightness(bl);
 	int ret;
 
-	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	/* The backlight core applies the cached value when enabling the panel. */
+	if (!ctx->panel.prepared)
+		return 0;
 
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
-	if (ret < 0)
-		return ret;
-
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	dsi->mode_flags = mode_flags;
 
-	return 0;
+	return ret;
 }
 
 static int ams678uw01_bl_get_brightness(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct ams678uw01 *ctx = mipi_dsi_get_drvdata(dsi);
+	unsigned long mode_flags = dsi->mode_flags;
 	u16 brightness;
 	int ret;
 
-	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	if (!ctx->panel.prepared)
+		return bl->props.brightness;
 
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
+	dsi->mode_flags = mode_flags;
 	if (ret < 0)
 		return ret;
 
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
-
 	return brightness;
 }
 
