From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Timo <1788603+darknagel@users.noreply.github.com>
Date: Tue, 24 Nov 2026 18:03:03 +0100
Subject: [PATCH] wifi: ath11k: wake the system with the firmware's wake MSI

When a WoW event arrives, the firmware sends the MSI of the WAKE user.
Request that vector with IRQF_NO_SUSPEND, so that it stays enabled
over system sleep, and end the sleep from its handler, as the vendor
driver does.

Only with multiple MSI vectors: with a single one the vector is shared
with all other interrupts.
---
 drivers/net/wireless/ath/ath11k/pci.c | 34 +++++++++++++++++++++++++++
 drivers/net/wireless/ath/ath11k/pci.h |  1 +
 2 files changed, 35 insertions(+)

diff --git a/drivers/net/wireless/ath/ath11k/pci.c b/drivers/net/wireless/ath/ath11k/pci.c
index 1bc7bca199..f26c568ada 100644
--- a/drivers/net/wireless/ath/ath11k/pci.c
+++ b/drivers/net/wireless/ath/ath11k/pci.c
@@ -7,6 +7,7 @@
 #include <linux/module.h>
 #include <linux/msi.h>
 #include <linux/pci.h>
+#include <linux/suspend.h>
 #include <linux/of.h>
 #include <linux/time.h>
 #include <linux/vmalloc.h>
@@ -435,6 +436,37 @@ static void ath11k_pci_msi_disable(struct ath11k_pci *ab_pci)
 	ath11k_pci_msi_config(ab_pci, false);
 }
 
+/* The firmware sends this MSI when a WoW event should wake the host */
+static irqreturn_t ath11k_pci_wake_irq(int irq, void *data)
+{
+	pm_system_wakeup();
+
+	return IRQ_HANDLED;
+}
+
+static void ath11k_pci_config_wake_irq(struct ath11k_base *ab)
+{
+	struct ath11k_pci *ab_pci = ath11k_pci_priv(ab);
+	u32 user_base_data, base_vector;
+	int num_vectors, irq, ret;
+
+	/* with a single MSI the vector is shared with everything else */
+	if (!test_bit(ATH11K_FLAG_MULTI_MSI_VECTORS, &ab->dev_flags) ||
+	    ath11k_pcic_get_user_msi_assignment(ab, "WAKE", &num_vectors,
+						&user_base_data, &base_vector))
+		return;
+
+	irq = ath11k_pci_get_msi_irq(ab, base_vector);
+	ret = devm_request_irq(ab->dev, irq, ath11k_pci_wake_irq,
+			       IRQF_NO_SUSPEND, "ath11k_wake", ab);
+	if (ret) {
+		ath11k_warn(ab, "failed to request wake irq: %d\n", ret);
+		return;
+	}
+
+	ab_pci->wake_irq = irq;
+}
+
 static int ath11k_pci_alloc_msi(struct ath11k_pci *ab_pci)
 {
 	struct ath11k_base *ab = ab_pci->ab;
@@ -1126,6 +1158,8 @@ static int ath11k_pci_probe(struct pci_dev *pdev,
 		goto err_ce_free;
 	}
 
+	ath11k_pci_config_wake_irq(ab);
+
 	/* kernel may allocate a dummy vector before request_irq and
 	 * then allocate a real vector when request_irq is called.
 	 * So get msi_data here again to avoid spurious interrupt
diff --git a/drivers/net/wireless/ath/ath11k/pci.h b/drivers/net/wireless/ath/ath11k/pci.h
index 2579d54477..bf1ede4f28 100644
--- a/drivers/net/wireless/ath/ath11k/pci.h
+++ b/drivers/net/wireless/ath/ath11k/pci.h
@@ -75,6 +75,7 @@ struct ath11k_pci {
 	u16 link_ctl;
 	u64 dma_mask;
 	bool wow_no_d3cold;
+	int wake_irq;
 };
 
 static inline struct ath11k_pci *ath11k_pci_priv(struct ath11k_base *ab)
