From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Timo <1788603+darknagel@users.noreply.github.com>
Date: Sat, 14 Nov 2026 12:54:35 +0100
Subject: [PATCH 115/116] drm/panel: samsung-ams678uw01: power off when the PPS
 cannot be sent

If sending the DSC picture parameter set fails, prepare() returned the
error with the supplies still enabled and the panel out of reset. The
panel is then not marked prepared, so unprepare() never runs and the
regulators stay on. Take the same exit as a failed init sequence.

Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
---
 drivers/gpu/drm/panel/panel-samsung-ams678uw01.c | 13 ++++++++-----
 1 file changed, 8 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-samsung-ams678uw01.c b/drivers/gpu/drm/panel/panel-samsung-ams678uw01.c
index 200774717..e95d06486 100644
--- a/drivers/gpu/drm/panel/panel-samsung-ams678uw01.c
+++ b/drivers/gpu/drm/panel/panel-samsung-ams678uw01.c
@@ -281,20 +281,23 @@ static int ams678uw01_prepare(struct drm_panel *panel)
 	ret = ams678uw01_on(ctx);
 	if (ret < 0) {
 		dev_err(dev, "Failed to initialize panel: %d\n", ret);
-		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
-		regulator_bulk_disable(ARRAY_SIZE(ams678uw01_supplies), ctx->supplies);
-		return ret;
+		goto err_power_off;
 	}
 
 	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
 
 	ret = mipi_dsi_picture_parameter_set(ctx->dsi, &pps);
 	if (ret < 0) {
-		dev_err(panel->dev, "failed to transmit PPS: %d\n", ret);
-		return ret;
+		dev_err(dev, "failed to transmit PPS: %d\n", ret);
+		goto err_power_off;
 	}
 
 	return 0;
+
+err_power_off:
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(ams678uw01_supplies), ctx->supplies);
+	return ret;
 }
 
 static int ams678uw01_unprepare(struct drm_panel *panel)
