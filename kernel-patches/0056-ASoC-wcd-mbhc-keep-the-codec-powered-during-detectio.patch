From 7a1f18b7a7817b0c74d6a5bed1e5dfbee66f878f Mon Sep 17 00:00:00 2001
From: Roman Kuraev <naoru.desu@gmail.com>
Date: Mon, 9 Nov 2026 18:17:12 +0000
Subject: [PATCH] ASoC: wcd-mbhc: keep the codec powered during detection

Hold a runtime PM reference for the deferred headset detection worker.
Otherwise register reads and ADC polling can run after the codec
suspends. Balance the reference on every worker exit.
Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
---
 sound/soc/codecs/wcd-mbhc-v2.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/sound/soc/codecs/wcd-mbhc-v2.c b/sound/soc/codecs/wcd-mbhc-v2.c
index bb0c8478a..c4faa8087 100644
--- a/sound/soc/codecs/wcd-mbhc-v2.c
+++ b/sound/soc/codecs/wcd-mbhc-v2.c
@@ -516,6 +516,13 @@ static void mbhc_plug_detect_fn(struct work_struct *work)
 	struct snd_soc_component *component = mbhc->component;
 	enum snd_jack_types jack_type;
 	bool detection_type;
+	int ret;
+
+	ret = pm_runtime_get_sync(component->dev);
+	if (ret < 0 && ret != -EACCES) {
+		pm_runtime_put_noidle(component->dev);
+		return;
+	}
 
 	mutex_lock(&mbhc->lock);
 
@@ -579,6 +586,7 @@ static void mbhc_plug_detect_fn(struct work_struct *work)
 exit:
 	mbhc->in_swch_irq_handler = false;
 	mutex_unlock(&mbhc->lock);
+	pm_runtime_put_autosuspend(component->dev);
 }
 
 static irqreturn_t wcd_mbhc_mech_plug_detect_irq(int irq, void *data)
