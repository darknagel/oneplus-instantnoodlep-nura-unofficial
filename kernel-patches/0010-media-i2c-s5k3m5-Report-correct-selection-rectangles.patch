From 0d01d08e988f40bb76e47effba6e7913d11090b3 Mon Sep 17 00:00:00 2001
From: Timo <1788603+darknagel@users.noreply.github.com>
Date: Mon, 26 Oct 2026 18:56:44 +0100
Subject: [PATCH 10/12] media: i2c: s5k3m5: Report correct selection rectangles

The crop rectangle used the mode width as height, and the driver did not
implement V4L2_SEL_TGT_NATIVE_SIZE and V4L2_SEL_TGT_CROP_DEFAULT, which
libcamera needs to report the pixel array:

  ERROR V4L2 's5k3m5 20-002d': Unable to get rectangle 1 on pad 0/0
  WARN CameraSensor 's5k3m5 20-002d': The PixelArrayActiveAreas property
       has been defaulted to (0, 0)/4208x4208

Report the 4208x3120 pixel array for the native size, the crop bounds
and the default crop, and the analogue crop of the current mode for the
crop target: the 2104x1184 mode reads rows 384 to 2751 and bins them,
which is a 4208x2368 window starting at row 376 of the full mode.

Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
---
 drivers/media/i2c/s5k3m5.c | 24 ++++++++++++++++++++++--
 1 file changed, 22 insertions(+), 2 deletions(-)

diff --git a/drivers/media/i2c/s5k3m5.c b/drivers/media/i2c/s5k3m5.c
index c591b580d..ebe200e4b 100644
--- a/drivers/media/i2c/s5k3m5.c
+++ b/drivers/media/i2c/s5k3m5.c
@@ -44,6 +44,9 @@
 #define S5K3M5_VTS_MAX			0xffff
 
 #define S5K3M5_REG_HTS			CCI_REG16(0x0342)
+#define S5K3M5_NATIVE_WIDTH		4208
+#define S5K3M5_NATIVE_HEIGHT		3120
+
 #define S5K3M5_REG_X_ADDR_START		CCI_REG16(0x0344)
 #define S5K3M5_REG_Y_ADDR_START		CCI_REG16(0x0346)
 #define S5K3M5_REG_X_ADDR_END		CCI_REG16(0x0348)
@@ -76,6 +79,7 @@ struct s5k3m5_mode {
 	u32 hts;			/* Horizontal timing size */
 	u32 vts;			/* Default vertical timing size */
 	u32 exposure;			/* Default exposure value */
+	struct v4l2_rect crop;		/* Analogue crop rectangle */
 
 	const struct s5k3m5_reg_list reg_list;	/* Sensor register setting */
 };
@@ -697,6 +701,12 @@ static const struct s5k3m5_mode s5k3m5_supported_modes[] = {
 		.hts = 4848,
 		.vts = 3314,
 		.exposure = 256,
+		.crop = {
+			.left = 0,
+			.top = 0,
+			.width = 4208,
+			.height = 3120,
+		},
 		.reg_list = {
 			.regs = s5k3m5_4208x3120_30fps_mode,
 			.num_regs = ARRAY_SIZE(s5k3m5_4208x3120_30fps_mode),
@@ -708,6 +718,12 @@ static const struct s5k3m5_mode s5k3m5_supported_modes[] = {
 		.hts = 4928,
 		.vts = 1624,
 		.exposure = 256,
+		.crop = {
+			.left = 0,
+			.top = 376,
+			.width = 4208,
+			.height = 2368,
+		},
 		.reg_list = {
 			.regs = s5k3m5_2104x1184_60fps_mode,
 			.num_regs = ARRAY_SIZE(s5k3m5_2104x1184_60fps_mode),
@@ -1048,11 +1064,15 @@ static int s5k3m5_get_selection(struct v4l2_subdev *sd,
 
 	switch (sel->target) {
 	case V4L2_SEL_TGT_CROP:
+		sel->r = s5k3m5->mode->crop;
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
 	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
 		sel->r.left = 0;
 		sel->r.top = 0;
-		sel->r.width = s5k3m5->mode->width;
-		sel->r.height = s5k3m5->mode->width;
+		sel->r.width = S5K3M5_NATIVE_WIDTH;
+		sel->r.height = S5K3M5_NATIVE_HEIGHT;
 		return 0;
 	default:
 		return -EINVAL;
-- 
2.43.0

