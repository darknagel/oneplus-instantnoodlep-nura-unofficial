+/*
+ * These are the operations of writable mapped directories. Files can be
+ * created, written, renamed and removed below them, which the sensor registry
+ * needs to save its state.
+ */
+static int mapped_rw_openat(struct hexagonfs_fd *dir,
+			    const char *segment,
+			    bool expect_dir,
+			    struct hexagonfs_fd **out)
+{
+	int flags = O_RDONLY;
+
+	if (expect_dir)
+		flags |= O_DIRECTORY;
+
+	return mapped_openat_with_ops(dir, segment, flags,
+				      &hexagonfs_mapped_rw_ops, out);
+}
+
+static int mapped_rw_create(struct hexagonfs_fd *dir,
+			    const char *segment,
+			    int flags,
+			    struct hexagonfs_fd **out)
+{
+	return mapped_openat_with_ops(dir, segment, flags | O_NOFOLLOW,
+				      &hexagonfs_mapped_rw_ops, out);
+}
+
+static int mapped_rw_rename(struct hexagonfs_fd *old_dir, const char *old_segment,
+			    struct hexagonfs_fd *new_dir, const char *new_segment)
+{
+	struct mapped_ctx *old_ctx = old_dir->data;
+	struct mapped_ctx *new_ctx = new_dir->data;
+	int ret;
+
+	ret = renameat(old_ctx->fd, old_segment, new_ctx->fd, new_segment);
+	if (ret == -1)
+		return -errno;
+
+	return 0;
+}
+
+static int mapped_rw_unlink(struct hexagonfs_fd *dir, const char *segment)
+{
+	struct mapped_ctx *ctx = dir->data;
+	int ret;
+
+	ret = unlinkat(ctx->fd, segment, 0);
+	if (ret == -1)
+		return -errno;
+
+	return 0;
+}
+
+static ssize_t mapped_rw_write(struct hexagonfs_fd *fd, size_t size, const void *ptr)
+{
+	struct mapped_ctx *ctx = fd->data;
+	size_t done = 0;
+	ssize_t ret;
+
+	while (done < size) {
+		ret = write(ctx->fd, (const char *) ptr + done, size - done);
+		if (ret < 0) {
+			if (errno == EINTR)
+				continue;
+
+			return -errno;
+		}
+
+		done += ret;
+	}
+
+	return done;
+}
+
+static int mapped_rw_truncate(struct hexagonfs_fd *fd, off_t len)
+{
+	struct mapped_ctx *ctx = fd->data;
+	int ret;
+
+	ret = ftruncate(ctx->fd, len);
+	if (ret == -1)
+		return -errno;
+
+	return 0;
+}
+
+static int mapped_rw_sync(struct hexagonfs_fd *fd)
+{
+	struct mapped_ctx *ctx = fd->data;
+	int ret;
+
+	ret = fsync(ctx->fd);
+	if (ret == -1)
+		return -errno;
+
+	return 0;
+}
+
+static int mapped_rw_stat(struct hexagonfs_fd *fd, struct stat *stats)
+{
+	int ret;
+
+	ret = mapped_stat(fd, stats);
+	if (ret)
+		return ret;
+
+	stats->st_mode |= S_IWUSR;
+
+	return 0;
+}
+
 struct hexagonfs_file_ops hexagonfs_mapped_ops = {
 	.close = mapped_close,
 	.from_dirent = mapped_from_dirent,
@@ -342,6 +466,22 @@ struct hexagonfs_file_ops hexagonfs_mapped_or_empty_ops = {
 	.stat = mapped_or_empty_stat,
 };
 
