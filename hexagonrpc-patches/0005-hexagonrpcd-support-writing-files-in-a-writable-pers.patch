 				(const char *) inbufs[3].p);
-		return AEE_EUNSUPPORTED;
+		return AEE_EBADPARM;
 	}
 
 	if (!strcmp(inbufs[1].p, "ADSP_LIBRARY_PATH")) {
@@ -188,18 +236,20 @@ static uint32_t apps_std_fopen_with_env(void *data,
 		return AEE_EFAILED;
 	}
 
