 				(const char *) inbufs[3].p,
-				strerror(errno));
+				(const char *) inbufs[4].p,
+				strerror(-fd));
 		return AEE_EFAILED;
 	}
 
 #ifdef HEXAGONRPC_VERBOSE
-	printf("openat($%s, %s, %c) -> %d\n", (const char *) inbufs[1].p,
+	printf("openat($%s, %s, %s) -> %d\n", (const char *) inbufs[1].p,
 					      (const char *) inbufs[3].p,
-					      rw_mode,
+					      (const char *) inbufs[4].p,
 					      fd);
 #endif
 
@@ -208,6 +258,53 @@ static uint32_t apps_std_fopen_with_env(void *data,
 	return 0;
 }
 
+static uint32_t apps_std_fsync(void *data,
+			       const struct fastrpc_io_buffer *inbufs,
+			       struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const uint32_t *fd = inbufs[0].p;
+	int ret;
+
+	ret = hexagonfs_fsync(ctx->fds, *fd);
+	if (ret) {
+		fprintf(stderr, "Could not sync file: %s\n", strerror(-ret));
+		return AEE_EFAILED;
+	}
+
+#ifdef HEXAGONRPC_VERBOSE
+	printf("fsync(%u)\n", *fd);
+#endif
+
+	return 0;
+}
+
+static uint32_t apps_std_fremove(void *data,
+				 const struct fastrpc_io_buffer *inbufs,
+				 struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	int ret;
+
+	// The name must be NULL-terminated
+	if (((const char *) inbufs[1].p)[inbufs[1].s - 1] != 0)
+		return AEE_EBADPARM;
+
+	ret = hexagonfs_unlink(ctx->fds, ctx->rootfd, ctx->rootfd, inbufs[1].p);
+	if (ret) {
+		fprintf(stderr, "Could not remove %s: %s\n",
+				(const char *) inbufs[1].p,
+				strerror(-ret));
+		return AEE_EFAILED;
+	}
+
+#ifdef HEXAGONRPC_VERBOSE
+	printf("remove(%s)\n", (const char *) inbufs[1].p);
+#endif
+
+	return 0;
+}
+
 static uint32_t apps_std_opendir(void *data,
 				 const struct fastrpc_io_buffer *inbufs,
 				 struct fastrpc_io_buffer *outbufs)
@@ -351,6 +448,61 @@ static uint32_t apps_std_stat(void *data,
