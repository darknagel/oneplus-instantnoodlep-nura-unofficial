-	if (rw_mode == 'w' || rw_mode == 'a') {
-		fprintf(stderr, "Tried to open %s for writing\n",
+	flags = apps_std_mode_to_flags(inbufs[4].p);
+	if (flags < 0) {
+		fprintf(stderr, "Unknown mode %s to open %s\n",
