@@ -0,0 +1,260 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast detection autofocus
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/control_ids.h>
+
+namespace libcamera {
+
+namespace ipa::softisp::algorithms {
+
+/**
+ * \class Af
+ * \brief Contrast detection autofocus for the software ISP
+ *
+ * The lens is swept over its range in coarse steps while the sharpness
+ * measure of the statistics is recorded. A fine sweep around the sharpest
+ * coarse position then picks the final lens position. In continuous mode a
+ * new scan starts when the sharpness changes significantly for a few
+ * statistics frames in a row, for example because the scene changed.
+ *
+ * The sharpness is normalised by the brightness of the measured area, so
+ * exposure changes from the AGC do not look like focus changes.
+ *
+ * Statistics are only calculated for every fourth frame, and the lens needs
+ * time to settle after a move. The statistics frames that follow a move are
+ * therefore skipped, so that every measurement belongs to the lens position
+ * it is recorded for.
+ */
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+int Af::init(IPAContext &context, const ValueNode &tuningData)
+{
+	coarseStep_ = tuningData["coarseStep"].get<int32_t>(coarseStep_);
+	fineSteps_ = tuningData["fineSteps"].get<uint32_t>(fineSteps_);
+	warmup_ = tuningData["warmup"].get<uint32_t>(warmup_);
+	changeThreshold_ = tuningData["changeThreshold"].get<double>(changeThreshold_);
+	changeCount_ = tuningData["changeCount"].get<uint32_t>(changeCount_);
+	settleFrames_ = tuningData["settleFrames"].get<uint32_t>(settleFrames_);
+
+	context.ctrlMap[&controls::AfMode] =
+		ControlInfo(controls::AfModeValues,
+			    ControlValue(static_cast<int32_t>(controls::AfModeContinuous)));
+	context.ctrlMap[&controls::AfTrigger] =
+		ControlInfo(controls::AfTriggerValues);
+
+	return 0;
+}
+
+int Af::configure(IPAContext &context, const IPAConfigInfo &configInfo)
+{
+	auto &af = context.configuration.af;
+	auto it = configInfo.lensControls.find(V4L2_CID_FOCUS_ABSOLUTE);
+
+	af.enabled = it != configInfo.lensControls.end();
+	if (!af.enabled) {
+		LOG(IPASoftAf, Debug) << "No focus lens, autofocus disabled";
+		return 0;
+	}
+
+	af.min = it->second.min().get<int32_t>();
+	af.max = it->second.max().get<int32_t>();
+
+	context.activeState.af.position = af.min;
+	context.activeState.af.update = false;
+
+	state_ = State::Idle;
+	afState_ = controls::AfStateIdle;
+	position_ = af.min;
+	settle_ = 0;
+	refSharpness_ = 0.0;
+	refPending_ = false;
+	validFrames_ = 0;
+	changed_ = 0;
+	triggered_ = false;
+
+	LOG(IPASoftAf, Info) << "Lens range " << af.min << "-" << af.max;
+
+	return 0;
+}
+
+void Af::queueRequest([[maybe_unused]] IPAContext &context,
+		      [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      const ControlList &controls)
+{
+	const auto &mode = controls.get(controls::AfMode);
+	if (mode.has_value() && *mode != mode_) {
+		mode_ = static_cast<controls::AfModeEnum>(*mode);
+		state_ = State::Idle;
+		afState_ = controls::AfStateIdle;
+		refSharpness_ = 0.0;
+		LOG(IPASoftAf, Debug) << "Mode " << mode_;
+	}
+
+	const auto &trigger = controls.get(controls::AfTrigger);
+	if (trigger.has_value()) {
+		if (*trigger == controls::AfTriggerStart)
+			triggered_ = true;
+		else if (*trigger == controls::AfTriggerCancel) {
+			triggered_ = false;
+			state_ = State::Idle;
+			afState_ = controls::AfStateIdle;
+		}
+	}
+}
+
+void Af::moveTo(IPAContext &context, int32_t position)
+{
+	const auto &af = context.configuration.af;
+
+	position_ = std::clamp(position, af.min, af.max);
+	context.activeState.af.position = position_;
+	context.activeState.af.update = true;
+	settle_ = settleFrames_;
+}
+
+void Af::startScan(IPAContext &context)
+{
+	const auto &af = context.configuration.af;
+
+	state_ = State::Coarse;
+	afState_ = controls::AfStateScanning;
+	step_ = coarseStep_;
+	scanEnd_ = af.max;
+	bestSharpness_ = 0.0;
+	bestPosition_ = af.min;
+	belowBest_ = 0;
+	changed_ = 0;
+
+	moveTo(context, af.min);
+	/* The first move can cross the whole range, give it more time. */
+	settle_ = settleFrames_ * 2;
+}
+
+void Af::record(int32_t position, double sharpness)
+{
+	if (sharpness > bestSharpness_) {
+		bestSharpness_ = sharpness;
+		bestPosition_ = position;
+		belowBest_ = 0;
+	} else if (sharpness < bestSharpness_ * 0.7) {
+		belowBest_++;
+	}
+}
+
+void Af::process(IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 ControlList &metadata)
+{
+	if (!context.configuration.af.enabled)
+		return;
+
+	metadata.set(controls::AfState, afState_);
+
+	if (!stats->valid || !stats->sharpnessBase)
+		return;
+
+	if (settle_) {
+		settle_--;
+		return;
+	}
+
+	double sharpness = static_cast<double>(stats->sharpness) /
+			   static_cast<double>(stats->sharpnessBase);
+
+	switch (state_) {
+	case State::Idle:
+		if (refPending_) {
+			refSharpness_ = sharpness;
+			refPending_ = false;
+			return;
+		}
+
+		if (mode_ == controls::AfModeAuto) {
+			if (triggered_) {
+				triggered_ = false;
+				startScan(context);
+			}
+			return;
+		}
+
+		if (mode_ != controls::AfModeContinuous)
+			return;
+
+		if (refSharpness_ == 0.0) {
+			if (++validFrames_ >= warmup_)
+				startScan(context);
+			return;
+		}
+
+		if (std::abs(sharpness / refSharpness_ - 1.0) > changeThreshold_) {
+			if (++changed_ >= changeCount_) {
+				LOG(IPASoftAf, Debug)
+					<< "Sharpness changed " << refSharpness_
+					<< " -> " << sharpness << ", rescanning";
+				startScan(context);
+			}
+		} else {
+			changed_ = 0;
+			refSharpness_ = 0.9 * refSharpness_ + 0.1 * sharpness;
+		}
+		return;
+
+	case State::Coarse:
+		record(position_, sharpness);
+		LOG(IPASoftAf, Debug)
+			<< "Coarse " << position_ << ": " << sharpness;
+
+		/* Stop early once well past a clear peak. */
+		if (position_ + step_ <= scanEnd_ && belowBest_ < 3) {
+			moveTo(context, position_ + step_);
+			return;
+		}
+
+		state_ = State::Fine;
+		step_ = std::max<int32_t>(coarseStep_ * 2 / fineSteps_, 1);
+		scanEnd_ = std::min(bestPosition_ + coarseStep_,
+				    context.configuration.af.max);
+		moveTo(context, bestPosition_ - coarseStep_);
+		return;
+
+	case State::Fine:
+		record(position_, sharpness);
+		LOG(IPASoftAf, Debug)
+			<< "Fine " << position_ << ": " << sharpness;
+
+		if (position_ + step_ <= scanEnd_) {
+			moveTo(context, position_ + step_);
+			return;
+		}
+
+		LOG(IPASoftAf, Debug)
+			<< "Focused at " << bestPosition_ << " (" << bestSharpness_ << ")";
+		moveTo(context, bestPosition_);
+		state_ = State::Idle;
+		afState_ = controls::AfStateFocused;
+		refPending_ = true;
+		validFrames_ = 0;
+		return;
+	}
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::softisp::algorithms */
+
+} /* namespace libcamera */
