+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast detection autofocus
+ */
+
+#pragma once
+
+#include <libcamera/control_ids.h>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::softisp::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class State {
+		Idle,
+		Coarse,
+		Fine,
+	};
+
+	void startScan(IPAContext &context);
+	void moveTo(IPAContext &context, int32_t position);
+	void record(int32_t position, double sharpness);
+
+	int32_t coarseStep_ = 256;
+	unsigned int fineSteps_ = 8;
+	unsigned int warmup_ = 16;
+	double changeThreshold_ = 0.3;
+	unsigned int changeCount_ = 3;
+	unsigned int settleFrames_ = 1;
+
+	controls::AfModeEnum mode_ = controls::AfModeContinuous;
+	controls::AfStateEnum afState_ = controls::AfStateIdle;
+	State state_ = State::Idle;
+	bool triggered_ = false;
+
+	int32_t position_ = 0;
+	int32_t scanEnd_ = 0;
+	int32_t step_ = 0;
+	int32_t bestPosition_ = 0;
+	double bestSharpness_ = 0.0;
+	unsigned int belowBest_ = 0;
+
+	double refSharpness_ = 0.0;
+	bool refPending_ = false;
+	unsigned int validFrames_ = 0;
+	unsigned int changed_ = 0;
+	unsigned int settle_ = 0;
+};
+
+} /* namespace ipa::softisp::algorithms */
+
+} /* namespace libcamera */
