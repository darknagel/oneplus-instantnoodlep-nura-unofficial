diff --git a/src/ipa/softisp/algorithms/awb.cpp b/src/ipa/softisp/algorithms/awb.cpp
index fb9bcb0..f276344 100644
--- a/src/ipa/softisp/algorithms/awb.cpp
+++ b/src/ipa/softisp/algorithms/awb.cpp
@@ -7,6 +7,7 @@
 
 #include "awb.h"
 
+#include <algorithm>
 #include <stdint.h>
 
 #include <libcamera/base/log.h>
@@ -24,6 +25,13 @@ namespace ipa::softisp::algorithms {
  */
 static constexpr unsigned int kDefaultLux = 500;
 
+/*
+ * Use the nearly grey pixels from this fraction of all pixels on, and only
+ * them from kGreyFullFraction on.
+ */
+static constexpr double kGreyMinFraction = 0.02;
+static constexpr double kGreyFullFraction = 0.10;
+
 class SoftIspAwbStats final : public AwbStats
 {
 public:
@@ -75,6 +83,13 @@ private:
  */
 int Awb::init(IPAContext &context, const ValueNode &tuningData)
 {
+	/*
+	 * How much the nearly grey pixels may count at most, from 0.0 (plain
+	 * grey world) to 1.0. A camera that mostly sees mixed light, like a
+	 * front camera facing displays, can lower it.
+	 */
+	greyWeight_ = std::clamp(tuningData["greyWeight"].get<double>(1.0), 0.0, 1.0);
+
 	return awbAlgo_.init(tuningData, context.ctrlMap);
 }
 
@@ -147,6 +162,29 @@ SoftIspAwbStats Awb::calculateRgbMeans(IPAContext &context,
 				   static_cast<double>(sum.g()) / nPixels,
 				   static_cast<double>(sum.b()) / nPixels } };
 
+	/*
+	 * Prefer the pixels that look nearly grey with the current gains:
+	 * large coloured areas then no longer tint the whole picture. With
+	 * few such pixels, for example while the gains are still far off,
+	 * blend in the plain grey world, so the gains keep moving.
+	 */
+	const uint64_t nGrey = stats->greyPixels_;
+	const double greyFraction = static_cast<double>(nGrey) / nPixels;
+	if (greyFraction >= kGreyMinFraction) {
+		const uint64_t greyOffset = blackLevel * nGrey;
+		const RGB<uint64_t> greySum =
+			stats->greySum_.max(greyOffset + minValid) - greyOffset;
+		const RGB<double> greyMeans = { { static_cast<double>(greySum.r()) / nGrey,
+						  static_cast<double>(greySum.g()) / nGrey,
+						  static_cast<double>(greySum.b()) / nGrey } };
+		const double weight = greyWeight_ *
+				      std::min(1.0, greyFraction / kGreyFullFraction);
+
+		/* Compare ratios: the grey pixels are darker or brighter overall */
+		const double scale = rgbMeans.g() / greyMeans.g();
+		rgbMeans = greyMeans * (scale * weight) + rgbMeans * (1.0 - weight);
+	}
+
 	return SoftIspAwbStats(rgbMeans);
 }
 
