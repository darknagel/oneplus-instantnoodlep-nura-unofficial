diff --git a/src/libcamera/software_isp/swstats_cpu.cpp b/src/libcamera/software_isp/swstats_cpu.cpp
index 1095179..9aaadc1 100644
--- a/src/libcamera/software_isp/swstats_cpu.cpp
+++ b/src/libcamera/software_isp/swstats_cpu.cpp
@@ -11,6 +11,7 @@
 
 #include "libcamera/internal/software_isp/swstats_cpu.h"
 
+#include <algorithm>
 #include <stdlib.h>
 
 #include <libcamera/base/log.h>
@@ -187,10 +188,39 @@ SwStatsCpu::SwStatsCpu(const CameraManager &cm, bool quadBayer)
  */
 static constexpr unsigned int kSaturationThreshold = 0.95 * 256;
 
+/*
+ * A pixel counts as nearly grey for the white balance when its red and blue
+ * values, with the current white balance gains applied, are within this
+ * fraction (1.0 = 256) of its green value.
+ */
+static constexpr int kGreyTolerance = 64; /* 0.25 * 256 */
+
 static constexpr unsigned int kRedYMul = 77; /* 0.299 * 256 */
 static constexpr unsigned int kGreenYMul = 150; /* 0.587 * 256 */
 static constexpr unsigned int kBlueYMul = 29; /* 0.114 * 256 */
 
+/* Skip pixels too dark for a reliable colour, in 8-bit units */
+static constexpr int kGreyMinGreen = 8;
+
+#define SWSTATS_ACCUMULATE_GREY(div)                                        \
+	{                                                                   \
+		const int black = greyBlack_ * (div);                       \
+		const int gg = static_cast<int>(g) - black;                 \
+		if (gg > kGreyMinGreen * (div)) {                           \
+			const int rr = ((static_cast<int>(r) - black) *     \
+					static_cast<int>(greyGainR_)) >> 8; \
+			const int bb = ((static_cast<int>(b) - black) *     \
+					static_cast<int>(greyGainB_)) >> 8; \
+			const int tol = (gg * kGreyTolerance) >> 8;         \
+			if (abs(rr - gg) < tol && abs(bb - gg) < tol) {     \
+				greyR += r;                                 \
+				greyG += g;                                 \
+				greyB += b;                                 \
+				nGrey++;                                    \
+			}                                                   \
+		}                                                           \
+	}
+
 #define SWSTATS_START_LINE_STATS(pixel_t) \
 	pixel_t r, g, g2, b;              \
 	uint64_t yVal;                    \
@@ -198,7 +228,11 @@ static constexpr unsigned int kBlueYMul = 29; /* 0.114 * 256 */
 	uint64_t sumR = 0;                \
 	uint64_t sumG = 0;                \
 	uint64_t sumB = 0;                \
-	uint64_t nSamples = 0;
+	uint64_t nSamples = 0;            \
+	uint64_t greyR = 0;               \
+	uint64_t greyG = 0;               \
+	uint64_t greyB = 0;               \
+	uint64_t nGrey = 0;
 
 #define SWSTATS_ACCUMULATE_LINE_STATS(div)      \
 	if (r < kSaturationThreshold * (div) && \
@@ -208,6 +242,7 @@ static constexpr unsigned int kBlueYMul = 29; /* 0.114 * 256 */
 		sumG += g;                      \
 		sumB += b;                      \
 		nSamples++;                     \
+		SWSTATS_ACCUMULATE_GREY(div)    \
 	}                                       \
                                                 \
 	yVal = r * kRedYMul;                    \
@@ -215,11 +250,15 @@ static constexpr unsigned int kBlueYMul = 29; /* 0.114 * 256 */
 	yVal += b * kBlueYMul;                  \
 	stats.yHistogram[yVal * SwIspStats::kYHistogramSize / (256 * 256 * (div))]++;
 
-#define SWSTATS_FINISH_LINE_STATS() \
-	stats.sum_.r() += sumR;     \
-	stats.sum_.g() += sumG;     \
-	stats.sum_.b() += sumB;     \
-	stats.numPixels_ += nSamples;
+#define SWSTATS_FINISH_LINE_STATS()  \
+	stats.sum_.r() += sumR;      \
+	stats.sum_.g() += sumG;      \
+	stats.sum_.b() += sumB;      \
+	stats.numPixels_ += nSamples; \
+	stats.greySum_.r() += greyR; \
+	stats.greySum_.g() += greyG; \
+	stats.greySum_.b() += greyB; \
+	stats.greyPixels_ += nGrey;
 
 void SwStatsCpu::statsBGGR8Line0(const uint8_t *src[], SwIspStats &stats)
 {
@@ -472,6 +511,23 @@ void SwStatsCpu::statsGBRG12PLine0(const uint8_t *src[], SwIspStats &stats)
 	SWSTATS_FINISH_LINE_STATS()
 }
 
+/**
+ * \brief Set the white balance the grey pixel test is made with
+ * \param[in] gains The white balance gains of the frame
+ * \param[in] blackLevel The black level of the frame, 1.0 = full scale
+ *
+ * The statistics collect the pixels that look nearly grey with these gains
+ * separately, see SwIspStats::greySum_.
+ */
+void SwStatsCpu::setGreyReference(const RGB<double> &gains, double blackLevel)
+{
+	const double g = gains.g() > 0.0 ? gains.g() : 1.0;
+
+	greyGainR_ = static_cast<unsigned int>(std::clamp(gains.r() / g, 0.0, 16.0) * 256);
+	greyGainB_ = static_cast<unsigned int>(std::clamp(gains.b() / g, 0.0, 16.0) * 256);
+	greyBlack_ = static_cast<unsigned int>(std::clamp(blackLevel, 0.0, 1.0) * 255);
+}
+
 /**
  * \brief Reset state to start statistics gathering for a new frame
  * \param[in] frame The frame number
@@ -489,6 +545,8 @@ void SwStatsCpu::startFrame(uint32_t frame)
 	for (auto &s : stats_) {
 		s.sum_ = RGB<uint64_t>({ 0, 0, 0 });
 		s.numPixels_ = 0;
+		s.greySum_ = RGB<uint64_t>({ 0, 0, 0 });
+		s.greyPixels_ = 0;
 		s.yHistogram.fill(0);
 		s.sharpness = 0;
 		s.sharpnessBase = 0;
@@ -509,12 +567,16 @@ void SwStatsCpu::finishFrame(uint32_t frame, uint32_t bufferId)
 	if (valid) {
 		sharedStats_->sum_ = RGB<uint64_t>({ 0, 0, 0 });
 		sharedStats_->numPixels_ = 0;
+		sharedStats_->greySum_ = RGB<uint64_t>({ 0, 0, 0 });
+		sharedStats_->greyPixels_ = 0;
 		sharedStats_->yHistogram.fill(0);
 		sharedStats_->sharpness = 0;
 		sharedStats_->sharpnessBase = 0;
 		for (const auto &s : stats_) {
 			sharedStats_->sum_ += s.sum_;
 			sharedStats_->numPixels_ += s.numPixels_;
+			sharedStats_->greySum_ += s.greySum_;
+			sharedStats_->greyPixels_ += s.greyPixels_;
 			sharedStats_->sharpness += s.sharpness;
 			sharedStats_->sharpnessBase += s.sharpnessBase;
 			for (unsigned int j = 0; j < SwIspStats::kYHistogramSize; j++)
@@ -522,6 +584,7 @@ void SwStatsCpu::finishFrame(uint32_t frame, uint32_t bufferId)
 		}
 
 		sharedStats_->sum_ >>= sumShift_;
+		sharedStats_->greySum_ >>= sumShift_;
 	}
 
 	sharedStats_->valid = valid;
