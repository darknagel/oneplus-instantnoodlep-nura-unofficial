index 247b4fa..fe8f062 100644
--- a/include/libcamera/internal/software_isp/swisp_stats.h
+++ b/include/libcamera/internal/software_isp/swisp_stats.h
@@ -44,6 +44,19 @@ struct SwIspStats {
 	 * \brief Number of unsaturated pixels accumulated in \a sum_
 	 */
 	uint64_t numPixels_;
+	/**
+	 * \brief Sums of colour channels of the unsaturated pixels that look
+	 * nearly grey with the white balance gains of the frame
+	 *
+	 * Large coloured areas pull a plain grey world white balance towards
+	 * their complementary colour. Pixels that are nearly neutral already
+	 * are a better reference for the illuminant.
+	 */
+	RGB<uint64_t> greySum_;
+	/**
+	 * \brief Number of pixels accumulated in \a greySum_
+	 */
+	uint64_t greyPixels_;
 	/**
 	 * \brief Number of bins in the yHistogram
 	 */
diff --git a/include/libcamera/internal/software_isp/swstats_cpu.h b/include/libcamera/internal/software_isp/swstats_cpu.h
index 8327695..82d876a 100644
--- a/include/libcamera/internal/software_isp/swstats_cpu.h
+++ b/include/libcamera/internal/software_isp/swstats_cpu.h
@@ -54,6 +54,7 @@ public:
 
 	int configure(const StreamConfiguration &inputCfg, unsigned int statsBufferCount = 1);
 	void setWindow(const Rectangle &window);
+	void setGreyReference(const RGB<double> &gains, double blackLevel);
 	void startFrame(uint32_t frame);
 	void finishFrame(uint32_t frame, uint32_t bufferId);
 	void processFrame(uint32_t frame, uint32_t bufferId, MappedFrameBuffer &input);
@@ -146,6 +147,11 @@ private:
 	unsigned int stride_;
 	unsigned int sumShift_;
 	bool quadBayer_;
+
+	/* White balance gains (1.0 = 256) and black level for the grey test */
+	unsigned int greyGainR_ = 256;
+	unsigned int greyGainB_ = 256;
+	unsigned int greyBlack_ = 0;
 	BayerFormat::Order quadBayerOrder_ = BayerFormat::RGGB;
 
