 	};
 
 	void reset();
-	void startScan(IPAContext &context, double sharpness);
+	void startScan(IPAContext &context, double sharpness, const SwIspStats *stats);
+	bool phaseUsable(const SwIspStats *stats) const;
+	bool phaseFresh(const SwIspStats *stats) const;
+	void phaseStep(IPAContext &context, double phase);
+	void startFine(IPAContext &context, double phase);
+	void fineStep(IPAContext &context);
+	void finishFine(IPAContext &context);
 	void moveTo(IPAContext &context, int32_t position);
 	void record(int32_t position, double sharpness);
 	bool hasPeak() const;
@@ -61,6 +69,18 @@ private:
 	unsigned int stopCount_ = 2;
 	double minPeak_ = 1.5;
 
+	/* Phase detection, off while pdGain is 0 */
+	double pdGain_ = 0.0;
+	double pdMinConfidence_ = 0.6;
+	double pdMinSharpness_ = 0.0;
+	double pdTolerance_ = 0.25;
+	unsigned int pdMaxSteps_ = 3;
+	unsigned int pdFrames_ = 3;
+	double pdRescan_ = 1.0;
+	bool pdFine_ = true;
+	int32_t fineStep_ = 96;
+	unsigned int fineMax_ = 8;
+
 	controls::AfModeEnum mode_ = controls::AfModeContinuous;
 	controls::AfStateEnum afState_ = controls::AfStateIdle;
 	State state_ = State::Idle;
@@ -86,6 +106,18 @@ private:
 	unsigned int validFrames_ = 0;
 	unsigned int changed_ = 0;
 	unsigned int settle_ = 0;
+
+	uint32_t pdSeen_ = 0;
+	uint32_t pdMoved_ = 0;
+	unsigned int pdSteps_ = 0;
+	bool havePrevPhase_ = false;
+	int32_t prevPhasePosition_ = 0;
+	double prevPhase_ = 0.0;
+	unsigned int pdChanged_ = 0;
+	unsigned int fineCount_ = 0;
+	unsigned int fineRun_ = 0;
+	int32_t fineLast_ = 0;
+	int fineDirection_ = 1;
 };
 
 } /* namespace ipa::softisp::algorithms */
