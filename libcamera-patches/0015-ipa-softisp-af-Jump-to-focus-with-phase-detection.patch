index 2da6e7c..64ba706 100755
--- a/src/ipa/softisp/algorithms/af.h
+++ b/src/ipa/softisp/algorithms/af.h
@@ -36,10 +36,18 @@ private:
 		Idle,
 		Climb,
 		Refine,
+		Phase,
