From 053e3b8ad3c06441230cb1e9a20e20e5bd0509d7 Mon Sep 17 00:00:00 2001
From: Timo <1788603+darknagel@users.noreply.github.com>
Date: Sat, 14 Nov 2026 21:18:56 +0100
Subject: [PATCH 13/15] software_isp: Pass a phase detection result to the IPA
 with the statistics

Sensors with phase detection pixels tell how far and in which direction
the lens is out of focus. Add the shift between the left and right pixels,
its confidence and the sequence number of the frame it was measured on to
SwIspStats, set from the pipeline handler through SoftwareIsp::setPhase().
---
 .../internal/software_isp/software_isp.h      |  2 ++
 .../internal/software_isp/swisp_stats.h       | 21 ++++++++++++
 .../internal/software_isp/swstats_cpu.h       |  9 +++++
 src/libcamera/software_isp/debayer.cpp        |  8 +++++
 src/libcamera/software_isp/debayer.h          |  4 +++
 src/libcamera/software_isp/debayer_cpu.h      |  4 +++
 src/libcamera/software_isp/debayer_egl.h      |  4 +++
 src/libcamera/software_isp/software_isp.cpp   | 13 ++++++++
 src/libcamera/software_isp/swstats_cpu.cpp    | 33 +++++++++++++++++++
 9 files changed, 98 insertions(+)

diff --git a/include/libcamera/internal/software_isp/software_isp.h b/include/libcamera/internal/software_isp/software_isp.h
index 10e5aa5..7018f16 100644
--- a/include/libcamera/internal/software_isp/software_isp.h
+++ b/include/libcamera/internal/software_isp/software_isp.h
@@ -85,6 +85,8 @@ public:
 
 	Signal<FrameBuffer *> inputBufferReady;
 	Signal<FrameBuffer *> outputBufferReady;
+	void setPhase(float phase, float confidence, uint32_t sequence);
+
 	Signal<uint32_t, uint32_t> ispStatsReady;
 	Signal<uint32_t, const ControlList &> metadataReady;
 	Signal<const ControlList &, const ControlList &> setSensorControls;
diff --git a/include/libcamera/internal/software_isp/swisp_stats.h b/include/libcamera/internal/software_isp/swisp_stats.h
index fe8f062..00d8d97 100644
--- a/include/libcamera/internal/software_isp/swisp_stats.h
+++ b/include/libcamera/internal/software_isp/swisp_stats.h
@@ -84,6 +84,27 @@ struct SwIspStats {
 	 * the image brightness.
 	 */
 	uint64_t sharpnessBase;
+	/**
+	 * \brief True if \a pdPhase holds a phase detection result
+	 */
+	bool pdValid;
+	/**
+	 * \brief Shift between the left and right phase detection pixels in
+	 * the centre of the image, in pixels of the phase detection data
+	 *
+	 * Zero when the centre of the image is in focus. The sign tells the
+	 * direction the lens has to move in, the size roughly how far.
+	 */
+	float pdPhase;
+	/**
+	 * \brief Normalised correlation of the left and right pixels at
+	 * \a pdPhase, from 0 (no match) to 1
+	 */
+	float pdConfidence;
+	/**
+	 * \brief Sequence number of the frame \a pdPhase was measured on
+	 */
+	uint32_t pdSequence;
 };
 
 } /* namespace libcamera */
diff --git a/include/libcamera/internal/software_isp/swstats_cpu.h b/include/libcamera/internal/software_isp/swstats_cpu.h
index 82d876a..03a1d3f 100644
--- a/include/libcamera/internal/software_isp/swstats_cpu.h
+++ b/include/libcamera/internal/software_isp/swstats_cpu.h
@@ -11,6 +11,7 @@
 
 #pragma once
 
+#include <mutex>
 #include <stdint.h>
 #include <vector>
 
@@ -55,6 +56,7 @@ public:
 	int configure(const StreamConfiguration &inputCfg, unsigned int statsBufferCount = 1);
 	void setWindow(const Rectangle &window);
 	void setGreyReference(const RGB<double> &gains, double blackLevel);
+	void setPhase(float phase, float confidence, uint32_t sequence);
 	void startFrame(uint32_t frame);
 	void finishFrame(uint32_t frame, uint32_t bufferId);
 	void processFrame(uint32_t frame, uint32_t bufferId, MappedFrameBuffer &input);
@@ -156,6 +158,13 @@ private:
 
 	std::vector<SwIspStats> stats_;
 	SharedMemObject<SwIspStats> sharedStats_;
+
+	/* Latest phase detection result, set from another thread */
+	std::mutex pdMutex_;
+	bool pdValid_ = false;
+	float pdPhase_ = 0.0f;
+	float pdConfidence_ = 0.0f;
+	uint32_t pdSequence_ = 0;
 	Benchmark bench_;
 };
 
