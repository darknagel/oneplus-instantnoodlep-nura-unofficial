diff --git a/src/libcamera/software_isp/software_isp.cpp b/src/libcamera/software_isp/software_isp.cpp
index 8ba8cad..119dc3e 100644
--- a/src/libcamera/software_isp/software_isp.cpp
+++ b/src/libcamera/software_isp/software_isp.cpp
@@ -451,6 +451,19 @@ void SoftwareIsp::process(uint32_t frame, FrameBuffer *input, FrameBuffer *outpu
 			       ConnectionTypeQueued, frame, input, output, debayerParams_);
 }
 
+/**
+ * \brief Pass a phase detection result to the IPA with the statistics
+ * \param[in] phase The shift between the left and right phase detection
+ * pixels in the centre of the image
+ * \param[in] confidence The normalised correlation at that shift
+ * \param[in] sequence The sequence number of the frame it was measured on
+ */
+void SoftwareIsp::setPhase(float phase, float confidence, uint32_t sequence)
+{
+	if (debayer_)
+		debayer_->setPhase(phase, confidence, sequence);
+}
+
 void SoftwareIsp::saveIspParams([[maybe_unused]] uint32_t frame)
 {
 	debayerParams_ = *sharedParams_;
diff --git a/src/libcamera/software_isp/swstats_cpu.cpp b/src/libcamera/software_isp/swstats_cpu.cpp
index 9aaadc1..b3aeec7 100644
--- a/src/libcamera/software_isp/swstats_cpu.cpp
+++ b/src/libcamera/software_isp/swstats_cpu.cpp
@@ -528,6 +528,25 @@ void SwStatsCpu::setGreyReference(const RGB<double> &gains, double blackLevel)
 	greyBlack_ = static_cast<unsigned int>(std::clamp(blackLevel, 0.0, 1.0) * 255);
 }
 
+/**
+ * \brief Set the latest phase detection result
+ * \param[in] phase The shift between the left and right pixels
+ * \param[in] confidence The normalised correlation at that shift
+ * \param[in] sequence The sequence number of the frame it was measured on
+ *
+ * The result is passed on with the statistics of the following frames, see
+ * SwIspStats::pdPhase. It may be called from any thread.
+ */
+void SwStatsCpu::setPhase(float phase, float confidence, uint32_t sequence)
+{
+	std::lock_guard<std::mutex> lock(pdMutex_);
+
+	pdValid_ = true;
+	pdPhase_ = phase;
+	pdConfidence_ = confidence;
+	pdSequence_ = sequence;
+}
+
 /**
  * \brief Reset state to start statistics gathering for a new frame
  * \param[in] frame The frame number
@@ -587,6 +606,15 @@ void SwStatsCpu::finishFrame(uint32_t frame, uint32_t bufferId)
 		sharedStats_->greySum_ >>= sumShift_;
 	}
 
+	{
+		std::lock_guard<std::mutex> lock(pdMutex_);
+
+		sharedStats_->pdValid = pdValid_;
+		sharedStats_->pdPhase = pdPhase_;
+		sharedStats_->pdConfidence = pdConfidence_;
+		sharedStats_->pdSequence = pdSequence_;
+	}
+
 	sharedStats_->valid = valid;
 	statsReady.emit(frame, bufferId);
 }
@@ -636,6 +664,11 @@ int SwStatsCpu::setupStandardBayerOrder(BayerFormat::Order order)
  */
 int SwStatsCpu::configure(const StreamConfiguration &inputCfg, unsigned int statsBufferCount)
 {
+	{
+		std::lock_guard<std::mutex> lock(pdMutex_);
+		pdValid_ = false;
+	}
+
 	stride_ = inputCfg.stride;
 	stats_.resize(statsBufferCount);
 
