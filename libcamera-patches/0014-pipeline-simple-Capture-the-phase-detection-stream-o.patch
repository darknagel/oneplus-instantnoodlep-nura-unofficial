+/*
+ * Sensors that send phase detection data as a second CSI-2 stream in the mode
+ * of the given size. The CSID passes that stream to the RDI after the one of
+ * the image (qcom_camss module parameters rdi_vc and rdi_dt). The data is an
+ * image of half the resolution. Its even lines hold the right and left phase
+ * detection pixels in alternating columns; the odd lines hold another pixel
+ * pair, which does not give a horizontal phase and is not used.
+ */
+struct PdafSensorInfo {
+	const char *model;
+	Size sensorSize;
+	Size pdSize;
+};
+
+const PdafSensorInfo pdafSensors[] = {
+	{ "imx689", { 4000, 3000 }, { 2000, 1500 } },
+};
+
+/* Largest shift between the left and right pixels that is searched for */
+constexpr int kPdMaxShift = 12;
+
+/*
+ * Measure the shift between the two phase detection pixels of the even
+ * lines (even and odd columns) in the centre half of the width of a frame in
+ * packed 10-bit format, over its whole height like the sharpness measure of
+ * the software ISP, as the maximum of their normalised cross-correlation.
+ * Returns false if the frame is too small to measure.
+ */
+bool measurePhase(const uint8_t *data, unsigned int stride, const Size &size,
+		  float *phase, float *confidence)
+{
+	constexpr int K = kPdMaxShift;
+	const unsigned int x0 = size.width / 4 / 4 * 4;
+	const unsigned int w = size.width / 2 / 4 * 4;
+	const unsigned int n = w / 2;
+
+	if (n < 4 * K)
+		return false;
+
+	std::vector<float> l(n), r(n);
+	std::array<double, 2 * K + 1> ab{}, bb{};
+	double aa = 0.0;
+
+	/* Every second even line. */
+	for (unsigned int y = 0; y < size.height; y += 4) {
+		const uint8_t *p = data + y * stride + x0 / 4 * 5;
+		float sumL = 0.0f, sumR = 0.0f;
+
+		for (unsigned int i = 0; i < w / 4; i++, p += 5) {
+			for (unsigned int j = 0; j < 4; j++) {
+				float v = static_cast<float>((p[j] << 2) |
+							     ((p[4] >> (2 * j)) & 3));
+				unsigned int c = i * 4 + j;
+				if (c & 1) {
+					r[c / 2] = v;
+					sumR += v;
+				} else {
+					l[c / 2] = v;
+					sumL += v;
+				}
+			}
+		}
+
+		const float meanL = sumL / n, meanR = sumR / n;
+		for (unsigned int c = 0; c < n; c++) {
+			l[c] -= meanL;
+			r[c] -= meanR;
+		}
+
+		float rowAa = 0.0f;
+		for (unsigned int c = K; c < n - K; c++)
+			rowAa += l[c] * l[c];
+		aa += rowAa;
+
+		for (int s = -K; s <= K; s++) {
+			float rowAb = 0.0f, rowBb = 0.0f;
+			for (unsigned int c = K; c < n - K; c++) {
+				const float b = r[c - s];
+				rowAb += l[c] * b;
+				rowBb += b * b;
+			}
+			ab[s + K] += rowAb;
+			bb[s + K] += rowBb;
+		}
+	}
+
+	std::array<double, 2 * K + 1> corr;
+	int best = 0;
+	for (int i = 0; i <= 2 * K; i++) {
+		corr[i] = ab[i] / std::sqrt(aa * bb[i] + 1e-9);
+		if (corr[i] > corr[best])
+			best = i;
+	}
+
+	/* A shift at the edge of the range is no measurement. */
+	if (best == 0 || best == 2 * K) {
+		*phase = static_cast<float>(best - K);
+		*confidence = 0.0f;
+		return true;
+	}
+
+	double sub = 0.0;
+	const double den = corr[best - 1] - 2.0 * corr[best] + corr[best + 1];
+	if (den < 0.0)
+		sub = 0.5 * (corr[best - 1] - corr[best + 1]) / den;
+
+	*phase = static_cast<float>(best - K + sub);
+	*confidence = static_cast<float>(corr[best]);
+	return true;
+}
