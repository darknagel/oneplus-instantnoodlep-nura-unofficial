 /* Retrieve all source pads connected to a sink pad through active routes. */
+/*
+ * Find the second RDI of the CSID the image goes through, and its video node,
+ * for a sensor that sends phase detection data.
+ */
+void SimpleCameraData::initPdaf()
+{
+	SimplePipelineHandler *pipe = SimpleCameraData::pipe();
+
+	if (!swIsp_)
+		return;
+
+	const PdafSensorInfo *info = nullptr;
+	for (const PdafSensorInfo &s : pdafSensors) {
+		if (sensor_->model() == s.model)
+			info = &s;
+	}
+	if (!info)
+		return;
+
+	for (const Entity &e : entities_) {
+		if (!e.source || !e.sourceLink ||
+		    e.entity->name().rfind("msm_csid", 0) != 0)
+			continue;
+
+		const MediaPad *pad = e.entity->getPadByIndex(e.source->index() + 1);
+		if (!pad)
+			break;
+
+		/* The RDI after the one of the image, on the same VFE. */
+		std::string name = e.sourceLink->sink()->entity()->name();
+		name.back() = static_cast<char>(name.back() + 1);
+
+		for (MediaLink *link : pad->links()) {
+			MediaEntity *line = link->sink()->entity();
+			if (line->name() != name)
+				continue;
+
+			for (const MediaPad *linePad : line->pads()) {
+				if (!(linePad->flags() & MEDIA_PAD_FL_SOURCE))
+					continue;
+
+				for (MediaLink *videoLink : linePad->links()) {
+					MediaEntity *node = videoLink->sink()->entity();
+					if (node->function() != MEDIA_ENT_F_IO_V4L)
+						continue;
+
+					pdaf_.video = std::make_unique<V4L2VideoDevice>(node);
+					pdaf_.line = std::make_unique<V4L2Subdevice>(line);
+					pdaf_.pad = pad;
+					pdaf_.link = link;
+					pdaf_.csid = pipe->subdev(e.entity);
+				}
+			}
+		}
+		break;
+	}
+
+	if (!pdaf_.video || !pdaf_.csid || pdaf_.video->open() || pdaf_.line->open()) {
+		pdaf_.video.reset();
+		pdaf_.line.reset();
+		return;
+	}
+
+	pdaf_.info = info;
+	LOG(SimplePipeline, Info)
+		<< "Phase detection data on " << pdaf_.video->deviceNode();
+}
+
+void SimpleCameraData::configurePdaf(const V4L2SubdeviceFormat &sensorFormat,
+				     const V4L2PixelFormat &fourcc)
+{
+	pdaf_.active = false;
+
+	if (!pdaf_.info || sensorFormat.size != pdaf_.info->sensorSize)
+		return;
+
+	V4L2SubdeviceFormat format{};
+	format.code = sensorFormat.code;
+	format.size = pdaf_.info->pdSize;
+
+	V4L2DeviceFormat videoFormat;
+	videoFormat.fourcc = fourcc;
+	videoFormat.size = pdaf_.info->pdSize;
+
+	int ret = pdaf_.link->setEnabled(true);
+	if (!ret)
+		ret = pdaf_.csid->setFormat(pdaf_.pad->index(), &format);
+	if (!ret)
+		ret = pdaf_.line->setFormat(0, &format);
+	if (!ret)
+		ret = pdaf_.video->setFormat(&videoFormat);
+
+	if (ret || videoFormat.fourcc != fourcc ||
+	    videoFormat.size != pdaf_.info->pdSize) {
+		LOG(SimplePipeline, Warning)
+			<< "Unable to configure the phase detection stream";
+		pdaf_.link->setEnabled(false);
+		return;
+	}
+
+	pdaf_.stride = videoFormat.planes[0].bpl;
+	pdaf_.active = true;
+}
+
+void SimpleCameraData::startPdaf()
+{
+	if (!pdaf_.active)
+		return;
+
+	int ret = pdaf_.video->allocateBuffers(4, &pdaf_.buffers);
+	if (ret > 0) {
+		for (const std::unique_ptr<FrameBuffer> &buffer : pdaf_.buffers) {
+			auto map = std::make_unique<MappedFrameBuffer>(buffer.get(),
+								       MappedFrameBuffer::MapFlag::Read);
+			if (!map->isValid()) {
+				ret = -ENOMEM;
+				break;
+			}
+			pdaf_.maps[buffer.get()] = std::move(map);
+		}
+	}
+
+	if (ret > 0) {
+		pdaf_.video->bufferReady.connect(this, &SimpleCameraData::pdafBufferReady);
+		ret = pdaf_.video->streamOn();
+	}
+
+	if (ret < 0) {
+		LOG(SimplePipeline, Warning)
+			<< "Unable to start the phase detection stream: " << ret;
+		stopPdaf();
+		return;
+	}
+
+	for (const std::unique_ptr<FrameBuffer> &buffer : pdaf_.buffers)
+		pdaf_.video->queueBuffer(buffer.get());
+}
+
+void SimpleCameraData::stopPdaf()
+{
+	if (!pdaf_.active)
+		return;
+
+	pdaf_.video->streamOff();
+	pdaf_.video->bufferReady.disconnect(this, &SimpleCameraData::pdafBufferReady);
+	pdaf_.maps.clear();
+	pdaf_.buffers.clear();
+	pdaf_.video->releaseBuffers();
+}
+
+void SimpleCameraData::pdafBufferReady(FrameBuffer *buffer)
+{
+	const FrameMetadata &metadata = buffer->metadata();
+
+	if (metadata.status == FrameMetadata::FrameCancelled)
+		return;
+
+	auto it = pdaf_.maps.find(buffer);
+	if (metadata.status == FrameMetadata::FrameSuccess && swIsp_ &&
+	    it != pdaf_.maps.end()) {
+		float phase, confidence;
+		if (measurePhase(it->second->planes()[0].data(), pdaf_.stride,
+				 pdaf_.info->pdSize, &phase, &confidence))
+			swIsp_->setPhase(phase, confidence, metadata.sequence);
+	}
+
+	pdaf_.video->queueBuffer(buffer);
+}
