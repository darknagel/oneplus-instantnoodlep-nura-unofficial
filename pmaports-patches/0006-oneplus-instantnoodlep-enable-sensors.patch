diff --git a/device/testing/device-oneplus-instantnoodlep/hexagonrpcd-sdsp.conf b/device/testing/device-oneplus-instantnoodlep/hexagonrpcd-sdsp.conf
new file mode 100755
index 0000000000..465a6dc74c
--- /dev/null
+++ b/device/testing/device-oneplus-instantnoodlep/hexagonrpcd-sdsp.conf
@@ -0,0 +1,5 @@
+# The sensor DSP needs to save its registry, otherwise it does not bring up
+# the accelerometer. Serve a writable copy as the persist directory.
+[Service]
+ExecStart=
+ExecStart=/usr/bin/hexagonrpcd -f /dev/fastrpc-sdsp -d sdsp -s -w /var/lib/hexagonrpcd/sensors-registry
diff --git a/device/testing/device-oneplus-instantnoodlep/hexagonrpcd.tmpfiles b/device/testing/device-oneplus-instantnoodlep/hexagonrpcd.tmpfiles
new file mode 100755
index 0000000000..2bf6ca81e4
--- /dev/null
+++ b/device/testing/device-oneplus-instantnoodlep/hexagonrpcd.tmpfiles
@@ -0,0 +1,6 @@
+# Writable sensor registry for hexagonrpcd, created from the packaged one once.
+# The parent stays owned by root, otherwise systemd-tmpfiles refuses the
+# chown below (unsafe path transition).
+d /var/lib/hexagonrpcd 0755 root root -
+C /var/lib/hexagonrpcd/sensors-registry - - - - /usr/share/qcom/sm8250/OnePlus/instantnoodlep/sensors/persist
+Z /var/lib/hexagonrpcd/sensors-registry - fastrpc fastrpc -
diff --git a/device/testing/firmware-oneplus-instantnoodlep/APKBUILD b/device/testing/firmware-oneplus-instantnoodlep/APKBUILD
index 06bdf96b52..781721a719 100644
