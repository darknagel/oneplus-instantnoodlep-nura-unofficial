 package() {
@@ -56,6 +59,21 @@ gpu() {
 	install -Dm644 "$builddir/gpu/a650_zap.mbn" -t "$subpkgdir/usr/lib/firmware/qcom/sm8250/OnePlus/instantnoodlep"
 }
 
+hexagonfs() {
+	pkgdesc="OnePlus 8 Pro files for hexagonrpcd (sensor DSP)"
+	depends="hexagonrpcd"
+
+	# dsp/sdsp from the dsp partition, sensor configuration from vendor and
+	# socinfo for the sensor DSP. sensors/persist is the initial registry,
+	# generated with sscregistrygen from the vendor configuration and the
+	# OnePlus configuration from odm on top of it.
+	local dir="$subpkgdir/usr/share/qcom/sm8250/OnePlus/instantnoodlep"
+	mkdir -p "$dir"
+	cp -r "$srcdir"/hexagonfs/. "$dir"
+	find "$dir" -type d -exec chmod 0755 {} \;
+	find "$dir" -type f -exec chmod 0644 {} \;
+}
+
 ipa() {
 	pil-squasher "$builddir/ipa/ipa_fws.mbn" "$builddir/ipa/ipa_fws.mdt"
 	install -Dm644 "$builddir/ipa/ipa_fws.mbn" -t $subpkgdir/usr/lib/firmware/postmarketos
@@ -90,4 +108,5 @@ venus() {
 
 sha512sums="
 c2855805e6327977fbd119ed89e76010586273008260c4df827622266f42dc318abf7f61f78408596377338cf36c03dd10b7279b6e6f7986569c970fffae72da  oneplus-instantnoodlep-firmware-2dce2681689fcf615198c663555c5a7c7b3650ba.tar.gz
+878e496bc79899264a93548a00d802ba1ea1e46d4243874803a87b0423d3bb48df0cb8f14a106d3d07e22eda51a6ae1988ae781b6337f842a6a239d044e54490  oneplus-instantnoodlep-hexagonfs-1.tar.gz
 "
