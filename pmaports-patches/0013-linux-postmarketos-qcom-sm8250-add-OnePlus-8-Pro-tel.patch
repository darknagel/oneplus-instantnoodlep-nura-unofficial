 83cb859ba62434fbdac0b8c1f8bda2b9766ea58a121b3e224fc46a94ad1610a86a3d529ad12343a31aba7058c710bdc89b08db5d4a26d484e5757ab5d8d73260  0001-dt-bindings-display-panel-Add-Samsung-AMS678UW01.patch
