++	ret = pm_runtime_resume_and_get(imx471->dev);
++	if (ret)
++		return ret;
++
++	ret = cci_multi_reg_write(imx471->regmap, imx471_init_regs,
++				  ARRAY_SIZE(imx471_init_regs), NULL);
