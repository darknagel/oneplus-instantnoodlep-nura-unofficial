++		goto error;
++
++	ret = __v4l2_ctrl_handler_setup(imx471->sd.ctrl_handler);
++	if (ret)
++		goto error;
++
++	ret = cci_write(imx471->regmap, IMX471_REG_MODE_SELECT,
++			IMX471_MODE_STREAMING, NULL);
++	if (ret)
++		goto error;
++
++	return 0;
++
++error:
++	dev_err(imx471->dev, "failed to start streaming: %d\n", ret);
++	pm_runtime_put_autosuspend(imx471->dev);
++
++	return ret;
++}
++
++static int imx471_disable_streams(struct v4l2_subdev *sd,
++				  struct v4l2_subdev_state *state, u32 pad,
++				  u64 streams_mask)
++{
++	struct imx471 *imx471 = to_imx471(sd);
++	int ret;
++
++	ret = cci_write(imx471->regmap, IMX471_REG_MODE_SELECT,
++			IMX471_MODE_STANDBY, NULL);
++	if (ret)
++		dev_err(imx471->dev, "failed to stop streaming: %d\n", ret);
++
++	pm_runtime_put_autosuspend(imx471->dev);
++
++	return ret;
++}
++
++static void imx471_update_pad_format(const struct imx471_mode *mode,
++				     struct v4l2_mbus_framefmt *fmt)
++{
++	fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
++	fmt->width = mode->width;
++	fmt->height = mode->height;
++	fmt->field = V4L2_FIELD_NONE;
++	fmt->colorspace = V4L2_COLORSPACE_RAW;
++	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
++	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
++	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
++}
++
++static int imx471_set_pad_format(struct v4l2_subdev *sd,
++				 struct v4l2_subdev_state *state,
++				 struct v4l2_subdev_format *fmt)
++{
++	struct imx471 *imx471 = to_imx471(sd);
++	s64 hblank, vblank, exposure_max;
++	const struct imx471_mode *mode;
++
++	mode = v4l2_find_nearest_size(imx471_supported_modes,
++				      ARRAY_SIZE(imx471_supported_modes),
++				      width, height,
++				      fmt->format.width, fmt->format.height);
++
++	imx471_update_pad_format(mode, &fmt->format);
++
++	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY || imx471->mode == mode)
++		goto set_format;
++
++	__v4l2_ctrl_s_ctrl(imx471->link_freq, mode->link_freq_index);
++	__v4l2_ctrl_s_ctrl_int64(imx471->pixel_rate, mode->pixel_rate);
++
++	hblank = mode->hts - mode->width;
++	__v4l2_ctrl_modify_range(imx471->hblank, hblank, hblank, 1, hblank);
++
++	vblank = mode->vts - mode->height;
++	__v4l2_ctrl_modify_range(imx471->vblank, vblank,
++				 IMX471_VTS_MAX - mode->height, 1, vblank);
++	__v4l2_ctrl_s_ctrl(imx471->vblank, vblank);
++
++	exposure_max = mode->vts - IMX471_EXPOSURE_MARGIN;
++	__v4l2_ctrl_modify_range(imx471->exposure, IMX471_EXPOSURE_MIN,
++				 exposure_max, IMX471_EXPOSURE_STEP,
++				 IMX471_EXPOSURE_DEFAULT);
++
++	if (imx471->sd.ctrl_handler->error)
++		return imx471->sd.ctrl_handler->error;
++
++	imx471->mode = mode;
++
++set_format:
++	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
++
++	return 0;
++}
++
++static int imx471_enum_mbus_code(struct v4l2_subdev *sd,
++				 struct v4l2_subdev_state *sd_state,
++				 struct v4l2_subdev_mbus_code_enum *code)
++{
++	if (code->index > 0)
++		return -EINVAL;
++
++	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
++
++	return 0;
++}
++
++static int imx471_enum_frame_size(struct v4l2_subdev *sd,
++				  struct v4l2_subdev_state *sd_state,
++				  struct v4l2_subdev_frame_size_enum *fse)
++{
++	if (fse->index >= ARRAY_SIZE(imx471_supported_modes))
++		return -EINVAL;
++
++	if (fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
++		return -EINVAL;
++
++	fse->min_width = imx471_supported_modes[fse->index].width;
++	fse->max_width = fse->min_width;
++	fse->min_height = imx471_supported_modes[fse->index].height;
++	fse->max_height = fse->min_height;
++
++	return 0;
++}
++
++static int imx471_get_selection(struct v4l2_subdev *sd,
++				struct v4l2_subdev_state *sd_state,
++				struct v4l2_subdev_selection *sel)
++{
++	struct imx471 *imx471 = to_imx471(sd);
++
++	switch (sel->target) {
++	case V4L2_SEL_TGT_CROP:
++		sel->r = imx471->mode->crop;
++		return 0;
++	case V4L2_SEL_TGT_NATIVE_SIZE:
++	case V4L2_SEL_TGT_CROP_BOUNDS:
++	case V4L2_SEL_TGT_CROP_DEFAULT:
++		sel->r.left = 0;
++		sel->r.top = 0;
++		sel->r.width = IMX471_NATIVE_WIDTH;
++		sel->r.height = IMX471_NATIVE_HEIGHT;
++		return 0;
++	default:
++		return -EINVAL;
++	}
++}
++
++static int imx471_init_state(struct v4l2_subdev *sd,
++			     struct v4l2_subdev_state *state)
++{
++	struct imx471 *imx471 = to_imx471(sd);
++	struct v4l2_subdev_format fmt = {
++		.which = V4L2_SUBDEV_FORMAT_TRY,
++		.pad = 0,
++		.format = {
++			.width = imx471->mode->width,
++			.height = imx471->mode->height,
++		},
++	};
++
++	imx471_set_pad_format(sd, state, &fmt);
++
++	return 0;
++}
++
++static const struct v4l2_subdev_video_ops imx471_video_ops = {
++	.s_stream = v4l2_subdev_s_stream_helper,
++};
++
++static const struct v4l2_subdev_pad_ops imx471_pad_ops = {
++	.set_fmt = imx471_set_pad_format,
++	.get_fmt = v4l2_subdev_get_fmt,
++	.get_selection = imx471_get_selection,
++	.enum_mbus_code = imx471_enum_mbus_code,
++	.enum_frame_size = imx471_enum_frame_size,
++	.enable_streams = imx471_enable_streams,
++	.disable_streams = imx471_disable_streams,
++};
++
++static const struct v4l2_subdev_ops imx471_subdev_ops = {
++	.video = &imx471_video_ops,
++	.pad = &imx471_pad_ops,
++};
++
++static const struct v4l2_subdev_internal_ops imx471_internal_ops = {
++	.init_state = imx471_init_state,
++};
++
++static const struct media_entity_operations imx471_subdev_entity_ops = {
++	.link_validate = v4l2_subdev_link_validate,
++};
++
++static int imx471_identify_sensor(struct imx471 *imx471)
++{
++	u64 val;
++	int ret;
++
++	ret = cci_read(imx471->regmap, IMX471_REG_CHIP_ID, &val, NULL);
++	if (ret) {
++		dev_err(imx471->dev, "failed to read chip id: %d\n", ret);
++		return ret;
++	}
++
++	if (val != IMX471_CHIP_ID) {
++		dev_err(imx471->dev, "chip id mismatch: %x!=%llx\n",
++			IMX471_CHIP_ID, val);
++		return -ENODEV;
++	}
++
++	return 0;
++}
++
++static int imx471_check_hwcfg(struct imx471 *imx471)
++{
++	struct fwnode_handle *fwnode = dev_fwnode(imx471->dev), *ep;
++	struct v4l2_fwnode_endpoint bus_cfg = {
++		.bus_type = V4L2_MBUS_CSI2_DPHY,
++	};
++	unsigned long freq_bitmap;
++	int ret;
++
++	if (!fwnode)
++		return -ENODEV;
++
++	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
++	if (!ep)
++		return -EINVAL;
++
++	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
++	fwnode_handle_put(ep);
++	if (ret)
++		return ret;
++
++	if (bus_cfg.bus.mipi_csi2.num_data_lanes != IMX471_DATA_LANES) {
++		dev_err(imx471->dev, "Invalid number of data lanes: %u\n",
++			bus_cfg.bus.mipi_csi2.num_data_lanes);
++		ret = -EINVAL;
++		goto endpoint_free;
++	}
++
++	ret = v4l2_link_freq_to_bitmap(imx471->dev, bus_cfg.link_frequencies,
++				       bus_cfg.nr_of_link_frequencies,
++				       imx471_link_freq_menu,
++				       ARRAY_SIZE(imx471_link_freq_menu),
++				       &freq_bitmap);
++	if (ret)
++		goto endpoint_free;
++
++	/* Both link frequencies are needed, one for each mode */
++	if (freq_bitmap != GENMASK(ARRAY_SIZE(imx471_link_freq_menu) - 1, 0)) {
++		dev_err(imx471->dev, "Not all link frequencies are supported\n");
++		ret = -EINVAL;
++	}
++
++endpoint_free:
++	v4l2_fwnode_endpoint_free(&bus_cfg);
++
++	return ret;
++}
++
++static int imx471_power_on(struct device *dev)
++{
++	struct v4l2_subdev *sd = dev_get_drvdata(dev);
++	struct imx471 *imx471 = to_imx471(sd);
++	int ret;
++
++	ret = regulator_bulk_enable(IMX471_NUM_SUPPLIES, imx471->supplies);
++	if (ret)
++		return ret;
++
++	/* Let the supplies settle before the clock is enabled */
++	usleep_range(2 * USEC_PER_MSEC, 3 * USEC_PER_MSEC);
++
++	ret = clk_prepare_enable(imx471->mclk);
++	if (ret)
++		goto disable_regulators;
++
++	usleep_range(2 * USEC_PER_MSEC, 3 * USEC_PER_MSEC);
++	gpiod_set_value_cansleep(imx471->reset_gpio, 0);
++	usleep_range(10 * USEC_PER_MSEC, 15 * USEC_PER_MSEC);
++
++	return 0;
++
++disable_regulators:
++	regulator_bulk_disable(IMX471_NUM_SUPPLIES, imx471->supplies);
++
++	return ret;
++}
++
++static int imx471_power_off(struct device *dev)
++{
++	struct v4l2_subdev *sd = dev_get_drvdata(dev);
++	struct imx471 *imx471 = to_imx471(sd);
++
++	gpiod_set_value_cansleep(imx471->reset_gpio, 1);
++
++	clk_disable_unprepare(imx471->mclk);
++
++	regulator_bulk_disable(IMX471_NUM_SUPPLIES, imx471->supplies);
++
++	return 0;
++}
++
++static int imx471_probe(struct i2c_client *client)
++{
++	struct imx471 *imx471;
++	unsigned long freq;
++	unsigned int i;
++	int ret;
++
++	imx471 = devm_kzalloc(&client->dev, sizeof(*imx471), GFP_KERNEL);
++	if (!imx471)
++		return -ENOMEM;
++
++	imx471->dev = &client->dev;
++	v4l2_i2c_subdev_init(&imx471->sd, client, &imx471_subdev_ops);
++
++	imx471->regmap = devm_cci_regmap_init_i2c(client, 16);
++	if (IS_ERR(imx471->regmap))
++		return dev_err_probe(imx471->dev, PTR_ERR(imx471->regmap),
++				     "failed to init CCI\n");
++
++	imx471->mclk = devm_v4l2_sensor_clk_get(imx471->dev, NULL);
++	if (IS_ERR(imx471->mclk))
++		return dev_err_probe(imx471->dev, PTR_ERR(imx471->mclk),
++				     "failed to get MCLK clock\n");
++
++	freq = clk_get_rate(imx471->mclk);
++	if (freq != IMX471_MCLK_FREQ)
++		return dev_err_probe(imx471->dev, -EINVAL,
++				     "MCLK clock frequency %lu is not supported\n",
++				     freq);
++
++	ret = imx471_check_hwcfg(imx471);
++	if (ret)
++		return dev_err_probe(imx471->dev, ret,
++				     "failed to check HW configuration\n");
++
++	imx471->reset_gpio = devm_gpiod_get_optional(imx471->dev, "reset",
++						     GPIOD_OUT_HIGH);
++	if (IS_ERR(imx471->reset_gpio))
++		return dev_err_probe(imx471->dev, PTR_ERR(imx471->reset_gpio),
++				     "cannot get reset GPIO\n");
++
++	for (i = 0; i < IMX471_NUM_SUPPLIES; i++)
++		imx471->supplies[i].supply = imx471_supply_names[i];
++
++	ret = devm_regulator_bulk_get(imx471->dev, IMX471_NUM_SUPPLIES,
++				      imx471->supplies);
++	if (ret)
++		return dev_err_probe(imx471->dev, ret,
++				     "failed to get supply regulators\n");
++
++	/* The sensor must be powered on to read the CHIP_ID register */
++	ret = imx471_power_on(imx471->dev);
++	if (ret)
++		return ret;
++
++	ret = imx471_identify_sensor(imx471);
++	if (ret) {
++		dev_err_probe(imx471->dev, ret, "failed to find sensor\n");
++		goto power_off;
++	}
++
++	imx471->mode = &imx471_supported_modes[0];
++	ret = imx471_init_controls(imx471);
++	if (ret) {
++		dev_err_probe(imx471->dev, ret, "failed to init controls\n");
++		goto power_off;
++	}
++
++	imx471->sd.state_lock = imx471->ctrl_handler.lock;
++	imx471->sd.internal_ops = &imx471_internal_ops;
++	imx471->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
++	imx471->sd.entity.ops = &imx471_subdev_entity_ops;
++	imx471->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
++	imx471->pad.flags = MEDIA_PAD_FL_SOURCE;
++
++	ret = media_entity_pads_init(&imx471->sd.entity, 1, &imx471->pad);
++	if (ret) {
++		dev_err_probe(imx471->dev, ret,
++			      "failed to init media entity pads\n");
++		goto v4l2_ctrl_handler_free;
++	}
++
++	ret = v4l2_subdev_init_finalize(&imx471->sd);
++	if (ret < 0) {
++		dev_err_probe(imx471->dev, ret,
++			      "failed to finalize subdev init\n");
++		goto media_entity_cleanup;
++	}
++
++	pm_runtime_set_active(imx471->dev);
++	pm_runtime_enable(imx471->dev);
++
++	ret = v4l2_async_register_subdev_sensor(&imx471->sd);
++	if (ret < 0) {
++		dev_err_probe(imx471->dev, ret,
++			      "failed to register V4L2 subdev\n");
++		goto subdev_cleanup;
++	}
++
++	pm_runtime_set_autosuspend_delay(imx471->dev, 1000);
++	pm_runtime_use_autosuspend(imx471->dev);
++	pm_runtime_idle(imx471->dev);
++
++	return 0;
++
++subdev_cleanup:
++	v4l2_subdev_cleanup(&imx471->sd);
++	pm_runtime_disable(imx471->dev);
++	pm_runtime_set_suspended(imx471->dev);
++
++media_entity_cleanup:
++	media_entity_cleanup(&imx471->sd.entity);
++
++v4l2_ctrl_handler_free:
++	v4l2_ctrl_handler_free(imx471->sd.ctrl_handler);
++
++power_off:
++	imx471_power_off(imx471->dev);
++
++	return ret;
++}
++
++static void imx471_remove(struct i2c_client *client)
++{
++	struct v4l2_subdev *sd = i2c_get_clientdata(client);
++	struct imx471 *imx471 = to_imx471(sd);
++
++	v4l2_async_unregister_subdev(sd);
++	v4l2_subdev_cleanup(sd);
++	media_entity_cleanup(&sd->entity);
++	v4l2_ctrl_handler_free(sd->ctrl_handler);
++	pm_runtime_disable(imx471->dev);
++
++	if (!pm_runtime_status_suspended(imx471->dev)) {
++		imx471_power_off(imx471->dev);
++		pm_runtime_set_suspended(imx471->dev);
++	}
++}
++
++static const struct dev_pm_ops imx471_pm_ops = {
++	SET_RUNTIME_PM_OPS(imx471_power_off, imx471_power_on, NULL)
++};
++
++static const struct of_device_id imx471_of_match[] = {
++	{ .compatible = "sony,imx471" },
++	{ /* sentinel */ }
++};
++MODULE_DEVICE_TABLE(of, imx471_of_match);
++
++static struct i2c_driver imx471_i2c_driver = {
++	.driver = {
++		.name = "imx471",
++		.pm = &imx471_pm_ops,
++		.of_match_table = imx471_of_match,
++	},
++	.probe = imx471_probe,
++	.remove = imx471_remove,
++};
++
++module_i2c_driver(imx471_i2c_driver);
++
++MODULE_AUTHOR("Timo <1788603+darknagel@users.noreply.github.com>");
++MODULE_DESCRIPTION("Sony IMX471 image sensor driver");
++MODULE_LICENSE("GPL");
