++static int imx471_set_ctrl(struct v4l2_ctrl *ctrl)
++{
++	struct imx471 *imx471 = container_of(ctrl->handler, struct imx471,
++					     ctrl_handler);
++	const struct imx471_mode *mode = imx471->mode;
++	s64 exposure_max;
++	int ret;
++
++	if (ctrl->id == V4L2_CID_VBLANK) {
++		/* Update max exposure while meeting expected vblanking */
++		exposure_max = mode->height + ctrl->val - IMX471_EXPOSURE_MARGIN;
++		__v4l2_ctrl_modify_range(imx471->exposure,
++					 imx471->exposure->minimum,
++					 exposure_max,
++					 imx471->exposure->step,
++					 imx471->exposure->default_value);
++	}
++
++	/* V4L2 controls are applied, when sensor is powered up for streaming */
++	if (!pm_runtime_get_if_active(imx471->dev))
++		return 0;
++
++	switch (ctrl->id) {
++	case V4L2_CID_ANALOGUE_GAIN:
++		ret = cci_write(imx471->regmap, IMX471_REG_AGAIN,
++				ctrl->val, NULL);
++		break;
++	case V4L2_CID_EXPOSURE:
++		ret = cci_write(imx471->regmap, IMX471_REG_EXPOSURE,
++				ctrl->val, NULL);
++		break;
++	case V4L2_CID_VBLANK:
++		ret = cci_write(imx471->regmap, IMX471_REG_VTS,
++				ctrl->val + mode->height, NULL);
++		break;
++	case V4L2_CID_TEST_PATTERN:
++		ret = cci_write(imx471->regmap, IMX471_REG_TEST_PATTERN,
++				ctrl->val, NULL);
++		break;
++	default:
++		ret = -EINVAL;
++		break;
++	}
++
++	pm_runtime_put(imx471->dev);
++
++	return ret;
++}
