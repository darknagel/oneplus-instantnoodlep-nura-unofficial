++static int imx471_enable_streams(struct v4l2_subdev *sd,
++				 struct v4l2_subdev_state *state, u32 pad,
++				 u64 streams_mask)
++{
++	struct imx471 *imx471 = to_imx471(sd);
++	const struct imx471_reg_list *reg_list = &imx471->mode->reg_list;
++	int ret;
