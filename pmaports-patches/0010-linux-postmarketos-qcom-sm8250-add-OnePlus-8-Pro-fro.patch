++				remote-endpoint = <&csiphy3_ep>;
++			};
++		};
++	};
++};
++
+ &cdsp {
+ 	firmware-name = "postmarketos/cdsp.mbn";
+ 	status = "okay";
+@@ -1233,6 +1298,20 @@ wcd_default: wcd-default-state {
+ 		output-low;
+ 	};
+ 
++	cam_front_avdd_en: cam-front-avdd-en-state {
