diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0011-media-i2c-Add-Sony-IMX471-image-sensor-driver.patch b/device/testing/linux-postmarketos-qcom-sm8250/0011-media-i2c-Add-Sony-IMX471-image-sensor-driver.patch
new file mode 100644
index 0000000000..29f2e8f6a1
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0011-media-i2c-Add-Sony-IMX471-image-sensor-driver.patch
@@ -0,0 +1,1116 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Mon, 26 Oct 2026 19:21:55 +0100
+Subject: [PATCH 11/12] media: i2c: Add Sony IMX471 image sensor driver
+
+Add a driver for the Sony IMX471, a 16 MP sensor used as front camera
+in the OnePlus 8 Pro. It supports two RAW10 modes over four CSI-2 D-PHY
+lanes with a 19.2 MHz MCLK:
+
+  4656x3496 at 30 fps (link frequency 748.8 MHz)
+  2328x1748 at 60 fps, 2x2 binned (link frequency 400 MHz)
+
+The register settings come from the camera module data of the phone.
+Exposure, analogue gain (1024 / (1024 - code), up to 16x), vertical
+blanking and the test patterns are exposed as controls.
+
+Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
+---
+ drivers/media/i2c/Kconfig  |   10 +
+ drivers/media/i2c/Makefile |    1 +
+ drivers/media/i2c/imx471.c | 1050 ++++++++++++++++++++++++++++++++++++
+ 3 files changed, 1061 insertions(+)
+ create mode 100755 drivers/media/i2c/imx471.c
+
+diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
+index 5d173e0ec..b7199f9f5 100644
+--- a/drivers/media/i2c/Kconfig
++++ b/drivers/media/i2c/Kconfig
+@@ -287,6 +287,16 @@ config VIDEO_IMX415
+ 	  To compile this driver as a module, choose M here: the
+ 	  module will be called imx415.
+ 
++config VIDEO_IMX471
++	tristate "Sony IMX471 sensor support"
++	select V4L2_CCI_I2C
++	help
++	  This is a Video4Linux2 sensor driver for the Sony
++	  IMX471 camera.
++
++	  To compile this driver as a module, choose M here: the
++	  module will be called imx471.
++
+ config VIDEO_MAX9271_LIB
+ 	tristate
+ 
+diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
+index e45359efe..acbd321fc 100644
+--- a/drivers/media/i2c/Makefile
++++ b/drivers/media/i2c/Makefile
+@@ -61,6 +61,7 @@ obj-$(CONFIG_VIDEO_IMX335) += imx335.o
+ obj-$(CONFIG_VIDEO_IMX355) += imx355.o
+ obj-$(CONFIG_VIDEO_IMX412) += imx412.o
+ obj-$(CONFIG_VIDEO_IMX415) += imx415.o
++obj-$(CONFIG_VIDEO_IMX471) += imx471.o
+ obj-$(CONFIG_VIDEO_IR_I2C) += ir-kbd-i2c.o
+ obj-$(CONFIG_VIDEO_ISL7998X) += isl7998x.o
+ obj-$(CONFIG_VIDEO_KS0127) += ks0127.o
+diff --git a/drivers/media/i2c/imx471.c b/drivers/media/i2c/imx471.c
+new file mode 100755
+index 000000000..f8eeb42d2
+--- /dev/null
++++ b/drivers/media/i2c/imx471.c
+@@ -0,0 +1,1050 @@
++// SPDX-License-Identifier: GPL-2.0
++/*
++ * Sony IMX471 image sensor driver
++ *
++ * The register settings are taken from the camera module data of the
++ * OnePlus 8 Pro, which uses the IMX471 as front camera with a 19.2 MHz
++ * MCLK and four CSI-2 D-PHY data lanes.
++ */
++
++#include <linux/clk.h>
++#include <linux/delay.h>
++#include <linux/gpio/consumer.h>
++#include <linux/i2c.h>
++#include <linux/module.h>
++#include <linux/pm_runtime.h>
++#include <linux/regulator/consumer.h>
++#include <linux/units.h>
++#include <media/v4l2-cci.h>
++#include <media/v4l2-ctrls.h>
++#include <media/v4l2-device.h>
++#include <media/v4l2-fwnode.h>
++
++#define IMX471_MCLK_FREQ		(19200 * HZ_PER_KHZ)
++#define IMX471_DATA_LANES		4
++
++#define IMX471_REG_CHIP_ID		CCI_REG16(0x0016)
++#define IMX471_CHIP_ID			0x0471
++
++#define IMX471_REG_MODE_SELECT		CCI_REG8(0x0100)
++#define IMX471_MODE_STANDBY		0x00
++#define IMX471_MODE_STREAMING		0x01
++
++#define IMX471_REG_EXPOSURE		CCI_REG16(0x0202)
++#define IMX471_EXPOSURE_MIN		4
++#define IMX471_EXPOSURE_STEP		1
++#define IMX471_EXPOSURE_MARGIN		10
++#define IMX471_EXPOSURE_DEFAULT		1000
++
++/* Analogue gain = 1024 / (1024 - code), up to 16x */
++#define IMX471_REG_AGAIN		CCI_REG16(0x0204)
++#define IMX471_AGAIN_MIN		0
++#define IMX471_AGAIN_MAX		960
++#define IMX471_AGAIN_STEP		1
++#define IMX471_AGAIN_DEFAULT		0
++
++#define IMX471_REG_VTS			CCI_REG16(0x0340)
++#define IMX471_VTS_MAX			0xffff
++
++#define IMX471_REG_TEST_PATTERN		CCI_REG16(0x0600)
++
++#define IMX471_NATIVE_WIDTH		4656
++#define IMX471_NATIVE_HEIGHT		3496
++
++#define to_imx471(_sd)			container_of(_sd, struct imx471, sd)
++
++static const s64 imx471_link_freq_menu[] = {
++	748800000,
++	400000000,
++};
++
++struct imx471_reg_list {
++	const struct cci_reg_sequence *regs;
++	unsigned int num_regs;
++};
++
++struct imx471_mode {
++	u32 width;			/* Frame width in pixels */
++	u32 height;			/* Frame height in pixels */
++	u32 hts;			/* Horizontal timing size */
++	u32 vts;			/* Default vertical timing size */
++	u32 link_freq_index;		/* Index into imx471_link_freq_menu */
++	u64 pixel_rate;			/* Pixel rate matching hts and vts */
++	struct v4l2_rect crop;		/* Analogue crop rectangle */
++
++	const struct imx471_reg_list reg_list;	/* Sensor register setting */
++};
++
++static const char * const imx471_test_pattern_menu[] = {
++	"Disabled",
++	"Solid colour",
++	"Colour bars",
++	"Fade to grey colour bars",
++	"PN9",
++};
++
++static const char * const imx471_supply_names[] = {
++	"avdd",		/* Analog power */
++	"dvdd",		/* Digital core power */
++	"dovdd",	/* Digital I/O power */
++};
++
++#define IMX471_NUM_SUPPLIES	ARRAY_SIZE(imx471_supply_names)
++
++struct imx471 {
++	struct device *dev;
++	struct regmap *regmap;
++	struct clk *mclk;
++	struct gpio_desc *reset_gpio;
++	struct regulator_bulk_data supplies[IMX471_NUM_SUPPLIES];
++
++	struct v4l2_subdev sd;
++	struct media_pad pad;
++
++	struct v4l2_ctrl_handler ctrl_handler;
++	struct v4l2_ctrl *link_freq;
++	struct v4l2_ctrl *pixel_rate;
++	struct v4l2_ctrl *hblank;
++	struct v4l2_ctrl *vblank;
++	struct v4l2_ctrl *exposure;
++
++	const struct imx471_mode *mode;
++};
++
++static const struct cci_reg_sequence imx471_init_regs[] = {
++	{ CCI_REG8(0x0136), 0x13 },
++	{ CCI_REG8(0x0137), 0x33 },
++	{ CCI_REG8(0x3c7e), 0x04 },
++	{ CCI_REG8(0x3c7f), 0x04 },
++	{ CCI_REG8(0x300a), 0x02 },
++	{ CCI_REG8(0x3e35), 0x00 },
++	{ CCI_REG8(0x3e36), 0x00 },
++	{ CCI_REG8(0x3e37), 0x00 },
++	{ CCI_REG8(0x3f7f), 0x01 },
++	{ CCI_REG8(0x4431), 0x04 },
