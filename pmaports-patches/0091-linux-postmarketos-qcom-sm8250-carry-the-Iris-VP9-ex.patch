+ 		op_pkt.stream_id = 1;
+@@ -492,6 +501,10 @@ iris_hfi_gen1_packet_session_set_property(struct hfi_session_set_property_pkt *p
+ 	packet->data[0] = ptype;
+ 
+ 	switch (ptype) {
++	case HFI_PROPERTY_PARAM_SECURE_SESSION:
++		*(u32 *)prop_data = *(u32 *)pdata;
++		packet->shdr.hdr.size += sizeof(u32);
++		break;
+ 	case HFI_PROPERTY_PARAM_FRAME_SIZE: {
+ 		struct hfi_framesize *in = pdata, *fsize = prop_data;
+ 
+@@ -1090,6 +1103,16 @@ static int iris_hfi_gen1_session_set_config_params(struct iris_inst *inst, u32 p
+ 		config_params = core->iris_firmware_data->dec_input_config_params_default;
