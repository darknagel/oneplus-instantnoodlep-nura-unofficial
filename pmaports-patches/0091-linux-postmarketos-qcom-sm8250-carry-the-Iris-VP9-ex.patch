+ 	return 0;
+ }
+ 
++void iris_free_output_extradata(struct iris_inst *inst, struct iris_buffer *buf)
++{
++	if (!buf->extra_vaddr)
++		return;
++
++	dma_free_coherent(inst->core->dev, IRIS_VP9_EXTRADATA_SIZE,
++			  buf->extra_vaddr, buf->extra_dma);
++	buf->extra_vaddr = NULL;
++	buf->extra_dma = 0;
++}
++
+ int iris_destroy_internal_buffer(struct iris_inst *inst, struct iris_buffer *buffer)
+ {
+ 	struct iris_core *core = inst->core;
+ 
+ 	list_del(&buffer->list);
++	iris_free_output_extradata(inst, buffer);
+ 	dma_free_attrs(core->dev, buffer->buffer_size, buffer->kvaddr,
+ 		       buffer->device_addr, buffer->dma_attrs);
+ 	kfree(buffer);
