 temp/usb-signaller/usb-signaller.initd        |  12 ++
 3 files changed, 256 insertions(+)
 create mode 100644 temp/usb-signaller/0001-main-keep-the-host-role-picked-by-the-Type-C-port-co.patch
 create mode 100644 temp/usb-signaller/APKBUILD
 create mode 100644 temp/usb-signaller/usb-signaller.initd

