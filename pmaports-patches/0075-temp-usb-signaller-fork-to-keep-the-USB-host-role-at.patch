--- /dev/null
+++ b/temp/usb-signaller/APKBUILD
@@ -0,0 +1,60 @@
+# Forked from Alpine: keep the USB host role that the Type-C port controller
+# picks when the phone powers a hub or monitor at boot, instead of switching
+# it to device role for the default mode. From instantnoodlep-nura-unofficial,
+# usb-signaller-patches/
+maintainer="Dylan Van Assche <dylan@postmarketos.org>"
+pkgname=usb-signaller
+pkgver=0.4.3
+pkgrel=10
+pkgdesc="Switch between different USB gadgets"
+url="https://codeberg.org/DylanVanAssche/usb-signaller"
+arch="all"
+license="GPL-3.0-or-later"
+source="$pkgname-$pkgver.tar.gz::https://codeberg.org/DylanVanAssche/usb-signaller/archive/v$pkgver.tar.gz
+	usb-signaller.initd
+	0001-main-keep-the-host-role-picked-by-the-Type-C-port-co.patch
+"
+makedepends="cargo-auditable eudev-dev"
+subpackages="$pkgname-systemd $pkgname-openrc"
+options="net"
+builddir="$srcdir/$pkgname"
+
+prepare() {
+	default_prepare
+	cargo fetch --target="$CHOST" --locked
+}
+
+build() {
+	cargo auditable build --release --frozen
+}
+
+check() {
+	cargo test --frozen
+}
+
+package() {
+	install -Dm755 target/release/usb-signaller "$pkgdir"/usr/bin/usb-signaller
+
+	# Init service files
+	for f in "$srcdir"/usb-signaller.initd distro/openrc/*.initd; do
+		install -Dm755 "$f" "$pkgdir"/etc/init.d/"$(basename "$f" .initd)"
+	done
+
+	for f in *.service distro/systemd/*.service; do
+		install -Dm644 "$f" "$pkgdir"/usr/lib/systemd/system/"$(basename "$f")"
+	done
+
+	for f in distro/scripts/*.sh; do
+		# service scripts/units expect no .sh extension
+		install -Dm755 "$f" "$pkgdir"/usr/bin/"$(basename "$f" .sh)"
+	done
+
+	# DBus policy
+	install -Dm644 com.meego.usb_moded.conf -t "$pkgdir"/usr/share/dbus-1/system.d/
+}
+
+sha512sums="
+10be75cccb2fa02bb818c2d02e57067b4bb9405041b0989537e0ecc53b9917e7bdc5ada4666a1cff3fa8e3f3c4593535ecf5470db86c6822b9b049d871f539dd  usb-signaller-0.4.3.tar.gz
+39d604f91a8cb5bdb358fda05902a67de6403b99e5cba8d094b18f463cc1520cf80a43e2a60acf7fcfff85b9d4b0c57f64cedba8d080acd2f809b0c699683490  usb-signaller.initd
+33220b055ccf5068aa2c4165bae4f9e0cee3d8c10588b8f97ba83e9049012e84ec54d89c51bd4222d8e73202622eae6f06b5b82ba6f5dca6251e382c7f81205b  0001-main-keep-the-host-role-picked-by-the-Type-C-port-co.patch
+"
