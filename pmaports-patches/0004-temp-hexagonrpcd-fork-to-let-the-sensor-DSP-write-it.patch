+ 	return 0;
+ }
+ 
++static uint32_t apps_std_fwrite(void *data,
++				const struct fastrpc_io_buffer *inbufs,
++				struct fastrpc_io_buffer *outbufs)
++{
++	struct apps_std_ctx *ctx = data;
++	const uint32_t *fd = inbufs[0].p;
++	struct {
++		uint32_t written;
++		uint32_t is_eof;
++	} *first_out = outbufs[0].p;
++	ssize_t ret;
++
++	ret = hexagonfs_write(ctx->fds, *fd, inbufs[1].s, inbufs[1].p);
++	if (ret < 0) {
++		fprintf(stderr, "Could not write file: %s\n", strerror(-ret));
++		return AEE_EFAILED;
++	}
++
++#ifdef HEXAGONRPC_VERBOSE
++	printf("write(%u, %u) -> %ld\n", *fd, inbufs[1].s, ret);
++#endif
++
++	first_out->written = ret;
++	first_out->is_eof = 0;
++
++	return 0;
++}
++
+ static uint32_t apps_std_fseek(void *data,
+ 			       const struct fastrpc_io_buffer *inbufs,
+ 			       struct fastrpc_io_buffer *outbufs)
+@@ -150,14 +179,32 @@ static uint32_t apps_std_fseek(void *data,
+ 	return 0;
+ }
+ 
++/*
++ * Convert a fopen(3) mode string to open(2) flags.
++ */
++static int apps_std_mode_to_flags(const char *mode)
++{
++	int rw = strchr(mode, '+') != NULL ? O_RDWR : O_WRONLY;
++
++	switch (mode[0]) {
++		case 'r':
++			return rw == O_RDWR ? O_RDWR : O_RDONLY;
++		case 'w':
++			return rw | O_CREAT | O_TRUNC;
++		case 'a':
++			return rw | O_CREAT | O_APPEND;
++		default:
++			return -1;
++	}
++}
++
