+# Contributor: Dylan Van Assche <dylan@postmarketos.org>
+# Local build of the official hexagonrpc v0.5.0 (Alpine still ships 0.4.0),
+# adds the sscregistrygen tool in a -tools subpackage.
+pkgname=hexagonrpcd
+pkgver=0.5.0
+pkgrel=3
+pkgdesc="Qualcomm HexagonFS daemon"
+url="https://github.com/linux-msm/hexagonrpc"
+arch="aarch64"
+license="GPL-3.0-or-later"
+makedepends="linux-headers meson json-c-dev"
+install="$pkgname.pre-install"
+subpackages="$pkgname-doc $pkgname-openrc $pkgname-systemd $pkgname-udev $pkgname-tools:tools"
+source="$pkgname-$pkgver.tar.gz::https://github.com/linux-msm/hexagonrpc/archive/refs/tags/v$pkgver.tar.gz
+	10-fastrpc.rules
+	$pkgname-adsp-rootpd.initd
+	$pkgname-adsp-sensorspd.initd
+	$pkgname-sdsp.initd
+	serve-sns-reg-version.patch
+	0001-hexagonrpcd-listener-fetch-input-buffers-larger-than.patch
+	0002-hexagonrpcd-listener-dispatch-method-IDs-above-30.patch
+	0003-hexagonfs-add-writable-mapped-directories.patch
+	0004-hexagonrpcd-support-writing-files-in-a-writable-pers.patch
+	"
+builddir="$srcdir/hexagonrpc-$pkgver"
+options="!check"
+
+build() {
+	abuild-meson . output
+	meson compile -C output
+}
+
+package() {
+	DESTDIR="$pkgdir" meson install --no-rebuild -C output
+	install -Dm644 "$srcdir"/10-fastrpc.rules -t "$pkgdir"/usr/lib/udev/rules.d/
+	install -Dm755 "$srcdir"/$pkgname-adsp-rootpd.initd "$pkgdir"/etc/init.d/$pkgname-adsp-rootpd
+	install -Dm755 "$srcdir"/$pkgname-adsp-sensorspd.initd "$pkgdir"/etc/init.d/$pkgname-adsp-sensorspd
+	install -Dm755 "$srcdir"/$pkgname-sdsp.initd "$pkgdir"/etc/init.d/$pkgname-sdsp
+}
+
+tools() {
+	pkgdesc="hexagonrpc tools (sscregistrygen)"
+	install -Dm755 "$builddir"/output/tools/sscregistrygen -t "$subpkgdir"/usr/bin/
+}
