 e1987069678d09858f8d70778de36981859d220183b2ed985802523a2a64f4aa2d16b4aec9545dfe0db1617b3a6be33f6394351868e6be76d5ab0f0fde507993  0158-drm-msm-dp-hold-one-runtime-PM-reference-per-plugged.patch
 c411ed2ef555dbdfa62f73b744c7a98160de4a12d136431e197ab4acd1bf3fdb99ea1602d87476873df36ac248298a25d3a2d3ece9566c4f8ebcdf4887bcf054  0159-drm-msm-dp-request-a-peripheral-flush-for-RGB-VSC-an.patch
