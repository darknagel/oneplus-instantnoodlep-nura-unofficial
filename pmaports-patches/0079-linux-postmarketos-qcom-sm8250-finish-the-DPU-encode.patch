 4 files changed, 247 insertions(+), 1 deletion(-)
 create mode 100644 device/testing/linux-postmarketos-qcom-sm8250/0161-drm-msm-dpu-reset-unassigned-resource-slots-to-NULL-.patch
 create mode 100644 device/testing/linux-postmarketos-qcom-sm8250/0162-drm-msm-dpu-Match-setup_dither-cleanup-to-the-way-it.patch
 create mode 100644 device/testing/linux-postmarketos-qcom-sm8250/0163-drm-msm-dpu-on-SM8250-pair-DSC-blocks-only-with-the-.patch

diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0161-drm-msm-dpu-reset-unassigned-resource-slots-to-NULL-.patch b/device/testing/linux-postmarketos-qcom-sm8250/0161-drm-msm-dpu-reset-unassigned-resource-slots-to-NULL-.patch
new file mode 100644
index 0000000000..9b9b4451f0
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0161-drm-msm-dpu-reset-unassigned-resource-slots-to-NULL-.patch
@@ -0,0 +1,72 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Xi Zhang <xz.ca.cn@gmail.com>
+Date: Mon, 26 Oct 2026 17:25:42 -0300
+Subject: [PATCH] drm/msm/dpu: reset unassigned resource slots to NULL on
+ topology update
+
+While this is not currently the case, it may be possible that topology
+for cwb and dsc resource requirements change between mode set in the
+future.
+
+e.g. when dsc support is added to DisplayPort, dsc may be optionally
+enabled and disabled between different modes due to
+bandwidth requirements.
+
+Set unassigned resource slots to NULL on topology update to avoid
+issues in the future. It's good practice to do so anyway.
+
+Link: https://lore.kernel.org/r/20261026-msm-dpu-res-clean-v2-1-3d864435186e@gmail.com
+Signed-off-by: Xi Zhang <xz.ca.cn@gmail.com>
+---
+ drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c | 22 ++++++++++++++-------
+ 1 file changed, 15 insertions(+), 7 deletions(-)
+
+diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
+index 7d3e7c7..cb05d9f 100644
+--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
++++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
+@@ -1217,9 +1217,13 @@ static void dpu_encoder_virt_atomic_mode_set(struct drm_encoder *drm_enc,
+ 						       ARRAY_SIZE(hw_pp));
+ 	}
+ 
+-	for (i = 0; i < num_cwb; i++) {
+-		dpu_enc->hw_cwb[i] = to_dpu_hw_cwb(hw_cwb[i]);
+-		cwb_mask |= BIT(dpu_enc->hw_cwb[i]->idx - CWB_0);
++	for (i = 0; i < ARRAY_SIZE(dpu_enc->hw_cwb); i++) {
++		if (i < num_cwb) {
++			dpu_enc->hw_cwb[i] = to_dpu_hw_cwb(hw_cwb[i]);
++			cwb_mask |= BIT(dpu_enc->hw_cwb[i]->idx - CWB_0);
++		} else {
++			dpu_enc->hw_cwb[i] = NULL;
++		}
+ 	}
+ 
+ 	dpu_enc->cwb_mask = cwb_mask;
+@@ -1227,16 +1231,20 @@ static void dpu_encoder_virt_atomic_mode_set(struct drm_encoder *drm_enc,
+ 	num_ctl = dpu_rm_get_assigned_resources(&dpu_kms->rm, global_state,
+ 		drm_enc->crtc, DPU_HW_BLK_CTL, hw_ctl, ARRAY_SIZE(hw_ctl));
+ 
+-	for (i = 0; i < MAX_CHANNELS_PER_ENC; i++)
++	for (i = 0; i < ARRAY_SIZE(dpu_enc->hw_pp); i++)
+ 		dpu_enc->hw_pp[i] = i < num_pp ? to_dpu_hw_pingpong(hw_pp[i])
+ 						: NULL;
+ 
+ 	num_dsc = dpu_rm_get_assigned_resources(&dpu_kms->rm, global_state,
+ 						drm_enc->crtc, DPU_HW_BLK_DSC,
+ 						hw_dsc, ARRAY_SIZE(hw_dsc));
+-	for (i = 0; i < num_dsc; i++) {
+-		dpu_enc->hw_dsc[i] = to_dpu_hw_dsc(hw_dsc[i]);
+-		dsc_mask |= BIT(dpu_enc->hw_dsc[i]->idx - DSC_0);
++	for (i = 0; i < ARRAY_SIZE(dpu_enc->hw_dsc); i++) {
++		if (i < num_dsc) {
++			dpu_enc->hw_dsc[i] = to_dpu_hw_dsc(hw_dsc[i]);
++			dsc_mask |= BIT(dpu_enc->hw_dsc[i]->idx - DSC_0);
++		} else {
++			dpu_enc->hw_dsc[i] = NULL;
++		}
+ 	}
+ 
+ 	dpu_enc->dsc_mask = dsc_mask;
+-- 
+2.51.2
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0162-drm-msm-dpu-Match-setup_dither-cleanup-to-the-way-it.patch b/device/testing/linux-postmarketos-qcom-sm8250/0162-drm-msm-dpu-Match-setup_dither-cleanup-to-the-way-it.patch
new file mode 100644
index 0000000000..6da17f56f6
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0162-drm-msm-dpu-Match-setup_dither-cleanup-to-the-way-it.patch
@@ -0,0 +1,44 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Xi Zhang <xz.ca.cn@gmail.com>
+Date: Mon, 26 Oct 2026 17:25:45 -0300
+Subject: [PATCH] drm/msm/dpu: Match setup_dither cleanup to the way it was set
+ up
+
+Cleanup hw_pp->ops.setup_dither with NULL for all PINGPONGs,
+matching the way it was setup during enable.
+
+Link: https://lore.kernel.org/r/20261026-msm-dpu-res-clean-v2-4-3d864435186e@gmail.com
+Signed-off-by: Xi Zhang <xz.ca.cn@gmail.com>
+---
+ drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c | 8 +++++---
+ 1 file changed, 5 insertions(+), 3 deletions(-)
+
+diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
+index cb05d9f..1ef969b 100644
+--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
++++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
+@@ -1321,7 +1321,7 @@ static void _dpu_encoder_virt_enable_helper(struct drm_encoder *drm_enc)
+ 	if (dpu_enc->disp_info.intf_type == INTF_DSI &&
+ 			!WARN_ON(dpu_enc->num_phys_encs == 0)) {
+ 		unsigned bpc = dpu_enc->connector->display_info.bpc;
+-		for (i = 0; i < MAX_CHANNELS_PER_ENC; i++) {
++		for (i = 0; i < ARRAY_SIZE(dpu_enc->hw_pp); i++) {
+ 			if (!dpu_enc->hw_pp[i])
+ 				continue;
+ 			_dpu_encoder_setup_dither(dpu_enc->hw_pp[i], bpc);
+@@ -2309,8 +2309,10 @@ void dpu_encoder_helper_phys_cleanup(struct dpu_encoder_phys *phys_enc)
+ 		}
+ 	}
+ 
+-	if (phys_enc->hw_pp && phys_enc->hw_pp->ops.setup_dither)
+-		phys_enc->hw_pp->ops.setup_dither(phys_enc->hw_pp, NULL);
++	if (dpu_enc->disp_info.intf_type == INTF_DSI)
++		for (i = 0; i < ARRAY_SIZE(dpu_enc->hw_pp); i++)
++			if (dpu_enc->hw_pp[i] && dpu_enc->hw_pp[i]->ops.setup_dither)
++				dpu_enc->hw_pp[i]->ops.setup_dither(dpu_enc->hw_pp[i], NULL);
+ 
+ 	if (dpu_enc->cwb_mask)
+ 		dpu_encoder_helper_phys_setup_cwb(phys_enc, false);
+-- 
+2.51.2
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0163-drm-msm-dpu-on-SM8250-pair-DSC-blocks-only-with-the-.patch b/device/testing/linux-postmarketos-qcom-sm8250/0163-drm-msm-dpu-on-SM8250-pair-DSC-blocks-only-with-the-.patch
new file mode 100644
index 0000000000..8d40b07eac
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0163-drm-msm-dpu-on-SM8250-pair-DSC-blocks-only-with-the-.patch
@@ -0,0 +1,124 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Sat, 14 Nov 2026 16:40:00 +0000
+Subject: [PATCH] drm/msm/dpu: on SM8250, pair DSC blocks only with the
+ pingpong of their index
+
+On SM8250 (DPU 6.0) the command-mode DSI panel of the OnePlus 8 Pro uses
+two DSC blocks in merge mode. When DisplayPort still holds PINGPONG_0/1
+in the commit that moves the picture back to the panel, the panel's CRTC
+gets LM_2/LM_3 and PINGPONG_2/3, and the even/odd rule pairs them with
+DSC_0/DSC_1 through the DSC_CTL mux. The panel then completes one frame
+after each CTL reset and none after it: every following kickoff times out
+on PINGPONG_2 and the panel stays grey.
+
+Pair DSC n only with PINGPONG n on DPU 6.0. The same commit then gets
+DSC_2/DSC_3, and the panel runs without a kickoff timeout. Whether the
+DSC_CTL mux cannot route the output of these DSC blocks to another
+pingpong, or the driver programs it wrongly, is not known, and no other
+DPU version was tested, so the others keep the even/odd rule. On DPU 6.0
+the single-DSC allocator now goes on to the next DSC block when one does
+not fit the pingpong, instead of failing the reservation.
+
+Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
+---
+ drivers/gpu/drm/msm/disp/dpu1/dpu_rm.c | 25 ++++++++++++++++++++-----
+ drivers/gpu/drm/msm/disp/dpu1/dpu_rm.h |  2 ++
+ 2 files changed, 22 insertions(+), 5 deletions(-)
+
+diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_rm.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_rm.c
+index 7e77d88..ab7d93f 100644
+--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_rm.c
++++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_rm.c
+@@ -54,6 +54,8 @@ int dpu_rm_init(struct drm_device *dev,
+ 	memset(rm, 0, sizeof(*rm));
+ 
+ 	rm->has_legacy_ctls = (cat->mdss_ver->core_major_ver < 5);
++	rm->dsc_pp_same_index = (cat->mdss_ver->core_major_ver == 6 &&
++				 cat->mdss_ver->core_minor_ver == 0);
+ 
+ 	/* Interrogate HW catalog and create tracking items for hw blocks */
+ 	for (i = 0; i < cat->mixer_count; i++) {
+@@ -504,8 +506,15 @@ static int _dpu_rm_pingpong_next_index(struct dpu_global_state *global_state,
+ 	return -ENAVAIL;
+ }
+ 
+-static int _dpu_rm_pingpong_dsc_check(int dsc_idx, int pp_idx)
++static int _dpu_rm_pingpong_dsc_check(struct dpu_rm *rm, int dsc_idx, int pp_idx)
+ {
++	/*
++	 * On SM8250 (DPU 6.0) a DSC fed from another PINGPONG through the
++	 * DSC_CTL mux gave the command-mode panel no frames after the first one.
++	 */
++	if (rm->dsc_pp_same_index)
++		return dsc_idx == pp_idx ? 0 : -ENAVAIL;
++
+ 	/*
+ 	 * DSC with even index must be used with the PINGPONG with even index
+ 	 * DSC with odd index must be used with the PINGPONG with odd index
+@@ -538,9 +547,13 @@ static int _dpu_rm_dsc_alloc(struct dpu_rm *rm,
+ 		if (pp_idx < 0)
+ 			return -ENAVAIL;
+ 
+-		ret = _dpu_rm_pingpong_dsc_check(dsc_idx, pp_idx);
+-		if (ret)
++		ret = _dpu_rm_pingpong_dsc_check(rm, dsc_idx, pp_idx);
++		if (ret) {
++			/* Leave pp_idx for the DSC of its own index. */
++			if (rm->dsc_pp_same_index)
++				continue;
+ 			return -ENAVAIL;
++		}
+ 
+ 		global_state->dsc_to_crtc_id[dsc_idx] = crtc_id;
+ 		num_dsc++;
+@@ -581,7 +594,7 @@ static int _dpu_rm_dsc_alloc_pair(struct dpu_rm *rm,
+ 		if (pp_idx < 0)
+ 			return -ENAVAIL;
+ 
+-		ret = _dpu_rm_pingpong_dsc_check(dsc_idx, pp_idx);
++		ret = _dpu_rm_pingpong_dsc_check(rm, dsc_idx, pp_idx);
+ 		if (ret) {
+ 			pp_idx = 0;
+ 			continue;
+@@ -591,7 +604,7 @@ static int _dpu_rm_dsc_alloc_pair(struct dpu_rm *rm,
+ 		if (pp_idx < 0)
+ 			return -ENAVAIL;
+ 
+-		ret = _dpu_rm_pingpong_dsc_check(dsc_idx + 1, pp_idx);
++		ret = _dpu_rm_pingpong_dsc_check(rm, dsc_idx + 1, pp_idx);
+ 		if (ret) {
+ 			pp_idx = 0;
+ 			continue;
+@@ -626,6 +639,8 @@ static int _dpu_rm_reserve_dsc(struct dpu_rm *rm,
+ 	 * 2) DSC pair starts from even index, such as index(0,1), (2,3), etc
+ 	 * 3) even PINGPONG connects to even DSC
+ 	 * 4) odd PINGPONG connects to odd DSC
++	 *    (on DPU 6.0 only the DSC of the same index, see
++	 *    _dpu_rm_pingpong_dsc_check())
+ 	 * 5) pair: encoder +--> pp_idx_0 --> dsc_idx_0
+ 	 *                  +--> pp_idx_1 --> dsc_idx_1
+ 	 */
+diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_rm.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_rm.h
+index ccd6440..4981d63 100644
+--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_rm.h
++++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_rm.h
+@@ -25,6 +25,7 @@ struct dpu_global_state;
+  * @hw_sspp: array of sspp hardware resources
+  * @cdm_blk: cdm hardware resource
+  * @has_legacy_ctls: DPU uses pre-ACTIVE CTL blocks.
++ * @dsc_pp_same_index: pair DSC blocks only with the PINGPONG of the same index (DPU 6.0).
+  */
+ struct dpu_rm {
+ 	struct dpu_hw_blk *pingpong_blks[PINGPONG_MAX - PINGPONG_0];
+@@ -39,6 +40,7 @@ struct dpu_rm {
+ 	struct dpu_hw_sspp *hw_sspp[SSPP_MAX - SSPP_NONE];
+ 	struct dpu_hw_blk *cdm_blk;
+ 	bool has_legacy_ctls;
++	bool dsc_pp_same_index;
+ };
+ 
+ struct dpu_rm_sspp_requirements {
+-- 
+2.51.2
+
