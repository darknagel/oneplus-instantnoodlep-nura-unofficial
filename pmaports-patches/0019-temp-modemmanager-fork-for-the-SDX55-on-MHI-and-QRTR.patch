diff --git a/temp/modemmanager/0001-intel-XMM7360-fix-big-endian-handling-of-ASN-integer.patch b/temp/modemmanager/0001-intel-XMM7360-fix-big-endian-handling-of-ASN-integer.patch
new file mode 100644
index 0000000000..894fc55b54
--- /dev/null
+++ b/temp/modemmanager/0001-intel-XMM7360-fix-big-endian-handling-of-ASN-integer.patch
@@ -0,0 +1,42 @@
+From 4b936ada44a0f6ccb02745e9452c2b4b2412341c Mon Sep 17 00:00:00 2001
+From: Aelin <aelin@postmarketos.org>
+Date: Thu, 11 Jun 2026 22:01:36 +0200
+Subject: [PATCH] intel: XMM7360: fix big-endian handling of ASN integer output
+
+xmm7360_byte_array_read_asn_int() previously always returned
+*out_val from the union member `value.l`, regardless of the actual
+integer size. On big-endian systems, this caused 1-byte or 2-byte
+values to be shifted incorrectly (e.g., 1-byte value 0x01 became
+0x01000000).
+
+Fix this by selecting the union member that matches the ASN int type.
+---
+ src/plugins/intel/mm-xmmrpc-xmm7360-protocol.c | 12 ++++--------
+ 1 file changed, 4 insertions(+), 8 deletions(-)
+
+diff --git a/src/plugins/intel/mm-xmmrpc-xmm7360-protocol.c b/src/plugins/intel/mm-xmmrpc-xmm7360-protocol.c
+index dcf16280..82db189c 100644
+--- a/src/plugins/intel/mm-xmmrpc-xmm7360-protocol.c
++++ b/src/plugins/intel/mm-xmmrpc-xmm7360-protocol.c
+@@ -115,14 +115,10 @@ xmm7360_byte_array_read_asn_int (GByteArray        *buf,
+         *out_arg = arg;
+ 
+     if (out_val) {
+-        /* If the ASN int is negative, we must convert a int8/int16
+-         * value to the appropriate u32 value to avoid returning a
+-         * positive 32-bit gint.
+-         */
+-        if ((arg.type == XMM7360_RPC_MSG_ARG_TYPE_BYTE) && (arg.value.b < 0))
+-            *out_val = (arg.value.b << 24) >> 24;
+-        else if ((arg.type == XMM7360_RPC_MSG_ARG_TYPE_SHORT) && (arg.value.s < 0))
+-            *out_val = (arg.value.s << 16) >> 16;
++        if (arg.type == XMM7360_RPC_MSG_ARG_TYPE_BYTE)
++            *out_val = arg.value.b;
++        else if (arg.type == XMM7360_RPC_MSG_ARG_TYPE_SHORT)
++            *out_val = arg.value.s;
+         else
+             *out_val = arg.value.l;
+     }
+-- 
+2.54.0
+
diff --git a/temp/modemmanager/0002-shared-qmi-do-not-abort-on-location-setup-after-unlock.patch b/temp/modemmanager/0002-shared-qmi-do-not-abort-on-location-setup-after-unlock.patch
new file mode 100644
index 0000000000..d0575d9092
--- /dev/null
+++ b/temp/modemmanager/0002-shared-qmi-do-not-abort-on-location-setup-after-unlock.patch
@@ -0,0 +1,44 @@
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Subject: [PATCH] shared-qmi: do not abort on location setup after SIM unlock
+
+The location interface is initialized a second time after a SIM PIN unlock.
+The inject request signals are then already connected and the assertion
+aborts ModemManager.
+
+Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
+---
+--- a/src/mm-shared-qmi.c
++++ b/src/mm-shared-qmi.c
+@@ -7065,19 +7065,20 @@
+         goto out;
+     }
+ 
+-    g_assert (!priv->loc_assistance_inject_time_req_indication_id);
+-    priv->loc_assistance_inject_time_req_indication_id =
+-        g_signal_connect (client,
+-                          "inject-time-request",
+-                          G_CALLBACK (loc_location_inject_time_req_indication_cb),
+-                          self);
++    /* The location interface is initialized again after a SIM PIN unlock */
++    if (!priv->loc_assistance_inject_time_req_indication_id)
++        priv->loc_assistance_inject_time_req_indication_id =
++            g_signal_connect (client,
++                              "inject-time-request",
++                              G_CALLBACK (loc_location_inject_time_req_indication_cb),
++                              self);
+ 
+-    g_assert (!priv->loc_assistance_inject_position_req_indication_id);
+-    priv->loc_assistance_inject_position_req_indication_id =
+-        g_signal_connect (client,
+-                          "inject-position-request",
+-                          G_CALLBACK (loc_location_inject_position_req_indication_cb),
+-                          self);
++    if (!priv->loc_assistance_inject_position_req_indication_id)
++        priv->loc_assistance_inject_position_req_indication_id =
++            g_signal_connect (client,
++                              "inject-position-request",
++                              G_CALLBACK (loc_location_inject_position_req_indication_cb),
++                              self);
+ 
+ out:
+     g_task_return_int (task, MM_MODEM_LOCATION_ASSISTANCE_DATA_TYPE_XTRA);
diff --git a/temp/modemmanager/0003-qcom-soc-support-mhi_net-data-ports.patch b/temp/modemmanager/0003-qcom-soc-support-mhi_net-data-ports.patch
new file mode 100644
index 0000000000..e8633a311b
--- /dev/null
+++ b/temp/modemmanager/0003-qcom-soc-support-mhi_net-data-ports.patch
@@ -0,0 +1,85 @@
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Subject: [PATCH] qcom-soc: support mhi_net data ports
+
+An SDX55 on MHI exposes its QMI services over QRTR, which puts it in this
+plugin, while the data port uses mhi_net. Use the PCIe endpoint for it and
+bind the WDS clients to the data port, Start Network otherwise fails with
+InvalidOperation.
+
+Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
+---
+--- a/src/plugins/qcom-soc/mm-broadband-modem-qmi-qcom-soc.c
++++ b/src/plugins/qcom-soc/mm-broadband-modem-qmi-qcom-soc.c
+@@ -111,6 +111,34 @@
+ }
+ 
+ static MMPortQmi *
++peek_port_qmi_for_data_mhi (MMBroadbandModemQmi  *self,
++                            MMPort               *data,
++                            MMQmiDataEndpoint    *out_endpoint,
++                            GError              **error)
++{
++    MMPortQmi *found = NULL;
++
++    /* A modem on MHI with QMI over QRTR: any QMI port manages the network
++     * interface, and the data port is not implied by the control channel */
++
++    found = mm_broadband_modem_qmi_peek_port_qmi (self);
++
++    if (!found)
++        g_set_error (error,
++                     MM_CORE_ERROR,
++                     MM_CORE_ERROR_NOT_FOUND,
++                     "Couldn't find any QMI port for 'net/%s'",
++                     mm_port_get_device (data));
++    else if (out_endpoint) {
++        out_endpoint->type = QMI_DATA_ENDPOINT_TYPE_PCIE;
++        out_endpoint->interface_number = 4;
++        out_endpoint->sio_port = QMI_SIO_PORT_NONE;
++    }
++
++    return found;
++}
++
++static MMPortQmi *
+ peek_port_qmi_for_data (MMBroadbandModemQmi  *self,
+                         MMPort               *data,
+                         MMQmiDataEndpoint    *out_endpoint,
+@@ -131,6 +159,9 @@
+     if (g_strcmp0 (net_port_driver, "bam-dmux") == 0)
+         return peek_port_qmi_for_data_bam_dmux (self, data, out_endpoint, error);
+ 
++    if (g_strcmp0 (net_port_driver, "mhi_net") == 0)
++        return peek_port_qmi_for_data_mhi (self, data, out_endpoint, error);
++
+     g_set_error (error,
+                  MM_CORE_ERROR,
+                  MM_CORE_ERROR_FAILED,
+--- a/src/mm-bearer-qmi.c
++++ b/src/mm-bearer-qmi.c
+@@ -2082,8 +2082,10 @@
+             return;
+         }
+ 
+-        /* If mux id given, bind mux data port */
+-        if (ctx->sio_port_failed || ctx->mux_id != QMI_DEVICE_MUX_ID_UNBOUND) {
++        /* If mux id given, bind mux data port. Over QRTR the client has no
++         * data port of its own, so it needs this even without multiplexing. */
++        if (ctx->sio_port_failed || ctx->mux_id != QMI_DEVICE_MUX_ID_UNBOUND ||
++            mm_port_get_subsys (MM_PORT (ctx->qmi)) == MM_PORT_SUBSYS_QRTR) {
+             g_autoptr(QmiMessageWdsBindMuxDataPortInput) input = NULL;
+ 
+             mm_obj_dbg (self, "binding to mux id %d", ctx->mux_id);
+@@ -2227,8 +2229,10 @@
+             return;
+         }
+ 
+-        /* If mux id given, bind mux data port */
+-        if (ctx->sio_port_failed || ctx->mux_id != QMI_DEVICE_MUX_ID_UNBOUND) {
++        /* If mux id given, bind mux data port. Over QRTR the client has no
++         * data port of its own, so it needs this even without multiplexing. */
++        if (ctx->sio_port_failed || ctx->mux_id != QMI_DEVICE_MUX_ID_UNBOUND ||
++            mm_port_get_subsys (MM_PORT (ctx->qmi)) == MM_PORT_SUBSYS_QRTR) {
+             g_autoptr(QmiMessageWdsBindMuxDataPortInput) input = NULL;
+ 
+             mm_obj_dbg (self, "binding to mux id %d", ctx->mux_id);
