+-	stats.sum_.r() += sumR;     \
+-	stats.sum_.g() += sumG;     \
+-	stats.sum_.b() += sumB;     \
+-	stats.numPixels_ += nSamples;
++#define SWSTATS_FINISH_LINE_STATS()  \
++	stats.sum_.r() += sumR;      \
++	stats.sum_.g() += sumG;      \
++	stats.sum_.b() += sumB;      \
