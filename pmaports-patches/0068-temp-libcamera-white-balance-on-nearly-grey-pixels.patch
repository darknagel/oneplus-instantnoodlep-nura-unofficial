++void SwStatsCpu::setGreyReference(const RGB<double> &gains, double blackLevel)
++{
++	const double g = gains.g() > 0.0 ? gains.g() : 1.0;
++
++	greyGainR_ = static_cast<unsigned int>(std::clamp(gains.r() / g, 0.0, 16.0) * 256);
