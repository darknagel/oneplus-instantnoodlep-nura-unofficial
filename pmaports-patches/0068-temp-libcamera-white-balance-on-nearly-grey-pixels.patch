++++ b/include/libcamera/internal/software_isp/swisp_stats.h
+@@ -44,6 +44,19 @@ struct SwIspStats {
+ 	 * \brief Number of unsaturated pixels accumulated in \a sum_
+ 	 */
+ 	uint64_t numPixels_;
++	/**
++	 * \brief Sums of colour channels of the unsaturated pixels that look
++	 * nearly grey with the white balance gains of the frame
++	 *
++	 * Large coloured areas pull a plain grey world white balance towards
++	 * their complementary colour. Pixels that are nearly neutral already
++	 * are a better reference for the illuminant.
++	 */
++	RGB<uint64_t> greySum_;
++	/**
++	 * \brief Number of pixels accumulated in \a greySum_
++	 */
++	uint64_t greyPixels_;
+ 	/**
+ 	 * \brief Number of bins in the yHistogram
+ 	 */
