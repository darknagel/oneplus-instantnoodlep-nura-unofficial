++/*
++ * A pixel counts as nearly grey for the white balance when its red and blue
++ * values, with the current white balance gains applied, are within this
++ * fraction (1.0 = 256) of its green value.
++ */
++static constexpr int kGreyTolerance = 64; /* 0.25 * 256 */
++
+ static constexpr unsigned int kRedYMul = 77; /* 0.299 * 256 */
+ static constexpr unsigned int kGreenYMul = 150; /* 0.587 * 256 */
+ static constexpr unsigned int kBlueYMul = 29; /* 0.114 * 256 */
+ 
++/* Skip pixels too dark for a reliable colour, in 8-bit units */
++static constexpr int kGreyMinGreen = 8;
++
++#define SWSTATS_ACCUMULATE_GREY(div)                                        \
++	{                                                                   \
++		const int black = greyBlack_ * (div);                       \
++		const int gg = static_cast<int>(g) - black;                 \
++		if (gg > kGreyMinGreen * (div)) {                           \
++			const int rr = ((static_cast<int>(r) - black) *     \
++					static_cast<int>(greyGainR_)) >> 8; \
++			const int bb = ((static_cast<int>(b) - black) *     \
++					static_cast<int>(greyGainB_)) >> 8; \
++			const int tol = (gg * kGreyTolerance) >> 8;         \
++			if (abs(rr - gg) < tol && abs(bb - gg) < tol) {     \
++				greyR += r;                                 \
++				greyG += g;                                 \
++				greyB += b;                                 \
++				nGrey++;                                    \
++			}                                                   \
++		}                                                           \
++	}
++
