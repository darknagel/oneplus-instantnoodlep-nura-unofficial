+ 	pixel_t r, g, g2, b;              \
+ 	uint64_t yVal;                    \
+@@ -198,7 +228,11 @@ static constexpr unsigned int kBlueYMul = 29; /* 0.114 * 256 */
+ 	uint64_t sumR = 0;                \
