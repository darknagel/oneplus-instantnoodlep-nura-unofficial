+	0065-arm64-dts-qcom-sm8250-oneplus-instantnoodlep-Fix-MMC5603-orientation.patch
 "
 builddir="$srcdir/linux-$_tag"
 
@@ -213,4 +214,5 @@ e1da3546326a1cfa5d66d8292ba363525e756ebd4d14c1d78776dbb0661d7bd0eacb9dfe01d4b65f
