 320bb9712cb872fb376e041fa0c3f2c126958cd6c70f4e881d7e614af5046c7646570e5e0117c8393effc5bb409def875965f188aea9a9a0a441696a2394da24  0063-media-i2c-lc898128-Start-only-once-the-camera-stays-.patch
 b07c37ddbe5df4bf69ca9209de22563ee5283b26ea13198fa85dc0297f5ecce11abf33d8700c37e4dbfa39efb64005c14ad1e0da18c4e40cfd5e4a02ef0a670d  0064-net-qrtr-accept-forwarded-client-deletions.patch
+876f054b7914ae3a4b1cd3b81b2f1046664171d868f72550f6b8993d3fcfb1dab4ae8184ab5813b2fbde119fd4b66d34a7dd0aecd4092d977e5458d7bc865196  0065-arm64-dts-qcom-sm8250-oneplus-instantnoodlep-Fix-MMC5603-orientation.patch
