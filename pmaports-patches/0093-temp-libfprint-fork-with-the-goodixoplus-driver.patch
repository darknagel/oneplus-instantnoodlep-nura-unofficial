++  GError *e = NULL;
++  g_autofree struct op_result *res = g_task_propagate_pointer (G_TASK (r), &e);
++  FpPrint *print = NULL;
++
++  if (!res)
++    {
++      fpi_device_enroll_complete (FP_DEVICE (o), NULL, e);
++      return;
++    }
++  fpi_device_get_enroll_data (FP_DEVICE (o), &print);
++  make_print (self, print, res->finger_id);
