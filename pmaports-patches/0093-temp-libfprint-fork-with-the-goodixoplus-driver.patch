+# Maintainer: Timo <1788603+darknagel@users.noreply.github.com>
+# Fork of community/libfprint: Dawid Wrobel's QSEE branch plus the
+# goodixoplus driver for the OnePlus 8 Pro in-display sensor.
+pkgname=libfprint
+pkgver=1.94.100_git20261116
+pkgrel=0
+_commit=430e24e538ba137b6edcfe2e1b3b8cc29c66fa6a
+pkgdesc="Library for fingerprint readers (with the Oplus Goodix QSEE driver)"
+url="https://github.com/wrobelda/libfprint"
+arch="aarch64"
+license="LGPL-2.1-or-later"
+makedepends="
+	eudev-dev
+	glib-dev
+	gobject-introspection-dev
+	libgudev-dev
+	libgusb-dev
+	meson
+	openssl-dev
+	pixman-dev
+	"
+options="!check"
+subpackages="$pkgname-dev $pkgname-udev"
+source="$pkgname-$_commit.tar.gz::https://github.com/wrobelda/libfprint/archive/$_commit.tar.gz
+	0001-goodixoplus-add-a-driver-for-the-Oplus-Goodix-optica.patch
+	"
+builddir="$srcdir/libfprint-$_commit"
+
+build() {
+	# Only this driver: goodixqsee matches the same misc device (goodix,gf3626)
+	abuild-meson \
+		-Ddrivers=goodixoplus \
+		-Dgtk-examples=false \
+		-Ddoc=false \
+		-Dudev_hwdb=disabled \
+		-Dudev_rules=disabled \
+		-Dinstalled-tests=false \
+		output
+	meson compile -C output
+}
+
+package() {
+	DESTDIR="$pkgdir" meson install -C output --no-rebuild
+}
+
+udev() {
+	pkgdesc="$pkgdesc (udev rules)"
+	install_if="$pkgname=$pkgver-r$pkgrel udev"
+	# No USB readers in this build, so no autosuspend rules; the package
+	# exists to replace community/libfprint-udev, which pins libfprint=1.94.9.
+	mkdir -p "$subpkgdir"/usr/lib/udev/rules.d
+	echo "# goodixoplus: no USB autosuspend rules needed" \
+		> "$subpkgdir"/usr/lib/udev/rules.d/60-fprint-autosuspend.rules
+}
