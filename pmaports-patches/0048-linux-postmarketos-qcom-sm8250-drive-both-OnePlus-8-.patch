From 1d898c45af0451f4fe0f5e3c179813b3a9f62b5d Mon Sep 17 00:00:00 2001
From: Timo <1788603+darknagel@users.noreply.github.com>
Date: Wed, 11 Nov 2026 18:55:02 +0100
Subject: [PATCH] linux-postmarketos-qcom-sm8250: drive both OnePlus 8 Pro
 flash channels as one LED

Kernel patch 0104: the stock camera uses both PM8150L flash channels as
one flash. One LED with both sources is also named white:flash, which
the torch switches of Plasma Mobile and Phosh look for.
---
 ...plus-instantnoodlep-Drive-both-flash.patch | 53 +++++++++++++++++++
 .../linux-postmarketos-qcom-sm8250/APKBUILD   |  4 +-
 2 files changed, 56 insertions(+), 1 deletion(-)
 create mode 100644 device/testing/linux-postmarketos-qcom-sm8250/0104-arm64-dts-qcom-sm8250-oneplus-instantnoodlep-Drive-both-flash.patch

diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0104-arm64-dts-qcom-sm8250-oneplus-instantnoodlep-Drive-both-flash.patch b/device/testing/linux-postmarketos-qcom-sm8250/0104-arm64-dts-qcom-sm8250-oneplus-instantnoodlep-Drive-both-flash.patch
new file mode 100644
index 0000000000..38619a44cc
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0104-arm64-dts-qcom-sm8250-oneplus-instantnoodlep-Drive-both-flash.patch
@@ -0,0 +1,53 @@
+From 72d0550bdbae298abe844add186ba282b947dfdd Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Tue, 10 Nov 2026 21:53:14 +0100
+Subject: [PATCH] arm64: dts: qcom: sm8250-oneplus-instantnoodlep: Drive both
+ flash channels as one LED
+
+The stock camera drives both PM8150L flash channels together for the
+one rear flash. Describe it as one LED with both sources, as stock
+does, which also gives it the name white:flash that desktop torch
+switches look for.
+---
+ .../qcom/sm8250-oneplus-instantnoodlep.dts    | 22 +++++++------------
+ 1 file changed, 8 insertions(+), 14 deletions(-)
+
+diff --git a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+index 45ab66e56..09d082e0e 100644
+--- a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
++++ b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+@@ -2407,23 +2407,17 @@ haptics_irq_default: haptics-irq-default-state {
+ &pm8150l_flash {
+ 	status = "okay";
+ 
++	/*
++	 * The stock camera drives channels 0 and 1 (mainline indices 1 and
++	 * 2) together as one flash, up to 500 mA torch and 1500 mA flash
++	 * per channel.
++	 */
+ 	led-0 {
+ 		function = LED_FUNCTION_FLASH;
+ 		color = <LED_COLOR_ID_WHITE>;
+-		function-enumerator = <0>;
+-		led-sources = <1>;
+-		led-max-microamp = <500000>;
+-		flash-max-microamp = <1500000>;
+-		flash-max-timeout-us = <1280000>;
+-	};
+-
+-	led-1 {
+-		function = LED_FUNCTION_FLASH;
+-		color = <LED_COLOR_ID_WHITE>;
+-		function-enumerator = <1>;
+-		led-sources = <2>;
+-		led-max-microamp = <500000>;
+-		flash-max-microamp = <1500000>;
++		led-sources = <1>, <2>;
++		led-max-microamp = <1000000>;
++		flash-max-microamp = <3000000>;
+ 		flash-max-timeout-us = <1280000>;
+ 	};
+ };
+-- 
+2.43.0
+
