--- a/device/testing/alsa-ucm-conf-oneplus-instantnoodlep/HiFi.conf
+++ b/device/testing/alsa-ucm-conf-oneplus-instantnoodlep/HiFi.conf
@@ -3,10 +3,12 @@ Syntax 3
 SectionVerb {
 	EnableSequence [
 		cset "name='TERT_MI2S_RX Audio Mixer MultiMedia1' 1"
+		cset "name='MultiMedia3 Mixer VA_CODEC_DMA_TX_0' 1"
 	]
 
 	DisableSequence [
 		cset "name='TERT_MI2S_RX Audio Mixer MultiMedia1' 0"
+		cset "name='MultiMedia3 Mixer VA_CODEC_DMA_TX_0' 0"
 	]
 
 	Value {
@@ -23,3 +25,35 @@ SectionDevice."Speaker" {
 		PlaybackChannels 2
 	}
 }
+
+# Digital microphones on the VA macro, as in the vendor mixer paths:
+# DMIC1 (bias 1), DMIC2 (bias 3, main microphone), DMIC3 (bias 4).
+# The decimators add 24 dB (108): speech at 30 cm peaks around -22 dBFS.
+SectionDevice."Mic" {
+	Comment "Stereo Microphones"
+
+	EnableSequence [
+		cset "name='VA_AIF1_CAP Mixer DEC0' 1"
+		cset "name='VA_AIF1_CAP Mixer DEC1' 1"
+
+		cset "name='VA DEC0 MUX' VA_DMIC"
+		cset "name='VA DEC1 MUX' VA_DMIC"
+
+		cset "name='VA DMIC MUX0' DMIC2"
+		cset "name='VA DMIC MUX1' DMIC1"
+
+		cset "name='VA_DEC0 Volume' 108"
+		cset "name='VA_DEC1 Volume' 108"
+	]
+
+	DisableSequence [
+		cset "name='VA_AIF1_CAP Mixer DEC0' 0"
+		cset "name='VA_AIF1_CAP Mixer DEC1' 0"
+	]
+
+	Value {
+		CapturePriority 100
+		CapturePCM "hw:${CardId},2"
+		CaptureChannels 2
+	}
+}
