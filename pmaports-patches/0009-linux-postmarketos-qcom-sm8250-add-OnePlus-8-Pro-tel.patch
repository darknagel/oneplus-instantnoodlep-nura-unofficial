@@ -0,0 +1,159 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Mon, 26 Oct 2026 18:26:23 +0100
+Subject: [PATCH 09/10] arm64: dts: qcom: sm8250-oneplus-instantnoodlep: Add
+ telephoto camera
+
+Enable CAMSS and CCI1 and add the Samsung S5K3M5 telephoto camera
+(slot 3 of the vendor device tree): CCI1 master 0, address 0x2d,
+CSIPHY2 with four lanes, MCLK2, reset on GPIO 90. The analog supply
+comes from an external LDO enabled by GPIO 139, the digital supply
+from PM8009 L4 (1.056 V), the I/O supply from PM8009 L7.
+
+The vendor runs MCLK at 19.2 MHz; the mainline driver expects 24 MHz,
+which the camera clock controller can provide.
+
+The vendor reports a sensor orientation of 90 degrees clockwise, which
+is a rotation of 270 degrees in the counter-clockwise convention of the
+rotation property (checked with an arrow on the screen).
+
+Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
+---
+ .../qcom/sm8250-oneplus-instantnoodlep.dts    | 100 ++++++++++++++++++
+ 1 file changed, 100 insertions(+)
+
+diff --git a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+index 06a1155bb..8911098d9 100644
+--- a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
++++ b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+@@ -242,6 +242,20 @@ ramoops@b0000000 {
+ 	};
+ 
+ 	/* Values from the vendor device tree overlay of project 19811 */
++	vreg_cam_tele_avdd: regulator-cam-tele-avdd {
++		compatible = "regulator-fixed";
++		regulator-name = "cam_tele_avdd";
++		regulator-min-microvolt = <2800000>;
++		regulator-max-microvolt = <2800000>;
++
++		gpio = <&tlmm 139 GPIO_ACTIVE_HIGH>;
++		enable-active-high;
++		vin-supply = <&vreg_bob>;
++
++		pinctrl-0 = <&cam_tele_avdd_en>;
++		pinctrl-names = "default";
++	};
++
+ 	sensor-devinfo {
+ 		compatible = "oneplus,sensor-devinfo";
+ 
+@@ -469,6 +483,13 @@ vreg_l2f_1p2: ldo2 {
+ 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+ 		};
+ 
++		vreg_l4f_1p05: ldo4 {
++			regulator-name = "vreg_l4f_1p05";
++			regulator-min-microvolt = <1056000>;
++			regulator-max-microvolt = <1056000>;
++			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
++		};
++
+ 		vreg_l6f_2p8: ldo6 {
+ 			regulator-name = "vreg_l6f_2p8";
+ 			regulator-min-microvolt = <2800000>;
+@@ -736,6 +757,62 @@ &adsp {
+ 	status = "okay";
+ };
+ 
++&camss {
++	vdda-phy-supply = <&vreg_l5a_0p88>;
++	vdda-pll-supply = <&vreg_l9a_1p2>;
++	status = "okay";
++
++	ports {
++		/* The port index is the CSIPHY id */
++		port@2 {
++			csiphy2_ep: endpoint {
++				clock-lanes = <7>;
++				data-lanes = <0 1 2 3>;
++				remote-endpoint = <&cam_tele_ep>;
++			};
++		};
++	};
++};
++
++&cci1 {
++	status = "okay";
++};
++
++&cci1_i2c0 {
++	#address-cells = <1>;
++	#size-cells = <0>;
++
++	/* Telephoto camera */
++	camera@2d {
++		compatible = "samsung,s5k3m5";
++		reg = <0x2d>;
++
++		clocks = <&camcc CAM_CC_MCLK2_CLK>;
++		assigned-clocks = <&camcc CAM_CC_MCLK2_CLK>;
++		assigned-clock-rates = <24000000>;
++
++		reset-gpios = <&tlmm 90 GPIO_ACTIVE_LOW>;
++
++		vdda-supply = <&vreg_cam_tele_avdd>;
++		vddd-supply = <&vreg_l4f_1p05>;
++		vddio-supply = <&vreg_l7f_1p8>;
++
++		pinctrl-0 = <&cam_tele_default>;
++		pinctrl-names = "default";
++
++		orientation = <1>;
++		rotation = <270>;
++
++		port {
++			cam_tele_ep: endpoint {
++				data-lanes = <1 2 3 4>;
++				link-frequencies = /bits/ 64 <602500000>;
++				remote-endpoint = <&csiphy2_ep>;
++			};
++		};
++	};
++};
++
+ &cdsp {
+ 	firmware-name = "postmarketos/cdsp.mbn";
+ 	status = "okay";
+@@ -1154,6 +1231,29 @@ wcd_default: wcd-default-state {
+ 		drive-strength = <16>;
+ 		output-low;
+ 	};
++
++	cam_tele_avdd_en: cam-tele-avdd-en-state {
++		pins = "gpio139";
++		function = "gpio";
++		drive-strength = <2>;
++		bias-disable;
++	};
++
++	cam_tele_default: cam-tele-default-state {
++		mclk-pins {
++			pins = "gpio96";
++			function = "cam_mclk";
++			drive-strength = <16>;
++			bias-disable;
++		};
++
++		rst-pins {
++			pins = "gpio90";
++			function = "gpio";
++			drive-strength = <2>;
++			bias-disable;
++		};
++	};
+ };
+ 
+ &ufs_mem_hc {
+-- 
+2.43.0
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0010-media-i2c-s5k3m5-Report-correct-selection-rectangles.patch b/device/testing/linux-postmarketos-qcom-sm8250/0010-media-i2c-s5k3m5-Report-correct-selection-rectangles.patch
new file mode 100644
index 0000000000..26e798590a
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0010-media-i2c-s5k3m5-Report-correct-selection-rectangles.patch
@@ -0,0 +1,92 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Mon, 26 Oct 2026 18:56:44 +0100
+Subject: [PATCH 10/10] media: i2c: s5k3m5: Report correct selection rectangles
+
+The crop rectangle used the mode width as height, and the driver did not
+implement V4L2_SEL_TGT_NATIVE_SIZE and V4L2_SEL_TGT_CROP_DEFAULT, which
+libcamera needs to report the pixel array:
+
+  ERROR V4L2 's5k3m5 20-002d': Unable to get rectangle 1 on pad 0/0
+  WARN CameraSensor 's5k3m5 20-002d': The PixelArrayActiveAreas property
+       has been defaulted to (0, 0)/4208x4208
+
+Report the 4208x3120 pixel array for the native size, the crop bounds
+and the default crop, and the analogue crop of the current mode for the
+crop target: the 2104x1184 mode reads rows 384 to 2751 and bins them,
+which is a 4208x2368 window starting at row 376 of the full mode.
+
+Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
+---
+ drivers/media/i2c/s5k3m5.c | 24 ++++++++++++++++++++++--
+ 1 file changed, 22 insertions(+), 2 deletions(-)
+
+diff --git a/drivers/media/i2c/s5k3m5.c b/drivers/media/i2c/s5k3m5.c
+index c591b580d..ebe200e4b 100644
+--- a/drivers/media/i2c/s5k3m5.c
++++ b/drivers/media/i2c/s5k3m5.c
+@@ -44,6 +44,9 @@
+ #define S5K3M5_VTS_MAX			0xffff
+ 
+ #define S5K3M5_REG_HTS			CCI_REG16(0x0342)
++#define S5K3M5_NATIVE_WIDTH		4208
++#define S5K3M5_NATIVE_HEIGHT		3120
++
+ #define S5K3M5_REG_X_ADDR_START		CCI_REG16(0x0344)
+ #define S5K3M5_REG_Y_ADDR_START		CCI_REG16(0x0346)
+ #define S5K3M5_REG_X_ADDR_END		CCI_REG16(0x0348)
+@@ -76,6 +79,7 @@ struct s5k3m5_mode {
+ 	u32 hts;			/* Horizontal timing size */
+ 	u32 vts;			/* Default vertical timing size */
+ 	u32 exposure;			/* Default exposure value */
++	struct v4l2_rect crop;		/* Analogue crop rectangle */
+ 
+ 	const struct s5k3m5_reg_list reg_list;	/* Sensor register setting */
+ };
+@@ -697,6 +701,12 @@ static const struct s5k3m5_mode s5k3m5_supported_modes[] = {
+ 		.hts = 4848,
+ 		.vts = 3314,
+ 		.exposure = 256,
++		.crop = {
++			.left = 0,
++			.top = 0,
++			.width = 4208,
++			.height = 3120,
++		},
+ 		.reg_list = {
+ 			.regs = s5k3m5_4208x3120_30fps_mode,
+ 			.num_regs = ARRAY_SIZE(s5k3m5_4208x3120_30fps_mode),
+@@ -708,6 +718,12 @@ static const struct s5k3m5_mode s5k3m5_supported_modes[] = {
+ 		.hts = 4928,
+ 		.vts = 1624,
+ 		.exposure = 256,
++		.crop = {
++			.left = 0,
++			.top = 376,
++			.width = 4208,
++			.height = 2368,
++		},
+ 		.reg_list = {
+ 			.regs = s5k3m5_2104x1184_60fps_mode,
+ 			.num_regs = ARRAY_SIZE(s5k3m5_2104x1184_60fps_mode),
+@@ -1048,11 +1064,15 @@ static int s5k3m5_get_selection(struct v4l2_subdev *sd,
+ 
+ 	switch (sel->target) {
+ 	case V4L2_SEL_TGT_CROP:
++		sel->r = s5k3m5->mode->crop;
++		return 0;
++	case V4L2_SEL_TGT_NATIVE_SIZE:
+ 	case V4L2_SEL_TGT_CROP_BOUNDS:
++	case V4L2_SEL_TGT_CROP_DEFAULT:
+ 		sel->r.left = 0;
+ 		sel->r.top = 0;
+-		sel->r.width = s5k3m5->mode->width;
+-		sel->r.height = s5k3m5->mode->width;
++		sel->r.width = S5K3M5_NATIVE_WIDTH;
++		sel->r.height = S5K3M5_NATIVE_HEIGHT;
+ 		return 0;
+ 	default:
+ 		return -EINVAL;
+-- 
+2.43.0
+
