 create mode 100644 device/testing/linux-postmarketos-qcom-sm8250/0115-drm-panel-samsung-ams678uw01-power-off-when-the-PPS-.patch
 create mode 100644 device/testing/linux-postmarketos-qcom-sm8250/0116-soc-qcom-oneplus-sensor-devinfo-bound-the-SAR-channe.patch

diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0115-drm-panel-samsung-ams678uw01-power-off-when-the-PPS-.patch b/device/testing/linux-postmarketos-qcom-sm8250/0115-drm-panel-samsung-ams678uw01-power-off-when-the-PPS-.patch
new file mode 100644
index 0000000000..7d080ea2e8
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0115-drm-panel-samsung-ams678uw01-power-off-when-the-PPS-.patch
@@ -0,0 +1,52 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Sat, 14 Nov 2026 12:54:35 +0100
+Subject: [PATCH 115/116] drm/panel: samsung-ams678uw01: power off when the PPS
+ cannot be sent
+
+If sending the DSC picture parameter set fails, prepare() returned the
+error with the supplies still enabled and the panel out of reset. The
+panel is then not marked prepared, so unprepare() never runs and the
+regulators stay on. Take the same exit as a failed init sequence.
+
+Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
+---
+ drivers/gpu/drm/panel/panel-samsung-ams678uw01.c | 13 ++++++++-----
+ 1 file changed, 8 insertions(+), 5 deletions(-)
+
+diff --git a/drivers/gpu/drm/panel/panel-samsung-ams678uw01.c b/drivers/gpu/drm/panel/panel-samsung-ams678uw01.c
+index 200774717..e95d06486 100644
+--- a/drivers/gpu/drm/panel/panel-samsung-ams678uw01.c
++++ b/drivers/gpu/drm/panel/panel-samsung-ams678uw01.c
+@@ -281,20 +281,23 @@ static int ams678uw01_prepare(struct drm_panel *panel)
+ 	ret = ams678uw01_on(ctx);
+ 	if (ret < 0) {
+ 		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+-		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+-		regulator_bulk_disable(ARRAY_SIZE(ams678uw01_supplies), ctx->supplies);
+-		return ret;
++		goto err_power_off;
+ 	}
+ 
+ 	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+ 
+ 	ret = mipi_dsi_picture_parameter_set(ctx->dsi, &pps);
+ 	if (ret < 0) {
+-		dev_err(panel->dev, "failed to transmit PPS: %d\n", ret);
+-		return ret;
++		dev_err(dev, "failed to transmit PPS: %d\n", ret);
++		goto err_power_off;
+ 	}
+ 
+ 	return 0;
++
++err_power_off:
++	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
++	regulator_bulk_disable(ARRAY_SIZE(ams678uw01_supplies), ctx->supplies);
++	return ret;
+ }
+ 
+ static int ams678uw01_unprepare(struct drm_panel *panel)
+-- 
+2.43.0
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0116-soc-qcom-oneplus-sensor-devinfo-bound-the-SAR-channe.patch b/device/testing/linux-postmarketos-qcom-sm8250/0116-soc-qcom-oneplus-sensor-devinfo-bound-the-SAR-channe.patch
new file mode 100644
index 0000000000..eb6be5567d
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0116-soc-qcom-oneplus-sensor-devinfo-bound-the-SAR-channe.patch
@@ -0,0 +1,33 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Sat, 14 Nov 2026 12:54:35 +0100
+Subject: [PATCH 116/116] soc: qcom: oneplus-sensor-devinfo: bound the SAR
+ channel count index
+
+parse_sar() stores the channel count at feature[n / 2], where n is the
+number of register values read from "sensor-reg". n can be up to
+PARAMETER_NUM - 1 = 24, which puts the index past the 10-entry feature
+array and into the next sensor entry. No current device tree reaches
+that, but skip the store instead of writing out of bounds.
+
+Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
+---
+ drivers/soc/qcom/oneplus-sensor-devinfo.c | 2 +-
+ 1 file changed, 1 insertion(+), 1 deletion(-)
+
+diff --git a/drivers/soc/qcom/oneplus-sensor-devinfo.c b/drivers/soc/qcom/oneplus-sensor-devinfo.c
+index e72a85273..76732a471 100755
+--- a/drivers/soc/qcom/oneplus-sensor-devinfo.c
++++ b/drivers/soc/qcom/oneplus-sensor-devinfo.c
+@@ -225,7 +225,7 @@ static void parse_sar(struct sensor_hw *hw, struct device_node *np)
+ 
+ 	/* The downstream driver stores the channel count after the register pairs */
+ 	if (!of_property_read_u32(np, "channel-num", &channels) &&
+-	    channels < SAR_MAX_CH_NUM)
++	    channels < SAR_MAX_CH_NUM && n / 2 < FEATURE_NUM)
+ 		hw->feature.feature[n / 2] = channels;
+ 
+ 	read_s32(np, "is-dc-offset", &dc_offset);
+-- 
+2.43.0
+
