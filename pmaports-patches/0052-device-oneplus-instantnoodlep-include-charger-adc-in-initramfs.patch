From d9ebfd19fc2392d80347b2d69974876872c03c43 Mon Sep 17 00:00:00 2001
From: Roman Kuraev <naoru.desu@gmail.com>
Date: Fri, 13 Nov 2026 15:47:44 +0000
Subject: [PATCH] device-oneplus-instantnoodlep: include the charger ADC in
 initramfs

The built-in PM8150B charger requests USB voltage and current channels
from the PM8150B ADC. Package the ADC in the ramdisk so that the charger
can probe before switching to the root filesystem.

mkinitfs includes qcom-vadc-common through the ADC's module dependency.
---
 device/testing/device-oneplus-instantnoodlep/APKBUILD       | 4 +++-
 device/testing/device-oneplus-instantnoodlep/modules-initfs | 1 +
 2 files changed, 4 insertions(+), 1 deletion(-)
 create mode 100644 device/testing/device-oneplus-instantnoodlep/modules-initfs

diff --git a/device/testing/device-oneplus-instantnoodlep/APKBUILD b/device/testing/device-oneplus-instantnoodlep/APKBUILD
index 1b07fea..2f199d9 100644
--- a/device/testing/device-oneplus-instantnoodlep/APKBUILD
+++ b/device/testing/device-oneplus-instantnoodlep/APKBUILD
@@ -3,7 +3,7 @@ maintainer="kouling <k0ul1ng@proton.me>"
 pkgname=device-oneplus-instantnoodlep
 pkgdesc="OnePlus 8 Pro"
 pkgver=7
-pkgrel=6
+pkgrel=7
 url="https://postmarketos.org"
 license="MIT"
 arch="aarch64"
@@ -30,6 +30,7 @@ source="
 	hexagonrpcd-sdsp.conf
 	hexagonrpcd.tmpfiles
 	kernel-cmdline.conf
+	modules-initfs
 	sm8250-oneplus-instantnoodlep-empty.dts
 "
 
@@ -58,5 +59,6 @@ d0e8f2e378130130ac72703aed957f7638e2dd75acf4aa421e1b4592c6cb6d296b652db0d9c242be
