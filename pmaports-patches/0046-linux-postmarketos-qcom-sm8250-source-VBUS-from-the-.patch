new file mode 100644
index 0000000000..5c96f51ee7
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0096-regulator-add-the-OnePlus-8-Pro-external-VBUS-sequen.patch
@@ -0,0 +1,272 @@
+From 3473868b0407ae5ab2fa137af944c79149062970 Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Mon, 9 Nov 2026 22:50:44 +0000
+Subject: [PATCH] regulator: add the OnePlus 8 Pro external VBUS sequence
+
+This board uses an external boost/output path rather than the PMIC OTG
+boost. Sequence the wireless-path select, boost enable and output gate
+with the vendor delays, and unwind GPIO failures.
+
+Describe the three control GPIOs and fixed 5 V output in a DT schema.
+This local board driver still needs upstream design review.
+
+Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
+---
+ .../oneplus,instantnoodlep-vbus.yaml          |  64 ++++++++
+ drivers/regulator/Kconfig                     |   7 +
+ drivers/regulator/Makefile                    |   2 +
+ .../regulator/oneplus-instantnoodlep-vbus.c   | 145 ++++++++++++++++++
+ 4 files changed, 218 insertions(+)
+ create mode 100644 Documentation/devicetree/bindings/regulator/oneplus,instantnoodlep-vbus.yaml
+ create mode 100644 drivers/regulator/oneplus-instantnoodlep-vbus.c
+
+diff --git a/Documentation/devicetree/bindings/regulator/oneplus,instantnoodlep-vbus.yaml b/Documentation/devicetree/bindings/regulator/oneplus,instantnoodlep-vbus.yaml
+new file mode 100644
+index 000000000..4c7b9a7d6
+--- /dev/null
++++ b/Documentation/devicetree/bindings/regulator/oneplus,instantnoodlep-vbus.yaml
+@@ -0,0 +1,64 @@
++# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
++%YAML 1.2
++---
++$id: http://devicetree.org/schemas/regulator/oneplus,instantnoodlep-vbus.yaml#
++$schema: http://devicetree.org/meta-schemas/core.yaml#
++
++title: OnePlus 8 Pro external USB VBUS supply
++
++maintainers:
++  - Roman Kuraev <naoru.desu@gmail.com>
++
++description:
++  The OnePlus 8 Pro supplies USB VBUS through an external 5 V boost and
++  output gate, sharing a power-path switch with wireless charging. The
++  controls must be sequenced to select the USB path and start the boost
++  before connecting it to the USB port.
++
++allOf:
++  - $ref: regulator.yaml#
++
++properties:
++  compatible:
++    const: oneplus,instantnoodlep-vbus
++
++  regulator-min-microvolt:
++    const: 5000000
++
++  regulator-max-microvolt:
++    const: 5000000
++
++  wireless-mode-gpios:
++    maxItems: 1
++    description: Selects the shared power path for USB VBUS output.
++
++  boost-enable-gpios:
++    maxItems: 1
++    description: Enables the external 5 V boost converter.
++
++  output-enable-gpios:
++    maxItems: 1
++    description: Connects the boost output to the USB port.
++
++required:
++  - compatible
++  - regulator-name
++  - wireless-mode-gpios
++  - boost-enable-gpios
++  - output-enable-gpios
++
++unevaluatedProperties: false
++
++examples:
++  - |
++    #include <dt-bindings/gpio/gpio.h>
++
++    regulator-vbus {
++        compatible = "oneplus,instantnoodlep-vbus";
++        regulator-name = "usb_vbus_external";
++        regulator-min-microvolt = <5000000>;
++        regulator-max-microvolt = <5000000>;
++        wireless-mode-gpios = <&pm8150l_gpios 8 GPIO_ACTIVE_HIGH>;
++        boost-enable-gpios = <&tlmm 172 GPIO_ACTIVE_HIGH>;
++        output-enable-gpios = <&pm8150l_gpios 4 GPIO_ACTIVE_HIGH>;
++    };
+diff --git a/drivers/regulator/Kconfig b/drivers/regulator/Kconfig
+index a54a54919..045611fc0 100644
+--- a/drivers/regulator/Kconfig
++++ b/drivers/regulator/Kconfig
+@@ -1889,4 +1889,11 @@ config REGULATOR_QCOM_LABIBB
+ 	  boost regulator and IBB can be used as a negative boost regulator
+ 	  for LCD display panel.
+ 
++config REGULATOR_ONEPLUS_INSTANTNOODLEP
++	tristate "OnePlus 8 Pro external USB VBUS power sequence"
++	depends on OF && GPIOLIB
++	help
++	  Control the external USB VBUS supply on OnePlus 8 Pro boards,
++	  including the shared wireless-charging path switch.
++
+ endif
+diff --git a/drivers/regulator/Makefile b/drivers/regulator/Makefile
+index 134eee274..561507c84 100644
+--- a/drivers/regulator/Makefile
++++ b/drivers/regulator/Makefile
+@@ -219,3 +219,5 @@ obj-$(CONFIG_REGULATOR_WM8400) += wm8400-regulator.o
+ obj-$(CONFIG_REGULATOR_WM8994) += wm8994-regulator.o
+ 
+ ccflags-$(CONFIG_REGULATOR_DEBUG) += -DDEBUG
++
++obj-$(CONFIG_REGULATOR_ONEPLUS_INSTANTNOODLEP) += oneplus-instantnoodlep-vbus.o
+diff --git a/drivers/regulator/oneplus-instantnoodlep-vbus.c b/drivers/regulator/oneplus-instantnoodlep-vbus.c
+new file mode 100644
+index 000000000..1f58a5378
+--- /dev/null
++++ b/drivers/regulator/oneplus-instantnoodlep-vbus.c
+@@ -0,0 +1,145 @@
++// SPDX-License-Identifier: GPL-2.0-only
++/* OnePlus 8 Pro external USB VBUS power sequence. */
++#include <linux/delay.h>
++#include <linux/gpio/consumer.h>
++#include <linux/module.h>
++#include <linux/platform_device.h>
++#include <linux/regulator/driver.h>
++#include <linux/regulator/of_regulator.h>
++
++struct instantnoodlep_vbus {
++	struct gpio_desc *wireless;
++	struct gpio_desc *boost;
++	struct gpio_desc *output;
++};
++
++static int instantnoodlep_vbus_off(struct instantnoodlep_vbus *vbus)
++{
++	int ret, err;
++
++	ret = gpiod_set_value_cansleep(vbus->output, 0);
++	err = gpiod_set_value_cansleep(vbus->boost, 0);
++	if (!ret)
++		ret = err;
++	msleep(20);
++	err = gpiod_set_value_cansleep(vbus->wireless, 0);
++	return ret ? ret : err;
++}
++
++static int instantnoodlep_vbus_enable(struct regulator_dev *rdev)
++{
++	struct instantnoodlep_vbus *vbus = rdev_get_drvdata(rdev);
++	int ret;
++
++	/* Follow the vendor USB PD policy, including its inter-stage delays. */
++	ret = gpiod_set_value_cansleep(vbus->wireless, 1);
++	if (ret)
++		goto fail;
++	msleep(20);
++	ret = gpiod_set_value_cansleep(vbus->boost, 1);
++	if (ret)
++		goto fail;
++	msleep(100);
++	ret = gpiod_set_value_cansleep(vbus->output, 1);
++	if (ret)
++		goto fail;
++	return 0;
++
++fail:
++	instantnoodlep_vbus_off(vbus);
++	return ret;
++}
++
++static int instantnoodlep_vbus_disable(struct regulator_dev *rdev)
++{
++	return instantnoodlep_vbus_off(rdev_get_drvdata(rdev));
++}
++
++static int instantnoodlep_vbus_is_enabled(struct regulator_dev *rdev)
++{
++	struct instantnoodlep_vbus *vbus = rdev_get_drvdata(rdev);
++
++	return gpiod_get_value_cansleep(vbus->output);
++}
++
++static const struct regulator_ops instantnoodlep_vbus_ops = {
++	.enable = instantnoodlep_vbus_enable,
++	.disable = instantnoodlep_vbus_disable,
++	.is_enabled = instantnoodlep_vbus_is_enabled,
++};
++
++static const struct regulator_desc instantnoodlep_vbus_desc = {
++	.name = "instantnoodlep-vbus",
++	.type = REGULATOR_VOLTAGE,
++	.owner = THIS_MODULE,
++	.ops = &instantnoodlep_vbus_ops,
++	.n_voltages = 1,
++	.fixed_uV = 5000000,
++};
++
++static void instantnoodlep_vbus_cleanup(void *data)
++{
++	instantnoodlep_vbus_off(data);
++}
++
++static int instantnoodlep_vbus_probe(struct platform_device *pdev)
++{
++	struct device *dev = &pdev->dev;
++	struct regulator_config config = {};
++	struct instantnoodlep_vbus *vbus;
++	struct regulator_dev *rdev;
++	int ret;
++
++	vbus = devm_kzalloc(dev, sizeof(*vbus), GFP_KERNEL);
++	if (!vbus)
++		return -ENOMEM;
++
++	/* Disconnect the port before configuring the upstream controls. */
++	vbus->output = devm_gpiod_get(dev, "output-enable", GPIOD_OUT_LOW);
++	if (IS_ERR(vbus->output))
++		return dev_err_probe(dev, PTR_ERR(vbus->output), "output GPIO\n");
++	vbus->boost = devm_gpiod_get(dev, "boost-enable", GPIOD_OUT_LOW);
++	if (IS_ERR(vbus->boost))
++		return dev_err_probe(dev, PTR_ERR(vbus->boost), "boost GPIO\n");
++	vbus->wireless = devm_gpiod_get(dev, "wireless-mode", GPIOD_OUT_LOW);
++	if (IS_ERR(vbus->wireless))
++		return dev_err_probe(dev, PTR_ERR(vbus->wireless), "wireless GPIO\n");
++
++	ret = devm_add_action_or_reset(dev, instantnoodlep_vbus_cleanup, vbus);
++	if (ret)
++		return ret;
++	platform_set_drvdata(pdev, vbus);
++	config.dev = dev;
++	config.of_node = dev->of_node;
++	config.driver_data = vbus;
++	config.init_data = of_get_regulator_init_data(dev, dev->of_node,
++						      &instantnoodlep_vbus_desc);
++	if (!config.init_data)
++		return -ENOMEM;
++	rdev = devm_regulator_register(dev, &instantnoodlep_vbus_desc, &config);
++	return PTR_ERR_OR_ZERO(rdev);
++}
++
++static void instantnoodlep_vbus_shutdown(struct platform_device *pdev)
++{
++	instantnoodlep_vbus_off(platform_get_drvdata(pdev));
++}
++
++static const struct of_device_id instantnoodlep_vbus_of_match[] = {
++	{ .compatible = "oneplus,instantnoodlep-vbus" },
++	{}
++};
++MODULE_DEVICE_TABLE(of, instantnoodlep_vbus_of_match);
++
++static struct platform_driver instantnoodlep_vbus_driver = {
++	.probe = instantnoodlep_vbus_probe,
++	.shutdown = instantnoodlep_vbus_shutdown,
++	.driver = {
++		.name = "instantnoodlep-vbus",
++		.of_match_table = instantnoodlep_vbus_of_match,
++	},
++};
++module_platform_driver(instantnoodlep_vbus_driver);
++
++MODULE_DESCRIPTION("OnePlus 8 Pro external USB VBUS power sequence");
++MODULE_LICENSE("GPL");
+-- 
+2.51.2
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0097-usb-typec-tcpm-add-an-optional-power-role-swap-callb.patch b/device/testing/linux-postmarketos-qcom-sm8250/0097-usb-typec-tcpm-add-an-optional-power-role-swap-callb.patch
new file mode 100644
index 0000000000..d3f9ce3bc6
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0097-usb-typec-tcpm-add-an-optional-power-role-swap-callb.patch
@@ -0,0 +1,127 @@
+From 5ec981a3dfa7ba017eb2a1c324d0c74a5e0bd517 Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Mon, 9 Nov 2026 22:50:44 +0000
+Subject: [PATCH] usb: typec: tcpm: add an optional power-role-swap callback
+
+Some port controllers must hold state for the duration of a PD
+power-role swap, while both CC terminations change and the PD channel
+has to stay on the same wire. Add set_power_role_swap(), called with
+the current polarity at PR_SWAP_START and again when the next AMS
+finishes, on hard reset and on port reset. A soft reset can replace
+the swap AMS, so the release does not depend on which AMS ends.
+
+tcpm_apply_rc() runs at the same point, but it is tied to TCPCI
+automatic VBUS discharge and has no counterpart at the end of the swap.
+
+The new callback remains a local API proposal.
+
+Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
+---
+ drivers/usb/typec/tcpm/tcpm.c | 27 +++++++++++++++++++++++++++
+ include/linux/usb/tcpm.h      |  6 ++++++
+ 2 files changed, 33 insertions(+)
+
+diff --git a/drivers/usb/typec/tcpm/tcpm.c b/drivers/usb/typec/tcpm/tcpm.c
+index 89eec20a2..6dea2e287 100644
+--- a/drivers/usb/typec/tcpm/tcpm.c
++++ b/drivers/usb/typec/tcpm/tcpm.c
+@@ -622,6 +622,7 @@ struct tcpm_port {
+ 	enum tcpm_ams ams;
+ 	enum tcpm_ams next_ams;
+ 	bool in_ams;
++	bool power_role_swap_active;
+ 
+ 	/* Auto vbus discharge status */
+ 	bool auto_vbus_discharge_enabled;
+@@ -1082,10 +1083,29 @@ static enum typec_cc_status tcpm_rp_cc(struct tcpm_port *port)
+ 	return TYPEC_CC_RP_DEF;
+ }
+ 
++static int tcpm_set_power_role_swap(struct tcpm_port *port, bool active)
++{
++	int ret;
++
++	if (!port->tcpc->set_power_role_swap || port->power_role_swap_active == active)
++		return 0;
++
++	ret = port->tcpc->set_power_role_swap(port->tcpc, active, port->polarity);
++	if (ret) {
++		tcpm_log_force(port, "Power-role swap control %d failed: %d", active, ret);
++		return ret;
++	}
++	port->power_role_swap_active = active;
++	return 0;
++}
++
+ static void tcpm_ams_finish(struct tcpm_port *port)
+ {
+ 	tcpm_log(port, "AMS %s finished", tcpm_ams_str[port->ams]);
+ 
++	/* A soft reset can replace the swap AMS; never leave the swap state held. */
++	tcpm_set_power_role_swap(port, false);
++
+ 	if (port->pd_capable && port->pwr_role == TYPEC_SOURCE) {
+ 		if (port->negotiated_rev >= PD_REV30)
+ 			tcpm_set_cc(port, SINK_TX_OK);
+@@ -4927,6 +4947,7 @@ static void tcpm_partner_source_caps_reset(struct tcpm_port *port)
+ 
+ static void tcpm_reset_port(struct tcpm_port *port)
+ {
++	tcpm_set_power_role_swap(port, false);
+ 	tcpm_enable_auto_vbus_discharge(port, false);
+ 	port->in_ams = false;
+ 	port->ams = NONE_AMS;
+@@ -5862,6 +5883,7 @@ static void run_state_machine(struct tcpm_port *port)
+ 		tcpm_ams_start(port, HARD_RESET);
+ 		break;
+ 	case HARD_RESET_START:
++		tcpm_set_power_role_swap(port, false);
+ 		port->sink_cap_done = false;
+ 		if (port->tcpc->enable_frs)
+ 			port->tcpc->enable_frs(port->tcpc, false);
+@@ -6095,6 +6117,10 @@ static void run_state_machine(struct tcpm_port *port)
+ 		tcpm_set_state(port, ready_state(port), 0);
+ 		break;
+ 	case PR_SWAP_START:
++		if (tcpm_set_power_role_swap(port, true)) {
++			tcpm_set_state(port, ERROR_RECOVERY, 0);
++			break;
++		}
+ 		tcpm_apply_rc(port);
+ 		if (port->pwr_role == TYPEC_SOURCE)
+ 			tcpm_set_state(port, PR_SWAP_SRC_SNK_TRANSITION_OFF,
+@@ -6842,6 +6868,7 @@ static void _tcpm_pd_vbus_vsafe0v(struct tcpm_port *port)
+ static void _tcpm_pd_hard_reset(struct tcpm_port *port)
+ {
+ 	tcpm_log_force(port, "Received hard reset");
++	tcpm_set_power_role_swap(port, false);
+ 	if (port->bist_request == BDO_MODE_TESTDATA && port->tcpc->set_bist_data)
+ 		port->tcpc->set_bist_data(port->tcpc, false);
+ 
+diff --git a/include/linux/usb/tcpm.h b/include/linux/usb/tcpm.h
+index 93079450b..776d684aa 100644
+--- a/include/linux/usb/tcpm.h
++++ b/include/linux/usb/tcpm.h
+@@ -78,6 +78,10 @@ enum tcpm_transmit_type {
+  *		with partner.
+  * @set_pd_rx:	Called to enable or disable reception of PD messages
+  * @set_roles:	Called to set power and data roles
++ * @set_power_role_swap:
++ *		Optional; prepare or finish a PD power-role swap. The polarity
++ *		identifies the active PD channel. A false argument also releases
++ *		any temporary state on reset or an aborted swap.
+  * @start_toggling:
+  *		Optional; if supported by hardware, called to start dual-role
+  *		toggling or single-role connection detection. Toggling stops
+@@ -152,6 +156,8 @@ struct tcpc_dev {
+ 	int (*set_pd_rx)(struct tcpc_dev *dev, bool on);
+ 	int (*set_roles)(struct tcpc_dev *dev, bool attached,
+ 			 enum typec_role role, enum typec_data_role data);
++	int (*set_power_role_swap)(struct tcpc_dev *dev, bool active,
++				   enum typec_cc_polarity polarity);
+ 	int (*start_toggling)(struct tcpc_dev *dev,
+ 			      enum typec_port_type port_type,
+ 			      enum typec_cc_status cc);
+-- 
+2.51.2
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0098-usb-typec-qcom-hold-orientation-and-defer-the-VBUS-c.patch b/device/testing/linux-postmarketos-qcom-sm8250/0098-usb-typec-qcom-hold-orientation-and-defer-the-VBUS-c.patch
new file mode 100644
index 0000000000..4caded5406
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0098-usb-typec-qcom-hold-orientation-and-defer-the-VBUS-c.patch
@@ -0,0 +1,211 @@
+From 592bf3e455027c62fdb409847c9f87253f01e45f Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Tue, 10 Nov 2026 03:30:54 +0000
+Subject: [PATCH] usb: typec: qcom: hold orientation and defer the VBUS check
+ during PR_SWAP
+
+Preserve PD transmit orientation while a power-role swap changes the CC
+termination, then release the override on completion, reset or detach.
+The override covers only the actual swap; holding it for a whole
+attachment masked unplug detection.
+
+During a source-to-sink power-role swap, the external VBUS switch
+turns off before the PMIC leaves its source state. VSAFE0V stays
+unset until Rd is applied, so polling it before changing CC always
+expires on the OnePlus 8 Pro.
+
+For this PR_SWAP path, defer the existing VSAFE0V check until Rd or
+recovery OPEN has been applied, before TCPM sends PS_RDY. Preserve
+immediate polling for other transitions and retain the warning when
+the deferred voltage-status check really times out. The deferral
+applies to every board that names its VBUS supply in the connector
+node, not only to external switches.
+
+Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
+---
+ .../typec/tcpm/qcom/qcom_pmic_typec_port.c    | 109 ++++++++++++++----
+ 1 file changed, 88 insertions(+), 21 deletions(-)
+
+diff --git a/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port.c b/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port.c
+index 29d9f4c8b..8ce5bba06 100644
+--- a/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port.c
++++ b/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port.c
+@@ -174,6 +174,9 @@ struct pmic_typec_port {
+ 
+ 	struct regulator		*vdd_vbus;
+ 	bool				vbus_enabled;
++	bool				external_vbus;
++	bool				power_role_swap;
++	bool				vbus_off_pending;
+ 	struct mutex			vbus_lock;		/* VBUS state serialization */
+ 
+ 	int				cc;
+@@ -290,34 +293,40 @@ static int qcom_pmic_typec_port_vbus_detect(struct pmic_typec_port *pmic_typec_p
+ 	return !!(misc & TYPEC_VBUS_DETECT);
+ }
+ 
+-static int qcom_pmic_typec_port_vbus_toggle(struct pmic_typec_port *pmic_typec_port, bool on)
++static void qcom_pmic_typec_port_wait_vbus(struct pmic_typec_port *port, bool on)
+ {
++	u32 val = on ? TYPEC_SM_VBUS_VSAFE5V : TYPEC_SM_VBUS_VSAFE0V;
+ 	u32 sm_stat;
+-	u32 val;
+ 	int ret;
+ 
+-	if (on) {
+-		ret = regulator_enable(pmic_typec_port->vdd_vbus);
+-		if (ret)
+-			return ret;
+-
+-		val = TYPEC_SM_VBUS_VSAFE5V;
+-	} else {
+-		ret = regulator_disable(pmic_typec_port->vdd_vbus);
+-		if (ret)
+-			return ret;
++	ret = regmap_read_poll_timeout(port->regmap, port->base + TYPEC_SM_STATUS_REG,
++				       sm_stat, sm_stat & val, 100, 250000);
++	if (ret)
++		dev_warn(port->dev, "vbus vsafe%dv fail\n", on ? 5 : 0);
++}
+ 
+-		val = TYPEC_SM_VBUS_VSAFE0V;
+-	}
++static int qcom_pmic_typec_port_vbus_toggle(struct pmic_typec_port *port, bool on)
++{
++	int ret;
+ 
+-	/* Poll waiting for transition to required vSafe5V or vSafe0V */
+-	ret = regmap_read_poll_timeout(pmic_typec_port->regmap,
+-				       pmic_typec_port->base + TYPEC_SM_STATUS_REG,
+-				       sm_stat, sm_stat & val,
+-				       100, 250000);
++	ret = on ? regulator_enable(port->vdd_vbus) : regulator_disable(port->vdd_vbus);
+ 	if (ret)
+-		dev_warn(pmic_typec_port->dev, "vbus vsafe%dv fail\n", on ? 5 : 0);
++		return ret;
++
++	port->vbus_off_pending = false;
++	/*
++	 * With an external VBUS switch, the PMIC can retain its source-state
++	 * VSAFE indication until Rp is removed. During PR_SWAP, check VSAFE0V
++	 * after applying Rd (or opening CC during recovery), before PS_RDY.
++	 */
++	if (!on && port->external_vbus && port->power_role_swap &&
++	    (port->cc == TYPEC_CC_RP_DEF || port->cc == TYPEC_CC_RP_1_5 ||
++	     port->cc == TYPEC_CC_RP_3_0)) {
++		port->vbus_off_pending = true;
++		return 0;
++	}
+ 
++	qcom_pmic_typec_port_wait_vbus(port, on);
+ 	return 0;
+ }
+ 
+@@ -514,6 +523,15 @@ static int qcom_pmic_typec_port_set_cc(struct tcpc_dev *tcpc,
+ 	if (ret)
+ 		goto done;
+ 
++	/* Let hardware detect the orientation of the next attachment. */
++	if (cc == TYPEC_CC_OPEN) {
++		ret = regmap_update_bits(pmic_typec_port->regmap,
++					 pmic_typec_port->base + TYPEC_CCOUT_CONTROL_REG,
++					 TYPEC_CCOUT_SRC, 0);
++		if (ret)
++			goto done;
++	}
++
+ 	pmic_typec_port->cc = cc;
+ 	qcom_pmic_set_cc_debounce(pmic_typec_port);
+ 	ret = 0;
+@@ -521,6 +539,15 @@ static int qcom_pmic_typec_port_set_cc(struct tcpc_dev *tcpc,
+ done:
+ 	spin_unlock_irqrestore(&pmic_typec_port->lock, flags);
+ 
++	if (!ret && (cc == TYPEC_CC_RD || cc == TYPEC_CC_OPEN)) {
++		mutex_lock(&pmic_typec_port->vbus_lock);
++		if (pmic_typec_port->vbus_off_pending && !pmic_typec_port->vbus_enabled) {
++			qcom_pmic_typec_port_wait_vbus(pmic_typec_port, false);
++			pmic_typec_port->vbus_off_pending = false;
++		}
++		mutex_unlock(&pmic_typec_port->vbus_lock);
++	}
++
+ 	dev_dbg(dev, "set_cc: currsrc=%x %s mode %s debounce %d attached %d cc=%s\n",
+ 		currsrc, rp_sel_to_name(currsrc),
+ 		mode == EN_SRC_ONLY ? "EN_SRC_ONLY" :
+@@ -534,10 +561,42 @@ static int qcom_pmic_typec_port_set_cc(struct tcpc_dev *tcpc,
+ static int qcom_pmic_typec_port_set_polarity(struct tcpc_dev *tcpc,
+ 					     enum typec_cc_polarity pol)
+ {
+-	/* Polarity is set separately by phy-qcom-qmp.c */
++	/* The USB/DP PHY controls orientation outside a PD power-role swap. */
+ 	return 0;
+ }
+ 
++static int qcom_pmic_typec_port_set_power_role_swap(struct tcpc_dev *tcpc,
++						 bool active,
++						 enum typec_cc_polarity pol)
++{
++	struct pmic_typec *tcpm = tcpc_to_tcpm(tcpc);
++	struct pmic_typec_port *port = tcpm->pmic_typec_port;
++	unsigned int mask = TYPEC_CCOUT_SRC;
++	unsigned int value = 0;
++	unsigned long flags;
++	int ret;
++
++	/* Preserve the PD channel only while the CC terminations change. */
++	if (active) {
++		mask |= TYPEC_CCOUT_BUFFER_EN | TYPEC_CCOUT_VALUE;
++		value = TYPEC_CCOUT_BUFFER_EN | TYPEC_CCOUT_SRC;
++		if (pol == TYPEC_POLARITY_CC2)
++			value |= TYPEC_CCOUT_VALUE;
++	}
++
++	spin_lock_irqsave(&port->lock, flags);
++	ret = regmap_update_bits(port->regmap, port->base + TYPEC_CCOUT_CONTROL_REG,
++				 mask, value);
++	spin_unlock_irqrestore(&port->lock, flags);
++	if (!ret) {
++		mutex_lock(&port->vbus_lock);
++		port->power_role_swap = active;
++		mutex_unlock(&port->vbus_lock);
++	}
++
++	return ret;
++}
++
+ static int qcom_pmic_typec_port_set_vconn(struct tcpc_dev *tcpc, bool on)
+ {
+ 	struct pmic_typec *tcpm = tcpc_to_tcpm(tcpc);
+@@ -613,6 +672,12 @@ static int qcom_pmic_typec_port_start_toggling(struct tcpc_dev *tcpc,
+ 
+ 	qcom_pmic_set_cc_debounce(pmic_typec_port);
+ 
++	ret = regmap_update_bits(pmic_typec_port->regmap,
++				 pmic_typec_port->base + TYPEC_CCOUT_CONTROL_REG,
++				 TYPEC_CCOUT_SRC, 0);
++	if (ret)
++		goto done;
++
+ 	/* force it to toggle at least once */
+ 	ret = regmap_write(pmic_typec_port->regmap,
+ 			   pmic_typec_port->base + TYPEC_MODE_CFG_REG,
+@@ -736,6 +801,7 @@ int qcom_pmic_typec_port_probe(struct platform_device *pdev,
+ 	pmic_typec_port->vdd_vbus = devm_of_regulator_get_optional(dev,
+ 								   to_of_node(connector),
+ 								   "vbus");
++	pmic_typec_port->external_vbus = !IS_ERR(pmic_typec_port->vdd_vbus);
+ 	if (pmic_typec_port->vdd_vbus == ERR_PTR(-ENODEV))
+ 		pmic_typec_port->vdd_vbus = devm_regulator_get(dev, "vdd-vbus");
+ 	if (IS_ERR(pmic_typec_port->vdd_vbus))
+@@ -778,6 +844,7 @@ int qcom_pmic_typec_port_probe(struct platform_device *pdev,
+ 	tcpm->tcpc.set_cc = qcom_pmic_typec_port_set_cc;
+ 	tcpm->tcpc.get_cc = qcom_pmic_typec_port_get_cc;
+ 	tcpm->tcpc.set_polarity = qcom_pmic_typec_port_set_polarity;
++	tcpm->tcpc.set_power_role_swap = qcom_pmic_typec_port_set_power_role_swap;
+ 	tcpm->tcpc.set_vconn = qcom_pmic_typec_port_set_vconn;
+ 	tcpm->tcpc.start_toggling = qcom_pmic_typec_port_start_toggling;
+ 
+-- 
+2.51.2
+
