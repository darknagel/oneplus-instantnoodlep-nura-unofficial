new file mode 100644
index 0000000000..592c7fed91
--- /dev/null
+++ b/temp/libfprint/0002-goodixoplus-report-finger-needed-wait-longer-for-the.patch
@@ -0,0 +1,46 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Wed, 18 Nov 2026 00:00:31 +0100
+Subject: [PATCH 2/2] goodixoplus: report finger-needed, wait longer for the
+ light
+
+fprintd publishes the finger status as the finger-needed and finger-present
+properties. Report FP_FINGER_STATUS_NEEDED while waiting, so that a session
+helper can draw the ring and the light under a compositor, where the
+framebuffer is not shown, and give it 150 ms before the capture.
+---
+ libfprint/drivers/goodixoplus/goodix-oplus.c | 7 +++++--
+ 1 file changed, 5 insertions(+), 2 deletions(-)
+
+diff --git a/libfprint/drivers/goodixoplus/goodix-oplus.c b/libfprint/drivers/goodixoplus/goodix-oplus.c
+index 979ee03..1c34e4f 100755
+--- a/libfprint/drivers/goodixoplus/goodix-oplus.c
++++ b/libfprint/drivers/goodixoplus/goodix-oplus.c
+@@ -311,6 +311,9 @@ capture (FpiDeviceGoodixOplus *self, gboolean enrolling, GError **error)
+ static gboolean
+ wait_finger (FpiDeviceGoodixOplus *self, GCancellable *cancellable, GError **error)
+ {
++  /* fprintd publishes this as "finger-needed"; under a compositor the
++   * goodix-fp-overlay session helper draws the ring and the light from it */
++  report_finger (self, FP_FINGER_STATUS_NEEDED);
+   goodix_oplus_io_guide (&self->io, TRUE);
+   for (;;)
+     {
+@@ -423,7 +426,7 @@ do_enroll (FpiDeviceGoodixOplus *self, GCancellable *cancellable, GError **error
+         goto out;
+       report_finger (self, FP_FINGER_STATUS_PRESENT);
+       goodix_oplus_io_light (&self->io, TRUE);
+-      g_usleep (80000);
++      g_usleep (150000); /* light on: framebuffer, or overlay via D-Bus + compositor */
+       if (!cmd_zero (self, T_SENSOR, 9, 32, NULL, error) || !capture (self, TRUE, error))
+         { goodix_oplus_io_light (&self->io, FALSE); goto out; }
+       put32 (p1, 0x34, 0x1c);
+@@ -492,7 +495,7 @@ do_identify (FpiDeviceGoodixOplus *self, GCancellable *cancellable, GError **err
+     return NULL;
+   report_finger (self, FP_FINGER_STATUS_PRESENT);
+   goodix_oplus_io_light (&self->io, TRUE);
+-  g_usleep (80000);
++  g_usleep (150000); /* light on: framebuffer, or overlay via D-Bus + compositor */
+   if (!cmd_zero (self, T_SENSOR, 9, 32, NULL, error))
+     goto out;
+   for (i = 0; i < AUTH_TRIES; i++)
