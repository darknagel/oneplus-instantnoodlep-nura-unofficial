 temp/libfprint/APKBUILD                       |  6 ++-
 3 files changed, 52 insertions(+), 4 deletions(-)
 create mode 100644 temp/libfprint/0002-goodixoplus-report-finger-needed-wait-longer-for-the.patch

diff --git a/temp/libfprint/0001-goodixoplus-add-a-driver-for-the-Oplus-Goodix-optica.patch b/temp/libfprint/0001-goodixoplus-add-a-driver-for-the-Oplus-Goodix-optica.patch
