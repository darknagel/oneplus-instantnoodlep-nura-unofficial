index 0000000000..c201541b4c
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0086-arm64-dts-qcom-pm8150b-add-the-charger-source-change.patch
@@ -0,0 +1,38 @@
+From 76245ebc69f4464c393917e4ef6e389aef6a9f7a Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Tue, 10 Nov 2026 19:20:56 +0000
+Subject: [PATCH] arm64: dts: qcom: pm8150b: add the charger source-change
+ interrupt
+
+Describe the USB input source-change interrupt so the charger driver can
+refresh its cached type and allowance when APSD completes late. The
+driver treats the interrupt as optional.
+
+Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
+---
+ arch/arm64/boot/dts/qcom/pm8150b.dtsi | 6 ++++--
+ 1 file changed, 4 insertions(+), 2 deletions(-)
+
+diff --git a/arch/arm64/boot/dts/qcom/pm8150b.dtsi b/arch/arm64/boot/dts/qcom/pm8150b.dtsi
+index a1a703520..9f14113fa 100644
+--- a/arch/arm64/boot/dts/qcom/pm8150b.dtsi
++++ b/arch/arm64/boot/dts/qcom/pm8150b.dtsi
+@@ -113,11 +113,13 @@ pm8150b_charger: charger@1000 {
+ 			interrupts = <0x2 0x13 0x4 IRQ_TYPE_EDGE_BOTH>,
+ 				     <0x2 0x12 0x2 IRQ_TYPE_EDGE_BOTH>,
+ 				     <0x2 0x16 0x1 IRQ_TYPE_EDGE_RISING>,
+-				     <0x2 0x13 0x7 IRQ_TYPE_EDGE_RISING>;
++				     <0x2 0x13 0x7 IRQ_TYPE_EDGE_RISING>,
++				     <0x2 0x13 0x6 IRQ_TYPE_EDGE_RISING>;
+ 			interrupt-names = "usbin-plugin",
+ 					  "bat-ov",
+ 					  "wdog-bark",
+-					  "usbin-icl-change";
++					  "usbin-icl-change",
++					  "usbin-src-change";
+ 
+ 			io-channels = <&pm8150b_adc 7>,
+ 				      <&pm8150b_adc 8>;
+-- 
+2.51.2
+
