+From e64f1301702d7ccb1e1917aecdb66e5ef3ba84a8 Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Mon, 9 Nov 2026 22:50:44 +0000
+Subject: [PATCH] power: supply: qcom_pm8150b: report battery over-voltage
+ health
+
+Report battery over-voltage as POWER_SUPPLY_HEALTH_OVERVOLTAGE instead
+of only logging it.
+
+Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
+---
+ drivers/power/supply/qcom_pm8150b_charger.c | 3 ++-
+ 1 file changed, 2 insertions(+), 1 deletion(-)
+
+diff --git a/drivers/power/supply/qcom_pm8150b_charger.c b/drivers/power/supply/qcom_pm8150b_charger.c
+index b84f298e9..b65ff5417 100644
+--- a/drivers/power/supply/qcom_pm8150b_charger.c
++++ b/drivers/power/supply/qcom_pm8150b_charger.c
+@@ -570,7 +570,8 @@ static int smb5_get_prop_health(struct smb5_chip *chip, int *val)
+ 	}
+ 
+ 	if (stat & CHARGER_ERROR_STATUS_BAT_OV_BIT) {
+-		dev_err(chip->dev, "battery over-voltage");
++		*val = POWER_SUPPLY_HEALTH_OVERVOLTAGE;
++		return 0;
+ 	}
+ 
+ 	rc = regmap_read(chip->regmap, chip->base + BATTERY_CHARGER_STATUS_7_REG,
+-- 
+2.51.2
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0085-power-supply-qcom_pm8150b-follow-TCPM-limits-and-ref.patch b/device/testing/linux-postmarketos-qcom-sm8250/0085-power-supply-qcom_pm8150b-follow-TCPM-limits-and-ref.patch
new file mode 100644
index 0000000000..3b93cabd45
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0085-power-supply-qcom_pm8150b-follow-TCPM-limits-and-ref.patch
@@ -0,0 +1,649 @@
+From 7c802beb40575145a821ac99419e905e37361d63 Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Tue, 10 Nov 2026 19:20:56 +0000
+Subject: [PATCH] power: supply: qcom_pm8150b: follow TCPM limits and refresh
+ legacy detection
+
+Use negotiated Type-C current while PD is active, suspend input when the
+source is unavailable, and bound legacy APSD retries. Stop charger policy
+from overwriting Type-C state owned by TCPM.
+
+Treat a zero TCPM limit as unknown for non-PD sources so default
+Rp and legacy cables reach BC1.2 detection. Preserve zero-current
+suspension for PD contracts and validate the input voltage before
+using a fallback limit.
+
+Start a fresh APSD cycle after enabling detection and invalidate the cached
+result on cable changes and PD transitions. A completed empty result is
+Unknown, not SDP; bounded polling and the optional source-change IRQ handle
+late completion without a restart loop. Keep unknown and SDP inputs at
+500 mA.
+
+Keep charging disabled until limits are installed, but leave USB input
+powering the system at 500 mA while probing waits for the Type-C
+supplier. Keep VBUS sourcing under software control as before. Program
+the battery's constant-charge current, falling back to 1.5 A when the
+device tree gives none.
+
+On an IN2023, the previously failing USB-A charger now detects as DCP and
+draws 1.48 A, including after PD; a computer hub still detects as SDP at
+500 mA.
+
+Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
+---
+ drivers/power/supply/qcom_pm8150b_charger.c | 418 +++++++++++++++-----
+ 1 file changed, 317 insertions(+), 101 deletions(-)
+
+diff --git a/drivers/power/supply/qcom_pm8150b_charger.c b/drivers/power/supply/qcom_pm8150b_charger.c
+index b65ff5417..73c7abfcf 100644
+--- a/drivers/power/supply/qcom_pm8150b_charger.c
++++ b/drivers/power/supply/qcom_pm8150b_charger.c
+@@ -16,6 +16,7 @@
+ #include <linux/kernel.h>
+ #include <linux/minmax.h>
+ #include <linux/module.h>
++#include <linux/mutex.h>
+ #include <linux/platform_device.h>
+ #include <linux/pm_wakeirq.h>
+ #include <linux/of.h>
+@@ -255,11 +256,13 @@
+ #define AICL_RERUN_TIME_MASK			GENMASK(1, 0)
+ 
+ #define SDP_CURRENT_UA			500000
+-#define CDP_CURRENT_UA			3000000
+-#define DCP_CURRENT_UA			3300000
+-#define CURRENT_MAX_UA			DCP_CURRENT_UA
++#define CDP_CURRENT_UA			1500000
++#define DCP_CURRENT_UA			1500000
++#define CURRENT_MAX_UA			3000000
++#define FAST_CHARGE_CURRENT_MAX_UA		8000000
++#define APSD_MAX_RETRIES			3
+ 
+-/* pmi8150b registers represent current in increments of 1/40th of an amp */
++/* PM8150B current registers use 50 mA steps. */
+ #define CURRENT_SCALE_FACTOR		50000
+ /* clang-format on */
+ 
+@@ -309,12 +312,21 @@ struct smb5_chip {
+ 	struct iio_channel *usb_in_v_chan;
+ 
+ 	struct power_supply *chg_psy;
++	struct mutex lock;
++	bool ready;
++	bool has_tcpm;
++	bool apsd_started;
++	unsigned int apsd_retries;
++	unsigned int user_current_limit;
++	unsigned int source_current_limit;
++	enum power_supply_usb_type usb_type;
+ };
+ 
+ static enum power_supply_property smb5_properties[] = {
+ 	POWER_SUPPLY_PROP_MANUFACTURER,
+ 	POWER_SUPPLY_PROP_MODEL_NAME,
+ 	POWER_SUPPLY_PROP_CURRENT_MAX,
++	POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+ 	POWER_SUPPLY_PROP_CURRENT_NOW,
+ 	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+ 	POWER_SUPPLY_PROP_STATUS,
+@@ -361,7 +373,6 @@ static int smb5_apsd_get_charger_type(struct smb5_chip *chip, int *val)
+ 		return rc;
+ 	}
+ 	if (!(apsd_stat & APSD_DTC_STATUS_DONE_BIT)) {
+-		dev_err(chip->dev, "Apsd not ready");
+ 		return -EAGAIN;
+ 	}
+ 
+@@ -373,20 +384,25 @@ static int smb5_apsd_get_charger_type(struct smb5_chip *chip, int *val)
+ 
+ 	stat &= APSD_RESULT_STATUS_MASK;
+ 
+-	if (stat & CDP_CHARGER_BIT){
++	switch (stat) {
++	case SDP_CHARGER_BIT:
++		*val = POWER_SUPPLY_USB_TYPE_SDP;
++		break;
++	case CDP_CHARGER_BIT:
+ 		*val = POWER_SUPPLY_USB_TYPE_CDP;
+-	} else if (stat & DCP_CHARGER_BIT){
+-		*val = POWER_SUPPLY_USB_TYPE_DCP;
+-	} else if (stat & OCP_CHARGER_BIT){
+-		*val = POWER_SUPPLY_USB_TYPE_DCP;
+-	} else if (stat & FLOAT_CHARGER_BIT){
+-		*val = POWER_SUPPLY_USB_TYPE_DCP;
+-	} else if (stat & QC_2P0_BIT){
+-		*val = POWER_SUPPLY_USB_TYPE_DCP;
+-	} else if (stat & QC_3P0_BIT){
++		break;
++	case DCP_CHARGER_BIT:
++	case OCP_CHARGER_BIT:
++	case QC_2P0_BIT:
++	case QC_3P0_BIT:
++	case DCP_CHARGER_BIT | QC_2P0_BIT:
++	case DCP_CHARGER_BIT | QC_3P0_BIT:
+ 		*val = POWER_SUPPLY_USB_TYPE_DCP;
+-	} else {
+-		*val = POWER_SUPPLY_USB_TYPE_SDP;
++		break;
++	default:
++		/* Empty, floating and unrecognised results are not an SDP. */
++		*val = POWER_SUPPLY_USB_TYPE_UNKNOWN;
++		break;
+ 	}
+ 
+ 	return 0;
+@@ -466,73 +482,230 @@ static int smb5_set_current_limit(struct smb5_chip *chip, unsigned int val)
+ {
+ 	unsigned char val_raw;
+ 
+-	if (val > 4950000) {
+-		dev_err(chip->dev,
+-			"Can't set current limit higher than 4950000uA");
++	if (val > CURRENT_MAX_UA)
+ 		return -EINVAL;
+-	}
+ 	val_raw = val / CURRENT_SCALE_FACTOR;
+ 
+ 	return regmap_write(chip->regmap, chip->base + USBIN_CURRENT_LIMIT_CFG,
+ 		val_raw);
+ }
+ 
++static int smb5_set_charge_current(struct smb5_chip *chip, int current_ua)
++{
++	/* Retain the bring-up default only for boards without a battery limit. */
++	if (current_ua <= 0)
++		current_ua = 1500000;
++	if (current_ua < CURRENT_SCALE_FACTOR ||
++	    current_ua > FAST_CHARGE_CURRENT_MAX_UA)
++		return -EINVAL;
++
++	return regmap_write(chip->regmap, chip->base + FAST_CHARGE_CURRENT_CFG,
++			    current_ua / CURRENT_SCALE_FACTOR);
++}
++
+ static int smb5_set_prop_charging_enabled(struct smb5_chip *chip, unsigned int val)
+ {
+ 	return regmap_update_bits(chip->regmap, chip->base + CHARGING_ENABLE_CMD,
+ 					CHARGING_ENABLE_CMD_BIT, val ? CHARGING_ENABLE_CMD_BIT : 0);
+ }
+ 
+-static void smb5_status_change_work(struct work_struct *work)
++static void smb5_queue_status_work(struct smb5_chip *chip)
+ {
+-	unsigned int charger_type, current_ua;
+-	int usb_online = 0;
+-	int count, rc;
+-	struct smb5_chip *chip;
++	mutex_lock(&chip->lock);
++	if (chip->ready)
++		mod_delayed_work(system_wq, &chip->status_change_work, 0);
++	mutex_unlock(&chip->lock);
++}
+ 
+-	chip = container_of(work, struct smb5_chip, status_change_work.work);
++static void smb5_external_power_changed(struct power_supply *psy)
++{
++	smb5_queue_status_work(power_supply_get_drvdata(psy));
++}
+ 
+-	smb5_get_prop_usb_online(chip, &usb_online);
+-	if (!usb_online)
+-		return;
++static int smb5_supplier_property(struct smb5_chip *chip,
++				 enum power_supply_property prop, int *value)
++{
++	union power_supply_propval val;
++	int ret;
+ 
+-	for (count = 0; count < 3; count++) {
+-		dev_dbg(chip->dev, "get charger type retry %d\n", count);
+-		rc = smb5_apsd_get_charger_type(chip, &charger_type);
+-		if (rc != -EAGAIN)
+-			break;
+-		msleep(100);
++	ret = power_supply_get_property_from_supplier(chip->chg_psy, prop, &val);
++	if (!ret)
++		*value = val.intval;
++	return ret;
++}
++
++static int smb5_apply_input_limit(struct smb5_chip *chip, unsigned int current_ua,
++				 bool apsd)
++{
++	int ret;
++
++	/* Suspend before disabling input; never leave a stale large limit. */
++	if (!current_ua) {
++		ret = regmap_update_bits(chip->regmap, chip->base + USBIN_CMD_IL,
++					 USBIN_SUSPEND_BIT, USBIN_SUSPEND_BIT);
++		if (ret)
++			return ret;
+ 	}
+ 
+-	if (rc < 0 && rc != -EAGAIN) {
+-		dev_err(chip->dev, "get charger type failed: %d\n", rc);
+-		return;
++	ret = smb5_set_current_limit(chip, current_ua);
++	if (ret)
++		return ret;
++	ret = regmap_update_bits(chip->regmap, chip->base + USBIN_OPTIONS_1_CFG,
++				 BC1P2_SRC_DETECT_BIT, apsd ? BC1P2_SRC_DETECT_BIT : 0);
++	if (ret)
++		return ret;
++
++	/* Software high-current mode, also used by downstream for PD. */
++	ret = regmap_update_bits(chip->regmap, chip->base + USBIN_ICL_OPTIONS,
++				 USBIN_MODE_CHG_BIT, USBIN_MODE_CHG_BIT);
++	if (ret)
++		return ret;
++	ret = regmap_update_bits(chip->regmap, chip->base + CMD_ICL_OVERRIDE,
++				 ICL_OVERRIDE_BIT, 0);
++	if (ret)
++		return ret;
++	ret = regmap_update_bits(chip->regmap, chip->base + USBIN_LOAD_CFG,
++				 ICL_OVERRIDE_AFTER_APSD_BIT, ICL_OVERRIDE_AFTER_APSD_BIT);
++	if (ret)
++		return ret;
++
++	return regmap_update_bits(chip->regmap, chip->base + USBIN_CMD_IL,
++				  USBIN_SUSPEND_BIT, current_ua ? 0 : USBIN_SUSPEND_BIT);
++}
++
++static void smb5_status_change_work(struct work_struct *work)
++{
++	struct smb5_chip *chip = container_of(work, struct smb5_chip,
++					     status_change_work.work);
++	int online, type = POWER_SUPPLY_USB_TYPE_UNKNOWN, current_ua = 0;
++	int voltage_uv, ret;
++	bool apsd = false, start_apsd = false, retry = false;
++
++	mutex_lock(&chip->lock);
++	if (!chip->ready)
++		goto unlock;
++
++	if (chip->has_tcpm) {
++		ret = smb5_supplier_property(chip, POWER_SUPPLY_PROP_ONLINE, &online);
++		if (ret)
++			goto fail;
++		if (!online) {
++			chip->apsd_retries = 0;
++			goto apply;
++		}
++		ret = smb5_supplier_property(chip, POWER_SUPPLY_PROP_CURRENT_NOW,
++					     &current_ua);
++		if (ret)
++			goto fail;
++		ret = smb5_supplier_property(chip, POWER_SUPPLY_PROP_USB_TYPE, &type);
++		if (ret)
++			goto fail;
++		ret = smb5_supplier_property(chip, POWER_SUPPLY_PROP_VOLTAGE_NOW,
++					     &voltage_uv);
++		if (ret)
++			goto fail;
++
++		/* Default Rp is reported as zero when TCPM has no BC1.2 limit. */
++		if (current_ua < 0)
++			goto apply;
++		/* This board advertises only fixed 5 V PDOs. */
++		if (voltage_uv < 4500000 || voltage_uv > 5500000) {
++			ret = -ERANGE;
++			goto fail;
++		}
++		if (type == POWER_SUPPLY_USB_TYPE_PD ||
++		    type == POWER_SUPPLY_USB_TYPE_PD_PPS || current_ua > SDP_CURRENT_UA) {
++			if (type != POWER_SUPPLY_USB_TYPE_PD &&
++			    type != POWER_SUPPLY_USB_TYPE_PD_PPS)
++				type = POWER_SUPPLY_USB_TYPE_C;
++			chip->apsd_retries = 0;
++			goto apply;
++		}
++	} else {
++		ret = smb5_get_prop_usb_online(chip, &online);
++		if (ret)
++			goto fail;
++		if (!online) {
++			chip->apsd_retries = 0;
++			goto apply;
++		}
+ 	}
+ 
+-	if (rc < 0) {
+-		rc = regmap_update_bits(chip->regmap, chip->base + CMD_APSD,
+-					APSD_RERUN_BIT, APSD_RERUN_BIT);
+-		schedule_delayed_work(&chip->status_change_work,
+-				      msecs_to_jiffies(1000));
+-		dev_dbg(chip->dev, "get charger type failed, rerun apsd\n");
+-		return;
++	/* Default Rp or a legacy cable: start with a conservative BC1.2 limit. */
++	apsd = true;
++	current_ua = SDP_CURRENT_UA;
++	if (!chip->apsd_started) {
++		/* Ignore any result left by the previous connection or PD mode. */
++		type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
++		start_apsd = true;
++		retry = true;
++		goto apply;
+ 	}
+ 
+-	switch (charger_type) {
+-	case POWER_SUPPLY_USB_TYPE_CDP:
++	ret = smb5_apsd_get_charger_type(chip, &type);
++	if (ret == -EAGAIN)
++		type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
++	else if (ret)
++		goto fail;
++	else if (type == POWER_SUPPLY_USB_TYPE_CDP)
