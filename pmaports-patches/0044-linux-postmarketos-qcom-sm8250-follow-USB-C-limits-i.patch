diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0086-arm64-dts-qcom-pm8150b-add-the-charger-source-change.patch b/device/testing/linux-postmarketos-qcom-sm8250/0086-arm64-dts-qcom-pm8150b-add-the-charger-source-change.patch
