+index 96c5fae..1095179 100644
+--- a/src/libcamera/software_isp/swstats_cpu.cpp
++++ b/src/libcamera/software_isp/swstats_cpu.cpp
+@@ -23,6 +23,15 @@
+ 
+ namespace libcamera {
+ 
++/*
++ * Differences between neighbouring sampled green values up to this size are
++ * treated as noise by the autofocus sharpness measure.
++ */
++static constexpr unsigned int kSharpnessCoring = 2;
++
++/* Green values from here on are treated as clipped by the sharpness measure. */
++static constexpr unsigned int kSharpnessClip = 240;
++
+ /**
+  * \class SwStatsCpu
+  * \brief Class for gathering statistics on the CPU
+@@ -312,9 +321,19 @@ void SwStatsCpu::statsBGGR10PLine0(const uint8_t *src[], SwIspStats &stats)
+ 		r = src1[x + 1];
+ 		g = (g + g2) / 2;
+ 		if (x >= afStart_ && x < afEnd_) {
+-			if (x != afStart_)
+-				sharp += abs(static_cast<int>(g) - static_cast<int>(prevG));
+-			sharpBase += g;
++			if (x != afStart_) {
++				unsigned int d = abs(static_cast<int>(g) -
++						     static_cast<int>(prevG));
++				/*
++				 * Ignore small steps, they are mostly noise, and
++				 * steps at clipped highlights: the edges of
++				 * defocused lights would win otherwise.
++				 */
++				if (d > kSharpnessCoring &&
++				    g < kSharpnessClip && prevG < kSharpnessClip)
++					sharp += d * d;
++			}
++			sharpBase += g * g;
+ 			prevG = g;
+ 		}
+ 		/* Data is already 8 bits, divide by 1 */
+@@ -349,9 +368,19 @@ void SwStatsCpu::statsGBRG10PLine0(const uint8_t *src[], SwIspStats &stats)
+ 		g2 = src1[x + 1];
+ 		g = (g + g2) / 2;
+ 		if (x >= afStart_ && x < afEnd_) {
+-			if (x != afStart_)
+-				sharp += abs(static_cast<int>(g) - static_cast<int>(prevG));
+-			sharpBase += g;
++			if (x != afStart_) {
++				unsigned int d = abs(static_cast<int>(g) -
++						     static_cast<int>(prevG));
++				/*
++				 * Ignore small steps, they are mostly noise, and
++				 * steps at clipped highlights: the edges of
++				 * defocused lights would win otherwise.
++				 */
++				if (d > kSharpnessCoring &&
++				    g < kSharpnessClip && prevG < kSharpnessClip)
++					sharp += d * d;
++			}
++			sharpBase += g * g;
+ 			prevG = g;
+ 		}
+ 		/* Data is already 8 bits, divide by 1 */
+@@ -685,7 +714,7 @@ void SwStatsCpu::processBayerFrame2(MappedFrameBuffer &in)
+ 		/* linePointers[0] is not used by any stats0_ functions */
+ 		linePointers[1] = src;
+ 		linePointers[2] = src + stride_;
+-		(this->*stats0_)(linePointers, stats_[0]);
++		processStats0(y, linePointers, stats_[0]);
+ 		src += stride_ * 2;
+ 	}
+ }
