 create mode 100644 device/testing/linux-postmarketos-qcom-sm8250/0062-arm64-dts-qcom-sm8250-oneplus-instantnoodlep-Use-the.patch
 create mode 100644 device/testing/linux-postmarketos-qcom-sm8250/0063-media-i2c-lc898128-Start-only-once-the-camera-stays-.patch

diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0061-soc-qcom-oneplus-sensor-devinfo-Take-the-layout-from.patch b/device/testing/linux-postmarketos-qcom-sm8250/0061-soc-qcom-oneplus-sensor-devinfo-Take-the-layout-from.patch
new file mode 100644
index 0000000000..a65da11412
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0061-soc-qcom-oneplus-sensor-devinfo-Take-the-layout-from.patch
@@ -0,0 +1,84 @@
+From 66c99d9b3e9e0e24fbcf7226a23f9e373b8805f9 Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Mon, 9 Nov 2026 20:29:16 +0100
+Subject: [PATCH 61/63] soc: qcom: oneplus-sensor-devinfo: Take the layout from
+ the item size
+
+SLPI builds of OxygenOS read SMEM item 130 in different layouts, even
+with the same version string (SLPI.HY.3.0-00262): older ones with 2
+chips per sensor type at a stride of 0x174 and the algorithm records at
+0x1000, newer ones with 3 chips at 0x22c and 0x17e8. Older bootloaders
+create the item themselves in the layout of their firmware, newer ones
+leave it to the kernel.
+
+With each phone running the SLPI firmware from its own modem partition,
+the layout therefore follows the item: keep the size of an item the
+bootloader created, and create a missing one in the layout named by
+oneplus,sources-per-sensor, by default the newer 3-chip one.
+
+Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
+---
+ .../soc/qcom/oneplus,sensor-devinfo.yaml      |  7 +++----
+ drivers/soc/qcom/oneplus-sensor-devinfo.c     | 19 ++++++++++---------
+ 2 files changed, 13 insertions(+), 13 deletions(-)
+
+diff --git a/Documentation/devicetree/bindings/soc/qcom/oneplus,sensor-devinfo.yaml b/Documentation/devicetree/bindings/soc/qcom/oneplus,sensor-devinfo.yaml
+index 6a1c739a4..520f1ef7d 100755
+--- a/Documentation/devicetree/bindings/soc/qcom/oneplus,sensor-devinfo.yaml
++++ b/Documentation/devicetree/bindings/soc/qcom/oneplus,sensor-devinfo.yaml
+@@ -23,10 +23,9 @@ properties:
+     $ref: /schemas/types.yaml#/definitions/uint32
+     enum: [2, 3]
+     description:
+-      Number of alternative chips per sensor type in the layout of SMEM item
+-      130. Older firmware always reads 2, newer firmware 3, independent of
+-      the size of the item. Without this property, the layout follows the
+-      size of the item.
++      Number of alternative chips per sensor type when the kernel creates
++      SMEM item 130. Older firmware reads 2, newer firmware 3. An item that
++      the bootloader created keeps its own layout. Defaults to 3.
+ 
+ patternProperties:
+   "^(gsensor|msensor|lsensor|lrsensor|psensor|ssensor|sdsensor|cctsensor|cctrsensor)-[0-9]$":
+diff --git a/drivers/soc/qcom/oneplus-sensor-devinfo.c b/drivers/soc/qcom/oneplus-sensor-devinfo.c
+index e81588fc3..e72a85273 100755
+--- a/drivers/soc/qcom/oneplus-sensor-devinfo.c
++++ b/drivers/soc/qcom/oneplus-sensor-devinfo.c
+@@ -329,7 +329,11 @@ static int oneplus_sensor_devinfo_probe(struct platform_device *pdev)
+ 	u32 type, n_sources = 0;
+ 	int ret;
+ 
+-	/* The firmware reads a fixed layout, whatever the size of the item */
++	/*
++	 * Older bootloaders create the item themselves, in the layout their
++	 * firmware reads. Otherwise create it, by default in the layout of
++	 * newer firmware. Either way the size tells the layout.
++	 */
+ 	if (!of_property_read_u32(dev->of_node, "oneplus,sources-per-sensor", &n_sources) &&
+ 	    n_sources != 2 && n_sources != 3)
+ 		return dev_err_probe(dev, -EINVAL,
+@@ -348,16 +352,13 @@ static int oneplus_sensor_devinfo_probe(struct platform_device *pdev)
+ 		return dev_err_probe(dev, PTR_ERR(di.info), "failed to get SMEM item\n");
+ 
+ 	di.n_algorithms = SENSOR_ALGO_NUM;
+-	if ((!n_sources || n_sources == 2) &&
+-	    size == info_size(2, SENSOR_ALGO_NUM_LEGACY)) {
+-		di.n_sources = 2;
+-		di.n_algorithms = SENSOR_ALGO_NUM_LEGACY;
+-	} else if (n_sources && size >= info_size(n_sources, SENSOR_ALGO_NUM)) {
+-		di.n_sources = n_sources;
+-	} else if (!n_sources && size == info_size(3, SENSOR_ALGO_NUM)) {
++	if (size == info_size(3, SENSOR_ALGO_NUM)) {
+ 		di.n_sources = 3;
+-	} else if (!n_sources && size == info_size(2, SENSOR_ALGO_NUM)) {
++	} else if (size == info_size(2, SENSOR_ALGO_NUM)) {
+ 		di.n_sources = 2;
++	} else if (size == info_size(2, SENSOR_ALGO_NUM_LEGACY)) {
++		di.n_sources = 2;
++		di.n_algorithms = SENSOR_ALGO_NUM_LEGACY;
+ 	} else {
+ 		return dev_err_probe(dev, -EINVAL, "unexpected SMEM item size %zu\n", size);
+ 	}
+-- 
+2.43.0
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0062-arm64-dts-qcom-sm8250-oneplus-instantnoodlep-Use-the.patch b/device/testing/linux-postmarketos-qcom-sm8250/0062-arm64-dts-qcom-sm8250-oneplus-instantnoodlep-Use-the.patch
new file mode 100644
index 0000000000..7b8b2fd08f
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0062-arm64-dts-qcom-sm8250-oneplus-instantnoodlep-Use-the.patch
@@ -0,0 +1,32 @@
+From 135c4a0b6864fa9f5b09cf842d4a0c32f49264a2 Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Mon, 9 Nov 2026 20:29:16 +0100
+Subject: [PATCH 62/63] arm64: dts: qcom: sm8250-oneplus-instantnoodlep: Use
+ the default sensor layout
+
+The phone now runs the SLPI firmware from its own modem partition, which
+on current OxygenOS reads the 3-chip layout. Older bootloaders create the
+item themselves, and the driver keeps their layout.
+
+Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
+---
+ arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts | 3 +--
+ 1 file changed, 1 insertion(+), 2 deletions(-)
+
+diff --git a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+index dfd9ab7f2..ed8053b85 100644
+--- a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
++++ b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+@@ -389,8 +389,7 @@ vreg_cam_tele_avdd: regulator-cam-tele-avdd {
+ 
+ 	sensor-devinfo {
+ 		compatible = "oneplus,sensor-devinfo";
+-		/* The SLPI firmware reads the layout of older OxygenOS */
+-		oneplus,sources-per-sensor = <2>;
++		/* The SLPI firmware of this phone reads the 3-source layout */
+ 
+ 		/* LSM6DSM */
+ 		gsensor-0 {
+-- 
+2.43.0
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0063-media-i2c-lc898128-Start-only-once-the-camera-stays-.patch b/device/testing/linux-postmarketos-qcom-sm8250/0063-media-i2c-lc898128-Start-only-once-the-camera-stays-.patch
new file mode 100644
index 0000000000..b15eb5e122
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0063-media-i2c-lc898128-Start-only-once-the-camera-stays-.patch
@@ -0,0 +1,172 @@
+From 2baddda90e9dfa39a74c2fdf511c35ca58b1c0d3 Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Mon, 9 Nov 2026 20:29:16 +0100
+Subject: [PATCH 63/63] media: i2c: lc898128: Start only once the camera stays
+ on
+
+Applications and udev power the image sensor up for a moment just to
+list the cameras, and every time the servo engaged and released the
+lens audibly. Start the servo only after the sensor has been powered
+for 1.5 seconds.
+
+Also drop DL_FLAG_RPM_ACTIVE: when the sensor was powered while the
+driver probed, the supplier count never came back down and the OIS
+stayed on with the camera off.
+
+Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
+---
+ drivers/media/i2c/lc898128.c | 68 ++++++++++++++++++++++++++----------
+ 1 file changed, 50 insertions(+), 18 deletions(-)
+
+diff --git a/drivers/media/i2c/lc898128.c b/drivers/media/i2c/lc898128.c
+index a09957391..a2af6a55c 100644
+--- a/drivers/media/i2c/lc898128.c
++++ b/drivers/media/i2c/lc898128.c
+@@ -7,16 +7,22 @@
+  * so the driver only powers it up and sends the start commands. It follows
+  * the image sensor named by "onnn,camera" through a runtime PM device link:
+  * stabilisation runs whenever the sensor is powered.
++ *
++ * Starting the servo moves the lens audibly, and applications power the
++ * sensor up briefly just to list the cameras. The servo therefore starts
++ * only once the sensor has stayed powered for a while.
+  */
+ 
+ #include <linux/delay.h>
+ #include <linux/device.h>
++#include <linux/devm-helpers.h>
+ #include <linux/i2c.h>
+ #include <linux/module.h>
+ #include <linux/of.h>
+ #include <linux/pm_runtime.h>
+ #include <linux/regulator/consumer.h>
+ #include <linux/unaligned.h>
++#include <linux/workqueue.h>
+ 
+ #define LC898128_REG_FW_VERSION		0x8000
+ #define LC898128_CMD_SERVO		0xf010
+@@ -26,6 +32,7 @@
+ #define LC898128_CMD_GYRO_INIT		0xf015
+ 
+ #define LC898128_READY_RETRIES		10
++#define LC898128_START_DELAY_MS		1500
+ 
+ static bool enable = true;
+ module_param(enable, bool, 0644);
+@@ -40,6 +47,8 @@ struct lc898128 {
+ 	struct i2c_client *client;
+ 	struct regulator_bulk_data supplies[ARRAY_SIZE(lc898128_supply_names)];
+ 	struct device_link *link;
++	struct delayed_work start_work;
++	bool started;
+ 	u32 gyro;
+ };
+ 
+@@ -133,27 +142,36 @@ static int lc898128_start(struct lc898128 *ois)
+ 	return 0;
+ }
+ 
+-static int lc898128_runtime_resume(struct device *dev)
++static void lc898128_start_work(struct work_struct *work)
+ {
+-	struct lc898128 *ois = dev_get_drvdata(dev);
++	struct lc898128 *ois = container_of(to_delayed_work(work),
++					    struct lc898128, start_work);
+ 	u32 version;
+ 	int ret;
+ 
+-	ret = regulator_bulk_enable(ARRAY_SIZE(ois->supplies), ois->supplies);
+-	if (ret)
+-		return ret;
+-
+-	usleep_range(5000, 6000);
+-
+ 	ret = lc898128_wait_ready(ois, &version);
+ 	if (!ret)
+ 		ret = lc898128_start(ois);
+ 	if (ret) {
+-		dev_err(dev, "failed to start: %d\n", ret);
+-		regulator_bulk_disable(ARRAY_SIZE(ois->supplies), ois->supplies);
+-		return ret;
++		dev_err(&ois->client->dev, "failed to start: %d\n", ret);
++		return;
+ 	}
+ 
++	ois->started = true;
++}
++
++static int lc898128_runtime_resume(struct device *dev)
++{
++	struct lc898128 *ois = dev_get_drvdata(dev);
++	int ret;
++
++	ret = regulator_bulk_enable(ARRAY_SIZE(ois->supplies), ois->supplies);
++	if (ret)
++		return ret;
++
++	schedule_delayed_work(&ois->start_work,
++			      msecs_to_jiffies(LC898128_START_DELAY_MS));
++
+ 	return 0;
+ }
+ 
+@@ -161,9 +179,14 @@ static int lc898128_runtime_suspend(struct device *dev)
+ {
+ 	struct lc898128 *ois = dev_get_drvdata(dev);
+ 
++	cancel_delayed_work_sync(&ois->start_work);
++
+ 	/* Let the lens settle before the power goes */
+-	lc898128_write(ois, LC898128_CMD_OIS_ENABLE, 0);
+-	lc898128_write(ois, LC898128_CMD_SERVO, LC898128_SERVO_OFF);
++	if (ois->started) {
++		lc898128_write(ois, LC898128_CMD_OIS_ENABLE, 0);
++		lc898128_write(ois, LC898128_CMD_SERVO, LC898128_SERVO_OFF);
++		ois->started = false;
++	}
+ 	regulator_bulk_disable(ARRAY_SIZE(ois->supplies), ois->supplies);
+ 
+ 	return 0;
+@@ -175,7 +198,7 @@ static int lc898128_probe(struct i2c_client *client)
+ 	struct i2c_client *sensor;
+ 	struct device_node *np;
+ 	struct lc898128 *ois;
+-	u32 flags, version;
++	u32 version;
+ 	unsigned int i;
+ 	int ret;
+ 
+@@ -220,6 +243,13 @@ static int lc898128_probe(struct i2c_client *client)
+ 		return dev_err_probe(dev, ret, "failed to read the version\n");
+ 	}
+ 
++	ret = devm_delayed_work_autocancel(dev, &ois->start_work,
++					   lc898128_start_work);
++	if (ret) {
++		put_device(&sensor->dev);
++		return ret;
++	}
++
+ 	pm_runtime_set_suspended(dev);
+ 	ret = devm_pm_runtime_enable(dev);
+ 	if (ret) {
+@@ -227,10 +257,12 @@ static int lc898128_probe(struct i2c_client *client)
+ 		return ret;
+ 	}
+ 
+-	flags = DL_FLAG_STATELESS | DL_FLAG_PM_RUNTIME;
+-	if (pm_runtime_active(&sensor->dev))
+-		flags |= DL_FLAG_RPM_ACTIVE;
+-	ois->link = device_link_add(&sensor->dev, dev, flags);
++	/*
++	 * No DL_FLAG_RPM_ACTIVE: if the sensor is powered right now, the OIS
++	 * only joins from its next power up, but the counts stay balanced.
++	 */
++	ois->link = device_link_add(&sensor->dev, dev,
++				    DL_FLAG_STATELESS | DL_FLAG_PM_RUNTIME);
+ 	put_device(&sensor->dev);
+ 	if (!ois->link)
+ 		return dev_err_probe(dev, -EINVAL, "failed to link to the camera\n");
+-- 
+2.43.0
+
