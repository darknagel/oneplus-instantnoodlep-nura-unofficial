--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0145-drm-msm-dp-skip-PUSH_IDLE-when-the-link-was-never-en.patch
@@ -0,0 +1,89 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Jesse Casco <jesse.casco@gmail.com>
+Date: Sat, 8 Aug 2026 13:13:25 -0400
+Subject: [PATCH] drm/msm/dp: skip PUSH_IDLE when the link was never enabled
+
+msm_dp_display_atomic_enable() returns early when link training fails,
+leaving ->power_on false and the main link down.
+msm_dp_display_atomic_disable() nevertheless writes DP_STATE_CTRL_PUSH_IDLE
+and waits for an idle-pattern completion that cannot arrive, so every failed
+enable is followed by "PUSH_IDLE pattern timedout".
+
+Every other step of the teardown is already gated on that flag:
+msm_dp_display_disable(), called from .atomic_post_disable(), returns early
+on !power_on. The PUSH_IDLE write is the only one that is not, so the
+controller's runtime-PM reference is then dropped without the link having
+been taken down.
+
+On glymur (Snapdragon X2 Elite) the consequence is not a warning. The SoC
+does not survive it: TrustZone force-stops the SOCCP and ADSP remote
+processors and the machine resets silently about 50 ms later, with no oops
+and no panic. On an ASUS Zenbook A16 (UX3607OA), whose eDP panel does not
+currently train, this reproduces without any compositor or GPU involvement:
+
+  # eDP enable has already failed with "Failed link training (rc=-104)"
+  echo 1 > /sys/class/graphics/fb0/blank
+
+  [535.645455] === marker ===
+  [535.694833] qcom_q6v5_pas d00000.remoteproc: fatal error received: \
+                 sys_m_smsm.c:512:TZ force stop
+  [535.694875] remoteproc remoteproc0: crash detected in soccp: type fatal error
+  [535.728857] qcom_q6v5_pas 6800000.remoteproc: fatal error received: \
+                 sys_m_smsm.c:783:err fatal notification received from TZ
+  <SoC reset>
+
+Gate the PUSH_IDLE write on ->power_on so the disable path is consistent
+with the rest of the teardown. With this applied the same sequence is
+harmless and the machine stays up; without it, it resets every time.
+
+The unconditional write dates back to the original DP driver
+(c943b4948b58 ("drm/msm/dp: add displayPort driver support")), but the
+surrounding code has been restructured several times since, so no Fixes:
+tag is offered.
+
+Note that the eDP link-training failure that exposes this on the A16 is a
+separate problem in the glymur eDP PHY and is reported separately; this
+change is about not damaging the machine when training fails, for whatever
+reason.
+
+Tested on ASUS Zenbook A16 (UX3607OA), Snapdragon X2 Elite Extreme, on
+linux-next next-20260803 and next-20260807. The machine has since been
+running next-20260807 with this patch as its daily driver.
+
+Link: https://lore.kernel.org/r/20260808171325.133041-1-jesse.casco@gmail.com
+Assisted-by: Anthropic:Claude-Opus-5
+Signed-off-by: Jesse Casco <jesse.casco@gmail.com>
+Reviewed-by: Dmitry Baryshkov <dmitry.baryshkov@oss.qualcomm.com>
+[ backport to 7.2: the hunk lands in msm_dp_bridge_atomic_disable(); in this tree the disable path's msm_dp_display_disable() is reached from msm_dp_bridge_atomic_post_disable() ]
+---
+ drivers/gpu/drm/msm/dp/dp_display.c | 14 ++++++++++++++
+ 1 file changed, 14 insertions(+)
+
+diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
+index 9c0ee32..9a12d3b 100644
+--- a/drivers/gpu/drm/msm/dp/dp_display.c
++++ b/drivers/gpu/drm/msm/dp/dp_display.c
+@@ -1481,6 +1481,20 @@ void msm_dp_bridge_atomic_disable(struct drm_bridge *drm_bridge,
+ 
+ 	msm_dp_display = container_of(dp, struct msm_dp_display_private, msm_dp_display);
+ 
++	/*
++	 * If .atomic_enable() bailed out - link training failure is the common
++	 * case - the mainlink was never brought up and ->power_on stayed false.
++	 * Driving the PUSH_IDLE pattern into a controller that was never
++	 * enabled times out, and .atomic_post_disable() then drops the
++	 * controller's runtime-PM reference without tearing the PHY back down,
++	 * because msm_dp_display_disable() returns early on !power_on.  On
++	 * glymur (Snapdragon X2 Elite) that combination is answered by a
++	 * TrustZone-level SOCCP/ADSP force-stop and a silent SoC reset.
++	 * There is nothing to push idle, so leave it alone.
++	 */
++	if (!dp->power_on)
++		return;
++
+ 	msm_dp_ctrl_push_idle(msm_dp_display->ctrl);
+ }
+ 
+-- 
+2.51.2
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0157-drm-msm-dp-don-t-take-extra-references-on-multiple-p.patch b/device/testing/linux-postmarketos-qcom-sm8250/0157-drm-msm-dp-don-t-take-extra-references-on-multiple-p.patch
new file mode 100644
index 0000000000..7a89c20107
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0157-drm-msm-dp-don-t-take-extra-references-on-multiple-p.patch
@@ -0,0 +1,34 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Dmitry Baryshkov <dmitry.baryshkov@oss.qualcomm.com>
+Date: Sat, 24 Oct 2026 03:35:22 +0300
+Subject: [PATCH] drm/msm/dp: don't take extra references on multiple plug
+ events
+
+The upper layers might signal multiple sequential HPD plug events. Don't
+take extra references and skip all further HPD plug events until we
+receive the unplug event.
+
+Fixes: 3ea2d1c3d154 ("drm/msm/dp: turn link_ready into plugged")
+Signed-off-by: Dmitry Baryshkov <dmitry.baryshkov@oss.qualcomm.com>
+Link: https://lore.kernel.org/r/20261024-hpd-irq-events-v8-6-6ee949e7a384@oss.qualcomm.com
+---
+ drivers/gpu/drm/msm/dp/dp_display.c | 3 +++
+ 1 file changed, 3 insertions(+)
+
+diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
+index 9a12d3b..fcc653a 100644
+--- a/drivers/gpu/drm/msm/dp/dp_display.c
++++ b/drivers/gpu/drm/msm/dp/dp_display.c
+@@ -402,6 +402,9 @@ static int msm_dp_hpd_plug_handle(struct msm_dp_display_private *dp)
+ 
+ 	guard(mutex)(&dp->plugged_lock);
+ 
++	if (dp->plugged)
++		return 0;
++
+ 	ret = pm_runtime_resume_and_get(&pdev->dev);
+ 	if (ret) {
+ 		DRM_ERROR("failed to pm_runtime_resume\n");
+-- 
+2.51.2
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0158-drm-msm-dp-hold-one-runtime-PM-reference-per-plugged.patch b/device/testing/linux-postmarketos-qcom-sm8250/0158-drm-msm-dp-hold-one-runtime-PM-reference-per-plugged.patch
new file mode 100644
index 0000000000..3070ba5ea6
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0158-drm-msm-dp-hold-one-runtime-PM-reference-per-plugged.patch
@@ -0,0 +1,73 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Joonhoe Kim <26rote@gmail.com>
+Date: Sat, 24 Oct 2026 14:19:52 +0900
+Subject: [PATCH] drm/msm/dp: hold one runtime PM reference per plugged state
+
+msm_dp_bridge_detect() takes a runtime PM reference and keeps it when
+it leaves the sink plugged, so that the plugged state keeps the
+controller on. If the sink was plugged already, the plugged state holds
+a reference, and the new one is leaked. If the sink was plugged and
+detect() finds it gone, it drops only its own reference and clears the
+plugged state, so the unplug handler skips the put and the plugged
+state's reference is leaked as well.
+
+detect() runs on every probe of the connector. When HPD comes from a
+later bridge, such as a USB-C connector, nothing else keeps the
+controller on, and the leaked references keep it and the MDSS core GDSC
+powered after the display is unplugged.
+
+Hold the function's own reference for the duration of the call, take
+the plugged state's reference when detect() sets the plugged state and
+drop it when detect() clears it.
+
+Link: https://lore.kernel.org/r/20261024051952.2006-1-26rote@gmail.com
+Fixes: 3ea2d1c3d154 ("drm/msm/dp: turn link_ready into plugged")
+Signed-off-by: Joonhoe Kim <26rote@gmail.com>
+Reviewed-by: Dmitry Baryshkov <dmitry.baryshkov@oss.qualcomm.com>
+---
+ drivers/gpu/drm/msm/dp/dp_display.c | 10 ++++++++--
+ 1 file changed, 8 insertions(+), 2 deletions(-)
+
+diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
+index fcc653a..f3a1372 100644
+--- a/drivers/gpu/drm/msm/dp/dp_display.c
++++ b/drivers/gpu/drm/msm/dp/dp_display.c
+@@ -835,6 +835,7 @@ enum drm_connector_status msm_dp_bridge_detect(struct drm_bridge *bridge,
+ 	u8 dpcd[DP_RECEIVER_CAP_SIZE];
+ 	struct drm_dp_desc desc;
+ 	bool phy_deinit;
++	bool was_plugged;
+ 	int ret;
+ 
+ 	dp = to_dp_bridge(bridge)->msm_dp_display;
+@@ -842,12 +843,14 @@ enum drm_connector_status msm_dp_bridge_detect(struct drm_bridge *bridge,
+ 	priv = container_of(dp, struct msm_dp_display_private, msm_dp_display);
+ 
+ 	guard(mutex)(&priv->plugged_lock);
+-	ret = pm_runtime_resume_and_get(&dp->pdev->dev);
++	PM_RUNTIME_ACQUIRE_IF_ENABLED(&dp->pdev->dev, pm);
++	ret = PM_RUNTIME_ACQUIRE_ERR(&pm);
+ 	if (ret) {
+ 		DRM_ERROR("failed to pm_runtime_resume\n");
+ 		return status;
+ 	}
+ 
++	was_plugged = priv->plugged;
+ 	phy_deinit = msm_dp_display_host_phy_init(priv);
+ 
+ 	msm_dp_aux_enable_xfers(priv->aux, true);
+@@ -897,7 +900,10 @@ end:
+ 			msm_dp_display_host_phy_exit(priv);
+ 		}
+ 
+-		pm_runtime_put_sync(&dp->pdev->dev);
++		if (was_plugged)
++			pm_runtime_put_noidle(&dp->pdev->dev);
++	} else if (!was_plugged) {
++		pm_runtime_get_noresume(&dp->pdev->dev);
+ 	}
+ 
+ 	return status;
+-- 
+2.51.2
+
