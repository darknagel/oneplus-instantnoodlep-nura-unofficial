index 0000000000..9bca16a351
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0074-arm64-dts-qcom-instantnoodlep-describe-the-AW8697-ha.patch
@@ -0,0 +1,73 @@
+From ea12e177d7f3e21b33350cb5afd4c9b7628df770 Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Tue, 10 Nov 2026 10:08:51 +0000
+Subject: [PATCH] arm64: dts: qcom: instantnoodlep: describe the AW8697 haptics
+
+Wire the AW8697 on QUP I2C11 using reset GPIO72 and interrupt
+GPIO118 from the stock project-19811 overlay. Use the 170 Hz
+LRA0619 tuning from the OnePlus driver, including drive level 54.
+The existing common OnePlus tree uses the same controller and pins.
+
+This enables the existing force-feedback driver for hardware testing;
+probe-time calibration and vibration still need device validation.
+
+Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
+---
+ .../qcom/sm8250-oneplus-instantnoodlep.dts    | 37 +++++++++++++++++++
+ 1 file changed, 37 insertions(+)
+
+diff --git a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+index 00008acaf..d1a0a0184 100644
+--- a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
++++ b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+@@ -2,6 +2,7 @@
+ 
+ #include <dt-bindings/media/video-interfaces.h>
+ #include <dt-bindings/gpio/gpio.h>
++#include <dt-bindings/leds/common.h>
+ #include <dt-bindings/arm/qcom,ids.h>
+ #include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+ #include <dt-bindings/phy/phy.h>
+@@ -2264,3 +2265,39 @@ &vamacro {
+ 	vdd-micb-supply = <&vreg_bob>;
+ 	qcom,dmic-sample-rate = <2400000>;
+ };
++
++&i2c11 {
++	status = "okay";
++
++	haptics@5a {
++		compatible = "awinic,aw8697";
++		reg = <0x5a>;
++		interrupts-extended = <&tlmm 118 IRQ_TYPE_EDGE_FALLING>;
++		reset-gpios = <&tlmm 72 GPIO_ACTIVE_HIGH>;
++		pinctrl-names = "default";
++		pinctrl-0 = <&haptics_irq_default>;
++		awinic,f0-preset = <1700>;
++		awinic,f0-coefficient = <260>;
++		awinic,f0-calibration-percent = <7>;
++		awinic,drive-level = <54>;
++		awinic,f0-detection-play-time = <5>;
++		awinic,f0-detection-wait-time = <3>;
++		awinic,f0-detection-repeat = <2>;
++		awinic,f0-detection-trace = <15>;
++		awinic,boost-debug = /bits/ 8 <0x30 0xeb 0xd4>;
++		awinic,tset = /bits/ 8 <0x12>;
++		awinic,r-spare = /bits/ 8 <0x68>;
++		awinic,bemf-upper-threshold = <4104>;
++		awinic,bemf-lower-threshold = <1016>;
++	};
++};
++
++&tlmm {
++	haptics_irq_default: haptics-irq-default-state {
++		pins = "gpio118";
++		function = "gpio";
++		drive-strength = <2>;
++		input-enable;
++		bias-pull-up;
++	};
++};
+-- 
+2.51.2
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0075-arm64-dts-qcom-instantnoodlep-expose-the-two-flash-L.patch b/device/testing/linux-postmarketos-qcom-sm8250/0075-arm64-dts-qcom-instantnoodlep-expose-the-two-flash-L.patch
