index 0000000000..6c84a5bfa2
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0075-arm64-dts-qcom-instantnoodlep-expose-the-two-flash-L.patch
@@ -0,0 +1,53 @@
+From e5dd4b8368fc397c33ef0c56d26cea918cc39e34 Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Tue, 10 Nov 2026 10:08:51 +0000
+Subject: [PATCH] arm64: dts: qcom: instantnoodlep: expose the two flash LEDs
+
+The stock camera flash uses PM8150L channels 0 and 1, corresponding
+to the mainline binding indices 1 and 2. Expose both channels through
+the existing flash driver without a default trigger.
+
+Start hardware validation with conservative limits of 100 mA torch,
+500 mA flash and 200 ms duration per channel. Camera synchronization
+and maximum output remain unvalidated.
+
+Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
+---
+ .../qcom/sm8250-oneplus-instantnoodlep.dts    | 24 +++++++++++++++++++
+ 1 file changed, 24 insertions(+)
+
+diff --git a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+index d1a0a0184..79e125810 100644
+--- a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
++++ b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+@@ -2301,3 +2301,27 @@ haptics_irq_default: haptics-irq-default-state {
+ 		bias-pull-up;
+ 	};
+ };
++
++&pm8150l_flash {
++	status = "okay";
++
++	led-0 {
++		function = LED_FUNCTION_FLASH;
++		color = <LED_COLOR_ID_WHITE>;
++		function-enumerator = <0>;
++		led-sources = <1>;
++		led-max-microamp = <100000>;
++		flash-max-microamp = <500000>;
++		flash-max-timeout-us = <200000>;
++	};
++
++	led-1 {
++		function = LED_FUNCTION_FLASH;
++		color = <LED_COLOR_ID_WHITE>;
++		function-enumerator = <1>;
++		led-sources = <2>;
++		led-max-microamp = <100000>;
++		flash-max-microamp = <500000>;
++		flash-max-timeout-us = <200000>;
++	};
++};
+-- 
+2.51.2
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0076-arm64-dts-qcom-instantnoodlep-stop-matching-the-wron.patch b/device/testing/linux-postmarketos-qcom-sm8250/0076-arm64-dts-qcom-instantnoodlep-stop-matching-the-wron.patch
new file mode 100644
index 0000000000..fe46671530
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0076-arm64-dts-qcom-instantnoodlep-stop-matching-the-wron.patch
@@ -0,0 +1,54 @@
+From e9647bb9f55ca418aa58e5c0e469ce6686ddca1c Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Tue, 10 Nov 2026 10:08:51 +0000
+Subject: [PATCH] arm64: dts: qcom: instantnoodlep: stop matching the wrong
+ charge pump
+
+The stock project-19811 overlay identifies the device at I2C5:0x66
+as a BQ2597x wireless charge pump. The BQ25980 driver has a different
+register layout and is already blacklisted on the test device.
+
+Correct the compatible and disable the node until wireless receiver
+control and the required charging limits are integrated. This avoids
+relying on a userspace blacklist to prevent the wrong driver binding.
+
+Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
+---
+ .../qcom/sm8250-oneplus-instantnoodlep.dts    | 20 ++++++++++---------
+ 1 file changed, 11 insertions(+), 9 deletions(-)
+
+diff --git a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+index 79e125810..3e47dd0b3 100644
+--- a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
++++ b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+@@ -1233,16 +1233,18 @@ nfc@28 {
+ };
+ 
+ &i2c5 {
+-    status = "okay";
++	status = "okay";
+ 
+-    charger@66 {
+-        compatible = "ti,bq25980";
+-        status = "ok";
+-        reg = <0x66>;
+-        interrupt-parent = <&tlmm>;
+-        interrupts = <0x0f 0x00>;
+-        monitored-battery = <&battery>;
+-    };
++	charger@66 {
++		/* Stock uses a BQ2597x wireless charge pump, not a BQ25980. */
++		compatible = "ti,bq2597x-standalone";
++		/* Requires the wireless receiver and validated charge limits. */
++		status = "disabled";
++		reg = <0x66>;
++		interrupt-parent = <&tlmm>;
++		interrupts = <0x0f 0x00>;
++		monitored-battery = <&battery>;
++	};
+ };
+ 
+ &i2c16 {
+-- 
+2.51.2
+
