+# Maintainer: Timo <1788603+darknagel@users.noreply.github.com>
+# Graphical side of the OnePlus 8 Pro in-display fingerprint sensor: lights the
+# sensor while fprintd waits for a finger (also over the Plasma lock screen) and
+# adds the PAM stacks kscreenlocker's kde-fingerprint service includes.
+pkgname=goodix-fp-overlay
+pkgver=1.0
+pkgrel=0
+pkgdesc="Sensor light and lock screen setup for the OnePlus 8 Pro fingerprint reader"
+url="https://github.com/darknagel/oneplus-instantnoodlep-nura-unofficial"
+arch="aarch64"
+license="LGPL-2.1-or-later"
+depends="fprintd fprintd-pam"
+makedepends="
+	cmake
+	layer-shell-qt-dev
+	plasma-wayland-protocols
+	qt6-qtbase-dev
+	qt6-qtwayland-dev
+	samurai
+	"
+options="!check" # no tests
+source="CMakeLists.txt
+	goodix-fp-overlay.cpp
+	goodix-fp-overlay.desktop
+	fingerprint-auth
+	postlogin
+	"
+builddir="$srcdir/src"
+
+prepare() {
+	default_prepare
+	# abuild links the local sources; cmake would install the .desktop
+	# files as those links
+	mkdir -p "$builddir"
+	local f
+	for f in $source; do
+		cp -L "$srcdir/$f" "$builddir"/
+	done
+}
+
+build() {
+	cmake -B build -G Ninja \
+		-DCMAKE_BUILD_TYPE=None \
+		-DCMAKE_INSTALL_PREFIX=/usr
+	cmake --build build
+}
+
+package() {
+	DESTDIR="$pkgdir" cmake --install build
+	# kscreenlocker's /etc/pam.d/kde-fingerprint includes these two
+	install -Dm644 fingerprint-auth postlogin -t "$pkgdir"/etc/pam.d/
+}
