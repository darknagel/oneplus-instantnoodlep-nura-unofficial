--- /dev/null
+++ b/device/testing/goodix-fp-overlay/goodix-fp-overlay.desktop
@@ -0,0 +1,8 @@
+[Desktop Entry]
+Type=Application
+Name=Fingerprint sensor light
+Comment=Lights the in-display fingerprint sensor while fprintd waits for a finger
+Exec=/usr/bin/goodix-fp-overlay
