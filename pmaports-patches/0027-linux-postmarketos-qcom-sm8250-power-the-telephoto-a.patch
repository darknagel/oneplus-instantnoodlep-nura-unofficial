From 09b098f69a0574bf5152dfcf6028c22abf5d4540 Mon Sep 17 00:00:00 2001
From: Timo <1788603+darknagel@users.noreply.github.com>
Date: Mon, 9 Nov 2026 18:06:49 +0100
Subject: [PATCH] linux-postmarketos-qcom-sm8250: power the telephoto actuator
 bus on the OnePlus 8 Pro

The telephoto focus actuator talked to the camera I2C bus without its 1.8 V pull-up supply. The CCI then timed out and reset both masters, which made the front camera fail to probe at some boots.

Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
---
 ...ia-i2c-lc898217xc-Add-the-I-O-supply.patch | 32 +++++++++++++++++++
 ...m8250-oneplus-instantnoodlep-Power-t.patch | 30 +++++++++++++++++
 .../linux-postmarketos-qcom-sm8250/APKBUILD   |  6 +++-
 3 files changed, 67 insertions(+), 1 deletion(-)
 create mode 100644 device/testing/linux-postmarketos-qcom-sm8250/0050-media-i2c-lc898217xc-Add-the-I-O-supply.patch
 create mode 100644 device/testing/linux-postmarketos-qcom-sm8250/0051-arm64-dts-qcom-sm8250-oneplus-instantnoodlep-Power-t.patch

diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0050-media-i2c-lc898217xc-Add-the-I-O-supply.patch b/device/testing/linux-postmarketos-qcom-sm8250/0050-media-i2c-lc898217xc-Add-the-I-O-supply.patch
new file mode 100644
index 0000000000..3f5073f4c5
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0050-media-i2c-lc898217xc-Add-the-I-O-supply.patch
@@ -0,0 +1,32 @@
+From 8bc655c5bb1c767a76c5e5305694adce50732004 Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Mon, 9 Nov 2026 18:02:45 +0100
+Subject: [PATCH 50/51] media: i2c: lc898217xc: Add the I/O supply
+
+The I2C bus of the actuator can be powered by a separate rail, as on the
+OnePlus 8 Pro, where the camera I2C pull-ups hang on the 1.8 V camera I/O
+supply. Without it, setting the focus while no sensor holds that rail on
+times out, and the CCI controller resets both of its masters.
+
+Add an optional "vio" supply.
+
+Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
+---
+ drivers/media/i2c/lc898217xc.c | 1 +
+ 1 file changed, 1 insertion(+)
+
+diff --git a/drivers/media/i2c/lc898217xc.c b/drivers/media/i2c/lc898217xc.c
+index 03e07a173..9667319a1 100644
+--- a/drivers/media/i2c/lc898217xc.c
++++ b/drivers/media/i2c/lc898217xc.c
+@@ -25,6 +25,7 @@
+ static const char *const lc898217xc_supply_names[] = {
+ 	"vdd",
+ 	"vana",
++	"vio",
+ };
+ 
+ struct lc898217xc {
+-- 
+2.43.0
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0051-arm64-dts-qcom-sm8250-oneplus-instantnoodlep-Power-t.patch b/device/testing/linux-postmarketos-qcom-sm8250/0051-arm64-dts-qcom-sm8250-oneplus-instantnoodlep-Power-t.patch
new file mode 100644
index 0000000000..77c3e6fae0
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0051-arm64-dts-qcom-sm8250-oneplus-instantnoodlep-Power-t.patch
@@ -0,0 +1,30 @@
+From 299a10a41dcb8560136c29d747fb054d7fc40cf2 Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Mon, 9 Nov 2026 18:02:46 +0100
+Subject: [PATCH 51/51] arm64: dts: qcom: sm8250-oneplus-instantnoodlep: Power
+ the telephoto actuator bus
+
+The camera I2C pull-ups are on L7F. Give the telephoto focus actuator
+that supply, like the other actuators, so it does not talk to an
+unpowered bus and make the CCI reset the front camera's master at boot.
+
+Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
+---
+ arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts | 1 +
+ 1 file changed, 1 insertion(+)
+
+diff --git a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+index 81263864f..538d1049c 100644
+--- a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
++++ b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+@@ -1120,6 +1120,7 @@ cam_tele_af: lens@74 {
+ 
+ 		vdd-supply = <&vreg_cam_tele_vaf>;
+ 		vana-supply = <&vreg_l6f_2p8>;
++		vio-supply = <&vreg_l7f_1p8>;
+ 	};
+ };
+ 
+-- 
+2.43.0
+
