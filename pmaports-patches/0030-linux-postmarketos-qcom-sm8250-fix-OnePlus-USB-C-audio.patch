+From 4356e3ff615d4609058441bed7710d28b860036f Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Mon, 9 Nov 2026 18:17:12 +0000
+Subject: [PATCH] dt-bindings: sound: describe WCD938x USB-C audio
+ routing
+
+Describe the codec as a Type-C mode-switch endpoint and allow FSA4480 to
+connect both the USB-C connector and the codec through graph ports.
+Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
+---
+ .../devicetree/bindings/sound/qcom,wcd938x.yaml    |  8 ++++++++
+ .../devicetree/bindings/usb/fcs,fsa4480.yaml       | 14 +++++++++++++-
+ 2 files changed, 21 insertions(+), 1 deletion(-)
+
+diff --git a/Documentation/devicetree/bindings/sound/qcom,wcd938x.yaml b/Documentation/devicetree/bindings/sound/qcom,wcd938x.yaml
+index ab1c6285d..dc33b8228 100644
+--- a/Documentation/devicetree/bindings/sound/qcom,wcd938x.yaml
++++ b/Documentation/devicetree/bindings/sound/qcom,wcd938x.yaml
+@@ -23,6 +23,14 @@ properties:
+       - qcom,wcd9380-codec
+       - qcom,wcd9385-codec
+ 
++  mode-switch:
++    type: boolean
++    description: Receive USB-C audio accessory events from the analog audio switch.
++
++  port:
++    $ref: /schemas/graph.yaml#/properties/port
++    description: Connection to the USB-C analog audio switch.
++
+   mux-controls:
+     description: A reference to the audio mux switch for
+       switching CTIA/OMTP Headset types
+diff --git a/Documentation/devicetree/bindings/usb/fcs,fsa4480.yaml b/Documentation/devicetree/bindings/usb/fcs,fsa4480.yaml
+index 89b1fb90a..2c7235916 100644
+--- a/Documentation/devicetree/bindings/usb/fcs,fsa4480.yaml
++++ b/Documentation/devicetree/bindings/usb/fcs,fsa4480.yaml
+@@ -69,10 +69,22 @@ properties:
+                   - AUX+ connected to SBU2
+                   - AUX- connected to SBU1
+ 
++  ports:
++    $ref: /schemas/graph.yaml#/properties/ports
++    properties:
++      port@0:
++        $ref: /schemas/graph.yaml#/properties/port
++        description: Connection to the USB-C connector.
++      port@1:
++        $ref: /schemas/graph.yaml#/properties/port
++        description: Analog audio connection to the codec for accessory detection.
++    required:
++      - port@0
++      - port@1
++
+ required:
+   - compatible
+   - reg
+-  - port
+ 
+ allOf:
+   - $ref: usb-switch.yaml#
+-- 
+2.56.0
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0056-ASoC-wcd-mbhc-keep-the-codec-powered-during-detectio.patch b/device/testing/linux-postmarketos-qcom-sm8250/0056-ASoC-wcd-mbhc-keep-the-codec-powered-during-detectio.patch
new file mode 100644
index 0000000..41f278e
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0056-ASoC-wcd-mbhc-keep-the-codec-powered-during-detectio.patch
@@ -0,0 +1,42 @@
+From 7a1f18b7a7817b0c74d6a5bed1e5dfbee66f878f Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Mon, 9 Nov 2026 18:17:12 +0000
+Subject: [PATCH] ASoC: wcd-mbhc: keep the codec powered during detection
+
+Hold a runtime PM reference for the deferred headset detection worker.
+Otherwise register reads and ADC polling can run after the codec
+suspends. Balance the reference on every worker exit.
+Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
+---
+ sound/soc/codecs/wcd-mbhc-v2.c | 8 ++++++++
+ 1 file changed, 8 insertions(+)
+
+diff --git a/sound/soc/codecs/wcd-mbhc-v2.c b/sound/soc/codecs/wcd-mbhc-v2.c
+index bb0c8478a..c4faa8087 100644
+--- a/sound/soc/codecs/wcd-mbhc-v2.c
++++ b/sound/soc/codecs/wcd-mbhc-v2.c
+@@ -516,6 +516,13 @@ static void mbhc_plug_detect_fn(struct work_struct *work)
+ 	struct snd_soc_component *component = mbhc->component;
+ 	enum snd_jack_types jack_type;
+ 	bool detection_type;
++	int ret;
++
++	ret = pm_runtime_get_sync(component->dev);
++	if (ret < 0 && ret != -EACCES) {
++		pm_runtime_put_noidle(component->dev);
++		return;
++	}
+ 
+ 	mutex_lock(&mbhc->lock);
+ 
+@@ -579,6 +586,7 @@ static void mbhc_plug_detect_fn(struct work_struct *work)
+ exit:
+ 	mbhc->in_swch_irq_handler = false;
+ 	mutex_unlock(&mbhc->lock);
++	pm_runtime_put_autosuspend(component->dev);
+ }
+ 
+ static irqreturn_t wcd_mbhc_mech_plug_detect_irq(int irq, void *data)
+-- 
+2.56.0
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0057-ASoC-wcd938x-receive-USB-C-audio-accessory-events.patch b/device/testing/linux-postmarketos-qcom-sm8250/0057-ASoC-wcd938x-receive-USB-C-audio-accessory-events.patch
new file mode 100644
index 0000000..297cd56
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0057-ASoC-wcd938x-receive-USB-C-audio-accessory-events.patch
@@ -0,0 +1,198 @@
+From d45de81d0ae2d474ba3ba11f0dd1a3bd2c777366 Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Mon, 9 Nov 2026 18:17:12 +0000
+Subject: [PATCH] ASoC: wcd938x: receive USB-C audio accessory events
+
+Use Type-C audio accessory notifications for boards without a mechanical
+headset jack. Serialize notifications with jack initialization and
+teardown, and keep the codec powered while reporting plug and unplug
+events.
+
+Boards without mode-switch retain the existing jack-detection behavior.
+Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
+---
+ sound/soc/codecs/Kconfig   |  2 +
+ sound/soc/codecs/wcd938x.c | 99 ++++++++++++++++++++++++++++++++++++--
+ 2 files changed, 97 insertions(+), 4 deletions(-)
+
+diff --git a/sound/soc/codecs/Kconfig b/sound/soc/codecs/Kconfig
+index c19a0d572..a4a05cfcd 100644
+--- a/sound/soc/codecs/Kconfig
++++ b/sound/soc/codecs/Kconfig
+@@ -2480,12 +2480,14 @@ config SND_SOC_WCD938X
+ 	depends on SND_SOC_WCD938X_SDW
+ 	tristate
+ 	depends on SOUNDWIRE || !SOUNDWIRE
++	depends on TYPEC || !TYPEC
+ 	select SND_SOC_WCD_CLASSH
+ 	select SND_SOC_WCD_COMMON
+ 	select MULTIPLEXER
+ 
+ config SND_SOC_WCD938X_SDW
+ 	tristate "WCD9380/WCD9385 Codec - SDW"
++	depends on TYPEC || !TYPEC
+ 	select SND_SOC_WCD938X
+ 	select SND_SOC_WCD_MBHC
+ 	select REGMAP_IRQ
+diff --git a/sound/soc/codecs/wcd938x.c b/sound/soc/codecs/wcd938x.c
+index c69e18667..3697b33c8 100644
+--- a/sound/soc/codecs/wcd938x.c
++++ b/sound/soc/codecs/wcd938x.c
+@@ -20,6 +20,8 @@
+ #include <sound/soc-dapm.h>
+ #include <linux/mux/consumer.h>
+ #include <linux/regulator/consumer.h>
++#include <linux/usb/typec_mux.h>
++#include <linux/usb/typec_altmode.h>
+ 
+ #include "wcd-clsh-v2.h"
+ #include "wcd-common.h"
+@@ -151,6 +153,8 @@ struct wcd938x_priv {
+ 	struct device_node *rxnode, *txnode;
+ 	struct regmap *regmap;
+ 	struct mutex micb_lock;
++	struct mutex typec_lock;
++	unsigned long typec_mode;
+ 	/* mbhc module */
+ 	struct wcd_mbhc *wcd_mbhc;
+ 	struct wcd_mbhc_config mbhc_cfg;
+@@ -3135,6 +3139,9 @@ static void wcd938x_soc_codec_remove(struct snd_soc_component *component)
+ {
+ 	struct wcd938x_priv *wcd938x = snd_soc_component_get_drvdata(component);
+ 
++	mutex_lock(&wcd938x->typec_lock);
++	wcd938x->jack = NULL;
++	mutex_unlock(&wcd938x->typec_lock);
+ 	wcd938x_mbhc_deinit(component);
+ 
+ 	free_irq(wcd938x->aux_pdm_wd_int, wcd938x);
+@@ -3144,17 +3151,95 @@ static void wcd938x_soc_codec_remove(struct snd_soc_component *component)
+ 	wcd_clsh_ctrl_free(wcd938x->clsh_info);
+ }
+ 
++/* Serialize Type-C notifications with sound-card jack initialization. */
++static int wcd938x_typec_report(struct wcd938x_priv *wcd, bool plugged)
++{
++	struct device *dev = wcd->common.dev;
++	int ret;
++
++	/* The sound card may initialize the jack before runtime PM is enabled. */
++	ret = pm_runtime_get_sync(dev);
++	if (ret < 0 && ret != -EACCES) {
++		pm_runtime_put_noidle(dev);
++		return ret;
++	}
++
++	if (plugged)
++		ret = wcd_mbhc_typec_report_plug(wcd->wcd_mbhc);
++	else
++		ret = wcd_mbhc_typec_report_unplug(wcd->wcd_mbhc);
++
++	pm_runtime_put_autosuspend(dev);
++
++	return ret;
++}
++
++static int wcd938x_typec_mux_set(struct typec_mux_dev *mux,
++			       struct typec_mux_state *state)
++{
++	struct wcd938x_priv *wcd = typec_mux_get_drvdata(mux);
++	bool was_audio, is_audio;
++	int ret = 0;
++
++	mutex_lock(&wcd->typec_lock);
++	was_audio = wcd->typec_mode == TYPEC_MODE_AUDIO;
++	is_audio = !state->alt && state->mode == TYPEC_MODE_AUDIO;
++	if (wcd->jack && was_audio != is_audio)
++		ret = wcd938x_typec_report(wcd, is_audio);
++	if (!ret)
++		wcd->typec_mode = is_audio ? TYPEC_MODE_AUDIO : TYPEC_STATE_SAFE;
++	mutex_unlock(&wcd->typec_lock);
++
++	return ret;
++}
++
++static void wcd938x_typec_mux_unregister(void *data)
++{
++	typec_mux_unregister(data);
++}
++
++static int wcd938x_add_typec(struct wcd938x_priv *wcd, struct device *dev)
++{
++	struct typec_mux_desc desc = {
++		.drvdata = wcd,
++		.fwnode = dev_fwnode(dev),
++		.set = wcd938x_typec_mux_set,
++	};
++	struct typec_mux_dev *mux;
++
++	if (!wcd->mbhc_cfg.typec_analog_mux)
++		return 0;
++
++	mux = typec_mux_register(dev, &desc);
++	if (IS_ERR(mux))
++		return dev_err_probe(dev, PTR_ERR(mux), "failed to register Type-C mux\n");
++
++	return devm_add_action_or_reset(dev, wcd938x_typec_mux_unregister, mux);
++}
++
+ static int wcd938x_codec_set_jack(struct snd_soc_component *comp,
+ 				  struct snd_soc_jack *jack, void *data)
+ {
+ 	struct wcd938x_priv *wcd = dev_get_drvdata(comp->dev);
+ 
+-	if (jack)
+-		return wcd_mbhc_start(wcd->wcd_mbhc, &wcd->mbhc_cfg, jack);
+-	else
++	int ret = 0;
++
++	mutex_lock(&wcd->typec_lock);
++	if (jack) {
++		ret = wcd_mbhc_start(wcd->wcd_mbhc, &wcd->mbhc_cfg, jack);
++		if (!ret) {
++			wcd->jack = jack;
++			if (wcd->mbhc_cfg.typec_analog_mux &&
++			    wcd->typec_mode == TYPEC_MODE_AUDIO)
++				ret = wcd938x_typec_report(wcd, true);
++		}
++	} else {
++		wcd->jack = NULL;
+ 		wcd_mbhc_stop(wcd->wcd_mbhc);
++	}
++	mutex_unlock(&wcd->typec_lock);
+ 
+-	return 0;
++	return ret;
+ }
+ 
+ static const struct snd_soc_component_driver soc_codec_dev_wcd938x = {
+@@ -3249,6 +3334,7 @@ static int wcd938x_populate_dt_data(struct wcd938x_priv *wcd938x, struct device
+ 	cfg->hph_thr = 50;
+ 
+ 	wcd_dt_parse_mbhc_data(dev, cfg);
++	cfg->typec_analog_mux = device_property_read_bool(dev, "mode-switch");
+ 
+ 	return 0;
+ }
+@@ -3487,6 +3573,7 @@ static int wcd938x_probe(struct platform_device *pdev)
+ 
+ 	dev_set_drvdata(dev, wcd938x);
+ 	mutex_init(&wcd938x->micb_lock);
++	mutex_init(&wcd938x->typec_lock);
+ 	wcd938x->common.dev = dev;
+ 	wcd938x->common.max_bias = 4;
+ 
+@@ -3494,6 +3581,10 @@ static int wcd938x_probe(struct platform_device *pdev)
+ 	if (ret)
+ 		return ret;
+ 
++	ret = wcd938x_add_typec(wcd938x, dev);
++	if (ret)
++		return ret;
++
+ 	ret = wcd938x_add_slave_components(wcd938x, dev, &match);
+ 	if (ret)
+ 		return ret;
+-- 
+2.56.0
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0058-usb-typec-fsa4480-forward-accessory-events-to-the-co.patch b/device/testing/linux-postmarketos-qcom-sm8250/0058-usb-typec-fsa4480-forward-accessory-events-to-the-co.patch
new file mode 100644
index 0000000..8241ac4
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0058-usb-typec-fsa4480-forward-accessory-events-to-the-co.patch
@@ -0,0 +1,60 @@
+From d7e675968080835f0b8f6b2785f1c3b6396cebcf Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Mon, 9 Nov 2026 18:17:12 +0000
+Subject: [PATCH] usb: typec: fsa4480: forward accessory events to the
+ codec
+
+Forward successful mode changes to the connected codec so its headset
+detection follows actual USB-C audio accessory attachment. Release the
+codec mux reference when the switch is removed.
+Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
+---
+ drivers/usb/typec/mux/fsa4480.c | 18 +++++++++++++++++-
+ 1 file changed, 17 insertions(+), 1 deletion(-)
+
+diff --git a/drivers/usb/typec/mux/fsa4480.c b/drivers/usb/typec/mux/fsa4480.c
+index bea0c1dee..fe6af2746 100644
+--- a/drivers/usb/typec/mux/fsa4480.c
++++ b/drivers/usb/typec/mux/fsa4480.c
+@@ -57,6 +57,7 @@ struct fsa4480 {
+ 
+ 	struct typec_switch_dev *sw;
+ 	struct typec_mux_dev *mux;
++	struct typec_mux *codec;
+ 
+ 	struct regmap *regmap;
+ 
+@@ -185,7 +186,15 @@ static int fsa4480_mux_set(struct typec_mux_dev *mux, struct typec_mux_state *st
+ 
+ 	mutex_unlock(&fsa->lock);
+ 
+-	return ret;
++	if (ret)
++		return ret;
++
++	return typec_mux_set(fsa->codec, state);
++}
++
++static void fsa4480_codec_put(void *data)
++{
++	typec_mux_put(data);
+ }
+ 
+ enum {
+@@ -263,6 +272,13 @@ static int fsa4480_probe(struct i2c_client *client)
+ 	if (!fsa)
+ 		return -ENOMEM;
+ 
++	fsa->codec = fwnode_typec_mux_get(dev_fwnode(dev));
++	if (IS_ERR(fsa->codec))
++		return dev_err_probe(dev, PTR_ERR(fsa->codec), "failed to get codec mux\n");
++	ret = devm_add_action_or_reset(dev, fsa4480_codec_put, fsa->codec);
++	if (ret)
++		return ret;
++
+ 	fsa->client = client;
+ 	mutex_init(&fsa->lock);
+ 
+-- 
+2.56.0
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0059-ASoC-lpass-rx-macro-sort-register-defaults.patch b/device/testing/linux-postmarketos-qcom-sm8250/0059-ASoC-lpass-rx-macro-sort-register-defaults.patch
new file mode 100644
index 0000000..b18641d
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0059-ASoC-lpass-rx-macro-sort-register-defaults.patch
@@ -0,0 +1,51 @@
+From b815c1413be554ead9f0f3aa5933c744672022d8 Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Mon, 9 Nov 2026 18:17:12 +0000
+Subject: [PATCH] ASoC: lpass-rx-macro: sort register defaults
+
+Keep the RX macro register defaults in ascending address order, as
+regmap requires. This removes the unsorted-register-default warning at
+probe.
+Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
+---
+ sound/soc/codecs/lpass-rx-macro.c | 10 ++++++++++
+ 1 file changed, 10 insertions(+)
+
+diff --git a/sound/soc/codecs/lpass-rx-macro.c b/sound/soc/codecs/lpass-rx-macro.c
+index 6233aa9f5..77b409623 100644
+--- a/sound/soc/codecs/lpass-rx-macro.c
++++ b/sound/soc/codecs/lpass-rx-macro.c
+@@ -7,6 +7,7 @@
+ #include <linux/io.h>
+ #include <linux/platform_device.h>
+ #include <linux/pm_runtime.h>
++#include <linux/sort.h>
+ #include <linux/clk.h>
+ #include <sound/soc.h>
+ #include <sound/pcm.h>
+@@ -3760,6 +3761,14 @@ static const struct snd_soc_component_driver rx_macro_component_drv = {
+ 	.num_dapm_routes = ARRAY_SIZE(rx_audio_map),
+ };
+ 
++static int rx_macro_reg_default_cmp(const void *a, const void *b)
++{
++	const struct reg_default *ra = a;
++	const struct reg_default *rb = b;
++
++	return (ra->reg > rb->reg) - (ra->reg < rb->reg);
++}
++
+ static int rx_macro_probe(struct platform_device *pdev)
+ {
+ 	struct device *dev = &pdev->dev;
+@@ -3852,6 +3861,7 @@ static int rx_macro_probe(struct platform_device *pdev)
+ 	if (!reg_config)
+ 		return -ENOMEM;
+ 
++	sort(reg_defaults, def_count, sizeof(*reg_defaults), rx_macro_reg_default_cmp, NULL);
+ 	reg_config->reg_defaults = reg_defaults;
+ 	reg_config->num_reg_defaults = def_count;
+ 
+-- 
+2.56.0
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0060-arm64-dts-qcom-sm8250-oneplus-instantnoodlep-wire-US.patch b/device/testing/linux-postmarketos-qcom-sm8250/0060-arm64-dts-qcom-sm8250-oneplus-instantnoodlep-wire-US.patch
new file mode 100644
index 0000000..a02699f
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0060-arm64-dts-qcom-sm8250-oneplus-instantnoodlep-wire-US.patch
@@ -0,0 +1,99 @@
+From f496339d7d6f52be4b6f493a6fd8d8799492078c Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Mon, 9 Nov 2026 18:17:12 +0000
+Subject: [PATCH] arm64: dts: qcom: sm8250-oneplus-instantnoodlep: wire
+ USB-C audio
+
+Describe the FSA4480 analog switch at I2C address 0x42 and connect it to
+the Type-C connector and WCD9385 codec. Advertise audio accessories so a
+normal USB connection no longer triggers mechanical headset detection.
+
+Speaker playback and ordinary USB attachment were tested. Analog USB-C
+headset playback, microphone and buttons still require hardware testing.
+Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
+---
+ .../qcom/sm8250-oneplus-instantnoodlep.dts    | 40 +++++++++++++++++++
+ 1 file changed, 40 insertions(+)
+
+diff --git a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+index 44f029275..4f040dcbc 100644
+--- a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
++++ b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+@@ -559,6 +559,7 @@ battery: battery {
