diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0069-Input-s6sy761-validate-the-initialized-multitouch-ax.patch b/device/testing/linux-postmarketos-qcom-sm8250/0069-Input-s6sy761-validate-the-initialized-multitouch-ax.patch
new file mode 100644
index 0000000000..f8618a26e9
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0069-Input-s6sy761-validate-the-initialized-multitouch-ax.patch
@@ -0,0 +1,33 @@
+From e47ddb4bc0b954f35be7fb1a6b9a12a0a38df9a2 Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Tue, 10 Nov 2026 10:00:31 +0000
+Subject: [PATCH] Input: s6sy761 - validate the initialized multitouch axes
+
+The driver initializes ABS_MT_POSITION_X/Y before parsing touchscreen
+properties. ABS_X/Y are populated later by input_mt_init_slots, so
+checking them before that call emits a warning even when both dimensions
+are valid. Check the multitouch axes that were actually initialized.
+
+Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
+---
+ drivers/input/touchscreen/s6sy761.c | 4 ++--
+ 1 file changed, 2 insertions(+), 2 deletions(-)
+
+diff --git a/drivers/input/touchscreen/s6sy761.c b/drivers/input/touchscreen/s6sy761.c
+index 0f24a9b73..3d8fcfa7f 100644
+--- a/drivers/input/touchscreen/s6sy761.c
++++ b/drivers/input/touchscreen/s6sy761.c
+@@ -439,8 +439,8 @@ static int s6sy761_probe(struct i2c_client *client)
+ 
+ 	touchscreen_parse_properties(sdata->input, true, &sdata->prop);
+ 
+-	if (!input_abs_get_max(sdata->input, ABS_X) ||
+-	    !input_abs_get_max(sdata->input, ABS_Y)) {
++	if (!input_abs_get_max(sdata->input, ABS_MT_POSITION_X) ||
++	    !input_abs_get_max(sdata->input, ABS_MT_POSITION_Y)) {
+ 		dev_warn(&client->dev, "the axis have not been set\n");
+ 	}
+ 
+-- 
+2.51.2
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0070-drm-panel-samsung-ams678uw01-defer-brightness-access.patch b/device/testing/linux-postmarketos-qcom-sm8250/0070-drm-panel-samsung-ams678uw01-defer-brightness-access.patch
new file mode 100644
index 0000000000..eb1cde0757
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0070-drm-panel-samsung-ams678uw01-defer-brightness-access.patch
@@ -0,0 +1,75 @@
+From 9838910fc4eeb5f7c44263f4f5fb80c33b4a6592 Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Tue, 10 Nov 2026 10:00:31 +0000
+Subject: [PATCH] drm/panel: samsung-ams678uw01: defer brightness access until
+ prepared
+
+Backlight sysfs can be accessed as soon as the device is registered,
+before the DSI host and panel are ready. Cache early brightness writes
+and let drm_panel_enable apply them through the backlight core. Return
+the cached brightness while unprepared instead of issuing a DCS read.
+
+Restore the original DSI mode flags after both successful and failed
+brightness transfers; a failed transfer must not leave LPM disabled.
+
+Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
+---
+ .../gpu/drm/panel/panel-samsung-ams678uw01.c  | 23 +++++++++++--------
+ 1 file changed, 14 insertions(+), 9 deletions(-)
+
+diff --git a/drivers/gpu/drm/panel/panel-samsung-ams678uw01.c b/drivers/gpu/drm/panel/panel-samsung-ams678uw01.c
+index 6229e41a7..200774717 100644
+--- a/drivers/gpu/drm/panel/panel-samsung-ams678uw01.c
++++ b/drivers/gpu/drm/panel/panel-samsung-ams678uw01.c
+@@ -330,34 +330,39 @@ static const struct drm_panel_funcs ams678uw01_panel_funcs = {
+ static int ams678uw01_bl_update_status(struct backlight_device *bl)
+ {
+ 	struct mipi_dsi_device *dsi = bl_get_data(bl);
++	struct ams678uw01 *ctx = mipi_dsi_get_drvdata(dsi);
++	unsigned long mode_flags = dsi->mode_flags;
+ 	u16 brightness = backlight_get_brightness(bl);
+ 	int ret;
+ 
+-	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
++	/* The backlight core applies the cached value when enabling the panel. */
++	if (!ctx->panel.prepared)
++		return 0;
+ 
++	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+ 	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+-	if (ret < 0)
+-		return ret;
+-
+-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
++	dsi->mode_flags = mode_flags;
+ 
+-	return 0;
++	return ret;
+ }
+ 
+ static int ams678uw01_bl_get_brightness(struct backlight_device *bl)
+ {
+ 	struct mipi_dsi_device *dsi = bl_get_data(bl);
++	struct ams678uw01 *ctx = mipi_dsi_get_drvdata(dsi);
++	unsigned long mode_flags = dsi->mode_flags;
+ 	u16 brightness;
+ 	int ret;
+ 
+-	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
++	if (!ctx->panel.prepared)
++		return bl->props.brightness;
+ 
++	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+ 	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
++	dsi->mode_flags = mode_flags;
+ 	if (ret < 0)
+ 		return ret;
+ 
+-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+-
+ 	return brightness;
+ }
+ 
+-- 
+2.51.2
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0071-arm64-dts-qcom-sm8250-supply-both-PCIe-IOMMU-cells.patch b/device/testing/linux-postmarketos-qcom-sm8250/0071-arm64-dts-qcom-sm8250-supply-both-PCIe-IOMMU-cells.patch
new file mode 100644
index 0000000000..4f41476db0
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0071-arm64-dts-qcom-sm8250-supply-both-PCIe-IOMMU-cells.patch
@@ -0,0 +1,55 @@
+From a03b296c8ac225a86163d377f10ee4f05596678b Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Tue, 10 Nov 2026 10:08:51 +0000
+Subject: [PATCH] arm64: dts: qcom: sm8250: supply both PCIe IOMMU cells
+
+The application SMMU declares two IOMMU cells, but the PCIe maps
+supply only the stream ID. Add an explicit zero stream-match mask
+to each mapping, preserving the existing IDs and single-RID ranges.
+This avoids the malformed-map compatibility fallback at boot.
+
+Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
+---
+ arch/arm64/boot/dts/qcom/sm8250.dtsi | 12 ++++++------
+ 1 file changed, 6 insertions(+), 6 deletions(-)
+
+diff --git a/arch/arm64/boot/dts/qcom/sm8250.dtsi b/arch/arm64/boot/dts/qcom/sm8250.dtsi
+index 20764b606..30c37adaa 100644
+--- a/arch/arm64/boot/dts/qcom/sm8250.dtsi
++++ b/arch/arm64/boot/dts/qcom/sm8250.dtsi
+@@ -2197,8 +2197,8 @@ pcie0: pcie@1c00000 {
+ 				      "tbu",
+ 				      "ddrss_sf_tbu";
+ 
+-			iommu-map = <0x0   &apps_smmu 0x1c00 0x1>,
+-				    <0x100 &apps_smmu 0x1c01 0x1>;
++			iommu-map = <0x0   &apps_smmu 0x1c00 0x0 0x1>,
++				    <0x100 &apps_smmu 0x1c01 0x0 0x1>;
+ 
+ 			resets = <&gcc GCC_PCIE_0_BCR>;
+ 			reset-names = "pci";
+@@ -2324,8 +2324,8 @@ pcie1: pcie@1c08000 {
+ 			assigned-clocks = <&gcc GCC_PCIE_1_AUX_CLK>;
+ 			assigned-clock-rates = <19200000>;
+ 
+-			iommu-map = <0x0   &apps_smmu 0x1c80 0x1>,
+-				    <0x100 &apps_smmu 0x1c81 0x1>;
++			iommu-map = <0x0   &apps_smmu 0x1c80 0x0 0x1>,
++				    <0x100 &apps_smmu 0x1c81 0x0 0x1>;
+ 
+ 			resets = <&gcc GCC_PCIE_1_BCR>;
+ 			reset-names = "pci";
+@@ -2451,8 +2451,8 @@ pcie2: pcie@1c10000 {
+ 			assigned-clocks = <&gcc GCC_PCIE_2_AUX_CLK>;
+ 			assigned-clock-rates = <19200000>;
+ 
+-			iommu-map = <0x0   &apps_smmu 0x1d00 0x1>,
+-				    <0x100 &apps_smmu 0x1d01 0x1>;
++			iommu-map = <0x0   &apps_smmu 0x1d00 0x0 0x1>,
++				    <0x100 &apps_smmu 0x1d01 0x0 0x1>;
+ 
+ 			resets = <&gcc GCC_PCIE_2_BCR>;
+ 			reset-names = "pci";
+-- 
+2.51.2
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0072-drm-msm-mark-the-fbdev-GEM-mapping-as-system-memory.patch b/device/testing/linux-postmarketos-qcom-sm8250/0072-drm-msm-mark-the-fbdev-GEM-mapping-as-system-memory.patch
new file mode 100644
index 0000000000..903c4356eb
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0072-drm-msm-mark-the-fbdev-GEM-mapping-as-system-memory.patch
@@ -0,0 +1,30 @@
+From a056c0f9008f4d1dd2a51e38421bb262b703bef1 Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Tue, 10 Nov 2026 10:23:14 +0000
+Subject: [PATCH] drm/msm: mark the fbdev GEM mapping as system memory
+
+The fbdev buffer is mapped with msm_gem_get_vaddr and uses the
+system-memory deferred drawing helpers. Set FBINFO_VIRTFB to describe
+that mapping, as the other DRM system-memory fbdev helpers do.
+This avoids the framebuffer address-space warning during console draws.
+
+Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
+---
+ drivers/gpu/drm/msm/msm_fbdev.c | 1 +
+ 1 file changed, 1 insertion(+)
+
+diff --git a/drivers/gpu/drm/msm/msm_fbdev.c b/drivers/gpu/drm/msm/msm_fbdev.c
+index fd19995b1..d05234bdd 100644
+--- a/drivers/gpu/drm/msm/msm_fbdev.c
++++ b/drivers/gpu/drm/msm/msm_fbdev.c
+@@ -132,6 +132,7 @@ int msm_fbdev_driver_fbdev_probe(struct drm_fb_helper *helper,
+ 	helper->fb = fb;
+ 
+ 	fbi->fbops = &msm_fb_ops;
++	fbi->flags |= FBINFO_VIRTFB; /* GEM buffer mapped into system memory */
+ 
+ 	drm_fb_helper_fill_info(fbi, helper, sizes);
+ 
+-- 
+2.51.2
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0073-power-supply-qcom_pm8150b-read-USB-telemetry-while-o.patch b/device/testing/linux-postmarketos-qcom-sm8250/0073-power-supply-qcom_pm8150b-read-USB-telemetry-while-o.patch
