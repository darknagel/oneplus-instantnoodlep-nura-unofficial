From ebb1d0f37f6a09214066f33bb669648b6beea6cb Mon Sep 17 00:00:00 2001
From: Roman Kuraev <naoru.desu@gmail.com>
Date: Thu, 12 Nov 2026 15:32:41 +0000
Subject: [PATCH] linux-postmarketos-qcom-sm8250: keep DisplayPort working over
 system sleep

Add kernel patches 0123-0124 to restore the DP PHY after suspend and avoid writes to an unclocked link. Advance to release 83.
---
 ...the-PHY-down-when-the-controller-is-.patch | 47 +++++++++++++++++++
 ...not-push-idle-on-a-link-that-is-down.patch | 41 ++++++++++++++++
 .../linux-postmarketos-qcom-sm8250/APKBUILD   |  6 ++-
 3 files changed, 93 insertions(+), 1 deletion(-)
 create mode 100644 device/testing/linux-postmarketos-qcom-sm8250/0123-drm-msm-dp-shut-the-PHY-down-when-the-controller-is-.patch
 create mode 100644 device/testing/linux-postmarketos-qcom-sm8250/0124-drm-msm-dp-do-not-push-idle-on-a-link-that-is-down.patch

diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0123-drm-msm-dp-shut-the-PHY-down-when-the-controller-is-.patch b/device/testing/linux-postmarketos-qcom-sm8250/0123-drm-msm-dp-shut-the-PHY-down-when-the-controller-is-.patch
new file mode 100644
index 0000000..751c9a3
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0123-drm-msm-dp-shut-the-PHY-down-when-the-controller-is-.patch
@@ -0,0 +1,47 @@
+From b21b4f65644709c9a943a914ea3160b032c8eb99 Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Thu, 12 Nov 2026 15:26:08 +0000
+Subject: [PATCH] drm/msm/dp: shut the PHY down when the controller is
+ suspended
+
+System sleep suspends the controller with pm_runtime_force_suspend()
+even while a sink is plugged in. For external DisplayPort the runtime
+suspend callback only deinitialises the host, so phy_initialized stays
+set although the PHY does not keep its setup: on SM8250 the DP PHY reads
+back PD_CTL 0x78, AUX_CFG1 0x00 and AUX_CFG2 0x04 right after resume,
+where 0x67, 0x13 and 0xa4 were programmed before. The next detect then
+skips the PHY init, every AUX transfer times out and the sink is
+reported as unplugged until it is plugged in again.
+
+Exit the PHY in the runtime suspend callback for external DisplayPort as
+well, as is already done for eDP, so that the next detect, hotplug or
+enable sets it up again. Runtime suspend without a sink is unaffected,
+the PHY is not initialised then.
+---
+ drivers/gpu/drm/msm/dp/dp_display.c | 9 ++++++---
+ 1 file changed, 6 insertions(+), 3 deletions(-)
+
+diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
+index fc87cd1..9c0ee32 100644
+--- a/drivers/gpu/drm/msm/dp/dp_display.c
++++ b/drivers/gpu/drm/msm/dp/dp_display.c
+@@ -1215,10 +1215,13 @@ static int msm_dp_pm_runtime_suspend(struct device *dev)
+ 
+ 	disable_irq(dp->irq);
+ 
+-	if (dp->msm_dp_display.is_edp) {
+-		msm_dp_display_host_phy_exit(dp);
++	/*
++	 * The PHY does not keep its setup once the controller is powered
++	 * down. System sleep gets here with a sink still plugged in.
++	 */
++	msm_dp_display_host_phy_exit(dp);
++	if (dp->msm_dp_display.is_edp)
+ 		msm_dp_aux_hpd_disable(dp->aux);
+-	}
+ 	msm_dp_display_host_deinit(dp);
+ 
+ 	return 0;
+-- 
+2.51.2
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0124-drm-msm-dp-do-not-push-idle-on-a-link-that-is-down.patch b/device/testing/linux-postmarketos-qcom-sm8250/0124-drm-msm-dp-do-not-push-idle-on-a-link-that-is-down.patch
new file mode 100644
index 0000000..f7c7f79
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0124-drm-msm-dp-do-not-push-idle-on-a-link-that-is-down.patch
@@ -0,0 +1,41 @@
+From 261bac462ecd3a11fd11a0a388fa37b758b7abeb Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Thu, 12 Nov 2026 15:26:09 +0000
+Subject: [PATCH] drm/msm/dp: do not push idle on a link that is down
+
+When link training fails in msm_dp_bridge_atomic_enable(),
+msm_dp_ctrl_on_link() has already switched the link clocks off again and
+power_on stays unset, but the bridge remains enabled as far as the atomic
+state is concerned. The following msm_dp_bridge_atomic_disable() writes
+DP_STATE_CTRL_PUSH_IDLE to a link register without a link clock.
+
+On SM8250 the SoC resets in the modeset that takes such an output down: the
+last messages are the failed link training and the encoder being disabled,
+with no panic.
+
+Only push idle patterns on a link that was brought up.
+---
+ drivers/gpu/drm/msm/dp/dp_display.c | 7 +++++++
+ 1 file changed, 7 insertions(+)
+
+diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
+index 9c0ee32..873adb3 100644
+--- a/drivers/gpu/drm/msm/dp/dp_display.c
++++ b/drivers/gpu/drm/msm/dp/dp_display.c
+@@ -1481,6 +1481,13 @@ void msm_dp_bridge_atomic_disable(struct drm_bridge *drm_bridge,
+ 
+ 	msm_dp_display = container_of(dp, struct msm_dp_display_private, msm_dp_display);
+ 
++	/*
++	 * Without a trained link the link clocks are off, and the link
++	 * registers must not be accessed.
++	 */
++	if (!dp->power_on)
++		return;
++
+ 	msm_dp_ctrl_push_idle(msm_dp_display->ctrl);
+ }
+ 
+-- 
+2.51.2
+
