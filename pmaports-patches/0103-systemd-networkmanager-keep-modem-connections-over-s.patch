+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Sun, 22 Nov 2026 19:30:00 +0100
+Subject: [PATCH] manager: keep modem connections over system sleep
+
+Before system sleep NetworkManager deactivates every device and brings
+it back after the resume. For a modem that drops the data bearer: the
+phone gets a new address after every sleep, open connections break,
+and nothing that arrives while it sleeps can reach it.
+
+ModemManager already puts the modem in its quiet state for sleep and
+syncs it on resume, and the bearer survives on the modem. Leave modem
+devices connected over system sleep, as Android does.
+---
+ src/core/nm-manager.c | 16 ++++++++++++++++
+ 1 file changed, 16 insertions(+)
+
+--- a/src/core/nm-manager.c
++++ b/src/core/nm-manager.c
+@@ -7268,6 +7268,15 @@
+     sleep_devices_check_empty(self);
+ }
+ 
++/* A modem keeps its data connection over system sleep, as on Android:
++ * ModemManager puts the modem in its quiet state, the bearer and its
++ * address stay, and incoming data can wake the phone. */
++static gboolean
++device_keeps_link_over_sleep(NMDevice *device)
++{
++    return nm_device_get_device_type(device) == NM_DEVICE_TYPE_MODEM;
++}
++
+ static void
+ device_sleep_cb(NMDevice *device, GParamSpec *pspec, NMManager *self)
+ {
+@@ -7348,6 +7357,13 @@
+                 if (suspending)
+                     continue;
+             }
++            if (suspending && device_keeps_link_over_sleep(device)) {
++                _LOGD(LOGD_SUSPEND,
++                      "sleep: device %s keeps its connection, skipping",
++                      nm_device_get_ip_iface(device));
++                continue;
++            }
++
+             /* Wake-on-LAN devices will be taken down post-suspend rather than pre- */
+             if (suspending && device_is_wake_on_lan(priv->platform, device)) {
+                 _LOGD(LOGD_SUSPEND,
