+# Maintainer: Timo <1788603+darknagel@users.noreply.github.com>
+# Based on the APKBUILD shipped by upstream (packaging/alpine).
+pkgname=qsee-supplicant
+pkgver=0.1.1_git20261116
+pkgrel=0
+_commit=36e06680cf7f690fccbdcd07abc2a64c4bb061d8
+pkgdesc="Userspace services for Qualcomm QSEECOM trusted applications"
+url="https://github.com/wrobelda/qsee-supplicant"
+arch="aarch64"
+license="BSD-2-Clause AND BSD-3-Clause-Clear"
+makedepends="linux-headers"
+subpackages="$pkgname-doc $pkgname-systemd:systemd"
+source="$pkgname-$_commit.tar.gz::https://github.com/wrobelda/qsee-supplicant/archive/$_commit.tar.gz
+	0001-gpfs-accept-requests-up-to-the-shared-buffer-size.patch
+	0002-rpmb-add-the-RPMB-listener-service-0x2000-for-UFS.patch
+	"
+builddir="$srcdir/qsee-supplicant-$_commit"
+
+build() {
+	make
+}
+
+check() {
+	make check
+}
+
+package() {
+	make DESTDIR="$pkgdir" install-bin install-systemd install-doc
+	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
+	install -Dm644 LICENSES/BSD-3-Clause-Clear.txt \
+		"$pkgdir"/usr/share/licenses/$pkgname/BSD-3-Clause-Clear.txt
+}
+
+systemd() {
+	pkgdesc="$pkgdesc (systemd services)"
+	depends="systemd"
+	install_if="$pkgname=$pkgver-r$pkgrel systemd"
+	amove usr/lib/systemd/system
+}
