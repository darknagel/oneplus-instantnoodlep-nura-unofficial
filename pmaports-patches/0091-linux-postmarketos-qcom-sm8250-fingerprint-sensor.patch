++			if (ret)
++				dev_warn(ctxdata->qtee->dev,
++					 "unloading app %u: %d\n", app_id, ret);
++			else
++				qseecom_tee_app_forget(ctxdata->qtee, app_id);
++		}
+ 		return 0;
++	}
+ 
