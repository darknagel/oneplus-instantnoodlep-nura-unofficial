++	 * inside the loop above would strand the references of every parameter
++	 * after the offending one.
++	 */
++	for (i = 0; i < *num_params; i++)
+ 		if ((param[i].attr & TEE_IOCTL_PARAM_ATTR_TYPE_MASK) !=
+ 		    TEE_IOCTL_PARAM_ATTR_TYPE_NONE)
+ 			return -EINVAL;
+-	}
