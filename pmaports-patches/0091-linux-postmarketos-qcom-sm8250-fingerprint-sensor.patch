++	param[0].attr = TEE_IOCTL_PARAM_ATTR_TYPE_VALUE_INPUT;
++	param[0].u.value.a = gen;
++	param[0].u.value.b = 0;
++	param[0].u.value.c = 0;
++
++	param[1].attr = TEE_IOCTL_PARAM_ATTR_TYPE_MEMREF_INOUT;
++	param[1].u.memref.shm = listener->shm;
