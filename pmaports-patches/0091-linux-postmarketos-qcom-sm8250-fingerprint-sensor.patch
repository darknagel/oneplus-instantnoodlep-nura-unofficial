+diff --git a/drivers/firmware/qcom/qcom_scm.c b/drivers/firmware/qcom/qcom_scm.c
+index f043691862..df351e91ca 100644
+--- a/drivers/firmware/qcom/qcom_scm.c
++++ b/drivers/firmware/qcom/qcom_scm.c
+@@ -2192,7 +2192,10 @@ static int qcom_scm_qseecom_service_listeners(struct qcom_scm_qseecom_resp *res)
+ 			return -ELOOP;
+ 		}
+ 
+-		id = res->data;
++		if (res->data > U32_MAX)
++		return -EINVAL;
++
++	id = res->data;
+ 		listener = qcom_scm_qseecom_listener_find(id);
+ 		if (listener) {
+ 			status = listener->service(listener);
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0185-tee-qseecom-drop-the-references-the-core-took-before.patch b/device/testing/linux-postmarketos-qcom-sm8250/0185-tee-qseecom-drop-the-references-the-core-took-before.patch
new file mode 100644
index 0000000000..cc3652c306
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0185-tee-qseecom-drop-the-references-the-core-took-before.patch
@@ -0,0 +1,67 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: =?UTF-8?q?Dawid=20Wr=C3=B3bel?= <me@dawidwrobel.com>
+Date: Mon, 3 Aug 2026 10:07:40 +0200
+Subject: [PATCH 185/222] tee: qseecom: drop the references the core took
+ before replacing a parameter
+
+TEE_IOC_SUPPL_RECV resolves any memref the caller passed and takes a reference
+for it, and the core deliberately does not release them afterwards -- see the
+comment on free_params() in tee_ioctl_supp_recv(), which explains that
+supp_recv may consume and replace its parameters, so the usual cleanup cannot
+run.
+
+That makes the references the driver's to drop, and this driver overwrote
+param[0] wholesale without doing so. A tee_shm pins the context that allocated
+it, so each leaked reference strands a context, tee_device_unregister() then
+waits for it for ever, and the module is left in "going" state that only a
+reboot clears -- the same failure this driver already documents for a different
+cause. Any client able to open the privileged device triggers it just by
+passing a memref.
+
+Drop them, and refuse anything that is not an empty parameter rather than
+silently discarding it, as OP-TEE does.
+
+Assisted-by: Claude:claude-opus-5
+Assisted-by: Kimi:kimi-k3
+(cherry picked from commit 20cd3f60b3f544714ff061e3d3eadc11c15d2fb7)
+---
+ drivers/tee/qseecom/core.c | 21 +++++++++++++++++++++
+ 1 file changed, 21 insertions(+)
+
+diff --git a/drivers/tee/qseecom/core.c b/drivers/tee/qseecom/core.c
+index a0ebf5a276..125edea74e 100644
+--- a/drivers/tee/qseecom/core.c
++++ b/drivers/tee/qseecom/core.c
+@@ -970,11 +970,32 @@ static int qseecom_tee_supp_recv(struct tee_context *ctx, u32 *func,
+ 	struct qseecom_tee *qtee = ctxdata->qtee;
+ 	struct qseecom_tee_supp *supp = &qtee->supp;
+ 	struct qseecom_tee_listener *listener;
++	unsigned int i;
+ 	int ret;
+ 
+ 	if (*num_params < 1)
+ 		return -EINVAL;
+ 
++	/*
++	 * The core resolved any memref the caller passed and took a reference
++	 * for it, and deliberately does not drop them on this path -- see the
++	 * comment on free_params() in tee_ioctl_supp_recv(). Since param[0] is
++	 * about to be overwritten wholesale, dropping them is ours to do, and
++	 * failing to leaves a reference on a tee_shm, which pins the context,
++	 * which strands the device on unregister.
++	 *
++	 * Nothing meaningful can be passed in, so refuse anything that is not
++	 * empty rather than silently discarding it.
++	 */
++	for (i = 0; i < *num_params; i++) {
++		if (tee_param_is_memref(param + i) && param[i].u.memref.shm)
++			tee_shm_put(param[i].u.memref.shm);
++
++		if ((param[i].attr & TEE_IOCTL_PARAM_ATTR_TYPE_MASK) !=
++		    TEE_IOCTL_PARAM_ATTR_TYPE_NONE)
++			return -EINVAL;
++	}
++
+ 	ret = wait_event_interruptible(supp->wq,
+ 				       qseecom_tee_supp_pending(supp));
+ 	if (ret)
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0186-tee-qseecom-only-free-a-listener-once-TZ-has-let-go-.patch b/device/testing/linux-postmarketos-qcom-sm8250/0186-tee-qseecom-only-free-a-listener-once-TZ-has-let-go-.patch
new file mode 100644
index 0000000000..2e1ff199a3
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0186-tee-qseecom-only-free-a-listener-once-TZ-has-let-go-.patch
@@ -0,0 +1,108 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: =?UTF-8?q?Dawid=20Wr=C3=B3bel?= <me@dawidwrobel.com>
+Date: Mon, 3 Aug 2026 10:08:04 +0200
+Subject: [PATCH 186/222] tee: qseecom: only free a listener once TZ has let go
+ of it
+
+The SCM layer removes a listener from its registry only when TZ confirms the
+deregistration -- list_del() sits under the success branch. On failure the
+listener stays on that list, live, with its ->service pointer still reachable
+from qcom_scm_qseecom_service_listeners().
+
+All three call sites freed it regardless, so a failed deregistration left the
+secure world holding a callback into freed memory, taken the next time an
+application raised a request for that id. The context-teardown path did not
+even look at the return value, and that is the supplicant-died-mid-request
+path, which is exactly when deregistration contends and fails.
+
+Route all three through one helper that frees only on success and otherwise
+leaks the listener with an error. Leaking is bad; calling a freed function
+pointer from the secure world is worse, and there is no third option while TZ
+can still name it.
+
+Assisted-by: Claude:claude-opus-5
+Assisted-by: Kimi:kimi-k3
+(cherry picked from commit 230aeefff5d1929376022609c816a6e47280f2a7)
+---
+ drivers/tee/qseecom/core.c | 47 ++++++++++++++++++++++++++++----------
+ 1 file changed, 35 insertions(+), 12 deletions(-)
+
+diff --git a/drivers/tee/qseecom/core.c b/drivers/tee/qseecom/core.c
+index 125edea74e..5428bd278d 100644
+--- a/drivers/tee/qseecom/core.c
++++ b/drivers/tee/qseecom/core.c
+@@ -963,6 +963,37 @@ static bool qseecom_tee_supp_pending(struct qseecom_tee_supp *supp)
+ 	return pending;
+ }
+ 
++/*
++ * Withdraw a listener and release what it held.
++ *
++ * The SCM layer only drops a listener from its registry once TZ has confirmed
++ * the deregistration; on failure the listener stays on that list, live, with
++ * its ->service pointer still reachable. Freeing regardless would hand the
++ * secure world a callback into freed memory the next time an application
++ * raised a request for that id.
++ *
++ * So on failure keep everything and say so. Leaking a listener is bad; calling
++ * through a freed function pointer from the secure world is worse, and there
++ * is no third option while TZ can still name it.
++ */
++static void qseecom_tee_listener_release(struct qseecom_tee *qtee,
++					 struct qseecom_tee_listener *listener)
++{
++	int ret;
++
++	ret = qcom_scm_qseecom_listener_unregister(&listener->scm);
++	if (ret) {
++		dev_err(qtee->dev,
++			"listener %u: deregistration failed (%d), leaking it -- TZ can still reach it\n",
++			listener->scm.id, ret);
++		return;
++	}
++
++	qcom_tzmem_free(listener->buf);
++	tee_shm_put(listener->shm);
++	kfree(listener);
++}
++
+ static int qseecom_tee_supp_recv(struct tee_context *ctx, u32 *func,
+ 				 u32 *num_params, struct tee_param *param)
+ {
+@@ -1129,10 +1160,7 @@ static void qseecom_tee_supp_close_context(struct tee_context *ctx)
+ 
+ 	list_for_each_entry_safe(listener, tmp, &ctxdata->listeners, node) {
+ 		list_del(&listener->node);
+-		qcom_scm_qseecom_listener_unregister(&listener->scm);
+-		qcom_tzmem_free(listener->buf);
+-		tee_shm_put(listener->shm);
+-		kfree(listener);
++		qseecom_tee_listener_release(ctxdata->qtee, listener);
+ 	}
+ }
+ 
+@@ -1385,10 +1413,7 @@ static int qseecom_tee_supp_open_session(struct tee_context *ctx,
+ 		mutex_lock(&ctxdata->mutex);
+ 		list_del(&listener->node);
+ 		mutex_unlock(&ctxdata->mutex);
+-		qcom_scm_qseecom_listener_unregister(&listener->scm);
+-		qcom_tzmem_free(listener->buf);
+-		tee_shm_put(shm);
+-		kfree(listener);
++		qseecom_tee_listener_release(qtee, listener);
+ 		return ret;
+ 	}
+ 
+@@ -1451,10 +1476,8 @@ static int qseecom_tee_supp_close_session(struct tee_context *ctx, u32 session)
+ 	 * answer holds the lock this needs. A supplicant that answers before
+ 	 * closing never sees it.
+ 	 */
+-	ret = qcom_scm_qseecom_listener_unregister(&listener->scm);
+-	qcom_tzmem_free(listener->buf);
+-	tee_shm_put(listener->shm);
+-	kfree(listener);
++	qseecom_tee_listener_release(ctxdata->qtee, listener);
++	ret = 0;
+ 
+ 	return ret;
+ }
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0187-tee-qseecom-refuse-an-invoke-that-cannot-be-staged-r.patch b/device/testing/linux-postmarketos-qcom-sm8250/0187-tee-qseecom-refuse-an-invoke-that-cannot-be-staged-r.patch
new file mode 100644
index 0000000000..e974d06a6b
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0187-tee-qseecom-refuse-an-invoke-that-cannot-be-staged-r.patch
@@ -0,0 +1,51 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: =?UTF-8?q?Dawid=20Wr=C3=B3bel?= <me@dawidwrobel.com>
+Date: Mon, 3 Aug 2026 10:21:31 +0200
+Subject: [PATCH 187/222] tee: qseecom: refuse an invoke that cannot be staged,
+ rather than sending it
+
+The patch loop skipped a buffer it could not map and carried on. That
+desynchronised the staging layout from the copy-back loop, which advances
+unconditionally, so the wrong bytes went back to user space -- and it skipped
+the address patch, leaving whatever user space had put at that offset in a
+field the application dereferences in the secure world. The staging buffer is a
+verbatim copy of the caller's request, so that value is user-chosen, and a zero
+there resets the machine.
+
+Cannot happen today, because check_patch() has already validated every memref.
+Fixed defensively: the failure mode is a hard reset, and the alternative is
+sending a request the driver knows is malformed.
+
+Assisted-by: Claude:claude-opus-5
+Assisted-by: Kimi:kimi-k3
+(cherry picked from commit 6bb2554328656a288df7e3007bf50ca7cbf5c5c4)
+---
+ drivers/tee/qseecom/core.c | 15 +++++++++++++--
+ 1 file changed, 13 insertions(+), 2 deletions(-)
+
+diff --git a/drivers/tee/qseecom/core.c b/drivers/tee/qseecom/core.c
+index 5428bd278d..d074e26bf1 100644
+--- a/drivers/tee/qseecom/core.c
++++ b/drivers/tee/qseecom/core.c
+@@ -799,8 +799,19 @@ static int qseecom_tee_invoke_func(struct tee_context *ctx,
+ 			void *pv;
+ 
+ 			pv = tee_shm_get_va(pshm, param[k + 1].u.memref.shm_offs);
+-			if (IS_ERR(pv))
+-				continue;
++			if (IS_ERR(pv)) {
++				/*
++				 * Cannot happen -- check_patch() validated
++				 * these memrefs -- but skipping the copy would
++				 * desynchronise the staging layout from the
++				 * copy-back loop *and* leave whatever user
++				 * space put at that offset in a field the
++				 * application dereferences in the secure
++				 * world. Refuse the invoke instead.
++				 */
++				ret = PTR_ERR(pv);
++				goto out_free;
++			}
+ 
+ 			memcpy(b + off, pv, plen);
+ 			pp = qcom_tzmem_to_phys(b + off);
