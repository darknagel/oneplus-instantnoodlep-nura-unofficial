diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0077-drm-msm-dsi-release-PLL-bias-references-after-a-lock.patch b/device/testing/linux-postmarketos-qcom-sm8250/0077-drm-msm-dsi-release-PLL-bias-references-after-a-lock.patch
