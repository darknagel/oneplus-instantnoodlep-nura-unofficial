+pkgrel=8
 _commit=7f0bf17ab518cd78925cf7e53cc0d5c42f88b41a
 pkgdesc="ModemManager library"
 url="https://www.freedesktop.org/wiki/Software/ModemManager"
@@ -53,6 +53,7 @@ source="https://gitlab.freedesktop.org/mobile-broadband/ModemManager/-/archive/$
 	0004-bearer-qmi-multiplex-by-default-on-mhi_net-over-QRTR.patch
 	0005-iface-modem-simple-disconnect-only-its-own-bearers.patch
 	0006-bearer-qmi-do-not-ask-for-WDS-event-reports.patch
+	0007-broadband-modem-qmi-reset-only-real-net-ports.patch
 	"
