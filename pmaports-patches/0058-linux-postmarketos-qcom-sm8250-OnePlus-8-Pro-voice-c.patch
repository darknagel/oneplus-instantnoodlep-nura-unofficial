++	unsigned long flags;
++
++	log = kmalloc_array(MHI_SAT_LOG_ENTRIES, sizeof(*log), GFP_KERNEL);
++	if (!log)
++		return -ENOMEM;
++
++	spin_lock_irqsave(&sat_cntrl->log_lock, flags);
++	memcpy(log, sat_cntrl->log, MHI_SAT_LOG_ENTRIES * sizeof(*log));
++	next = sat_cntrl->log_next;
