++static int q6voice_mailbox_init(struct device *dev)
++{
++	struct q6voice_mailbox *mb = &q6voice_mbox;
++	struct of_phandle_args args;
++	struct reserved_mem *rmem;
++	struct device_node *np;
++	u64 sid = 0;
++
++	np = of_parse_phandle(dev->of_node, "memory-region", 0);
++	if (!np)
++		return 0;
++
++	rmem = of_reserved_mem_lookup(np);
++	of_node_put(np);
++	if (!rmem)
++		return -EINVAL;
++
++	if (!of_parse_phandle_with_args(dev->of_node, "iommus", "#iommu-cells", 0, &args)) {
++		sid = args.args[0] & 0xf;
++		of_node_put(args.np);
++	}
++
++	mutex_lock(&mb->lock);
++	mb->phys = rmem->base;
++	mb->size = rmem->size;
++	mb->adsp_addr = dma_map_resource(dev, mb->phys, mb->size,
++					 DMA_BIDIRECTIONAL, 0);
++	if (dma_mapping_error(dev, mb->adsp_addr)) {
++		mutex_unlock(&mb->lock);
++		return -ENOMEM;
++	}
++	/* The ADSP expects the SMMU context in the upper address bits */
++	mb->adsp_addr |= sid << 32;
++	mb->dev = dev;
++	mutex_unlock(&mb->lock);
++
++	return 0;
++}
