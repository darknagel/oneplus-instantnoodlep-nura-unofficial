++++ b/sound/soc/qcom/qdsp6/q6voice-dai.c
+@@ -0,0 +1,473 @@
++// SPDX-License-Identifier: GPL-2.0
++// Copyright (c) 2012-2017, The Linux Foundation. All rights reserved.
++// Copyright (c) 2020, Stephan Gerhold
++
++#include <linux/dma-mapping.h>
++#include <linux/mhi.h>
++#include <linux/module.h>
++#include <linux/of.h>
++#include <linux/of_reserved_mem.h>
++#include <linux/platform_device.h>
++#include <sound/soc.h>
++#include <dt-bindings/sound/qcom,q6afe.h>
++#include <dt-bindings/sound/qcom,q6voice.h>
++#include "q6mvm.h"
++#include "q6voice.h"
++
++#define DRV_NAME	"q6voice-dai"
++
++/*
++ * With an external modem on PCIe (e.g. SDX55 next to SM8250) the ADSP exchanges
++ * voice packets with the modem through a small mailbox in DDR. The ADSP needs
++ * its address as seen from itself and from PCIe, and the PCIe link has to stay
++ * active while a call runs. The MHI channel AUDIO_VOICE_0 is an offload channel
++ * only used for this.
++ */
++struct q6voice_mailbox {
++	struct device *dev;
++	phys_addr_t phys;
++	size_t size;
++	dma_addr_t adsp_addr;
++	dma_addr_t pcie_addr;
++	struct mhi_device *mhi_dev;
++	bool configured;
++	unsigned int votes;
++	/* Protect everything above */
++	struct mutex lock;
++};
++
++static struct q6voice_mailbox q6voice_mbox = {
++	.lock = __MUTEX_INITIALIZER(q6voice_mbox.lock),
++};
++
++static int q6voice_mailbox_get(void)
++{
++	struct q6voice_mailbox *mb = &q6voice_mbox;
++	int ret = 0;
++
++	mutex_lock(&mb->lock);
++	if (!mb->dev)
++		goto out;
++
++	if (!mb->mhi_dev) {
++		dev_warn(mb->dev, "no PCIe voice channel, modem not up?\n");
++		goto out;
++	}
++
++	if (!mb->votes) {
++		ret = mhi_device_get_sync(mb->mhi_dev);
++		if (ret) {
++			dev_err(mb->dev, "failed to vote for PCIe: %d\n", ret);
++			goto out;
++		}
++	}
++	mb->votes++;
++
++	if (!mb->configured) {
++		ret = q6mvm_set_mailbox(mb->adsp_addr, mb->pcie_addr, mb->size);
++		if (ret)
++			dev_err(mb->dev, "failed to set mailbox: %d\n", ret);
++		else
++			mb->configured = true;
++		dev_info(mb->dev, "mailbox adsp %pad pcie %pad size %zu: %d\n",
++			 &mb->adsp_addr, &mb->pcie_addr, mb->size, ret);
++	}
++
++out:
++	mutex_unlock(&mb->lock);
++	return ret;
++}
++
++static void q6voice_mailbox_put(void)
++{
++	struct q6voice_mailbox *mb = &q6voice_mbox;
++
++	mutex_lock(&mb->lock);
++	if (mb->mhi_dev && mb->votes && !--mb->votes)
++		mhi_device_put(mb->mhi_dev);
++	mutex_unlock(&mb->lock);
++}
++
++static int q6voice_mhi_probe(struct mhi_device *mhi_dev,
++			     const struct mhi_device_id *id)
++{
++	struct q6voice_mailbox *mb = &q6voice_mbox;
++	struct device *pcie_dev = mhi_dev->mhi_cntrl->cntrl_dev;
++	int ret = 0;
++
++	mutex_lock(&mb->lock);
++	if (!mb->dev) {
++		ret = -EPROBE_DEFER;
++		goto out;
++	}
++
++	mb->pcie_addr = dma_map_resource(pcie_dev, mb->phys, mb->size,
++					 DMA_BIDIRECTIONAL, 0);
++	if (dma_mapping_error(pcie_dev, mb->pcie_addr)) {
++		ret = -ENOMEM;
++		goto out;
++	}
++
++	mb->mhi_dev = mhi_dev;
++	mb->configured = false;
++	mb->votes = 0;
++out:
++	mutex_unlock(&mb->lock);
++	return ret;
++}
++
++static void q6voice_mhi_remove(struct mhi_device *mhi_dev)
++{
++	struct q6voice_mailbox *mb = &q6voice_mbox;
++
++	mutex_lock(&mb->lock);
++	dma_unmap_resource(mhi_dev->mhi_cntrl->cntrl_dev, mb->pcie_addr,
++			   mb->size, DMA_BIDIRECTIONAL, 0);
++	mb->mhi_dev = NULL;
++	mb->configured = false;
++	mb->votes = 0;
++	mutex_unlock(&mb->lock);
++}
++
++static const struct mhi_device_id q6voice_mhi_match[] = {
