++
++		seq_printf(s, "[%5llu.%06llu] %-11s ", e->ts / NSEC_PER_SEC,
++			   (e->ts % NSEC_PER_SEC) / 1000, mhi_sat_cmd_str(e->type));
++
++		switch (e->type) {
