++struct vss_imvm_cmd_set_policy_dual_control_cmd {
++	struct apr_hdr hdr;
++
++	/* Set to TRUE to enable modem state machine control */
++	bool enable;
++} __packed;
++
++#define VSS_IMVM_CMD_ATTACH_VOCPROC			0x0001123E
++#define VSS_IMVM_CMD_DETACH_VOCPROC			0x0001123F
++
