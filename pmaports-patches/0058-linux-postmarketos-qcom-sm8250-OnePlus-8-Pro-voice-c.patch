diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0120-WIP-net-qrtr-Forward-between-endpoints-of-different-.patch b/device/testing/linux-postmarketos-qcom-sm8250/0120-WIP-net-qrtr-Forward-between-endpoints-of-different-.patch
new file mode 100644
index 0000000000..49a57cf274
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0120-WIP-net-qrtr-Forward-between-endpoints-of-different-.patch
@@ -0,0 +1,288 @@
+From 6b65f233a57cbbb91bc7c3523fa299aeb38c77c6 Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Tue, 3 Nov 2026 19:44:52 +0100
+Subject: [PATCH 120/137] WIP: net: qrtr: Forward between endpoints of
+ different networks
+
+An external modem on MHI talks to services on the DSPs (e.g. the voice
+services on the ADSP) through the application processor. Like the
+downstream kernel, forward data packets for nodes behind another
+endpoint and control messages about servers and clients between
+endpoints with a different network id. MHI endpoints get their own
+network id, so the GLINK edges still do not see each other.
+
+When a node says hello, also announce the remote servers it can reach
+through us.
+
+Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
+(cherry picked from commit c6f576d3962c164a85525135c1f8234099bf669f)
+---
+ net/qrtr/af_qrtr.c | 151 +++++++++++++++++++++++++++++++++++++++++++++
+ net/qrtr/mhi.c     |   1 +
+ net/qrtr/ns.c      |  15 ++++-
+ net/qrtr/qrtr.h    |   7 +++
+ 4 files changed, 173 insertions(+), 1 deletion(-)
+
+diff --git a/net/qrtr/af_qrtr.c b/net/qrtr/af_qrtr.c
+index 16b3932bf..a025b855c 100644
+--- a/net/qrtr/af_qrtr.c
++++ b/net/qrtr/af_qrtr.c
+@@ -81,6 +81,11 @@ struct qrtr_cb {
+ 
+ 	u8 type;
+ 	u8 confirm_rx;
++
++	/* forwarding: network of the receiving endpoint, broadcast to others */
++	u8 fwd_bcast;
++	u32 fwd_src_net;
++	u32 fwd_ep_nid;
+ };
+ 
+ #define QRTR_HDR_MAX_SIZE max_t(size_t, sizeof(struct qrtr_hdr_v1), \
+@@ -159,6 +164,12 @@ static int qrtr_bcast_enqueue(struct qrtr_node *node, struct sk_buff *skb,
+ 			      struct sockaddr_qrtr *to);
+ static struct qrtr_sock *qrtr_port_lookup(int port);
+ static void qrtr_port_put(struct qrtr_sock *ipc);
++static struct qrtr_node *qrtr_node_lookup(unsigned int nid);
++
++/* Packets to forward to endpoints of another network, see qrtr_fwd_work_fn() */
++static struct sk_buff_head qrtr_fwd_queue;
++static void qrtr_fwd_work_fn(struct work_struct *work);
++static DECLARE_WORK(qrtr_fwd_work, qrtr_fwd_work_fn);
+ 
+ /* Release node resources and free the node.
+  *
+@@ -435,6 +446,128 @@ static void qrtr_node_assign(struct qrtr_node *node, unsigned int nid)
+ 	spin_unlock_irqrestore(&qrtr_nodes_lock, flags);
+ }
+ 
++static unsigned int qrtr_node_net_id(struct qrtr_node *node)
++{
++	unsigned int net_id;
++
++	mutex_lock(&node->ep_lock);
++	net_id = node->ep ? node->ep->net_id : 0;
++	mutex_unlock(&node->ep_lock);
++
++	return net_id;
++}
++
++/**
++ * qrtr_nodes_forward() - check if packets get forwarded between two nodes
++ * @from: node id of the sender
++ * @to: node id of the receiver
++ *
++ * Return: true if both nodes are remote and behind endpoints of different
++ * networks
++ */
++bool qrtr_nodes_forward(unsigned int from, unsigned int to)
++{
++	struct qrtr_node *a, *b;
++	bool ret = false;
++
++	if (from == qrtr_local_nid || to == qrtr_local_nid)
++		return false;
++
++	a = qrtr_node_lookup(from);
++	b = qrtr_node_lookup(to);
++	if (a && b && a != b)
++		ret = qrtr_node_net_id(a) != qrtr_node_net_id(b);
++	qrtr_node_release(a);
++	qrtr_node_release(b);
++
++	return ret;
++}
++
++static void qrtr_fwd_xmit(struct qrtr_node *node, struct sk_buff *skb)
++{
++	struct qrtr_cb *cb = (struct qrtr_cb *)skb->cb;
++	struct qrtr_hdr_v1 *hdr;
++	size_t len = skb->len;
++
++	hdr = skb_push(skb, sizeof(*hdr));
++	hdr->version = cpu_to_le32(QRTR_PROTO_VER_1);
++	hdr->type = cpu_to_le32(cb->type);
++	hdr->src_node_id = cpu_to_le32(cb->src_node);
++	hdr->src_port_id = cpu_to_le32(cb->src_port);
++	if (cb->dst_port == QRTR_PORT_CTRL)
++		hdr->dst_node_id = cpu_to_le32(node->nid);
++	else
++		hdr->dst_node_id = cpu_to_le32(cb->dst_node);
++	hdr->dst_port_id = cpu_to_le32(cb->dst_port);
++	hdr->size = cpu_to_le32(len);
++	hdr->confirm_rx = cpu_to_le32(!!cb->confirm_rx);
++
++	if (skb_put_padto(skb, ALIGN(len, 4) + sizeof(*hdr)))
++		return;
++
++	mutex_lock(&node->ep_lock);
++	if (node->ep)
++		node->ep->xmit(node->ep, skb);
++	else
++		kfree_skb(skb);
++	mutex_unlock(&node->ep_lock);
++}
++
++/*
++ * Forward packets between endpoints of different networks, e.g. between an
++ * external modem on MHI and the DSPs on GLINK: data for nodes behind another
++ * endpoint, and control messages about servers and clients so that the nodes
++ * learn about each other.
++ */
++static void qrtr_fwd_work_fn(struct work_struct *work)
++{
++	struct qrtr_node *node, *dst;
++	struct sk_buff *skb, *skbn;
++	struct qrtr_cb *cb;
++
++	while ((skb = skb_dequeue(&qrtr_fwd_queue))) {
++		cb = (struct qrtr_cb *)skb->cb;
++
++		if (!cb->fwd_bcast) {
++			dst = qrtr_node_lookup(cb->dst_node);
++			if (dst && dst->nid != cb->fwd_ep_nid &&
++			    qrtr_node_net_id(dst) != cb->fwd_src_net)
++				qrtr_fwd_xmit(dst, skb);
++			else
++				kfree_skb(skb);
++			qrtr_node_release(dst);
++			continue;
++		}
++
++		mutex_lock(&qrtr_node_lock);
++		list_for_each_entry(node, &qrtr_all_nodes, item) {
++			if (node->nid == cb->fwd_ep_nid || node->nid == cb->src_node ||
++			    node->nid == QRTR_EP_NID_AUTO)
++				continue;
++			if (qrtr_node_net_id(node) == cb->fwd_src_net)
++				continue;
++
++			skbn = skb_copy(skb, GFP_KERNEL);
++			if (skbn)
++				qrtr_fwd_xmit(node, skbn);
++		}
++		mutex_unlock(&qrtr_node_lock);
++		kfree_skb(skb);
++	}
++}
++
++static void qrtr_fwd_queue_skb(struct qrtr_endpoint *ep, struct sk_buff *skb,
++			       bool bcast)
++{
++	struct qrtr_cb *cb = (struct qrtr_cb *)skb->cb;
++
++	cb->fwd_bcast = bcast;
++	cb->fwd_src_net = ep->net_id;
++	cb->fwd_ep_nid = ep->node->nid;
++	skb_queue_tail(&qrtr_fwd_queue, skb);
++	schedule_work(&qrtr_fwd_work);
++}
++
+ /**
+  * qrtr_endpoint_post() - post incoming data
+  * @ep: endpoint handle
+@@ -535,6 +668,22 @@ int qrtr_endpoint_post(struct qrtr_endpoint *ep, const void *data, size_t len)
+ 		qrtr_node_assign(node, le32_to_cpu(pkt->server.node));
+ 	}
+ 
++	/* Data for a node behind another endpoint */
++	if ((cb->type == QRTR_TYPE_DATA || cb->type == QRTR_TYPE_RESUME_TX) &&
++	    cb->dst_node != qrtr_local_nid && cb->dst_node != QRTR_NODE_BCAST) {
++		qrtr_fwd_queue_skb(ep, skb, false);
++		return 0;
++	}
++
++	if (cb->dst_port == QRTR_PORT_CTRL &&
++	    (cb->type == QRTR_TYPE_NEW_SERVER || cb->type == QRTR_TYPE_DEL_SERVER ||
++	     cb->type == QRTR_TYPE_DEL_CLIENT || cb->type == QRTR_TYPE_BYE)) {
++		struct sk_buff *skbn = skb_clone(skb, GFP_ATOMIC);
++
++		if (skbn)
++			qrtr_fwd_queue_skb(ep, skbn, true);
++	}
++
+ 	if (cb->type == QRTR_TYPE_RESUME_TX) {
+ 		qrtr_tx_resume(node, skb);
+ 	} else {
+@@ -1313,6 +1462,8 @@ static int __init qrtr_proto_init(void)
+ {
+ 	int rc;
+ 
++	skb_queue_head_init(&qrtr_fwd_queue);
++
+ 	rc = proto_register(&qrtr_proto, 1);
+ 	if (rc)
+ 		return rc;
+diff --git a/net/qrtr/mhi.c b/net/qrtr/mhi.c
+index 3990da1a6..bdfc18cca 100644
+--- a/net/qrtr/mhi.c
++++ b/net/qrtr/mhi.c
+@@ -119,6 +119,7 @@ static int qcom_mhi_qrtr_probe(struct mhi_device *mhi_dev,
+ 	qdev->mhi_dev = mhi_dev;
+ 	qdev->dev = &mhi_dev->dev;
+ 	qdev->ep.xmit = qcom_mhi_qrtr_send;
++	qdev->ep.net_id = 1;
+ 
+ 	dev_set_drvdata(&mhi_dev->dev, qdev);
+ 
+diff --git a/net/qrtr/ns.c b/net/qrtr/ns.c
+index 596c9c48b..50ec71fd4 100644
+--- a/net/qrtr/ns.c
++++ b/net/qrtr/ns.c
+@@ -216,7 +216,7 @@ static int announce_servers(struct sockaddr_qrtr *sq)
+ {
+ 	struct qrtr_server *srv;
+ 	struct qrtr_node *node;
+-	unsigned long index;
++	unsigned long index, node_idx;
+ 	int ret;
+ 
+ 	node = node_get(qrtr_ns.local_node);
+@@ -234,6 +234,19 @@ static int announce_servers(struct sockaddr_qrtr *sq)
+ 			return ret;
+ 		}
+ 	}
++
++	/* ... and the servers of remote nodes forwarded to the new node */
++	xa_for_each(&nodes, node_idx, node) {
++		if (node->id == qrtr_ns.local_node || node->id == sq->sq_node ||
++		    !qrtr_nodes_forward(node->id, sq->sq_node))
++			continue;
++
++		xa_for_each(&node->servers, index, srv) {
++			ret = service_announce_new(sq, srv);
++			if (ret < 0 && ret != -ENODEV)
++				return ret;
++		}
++	}
+ 	return 0;
+ }
+ 
+diff --git a/net/qrtr/qrtr.h b/net/qrtr/qrtr.h
+index c0c6d1742..55225a353 100644
+--- a/net/qrtr/qrtr.h
++++ b/net/qrtr/qrtr.h
+@@ -19,6 +19,11 @@ struct sk_buff;
+  */
+ struct qrtr_endpoint {
+ 	int (*xmit)(struct qrtr_endpoint *ep, struct sk_buff *skb);
++	/*
++	 * Packets are forwarded between endpoints with different network ids,
++	 * e.g. between an external modem on MHI and the DSPs on GLINK.
++	 */
++	unsigned int net_id;
+ 	/* private: not for endpoint use */
+ 	struct qrtr_node *node;
+ };
+@@ -27,6 +32,8 @@ int qrtr_endpoint_register(struct qrtr_endpoint *ep, unsigned int nid);
+ 
+ void qrtr_endpoint_unregister(struct qrtr_endpoint *ep);
+ 
++bool qrtr_nodes_forward(unsigned int from, unsigned int to);
++
+ int qrtr_endpoint_post(struct qrtr_endpoint *ep, const void *data, size_t len);
+ 
+ bool qrtr_nodes_share_endpoint(unsigned int first, unsigned int second);
+-- 
+2.43.0
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0121-WIP-qrtr-mhi-Do-not-lose-server-announcements-to-the.patch b/device/testing/linux-postmarketos-qcom-sm8250/0121-WIP-qrtr-mhi-Do-not-lose-server-announcements-to-the.patch
new file mode 100644
index 0000000000..4a53617390
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0121-WIP-qrtr-mhi-Do-not-lose-server-announcements-to-the.patch
@@ -0,0 +1,75 @@
+From e47c3a4eb3f4af11a0352b18ba595a3bba7b514f Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Tue, 3 Nov 2026 19:56:59 +0100
+Subject: [PATCH 121/137] WIP: qrtr/mhi: Do not lose server announcements to
+ the SDX55
+
+The SDX55 IPCR ring had 8 elements; announcing the remote servers after
+the modem says hello filled it and the name service gave up. Use bigger
+rings and retry when the ring is full.
+
+Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
+(cherry picked from commit 22ddf080a2e758db93a1004ece6e12b58a8d5414)
+---
+ drivers/bus/mhi/host/pci_generic.c |  4 ++--
+ net/qrtr/ns.c                      | 15 +++++++++++----
+ 2 files changed, 13 insertions(+), 6 deletions(-)
+
+diff --git a/drivers/bus/mhi/host/pci_generic.c b/drivers/bus/mhi/host/pci_generic.c
+index cedbebcae..b605fa6be 100644
+--- a/drivers/bus/mhi/host/pci_generic.c
++++ b/drivers/bus/mhi/host/pci_generic.c
+@@ -461,8 +461,8 @@ static const struct mhi_channel_config modem_qcom_sdx55_flashless_channels[] = {
+ 	MHI_CHANNEL_CONFIG_DL(13, "MBIM", 4, 0),
+ 	MHI_CHANNEL_CONFIG_UL(14, "QMI", 4, 0),
+ 	MHI_CHANNEL_CONFIG_DL(15, "QMI", 4, 0),
+-	MHI_CHANNEL_CONFIG_UL(20, "IPCR", 8, 0),
+-	MHI_CHANNEL_CONFIG_DL(21, "IPCR", 8, 0),
++	MHI_CHANNEL_CONFIG_UL(20, "IPCR", 64, 0),
++	MHI_CHANNEL_CONFIG_DL(21, "IPCR", 32, 0),
+ 	MHI_CHANNEL_CONFIG_UL(46, "IP_SW0", 64, 2),
+ 	MHI_CHANNEL_CONFIG_DL(47, "IP_SW0", 64, 3),
+ 	/* Voice packets go through an ADSP <-> modem mailbox, no rings */
+diff --git a/net/qrtr/ns.c b/net/qrtr/ns.c
+index 50ec71fd4..238e93a56 100644
+--- a/net/qrtr/ns.c
++++ b/net/qrtr/ns.c
+@@ -5,6 +5,7 @@
+  * Copyright (c) 2020, Linaro Ltd.
+  */
+ 
++#include <linux/delay.h>
+ #include <linux/module.h>
+ #include <linux/qrtr.h>
+ #include <linux/workqueue.h>
+@@ -217,7 +218,7 @@ static int announce_servers(struct sockaddr_qrtr *sq)
+ 	struct qrtr_server *srv;
+ 	struct qrtr_node *node;
+ 	unsigned long index, node_idx;
+-	int ret;
++	int ret, retry;
+ 
+ 	node = node_get(qrtr_ns.local_node);
+ 	if (!node)
+@@ -242,9 +243,15 @@ static int announce_servers(struct sockaddr_qrtr *sq)
+ 			continue;
+ 
+ 		xa_for_each(&node->servers, index, srv) {
+-			ret = service_announce_new(sq, srv);
+-			if (ret < 0 && ret != -ENODEV)
+-				return ret;
++			for (retry = 0; retry < 50; retry++) {
++				/* A small MHI ring can be full right after boot */
++				ret = service_announce_new(sq, srv);
++				if (ret != -EAGAIN && ret != -ENOSPC && ret != -ENOMEM)
++					break;
++				msleep(10);
++			}
++			if (ret < 0)
++				pr_warn("qrtr ns: announce to %u failed: %d\n", sq->sq_node, ret);
+ 		}
+ 	}
+ 	return 0;
+-- 
+2.43.0
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0122-WIP-net-qrtr-Forward-data-broadcasts.patch b/device/testing/linux-postmarketos-qcom-sm8250/0122-WIP-net-qrtr-Forward-data-broadcasts.patch
new file mode 100644
index 0000000000..fdccb78e9e
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0122-WIP-net-qrtr-Forward-data-broadcasts.patch
@@ -0,0 +1,44 @@
+From 443a7e931c5f7513b504eb7e6941609d534ba43b Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Tue, 3 Nov 2026 20:39:37 +0100
+Subject: [PATCH 122/137] WIP: net: qrtr: Forward data broadcasts
+
+Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
+(cherry picked from commit 73199ac0c20dc82edfd52e5c71146834140c257b)
+---
+ net/qrtr/af_qrtr.c | 12 ++++++++++++
+ 1 file changed, 12 insertions(+)
+
+diff --git a/net/qrtr/af_qrtr.c b/net/qrtr/af_qrtr.c
+index a025b855c..1cb1267b5 100644
+--- a/net/qrtr/af_qrtr.c
++++ b/net/qrtr/af_qrtr.c
+@@ -668,6 +668,16 @@ int qrtr_endpoint_post(struct qrtr_endpoint *ep, const void *data, size_t len)
+ 		qrtr_node_assign(node, le32_to_cpu(pkt->server.node));
+ 	}
+ 
++	/* Data broadcasts, e.g. APR clients registering with a service */
++	if (cb->type == QRTR_TYPE_DATA && (cb->dst_node == QRTR_NODE_BCAST ||
++					    cb->dst_node == (u16)QRTR_NODE_BCAST)) {
++		cb->dst_node = QRTR_NODE_BCAST;
++		pr_info("qrtr fwd: data bcast %u:%u -> port %u len %zu\n",
++			cb->src_node, cb->src_port, cb->dst_port, size);
++		qrtr_fwd_queue_skb(ep, skb, true);
++		return 0;
++	}
++
+ 	/* Data for a node behind another endpoint */
+ 	if ((cb->type == QRTR_TYPE_DATA || cb->type == QRTR_TYPE_RESUME_TX) &&
+ 	    cb->dst_node != qrtr_local_nid && cb->dst_node != QRTR_NODE_BCAST) {
+@@ -702,6 +712,8 @@ int qrtr_endpoint_post(struct qrtr_endpoint *ep, const void *data, size_t len)
+ 	return 0;
+ 
+ err:
++	print_hex_dump(KERN_INFO, "qrtr invalid: ", DUMP_PREFIX_OFFSET, 16, 4,
++		       data, min_t(size_t, len, 64), false);
+ 	kfree_skb(skb);
+ 	return -EINVAL;
+ 
+-- 
+2.43.0
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0123-WIP-net-qrtr-Forward-name-addressed-broadcasts-type-.patch b/device/testing/linux-postmarketos-qcom-sm8250/0123-WIP-net-qrtr-Forward-name-addressed-broadcasts-type-.patch
new file mode 100644
index 0000000000..ceb0321e8d
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0123-WIP-net-qrtr-Forward-name-addressed-broadcasts-type-.patch
@@ -0,0 +1,49 @@
+From a5f0064e81ce4141d2fc96ce5ae6076ebf6a874f Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Tue, 3 Nov 2026 20:45:13 +0100
+Subject: [PATCH 123/137] WIP: net: qrtr: Forward name addressed broadcasts
+ (type 8)
+
+Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
+(cherry picked from commit 5fae9b8c486a2fff6d593826155a8d6621a3d7b4)
+---
+ net/qrtr/af_qrtr.c | 16 ++++++++++++++++
+ 1 file changed, 16 insertions(+)
+
+diff --git a/net/qrtr/af_qrtr.c b/net/qrtr/af_qrtr.c
+index 1cb1267b5..0bde2f875 100644
+--- a/net/qrtr/af_qrtr.c
++++ b/net/qrtr/af_qrtr.c
+@@ -88,6 +88,8 @@ struct qrtr_cb {
+ 	u32 fwd_ep_nid;
+ };
+ 
++#define QRTR_TYPE_NAME_BCAST	8
++
+ #define QRTR_HDR_MAX_SIZE max_t(size_t, sizeof(struct qrtr_hdr_v1), \
+ 					sizeof(struct qrtr_hdr_v2))
+ 
+@@ -652,6 +654,20 @@ int qrtr_endpoint_post(struct qrtr_endpoint *ep, const void *data, size_t len)
+ 	    size < sizeof(struct qrtr_ctrl_pkt))
+ 		goto err;
+ 
++	/*
++	 * Type 8 from IPC router firmware: data to all servers of a service,
++	 * addressed by name (dst node = service, dst port = instance). APR
++	 * clients on the modem register with the ADSP like this.
++	 */
++	if (cb->type == QRTR_TYPE_NAME_BCAST) {
++		skb_put_data(skb, data + hdrlen, size);
++		qrtr_node_assign(node, cb->src_node);
++		pr_info("qrtr fwd: name bcast %u:%u -> svc %u inst %u len %zu\n",
++			cb->src_node, cb->src_port, cb->dst_node, cb->dst_port, size);
++		qrtr_fwd_queue_skb(ep, skb, true);
++		return 0;
++	}
++
+ 	if (cb->dst_port != QRTR_PORT_CTRL && cb->type != QRTR_TYPE_DATA &&
+ 	    cb->type != QRTR_TYPE_RESUME_TX)
+ 		goto err;
+-- 
+2.43.0
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0124-WIP-ASoC-qcom-q6voice-dai-Optionally-give-the-modem-.patch b/device/testing/linux-postmarketos-qcom-sm8250/0124-WIP-ASoC-qcom-q6voice-dai-Optionally-give-the-modem-.patch
new file mode 100644
index 0000000000..7b472b6601
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0124-WIP-ASoC-qcom-q6voice-dai-Optionally-give-the-modem-.patch
@@ -0,0 +1,87 @@
+From f5795baaa03bba87ff9e43dd3e3e88c2990ebd68 Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Tue, 3 Nov 2026 20:58:34 +0100
+Subject: [PATCH 124/137] WIP: ASoC: qcom: q6voice-dai: Optionally give the
+ modem the physical mailbox address
+
+Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
+(cherry picked from commit f503edb423fc434617e446fdd9e4a060372a302c)
+---
+ sound/soc/qcom/qdsp6/q6voice-dai.c | 40 ++++++++++++++++++++++++------
+ 1 file changed, 33 insertions(+), 7 deletions(-)
+
+diff --git a/sound/soc/qcom/qdsp6/q6voice-dai.c b/sound/soc/qcom/qdsp6/q6voice-dai.c
+index 4d945707b..119e77d2a 100644
+--- a/sound/soc/qcom/qdsp6/q6voice-dai.c
++++ b/sound/soc/qcom/qdsp6/q6voice-dai.c
+@@ -3,6 +3,7 @@
+ // Copyright (c) 2020, Stephan Gerhold
+ 
+ #include <linux/dma-mapping.h>
++#include <linux/iommu.h>
+ #include <linux/mhi.h>
+ #include <linux/module.h>
+ #include <linux/of.h>
+@@ -36,6 +37,10 @@ struct q6voice_mailbox {
+ 	struct mutex lock;
+ };
+ 
++static bool pcie_identity = true;
++module_param(pcie_identity, bool, 0444);
++MODULE_PARM_DESC(pcie_identity, "Give the modem the physical mailbox address");
++
+ static struct q6voice_mailbox q6voice_mbox = {
+ 	.lock = __MUTEX_INITIALIZER(q6voice_mbox.lock),
+ };
+@@ -101,11 +106,24 @@ static int q6voice_mhi_probe(struct mhi_device *mhi_dev,
+ 		goto out;
+ 	}
+ 
+-	mb->pcie_addr = dma_map_resource(pcie_dev, mb->phys, mb->size,
+-					 DMA_BIDIRECTIONAL, 0);
+-	if (dma_mapping_error(pcie_dev, mb->pcie_addr)) {
+-		ret = -ENOMEM;
+-		goto out;
++	if (pcie_identity) {
++		struct iommu_domain *dom = iommu_get_domain_for_dev(pcie_dev);
++
++		/* The modem may expect the physical address of the mailbox */
++		if (dom) {
++			ret = iommu_map(dom, mb->phys, mb->phys, mb->size,
++					IOMMU_READ | IOMMU_WRITE, GFP_KERNEL);
++			if (ret)
++				goto out;
++		}
++		mb->pcie_addr = mb->phys;
++	} else {
++		mb->pcie_addr = dma_map_resource(pcie_dev, mb->phys, mb->size,
++						 DMA_BIDIRECTIONAL, 0);
++		if (dma_mapping_error(pcie_dev, mb->pcie_addr)) {
++			ret = -ENOMEM;
++			goto out;
++		}
+ 	}
+ 
+ 	mb->mhi_dev = mhi_dev;
+@@ -121,8 +139,16 @@ static void q6voice_mhi_remove(struct mhi_device *mhi_dev)
+ 	struct q6voice_mailbox *mb = &q6voice_mbox;
+ 
+ 	mutex_lock(&mb->lock);
+-	dma_unmap_resource(mhi_dev->mhi_cntrl->cntrl_dev, mb->pcie_addr,
+-			   mb->size, DMA_BIDIRECTIONAL, 0);
++	if (pcie_identity) {
++		struct iommu_domain *dom =
++			iommu_get_domain_for_dev(mhi_dev->mhi_cntrl->cntrl_dev);
++
++		if (dom)
++			iommu_unmap(dom, mb->phys, mb->size);
++	} else {
++		dma_unmap_resource(mhi_dev->mhi_cntrl->cntrl_dev, mb->pcie_addr,
++				   mb->size, DMA_BIDIRECTIONAL, 0);
++	}
+ 	mb->mhi_dev = NULL;
+ 	mb->configured = false;
+ 	mb->votes = 0;
+-- 
+2.43.0
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0125-WIP-ASoC-qcom-q6voice-dai-Configure-the-mailbox-once.patch b/device/testing/linux-postmarketos-qcom-sm8250/0125-WIP-ASoC-qcom-q6voice-dai-Configure-the-mailbox-once.patch
new file mode 100644
index 0000000000..3b6d571394
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0125-WIP-ASoC-qcom-q6voice-dai-Configure-the-mailbox-once.patch
@@ -0,0 +1,103 @@
+From ee3ab6a49e69a538a5613cb86bbe85e11a412ba8 Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Tue, 3 Nov 2026 21:06:48 +0100
+Subject: [PATCH 125/137] WIP: ASoC: qcom: q6voice-dai: Configure the mailbox
+ once modem and ADSP are up
+
+Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
+(cherry picked from commit b55a12822f2de335b4b131315c28c05877322b9a)
+---
+ sound/soc/qcom/qdsp6/q6voice-dai.c | 49 ++++++++++++++++++++++++------
+ 1 file changed, 39 insertions(+), 10 deletions(-)
+
+diff --git a/sound/soc/qcom/qdsp6/q6voice-dai.c b/sound/soc/qcom/qdsp6/q6voice-dai.c
+index 119e77d2a..7431fac0c 100644
+--- a/sound/soc/qcom/qdsp6/q6voice-dai.c
++++ b/sound/soc/qcom/qdsp6/q6voice-dai.c
+@@ -37,7 +37,7 @@ struct q6voice_mailbox {
+ 	struct mutex lock;
+ };
+ 
+-static bool pcie_identity = true;
++static bool pcie_identity;
+ module_param(pcie_identity, bool, 0444);
+ MODULE_PARM_DESC(pcie_identity, "Give the modem the physical mailbox address");
+ 
+@@ -45,6 +45,40 @@ static struct q6voice_mailbox q6voice_mbox = {
+ 	.lock = __MUTEX_INITIALIZER(q6voice_mbox.lock),
+ };
+ 
++/* Called with mb->lock held */
++static int q6voice_mailbox_configure(struct q6voice_mailbox *mb)
++{
++	int ret;
++
++	ret = q6mvm_set_mailbox(mb->adsp_addr, mb->pcie_addr, mb->size);
++	if (!ret)
++		mb->configured = true;
++	dev_info(mb->dev, "mailbox adsp %pad pcie %pad size %zu: %d\n",
++		 &mb->adsp_addr, &mb->pcie_addr, mb->size, ret);
++	return ret;
++}
++
++/*
++ * The modem asks the ADSP for the mailbox as soon as a call starts, so tell
++ * the ADSP about it right away, like the downstream voice_mhi driver.
++ */
++static void q6voice_mailbox_work_fn(struct work_struct *work);
++static DECLARE_DELAYED_WORK(q6voice_mailbox_work, q6voice_mailbox_work_fn);
++
++static void q6voice_mailbox_work_fn(struct work_struct *work)
++{
++	struct q6voice_mailbox *mb = &q6voice_mbox;
++	int ret = 0;
++
++	mutex_lock(&mb->lock);
++	if (mb->dev && mb->mhi_dev && !mb->configured)
++		ret = q6voice_mailbox_configure(mb);
++	mutex_unlock(&mb->lock);
++
++	if (ret)
++		schedule_delayed_work(&q6voice_mailbox_work, HZ);
++}
++
+ static int q6voice_mailbox_get(void)
+ {
+ 	struct q6voice_mailbox *mb = &q6voice_mbox;
+@@ -68,15 +102,8 @@ static int q6voice_mailbox_get(void)
+ 	}
+ 	mb->votes++;
+ 
+-	if (!mb->configured) {
+-		ret = q6mvm_set_mailbox(mb->adsp_addr, mb->pcie_addr, mb->size);
+-		if (ret)
+-			dev_err(mb->dev, "failed to set mailbox: %d\n", ret);
+-		else
+-			mb->configured = true;
+-		dev_info(mb->dev, "mailbox adsp %pad pcie %pad size %zu: %d\n",
+-			 &mb->adsp_addr, &mb->pcie_addr, mb->size, ret);
+-	}
++	if (!mb->configured)
++		q6voice_mailbox_configure(mb);
+ 
+ out:
+ 	mutex_unlock(&mb->lock);
+@@ -129,6 +156,7 @@ static int q6voice_mhi_probe(struct mhi_device *mhi_dev,
+ 	mb->mhi_dev = mhi_dev;
+ 	mb->configured = false;
+ 	mb->votes = 0;
++	schedule_delayed_work(&q6voice_mailbox_work, 0);
+ out:
+ 	mutex_unlock(&mb->lock);
+ 	return ret;
+@@ -488,6 +516,7 @@ module_init(q6voice_dai_init);
+ 
+ static void __exit q6voice_dai_exit(void)
+ {
++	cancel_delayed_work_sync(&q6voice_mailbox_work);
+ 	if (IS_ENABLED(CONFIG_MHI_BUS))
+ 		mhi_driver_unregister(&q6voice_mhi_driver);
+ 	platform_driver_unregister(&q6voice_dai_platform_driver);
+-- 
+2.43.0
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0126-WIP-ASoC-qcom-q6voice-dai-Map-the-mailbox-at-a-fixed.patch b/device/testing/linux-postmarketos-qcom-sm8250/0126-WIP-ASoC-qcom-q6voice-dai-Map-the-mailbox-at-a-fixed.patch
new file mode 100644
index 0000000000..e39ff9fbd0
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0126-WIP-ASoC-qcom-q6voice-dai-Map-the-mailbox-at-a-fixed.patch
@@ -0,0 +1,69 @@
+From 6e314644d812bb43696ac55eefcfa9af3f8bfdad Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Tue, 3 Nov 2026 21:11:20 +0100
+Subject: [PATCH 126/137] WIP: ASoC: qcom: q6voice-dai: Map the mailbox at a
+ fixed low PCIe address
+
+Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
+(cherry picked from commit ccc63fe2e6d420da8602ccdaed61898d6fed3f8a)
+---
+ sound/soc/qcom/qdsp6/q6voice-dai.c | 18 +++++++++---------
+ 1 file changed, 9 insertions(+), 9 deletions(-)
+
+diff --git a/sound/soc/qcom/qdsp6/q6voice-dai.c b/sound/soc/qcom/qdsp6/q6voice-dai.c
+index 7431fac0c..8787f5ed1 100644
+--- a/sound/soc/qcom/qdsp6/q6voice-dai.c
++++ b/sound/soc/qcom/qdsp6/q6voice-dai.c
+@@ -37,9 +37,9 @@ struct q6voice_mailbox {
+ 	struct mutex lock;
+ };
+ 
+-static bool pcie_identity;
+-module_param(pcie_identity, bool, 0444);
+-MODULE_PARM_DESC(pcie_identity, "Give the modem the physical mailbox address");
++static unsigned long pcie_iova = 0x20000000;
++module_param(pcie_iova, ulong, 0444);
++MODULE_PARM_DESC(pcie_iova, "PCIe address of the mailbox, 0 = from the DMA API");
+ 
+ static struct q6voice_mailbox q6voice_mbox = {
+ 	.lock = __MUTEX_INITIALIZER(q6voice_mbox.lock),
+@@ -133,17 +133,17 @@ static int q6voice_mhi_probe(struct mhi_device *mhi_dev,
+ 		goto out;
+ 	}
+ 
+-	if (pcie_identity) {
++	if (pcie_iova) {
+ 		struct iommu_domain *dom = iommu_get_domain_for_dev(pcie_dev);
+ 
+-		/* The modem may expect the physical address of the mailbox */
++		/* Downstream keeps MHI addresses in 0x20000000..0x3fffffff */
+ 		if (dom) {
+-			ret = iommu_map(dom, mb->phys, mb->phys, mb->size,
++			ret = iommu_map(dom, pcie_iova, mb->phys, mb->size,
+ 					IOMMU_READ | IOMMU_WRITE, GFP_KERNEL);
+ 			if (ret)
+ 				goto out;
+ 		}
+-		mb->pcie_addr = mb->phys;
++		mb->pcie_addr = pcie_iova;
+ 	} else {
+ 		mb->pcie_addr = dma_map_resource(pcie_dev, mb->phys, mb->size,
+ 						 DMA_BIDIRECTIONAL, 0);
+@@ -167,12 +167,12 @@ static void q6voice_mhi_remove(struct mhi_device *mhi_dev)
+ 	struct q6voice_mailbox *mb = &q6voice_mbox;
+ 
+ 	mutex_lock(&mb->lock);
+-	if (pcie_identity) {
++	if (pcie_iova) {
+ 		struct iommu_domain *dom =
+ 			iommu_get_domain_for_dev(mhi_dev->mhi_cntrl->cntrl_dev);
+ 
+ 		if (dom)
+-			iommu_unmap(dom, mb->phys, mb->size);
++			iommu_unmap(dom, pcie_iova, mb->size);
+ 	} else {
+ 		dma_unmap_resource(mhi_dev->mhi_cntrl->cntrl_dev, mb->pcie_addr,
+ 				   mb->size, DMA_BIDIRECTIONAL, 0);
+-- 
+2.43.0
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0127-WIP-ASoC-qcom-q6voice-dai-Start-AUDIO_VOICE_0-during.patch b/device/testing/linux-postmarketos-qcom-sm8250/0127-WIP-ASoC-qcom-q6voice-dai-Start-AUDIO_VOICE_0-during.patch
