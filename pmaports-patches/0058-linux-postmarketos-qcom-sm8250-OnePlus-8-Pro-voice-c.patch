+ 1 file changed, 7 insertions(+)
+
+diff --git a/sound/soc/qcom/qdsp6/q6voice-dai.c b/sound/soc/qcom/qdsp6/q6voice-dai.c
+index 9ff212201..76c19d1b4 100644
+--- a/sound/soc/qcom/qdsp6/q6voice-dai.c
++++ b/sound/soc/qcom/qdsp6/q6voice-dai.c
+@@ -234,6 +234,13 @@ static int q6voice_mailbox_init(struct device *dev)
+ 	mutex_lock(&mb->lock);
+ 	mb->phys = rmem->base;
+ 	mb->size = rmem->size;
++	/*
++	 * The ADSP address carries the SMMU context in bits 32 and up, so a
++	 * mapping ending exactly at 4 GiB overflows into them. The allocator
++	 * hands out the highest free IOVA first, so occupy that slot with a
++	 * page that is never used (as found on the Mi 10T by royka1).
++	 */
++	dma_map_resource(dev, mb->phys, PAGE_SIZE, DMA_BIDIRECTIONAL, 0);
+ 	mb->adsp_addr = dma_map_resource(dev, mb->phys, mb->size,
+ 					 DMA_BIDIRECTIONAL, 0);
+ 	if (dma_mapping_error(dev, mb->adsp_addr)) {
+-- 
+2.43.0
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0133-WIP-net-qrtr-Send-forwarded-RESUME_TX-to-the-node-it.patch b/device/testing/linux-postmarketos-qcom-sm8250/0133-WIP-net-qrtr-Send-forwarded-RESUME_TX-to-the-node-it.patch
new file mode 100644
index 0000000000..a6ab966a74
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0133-WIP-net-qrtr-Send-forwarded-RESUME_TX-to-the-node-it.patch
@@ -0,0 +1,31 @@
+From d8a48c0a9372d01c215c359fa40f5db386c2082f Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Sat, 14 Nov 2026 14:29:45 +0100
+Subject: [PATCH 133/137] WIP: net: qrtr: Send forwarded RESUME_TX to the node
+ it is meant for
+
+---
+ net/qrtr/af_qrtr.c | 7 ++++++-
+ 1 file changed, 6 insertions(+), 1 deletion(-)
+
+diff --git a/net/qrtr/af_qrtr.c b/net/qrtr/af_qrtr.c
+index 0bde2f875..18f671280 100644
+--- a/net/qrtr/af_qrtr.c
++++ b/net/qrtr/af_qrtr.c
+@@ -496,7 +496,12 @@ static void qrtr_fwd_xmit(struct qrtr_node *node, struct sk_buff *skb)
+ 	hdr->type = cpu_to_le32(cb->type);
+ 	hdr->src_node_id = cpu_to_le32(cb->src_node);
+ 	hdr->src_port_id = cpu_to_le32(cb->src_port);
+-	if (cb->dst_port == QRTR_PORT_CTRL)
++	/*
++	 * Broadcast control messages go to the neighbour itself. A RESUME_TX
++	 * is for one sender, which may be a node behind the neighbour (the
++	 * SDX55 has two nodes on its MHI link), so keep its destination.
++	 */
++	if (cb->dst_port == QRTR_PORT_CTRL && cb->type != QRTR_TYPE_RESUME_TX)
+ 		hdr->dst_node_id = cpu_to_le32(node->nid);
+ 	else
+ 		hdr->dst_node_id = cpu_to_le32(cb->dst_node);
+-- 
+2.43.0
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0134-WIP-ASoC-qcom-q6cvp-Make-the-vocproc-topologies-para.patch b/device/testing/linux-postmarketos-qcom-sm8250/0134-WIP-ASoC-qcom-q6cvp-Make-the-vocproc-topologies-para.patch
new file mode 100644
index 0000000000..aaf8d2d4f5
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0134-WIP-ASoC-qcom-q6cvp-Make-the-vocproc-topologies-para.patch
@@ -0,0 +1,48 @@
+From 638450dd32937598309f57288273266c0a423ae7 Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Sat, 14 Nov 2026 14:42:51 +0100
+Subject: [PATCH 134/137] WIP: ASoC: qcom: q6cvp: Make the vocproc topologies
+ parameters, no Tx processing by default
+
+---
+ sound/soc/qcom/qdsp6/q6cvp.c | 17 +++++++++++++++--
+ 1 file changed, 15 insertions(+), 2 deletions(-)
+
+diff --git a/sound/soc/qcom/qdsp6/q6cvp.c b/sound/soc/qcom/qdsp6/q6cvp.c
+index 3549d3f14..6d8cc64ef 100644
+--- a/sound/soc/qcom/qdsp6/q6cvp.c
++++ b/sound/soc/qcom/qdsp6/q6cvp.c
+@@ -91,6 +91,19 @@ struct vss_ivocproc_cmd_create_full_control_session_v2_cmd {
+ 	char name[20];
+ } __packed;
+ 
++/*
++ * Without calibration data the single mic ECNS topology gives a silent
++ * uplink on the SM8250 ADSP, so run the Tx path without processing by
++ * default.
++ */
++static unsigned int tx_topology = VSS_IVOCPROC_TOPOLOGY_ID_NONE;
++module_param(tx_topology, uint, 0644);
++MODULE_PARM_DESC(tx_topology, "Topology of the vocproc's Tx path");
++
++static unsigned int rx_topology = VSS_IVOCPROC_TOPOLOGY_ID_RX_DEFAULT;
++module_param(rx_topology, uint, 0644);
++MODULE_PARM_DESC(rx_topology, "Topology of the vocproc's Rx path");
++
+ struct q6voice_session *q6cvp_session_create(enum q6voice_path_type path,
+ 					     u16 tx_port, u16 rx_port)
+ {
+@@ -100,8 +113,8 @@ struct q6voice_session *q6cvp_session_create(enum q6voice_path_type path,
+ 	cmd.hdr.opcode = VSS_IVOCPROC_CMD_CREATE_FULL_CONTROL_SESSION_V2;
+ 
+ 	/* TODO: Implement calibration */
+-	cmd.tx_topology_id = VSS_IVOCPROC_TOPOLOGY_ID_TX_SM_ECNS;
+-	cmd.rx_topology_id = VSS_IVOCPROC_TOPOLOGY_ID_RX_DEFAULT;
++	cmd.tx_topology_id = tx_topology;
++	cmd.rx_topology_id = rx_topology;
+ 
+ 	cmd.direction = VSS_IVOCPROC_DIRECTION_RX_TX;
+ 	cmd.tx_port_id = tx_port;
+-- 
+2.43.0
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0135-WIP-net-qrtr-Make-the-forwarding-messages-debug-outp.patch b/device/testing/linux-postmarketos-qcom-sm8250/0135-WIP-net-qrtr-Make-the-forwarding-messages-debug-outp.patch
new file mode 100644
index 0000000000..90e4df9364
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0135-WIP-net-qrtr-Make-the-forwarding-messages-debug-outp.patch
@@ -0,0 +1,44 @@
+From adf8bfe1b76a8dfe25e41a589a2ab43bdd0a761c Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Sat, 14 Nov 2026 14:50:56 +0100
+Subject: [PATCH 135/137] WIP: net: qrtr: Make the forwarding messages debug
+ output
+
+---
+ net/qrtr/af_qrtr.c | 6 +++---
+ 1 file changed, 3 insertions(+), 3 deletions(-)
+
+diff --git a/net/qrtr/af_qrtr.c b/net/qrtr/af_qrtr.c
+index 18f671280..fb18356ea 100644
+--- a/net/qrtr/af_qrtr.c
++++ b/net/qrtr/af_qrtr.c
+@@ -667,7 +667,7 @@ int qrtr_endpoint_post(struct qrtr_endpoint *ep, const void *data, size_t len)
+ 	if (cb->type == QRTR_TYPE_NAME_BCAST) {
+ 		skb_put_data(skb, data + hdrlen, size);
+ 		qrtr_node_assign(node, cb->src_node);
+-		pr_info("qrtr fwd: name bcast %u:%u -> svc %u inst %u len %zu\n",
++		pr_debug("qrtr fwd: name bcast %u:%u -> svc %u inst %u len %zu\n",
+ 			cb->src_node, cb->src_port, cb->dst_node, cb->dst_port, size);
+ 		qrtr_fwd_queue_skb(ep, skb, true);
+ 		return 0;
+@@ -693,7 +693,7 @@ int qrtr_endpoint_post(struct qrtr_endpoint *ep, const void *data, size_t len)
+ 	if (cb->type == QRTR_TYPE_DATA && (cb->dst_node == QRTR_NODE_BCAST ||
+ 					    cb->dst_node == (u16)QRTR_NODE_BCAST)) {
+ 		cb->dst_node = QRTR_NODE_BCAST;
+-		pr_info("qrtr fwd: data bcast %u:%u -> port %u len %zu\n",
++		pr_debug("qrtr fwd: data bcast %u:%u -> port %u len %zu\n",
+ 			cb->src_node, cb->src_port, cb->dst_port, size);
+ 		qrtr_fwd_queue_skb(ep, skb, true);
+ 		return 0;
+@@ -733,7 +733,7 @@ int qrtr_endpoint_post(struct qrtr_endpoint *ep, const void *data, size_t len)
+ 	return 0;
+ 
+ err:
+-	print_hex_dump(KERN_INFO, "qrtr invalid: ", DUMP_PREFIX_OFFSET, 16, 4,
++	print_hex_dump_debug("qrtr invalid: ", DUMP_PREFIX_OFFSET, 16, 4,
+ 		       data, min_t(size_t, len, 64), false);
+ 	kfree_skb(skb);
+ 	return -EINVAL;
+-- 
