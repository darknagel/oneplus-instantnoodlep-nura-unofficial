++
++int q6mvm_start(struct q6voice_session *mvm, bool state)
++{
++	struct apr_pkt cmd;
++
++	cmd.hdr.pkt_size = APR_HDR_SIZE;
++	cmd.hdr.opcode = state ? VSS_IMVM_CMD_START_VOICE : VSS_IMVM_CMD_STOP_VOICE;
++
++	return q6voice_common_send(mvm, &cmd.hdr);
++}
++EXPORT_SYMBOL_GPL(q6mvm_start);
++
++int q6mvm_set_mailbox(u64 adsp_addr, u64 pcie_addr, u32 size)
++{
++	struct vss_ipktexg_cmd_set_mailbox_memory_config cmd = {};
++	int ret;
++
++	if (!q6mvm_adev)
++		return -ENODEV;
++
++	cmd.hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
++					  APR_HDR_LEN(APR_HDR_SIZE), APR_PKT_VER);
++	cmd.hdr.pkt_size = sizeof(cmd);
++	cmd.hdr.src_port = Q6MVM_MAILBOX_PORT;
++	cmd.hdr.dest_port = 0;
++	cmd.hdr.opcode = VSS_IPKTEXG_CMD_SET_MAILBOX_MEMORY_CONFIG;
++	cmd.mailbox_mem_address_adsp = adsp_addr;
++	cmd.mailbox_mem_address_pcie = pcie_addr;
++	cmd.mem_size = size;
++
++	q6mvm_mailbox_done = false;
++	ret = apr_send_pkt(q6mvm_adev, (struct apr_pkt *)&cmd);
++	if (ret < 0)
++		return ret;
++
++	if (!wait_event_timeout(q6mvm_mailbox_wait, q6mvm_mailbox_done,
++				msecs_to_jiffies(500)))
++		return -ETIMEDOUT;
++
++	if (q6mvm_mailbox_status) {
++		dev_err(&q6mvm_adev->dev, "mailbox config failed: %#x\n",
++			q6mvm_mailbox_status);
++		return -EIO;
++	}
++
++	return 0;
++}
++EXPORT_SYMBOL_GPL(q6mvm_set_mailbox);
++
++static int q6mvm_callback(struct apr_device *adev, const struct apr_resp_pkt *data)
++{
++	const struct aprv2_ibasic_rsp_result_t *result = data->payload;
++
++	if (data->hdr.dest_port == Q6MVM_MAILBOX_PORT) {
++		if (data->hdr.opcode == APR_BASIC_RSP_RESULT &&
++		    result->opcode == VSS_IPKTEXG_CMD_SET_MAILBOX_MEMORY_CONFIG) {
++			q6mvm_mailbox_status = result->status;
++			q6mvm_mailbox_done = true;
++			wake_up(&q6mvm_mailbox_wait);
++		}
++		return 0;
++	}
++
++	return q6voice_common_callback(adev, data);
++}
