diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0100-arm64-dts-qcom-instantnoodlep-connect-DisplayPort-au.patch b/device/testing/linux-postmarketos-qcom-sm8250/0100-arm64-dts-qcom-instantnoodlep-connect-DisplayPort-au.patch
