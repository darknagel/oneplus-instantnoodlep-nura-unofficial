From 75e12cad2c63fb5b6b45f2610b0442e23d375f93 Mon Sep 17 00:00:00 2001
From: Timo <1788603+darknagel@users.noreply.github.com>
Date: Tue, 10 Nov 2026 23:06:24 +0100
Subject: [PATCH 43/43] linux-postmarketos-qcom-sm8250: fix resume from suspend
 on the OnePlus 8 Pro

Kernel patches 0080 and 0081: the sensor DSP no longer crashes at every
resume (FastRPC invocations were restarted by the freezer and sent
twice), and the touchscreen controller is set up again after resume.
---
 ...not-restart-invocations-when-the-sys.patch | 50 ++++++++++++++++
 ...et-the-controller-up-again-on-resume.patch | 57 +++++++++++++++++++
 .../linux-postmarketos-qcom-sm8250/APKBUILD   |  6 +-
 3 files changed, 112 insertions(+), 1 deletion(-)
 create mode 100644 device/testing/linux-postmarketos-qcom-sm8250/0080-misc-fastrpc-Do-not-restart-invocations-when-the-sys.patch
 create mode 100644 device/testing/linux-postmarketos-qcom-sm8250/0081-Input-s6sy761-set-the-controller-up-again-on-resume.patch

diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0080-misc-fastrpc-Do-not-restart-invocations-when-the-sys.patch b/device/testing/linux-postmarketos-qcom-sm8250/0080-misc-fastrpc-Do-not-restart-invocations-when-the-sys.patch
new file mode 100644
index 0000000000..1e06164aff
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0080-misc-fastrpc-Do-not-restart-invocations-when-the-sys.patch
@@ -0,0 +1,50 @@
+From 0d924200b985abdb1b2c367d00b5f9e781697eb7 Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Tue, 10 Nov 2026 22:50:09 +0100
+Subject: [PATCH 80/81] misc: fastrpc: Do not restart invocations when the
+ system suspends
+
+User space invocations wait interruptibly for the reply of the DSP. The
+freezer wakes such a task with a fake signal, the wait returns
+-ERESTARTSYS and the system call is restarted on resume. The context of
+the first attempt stays pending, so the DSP receives the same invocation
+twice.
+
+For a daemon that serves the DSP (adsp_listener next2) the second
+invocation carries the result of the previous request again. On the
+OnePlus 8 Pro the sensor DSP takes an exception in its FastRPC thread at
+every resume:
+
+  PDM: service 'sensor_process' crash: 'EX:sensor_process:0x1:frpc_dsp:0x73:PC=0xb20955ac'
+  remoteproc remoteproc0: crash detected in slpi: type fatal error
+
+Make the wait freezable, so that the task is frozen in place and simply
+continues to wait after resume.
+
+Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
+---
+ drivers/misc/fastrpc.c | 8 +++++++-
+ 1 file changed, 7 insertions(+), 1 deletion(-)
+
+diff --git a/drivers/misc/fastrpc.c b/drivers/misc/fastrpc.c
+index 8a2a5414f..94657dccf 100644
+--- a/drivers/misc/fastrpc.c
++++ b/drivers/misc/fastrpc.c
+@@ -1278,7 +1278,13 @@ static int fastrpc_internal_invoke(struct fastrpc_user *fl,  u32 kernel,
+ 		if (!wait_for_completion_timeout(&ctx->work, 10 * HZ))
+ 			err = -ETIMEDOUT;
+ 	} else {
+-		err = wait_for_completion_interruptible(&ctx->work);
++		/*
++		 * Freezable: the freezer otherwise interrupts the wait, the
++		 * system call is restarted on resume and sends the invocation
++		 * a second time while the first one is still pending.
++		 */
++		err = wait_for_completion_state(&ctx->work,
++						TASK_INTERRUPTIBLE | TASK_FREEZABLE);
+ 	}
+ 
+ 	if (err)
+-- 
+2.43.0
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0081-Input-s6sy761-set-the-controller-up-again-on-resume.patch b/device/testing/linux-postmarketos-qcom-sm8250/0081-Input-s6sy761-set-the-controller-up-again-on-resume.patch
new file mode 100644
index 0000000000..138dab12b2
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0081-Input-s6sy761-set-the-controller-up-again-on-resume.patch
@@ -0,0 +1,57 @@
+From 15fd29c49d8cd1337d66a717f4342d7529dcd175 Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Tue, 10 Nov 2026 22:50:09 +0100
+Subject: [PATCH 81/81] Input: s6sy761 - set the controller up again on resume
+
+The resume handler enabled the interrupt before powering the controller
+up. The interrupt thread then read the boot event that
+s6sy761_power_on() checks for, so every resume failed:
+
+  s6sy761 13-0048: failed to read events
+  s6sy761 13-0048: PM: dpm_run_callback(): s6sy761_resume returns -19
+
+The touch function was not enabled again, and sensing was never turned
+back on although the controller had lost its state with the power.
+
+Power the controller up first, turn sensing on if the input device is
+in use, and enable the interrupt last.
+
+Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
+---
+ drivers/input/touchscreen/s6sy761.c | 17 ++++++++++++++++-
+ 1 file changed, 16 insertions(+), 1 deletion(-)
+
+diff --git a/drivers/input/touchscreen/s6sy761.c b/drivers/input/touchscreen/s6sy761.c
+index 3d8fcfa7f..3a6586db7 100644
+--- a/drivers/input/touchscreen/s6sy761.c
++++ b/drivers/input/touchscreen/s6sy761.c
+@@ -500,10 +500,25 @@ static int s6sy761_suspend(struct device *dev)
+ static int s6sy761_resume(struct device *dev)
+ {
+ 	struct s6sy761_data *sdata = dev_get_drvdata(dev);
++	struct input_dev *input = sdata->input;
++	int ret;
++
++	/*
++	 * Keep the interrupt off until the controller is set up: the handler
++	 * would read the boot event that s6sy761_power_on() waits for.
++	 */
++	ret = s6sy761_power_on(sdata);
++	if (!ret) {
++		/* The controller lost its state, turn sensing back on */
++		mutex_lock(&input->mutex);
++		if (input_device_enabled(input))
++			ret = s6sy761_input_open(input);
++		mutex_unlock(&input->mutex);
++	}
+ 
+ 	enable_irq(sdata->client->irq);
+ 
+-	return s6sy761_power_on(sdata);
++	return ret;
+ }
+ 
+ static const struct dev_pm_ops s6sy761_pm_ops = {
+-- 
+2.43.0
+
