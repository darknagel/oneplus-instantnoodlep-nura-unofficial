++				startScan(context, sharpness);
+ 			}
+ 			return;
+ 		}
+@@ -204,7 +434,7 @@ void Af::process(IPAContext &context,
+ 
+ 		if (refSharpness_ == 0.0) {
+ 			if (++validFrames_ >= warmup_)
+-				startScan(context);
++				startScan(context, sharpness);
+ 			return;
+ 		}
+ 
+@@ -213,7 +443,7 @@ void Af::process(IPAContext &context,
+ 				LOG(IPASoftAf, Debug)
+ 					<< "Sharpness changed " << refSharpness_
+ 					<< " -> " << sharpness << ", rescanning";
+-				startScan(context);
++				startScan(context, sharpness);
+ 			}
+ 		} else {
+ 			changed_ = 0;
+@@ -221,46 +451,16 @@ void Af::process(IPAContext &context,
+ 		}
+ 		return;
+ 
+-	case State::Coarse:
++	case State::Climb:
++		LOG(IPASoftAf, Debug) << "Climb " << position_ << ": " << sharpness;
+ 		record(position_, sharpness);
+-		LOG(IPASoftAf, Debug)
+-			<< "Coarse " << position_ << ": " << sharpness;
+-
+-		/*
+-		 * Stop early once well past a clear peak. Without a peak the
+-		 * curve is flat and its noise says nothing, so keep scanning.
+-		 */
+-		if (position_ + step_ <= scanEnd_ &&
+-		    (belowBest_ < stopCount_ ||
+-		     bestSharpness_ < minSharpness_ * minPeak_)) {
+-			moveTo(context, position_ + step_);
+-			return;
+-		}
+-
+-		state_ = State::Fine;
+-		step_ = std::max<int32_t>(coarseStep_ * 2 / fineSteps_, 1);
+-		scanEnd_ = std::min(bestPosition_ + coarseStep_ / 2,
+-				    context.configuration.af.max);
+-		moveTo(context, bestPosition_ - coarseStep_ / 2);
++		climb(context);
+ 		return;
+ 
+-	case State::Fine:
++	case State::Refine:
++		LOG(IPASoftAf, Debug) << "Refine " << position_ << ": " << sharpness;
+ 		record(position_, sharpness);
+-		LOG(IPASoftAf, Debug)
+-			<< "Fine " << position_ << ": " << sharpness;
+-
+-		if (position_ + step_ <= scanEnd_) {
+-			moveTo(context, position_ + step_);
+-			return;
+-		}
+-
+-		LOG(IPASoftAf, Debug)
+-			<< "Focused at " << bestPosition_ << " (" << bestSharpness_ << ")";
+-		moveTo(context, bestPosition_);
+-		state_ = State::Idle;
+-		afState_ = controls::AfStateFocused;
+-		refPending_ = true;
+-		validFrames_ = 0;
++		finish(context);
+ 		return;
