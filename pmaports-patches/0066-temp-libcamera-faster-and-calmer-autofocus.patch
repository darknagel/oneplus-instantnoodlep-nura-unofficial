+-void Af::record(int32_t position, double sharpness)
++/*
++ * Near its peak the sharpness falls off monotonically on both sides. A
++ * neighbour of the best position that is less sharp than the sample beyond
++ * it is a bad measurement (seen now and then right after a lens move), which
++ * would pull the fitted peak away. Measure it once more.
++ */
++bool Af::remeasureDip(IPAContext &context)
+ {
+-	if (minSharpness_ == 0.0 || sharpness < minSharpness_)
+-		minSharpness_ = sharpness;
++	if (remeasured_ || !hasPeak())
++		return false;
++
++	auto it = samples_.find(bestPosition_);
++	if (it == samples_.end())
++		return false;
++
++	for (int side : { -1, 1 }) {
++		auto n1 = it, n2 = it;
++		if (side < 0) {
++			if (it == samples_.begin() || std::prev(it) == samples_.begin())
++				continue;
++			n1 = std::prev(it);
++			n2 = std::prev(n1);
++		} else {
++			n1 = std::next(it);
++			if (n1 == samples_.end() || std::next(n1) == samples_.end())
++				continue;
++			n2 = std::next(n1);
++		}
+ 
+-	if (sharpness > bestSharpness_) {
+-		bestSharpness_ = sharpness;
+-		bestPosition_ = position;
++		if (n1->second >= n2->second)
++			continue;
++
++		LOG(IPASoftAf, Debug)
++			<< "Dip at " << n1->first << ": " << n1->second
++			<< ", measuring again";
++		remeasured_ = true;
++		state_ = State::Refine;
++		moveTo(context, n1->first);
++		return true;
++	}
++
++	return false;
++}
++
++/*
++ * Measure the neighbours of the best position at coarseStep distance when the
++ * scan passed it with a larger step, so that the peak is fitted on a fine
++ * enough grid.
++ */
++bool Af::refineNeighbour(IPAContext &context)
++{
++	if (!hasPeak())
++		return false;
++
++	for (int side : { -1, 1 }) {
++		int32_t target = bestPosition_ + side * coarseStep_;
++		if (target < min_ || target > max_ || samples_.count(target))
++			continue;
++
++		auto it = samples_.find(bestPosition_);
++		auto next = side < 0 ? (it == samples_.begin() ? samples_.end() : std::prev(it))
++				     : std::next(it);
++		if (next != samples_.end() &&
++		    std::abs(next->first - bestPosition_) <= coarseStep_)
++			continue;
++
++		state_ = State::Refine;
++		moveTo(context, target);
++		return true;
++	}
++
++	return false;
++}
++
++int32_t Af::interpolate() const
++{
++	auto it = samples_.find(bestPosition_);
++	if (it == samples_.end() || it == samples_.begin() ||
++	    std::next(it) == samples_.end())
++		return bestPosition_;
++
++	auto lo = std::prev(it);
++	auto hi = std::next(it);
++	if (lo->second <= 0.0 || hi->second <= 0.0 || it->second <= 0.0)
++		return bestPosition_;
++
++	/* Fit a parabola through the logarithms, i.e. a Gaussian. */
++	double x1 = lo->first, x2 = it->first, x3 = hi->first;
++	double y1 = std::log(lo->second);
++	double y2 = std::log(it->second);
++	double y3 = std::log(hi->second);
++
++	double den = (x2 - x1) * (y2 - y3) - (x2 - x3) * (y2 - y1);
++	if (den <= 0.0)
++		return bestPosition_;
++
++	double num = (x2 - x1) * (x2 - x1) * (y2 - y3) -
++		     (x2 - x3) * (x2 - x3) * (y2 - y1);
++	double x = x2 - 0.5 * num / den;
++
++	x = std::clamp(x, (x1 + x2) / 2, (x2 + x3) / 2);
++	return static_cast<int32_t>(std::lround(x));
++}
++
++void Af::finish(IPAContext &context)
++{
++	if (remeasureDip(context) || refineNeighbour(context))
++		return;
++
++	int32_t target = interpolate();
++	bool peak = hasPeak();
++
++	LOG(IPASoftAf, Debug)
++		<< (peak ? "Focused at " : "No peak, resting at ") << target
++		<< " (best " << bestPosition_ << ": " << bestSharpness_
++		<< ", " << samples_.size() << " samples)";
++
++	moveTo(context, target);
++	state_ = State::Idle;
++	afState_ = peak ? controls::AfStateFocused : controls::AfStateFailed;
++	refPending_ = true;
++	validFrames_ = 0;
++}
++
++void Af::climb(IPAContext &context)
++{
++	/* The first step from the start position went the wrong way. */
++	if (!reversed_ && bestPosition_ == origin_ && belowBest_ >= 1) {
++		reversed_ = true;
++		direction_ = -direction_;
+ 		belowBest_ = 0;
+-	} else if (sharpness < bestSharpness_ * stopRatio_) {
+-		belowBest_++;
++		int32_t next = origin_ + direction_ * coarseStep_;
++		if (next >= min_ && next <= max_) {
++			moveTo(context, next);
++			return;
++		}
++	}
++
++	/* Well past a clear peak. */
++	if (hasPeak() && belowBest_ >= stopCount_) {
++		finish(context);
++		return;
++	}
++
++	/* Large steps while the curve is flat, small ones near the peak. */
++	double flat = minSharpness_ * flatRatio_;
++	int32_t step = bestSharpness_ < flat ? flatStep_ : coarseStep_;
++	int32_t next = position_ + direction_ * step;
++	int32_t edge = direction_ > 0 ? max_ : min_;
++
++	if (next < min_ || next > max_) {
++		/* Measure the end of the range unless it is close. */
++		if (std::abs(edge - position_) > step / 2)
++			next = edge;
++	}
++
++	if (next >= min_ && next <= max_ && next != position_) {
++		moveTo(context, next);
++		return;
+ 	}
++
++	/* End of the range: search the other side of the start position. */
++	bool peakHere = hasPeak() && bestPosition_ != origin_;
++	if (!reversed_ && !peakHere) {
++		reversed_ = true;
++		direction_ = -direction_;
++		belowBest_ = 0;
++		next = origin_ + direction_ * coarseStep_;
++		if (next >= min_ && next <= max_) {
++			moveTo(context, next);
++			return;
++		}
++	}
++
++	finish(context);
+ }
+ 
