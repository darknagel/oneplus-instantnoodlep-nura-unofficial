++void Af::startScan(IPAContext &context, double sharpness)
++{
++	samples_.clear();
+ 	bestSharpness_ = 0.0;
+-	bestPosition_ = af.min;
++	bestPosition_ = position_;
+ 	minSharpness_ = 0.0;
+ 	belowBest_ = 0;
+ 	changed_ = 0;
+ 
+-	moveTo(context, af.min);
+-	/* The first move can cross the whole range, give it more time. */
+-	settle_ = settleFrames_ * 2;
++	state_ = State::Climb;
++	afState_ = controls::AfStateScanning;
++	origin_ = position_;
++	reversed_ = false;
++	remeasured_ = false;
++	/* Search the larger part of the range first. */
++	direction_ = max_ - position_ >= position_ - min_ ? 1 : -1;
++
++	/* The current frame was taken at the start position. */
++	LOG(IPASoftAf, Debug) << "Climb " << position_ << ": " << sharpness;
