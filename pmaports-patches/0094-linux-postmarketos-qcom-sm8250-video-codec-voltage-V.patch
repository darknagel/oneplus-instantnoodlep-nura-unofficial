 6ee1c52306375930f7f886147efc549235c73e1f10eacfeae14ceb4f3986553ee173cf0c274e26a3a3c90241f1315f1a427a21f0a69f7c8e21fa729c12ef1e32  0220-input-misc-add-Goodix-SPI-fingerprint-sensor-driver.patch
 8d49a2fc3fe281242a44c86571f3fc4a0e659e217d006a2aae8521b25eded6daa09300451cf46fabd7edd038ad5e38feb7969a522207ae298b77fa71764c1c3c  0221-Documentation-input-document-the-Goodix-SPI-fingerpr.patch
