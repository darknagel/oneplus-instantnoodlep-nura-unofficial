@@ -0,0 +1,41 @@
+# Forked from Alpine: accept QRTR modems on any node, so that the external
+# SDX55 of the OnePlus 8 Pro (ModemManager port qrtr3) gets VoLTE.
+maintainer="Achill Gilgenast <achill@achill.org>"
+pkgname=81voltd
+pkgver=1.2.0
+pkgrel=2
+pkgdesc="Server-side implementation of IMS Data service on QMI/QRTR"
+url="https://gitlab.nura.eco/modem/81voltd"
+arch="all"
+license="GPL-2.0-or-later"
+makedepends="
+	libqmi-dev
+	meson
+	modemmanager-dev
+	qmi-utils
+	qrtr-dev
+	"
+subpackages="$pkgname-doc $pkgname-openrc $pkgname-systemd"
+source="https://gitlab.nura.eco/modem/81voltd/-/archive/v$pkgver/81voltd-v$pkgver.tar.gz
+	0001-qvd-modem-accept-QRTR-ports-of-any-node.patch
+	"
+builddir="$srcdir/$pkgname-v$pkgver"
+
+build() {
+	abuild-meson \
+		output .
+	meson compile -C output
+}
+
+check() {
+	meson test --print-errorlogs -C output
+}
+
+package() {
+	DESTDIR="$pkgdir" meson install --no-rebuild -C output
+}
