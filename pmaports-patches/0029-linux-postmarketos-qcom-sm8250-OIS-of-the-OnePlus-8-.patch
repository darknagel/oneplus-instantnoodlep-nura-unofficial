@@ -0,0 +1,63 @@
+From f305a3e96f81a77291a17e0b1c23595e1ca938e8 Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Mon, 9 Nov 2026 19:42:24 +0100
+Subject: [PATCH 54/54] arm64: dts: qcom: sm8250-oneplus-instantnoodlep: Add
+ the main camera OIS
+
+Add PM8009 L5, which powers the OIS controllers, and the LC898128 OIS
+controller of the main camera at 0x24 on CCI0 bus 0.
+
+Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
+---
+ .../qcom/sm8250-oneplus-instantnoodlep.dts    | 21 ++++++++++++++++++-
+ 1 file changed, 20 insertions(+), 1 deletion(-)
+
+diff --git a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+index 44f029275..ffa4d51b0 100644
+--- a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
++++ b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+@@ -630,6 +630,14 @@ vreg_l4f_1p05: ldo4 {
+ 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+ 		};
+ 
++		/* OIS controllers and the main camera EEPROM */
++		vreg_l5f_2p8: ldo5 {
++			regulator-name = "vreg_l5f_2p8";
++			regulator-min-microvolt = <2800000>;
++			regulator-max-microvolt = <2800000>;
++			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
++		};
++
+ 		vreg_l6f_2p8: ldo6 {
+ 			regulator-name = "vreg_l6f_2p8";
+ 			regulator-min-microvolt = <2800000>;
+@@ -955,7 +963,7 @@ &cci0_i2c0 {
+ 	#size-cells = <0>;
+ 
+ 	/* Main camera */
+-	camera@1a {
++	cam_main: camera@1a {
+ 		compatible = "sony,imx689";
+ 		reg = <0x1a>;
+ 
+@@ -995,6 +1003,17 @@ cam_main_af: lens@c {
+ 		vdd-supply = <&vreg_cam_main_vaf>;
+ 		vio-supply = <&vreg_l7f_1p8>;
+ 	};
++
++	/* Optical image stabilisation of the main camera */
++	ois@24 {
++		compatible = "onnn,lc898128";
++		reg = <0x24>;
++
++		vdd-supply = <&vreg_l5f_2p8>;
++		vio-supply = <&vreg_l7f_1p8>;
++
++		onnn,camera = <&cam_main>;
++	};
+ };
+ 
+ &cci0_i2c1 {
+-- 
