new file mode 100644
index 0000000000..da0a3bcde5
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0053-media-i2c-Add-a-driver-for-the-onsemi-LC898128-OIS-c.patch
@@ -0,0 +1,338 @@
+From 3cddeef9d54ab79c832d61adaaacb0ab92dcee43 Mon Sep 17 00:00:00 2001
+From: Timo <1788603+darknagel@users.noreply.github.com>
+Date: Mon, 9 Nov 2026 19:42:24 +0100
+Subject: [PATCH 53/54] media: i2c: Add a driver for the onsemi LC898128 OIS
+ controller
+
+The LC898128 runs optical image stabilisation from its own firmware: it
+reads the camera module's gyroscope and moves the lens itself. The host
+only powers it and sends three commands: select the gyroscope, switch
+the servo on and enable stabilisation.
+
+The controller follows the image sensor named by "onnn,camera" through
+a runtime PM device link, so it is on whenever the sensor is powered.
+A module parameter keeps the lens centred without stabilising.
+
+Signed-off-by: Timo <1788603+darknagel@users.noreply.github.com>
+---
+ drivers/media/i2c/Kconfig    |  11 ++
+ drivers/media/i2c/Makefile   |   1 +
+ drivers/media/i2c/lc898128.c | 272 +++++++++++++++++++++++++++++++++++
+ 3 files changed, 284 insertions(+)
+ create mode 100644 drivers/media/i2c/lc898128.c
+
+diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
+index e5375804b..04dd725e8 100644
+--- a/drivers/media/i2c/Kconfig
++++ b/drivers/media/i2c/Kconfig
+@@ -966,6 +966,17 @@ config VIDEO_DW9807_VCM
+ 	  capability. This is designed for linear control of
+ 	  voice coil motors, controlled via I2C serial interface.
+ 
++config VIDEO_LC898128
++	tristate "onsemi LC898128 optical image stabilisation"
++	depends on I2C && OF && PM
++	help
++	  This is a driver for the onsemi LC898128 optical image
++	  stabilisation controller. It starts stabilisation whenever the
++	  image sensor it belongs to is powered.
++
++	  To compile this driver as a module, choose M here: the
++	  module will be called lc898128.
++
+ config VIDEO_LC898217XC
+ 	tristate "LC898217XC lens voice coil support"
+ 	select V4L2_CCI_I2C
+diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
+index a3b2d75a0..5a8b5c12f 100644
+--- a/drivers/media/i2c/Makefile
++++ b/drivers/media/i2c/Makefile
+@@ -68,6 +68,7 @@ obj-$(CONFIG_VIDEO_GC5035) += gc5035.o
+ obj-$(CONFIG_VIDEO_IR_I2C) += ir-kbd-i2c.o
+ obj-$(CONFIG_VIDEO_ISL7998X) += isl7998x.o
+ obj-$(CONFIG_VIDEO_KS0127) += ks0127.o
++obj-$(CONFIG_VIDEO_LC898128) += lc898128.o
+ obj-$(CONFIG_VIDEO_LC898217XC) += lc898217xc.o
+ obj-$(CONFIG_VIDEO_LM3560) += lm3560.o
+ obj-$(CONFIG_VIDEO_LM3646) += lm3646.o
+diff --git a/drivers/media/i2c/lc898128.c b/drivers/media/i2c/lc898128.c
+new file mode 100644
+index 000000000..a09957391
+--- /dev/null
++++ b/drivers/media/i2c/lc898128.c
+@@ -0,0 +1,272 @@
++// SPDX-License-Identifier: GPL-2.0-only
++/*
++ * onsemi LC898128 optical image stabilisation (OIS) controller
++ *
++ * The controller runs its own firmware from internal flash. It reads the
++ * gyroscope of the camera module over SPI and moves the lens on its own,
++ * so the driver only powers it up and sends the start commands. It follows
++ * the image sensor named by "onnn,camera" through a runtime PM device link:
++ * stabilisation runs whenever the sensor is powered.
++ */
++
++#include <linux/delay.h>
++#include <linux/device.h>
++#include <linux/i2c.h>
++#include <linux/module.h>
++#include <linux/of.h>
++#include <linux/pm_runtime.h>
++#include <linux/regulator/consumer.h>
++#include <linux/unaligned.h>
++
++#define LC898128_REG_FW_VERSION		0x8000
++#define LC898128_CMD_SERVO		0xf010
++#define LC898128_SERVO_OFF		0
++#define LC898128_SERVO_BOTH_ON		3
++#define LC898128_CMD_OIS_ENABLE		0xf012
++#define LC898128_CMD_GYRO_INIT		0xf015
++
++#define LC898128_READY_RETRIES		10
++
++static bool enable = true;
++module_param(enable, bool, 0644);
++MODULE_PARM_DESC(enable, "Stabilise the image (otherwise only hold the lens centred)");
++
++static const char *const lc898128_supply_names[] = {
++	"vdd",
++	"vio",
++};
++
++struct lc898128 {
++	struct i2c_client *client;
++	struct regulator_bulk_data supplies[ARRAY_SIZE(lc898128_supply_names)];
++	struct device_link *link;
++	u32 gyro;
++};
++
++static int lc898128_write(struct lc898128 *ois, u16 reg, u32 val)
++{
++	u8 buf[6];
++	int ret;
++
++	put_unaligned_be16(reg, buf);
++	put_unaligned_be32(val, buf + 2);
++
++	ret = i2c_master_send(ois->client, buf, sizeof(buf));
++	if (ret < 0)
++		return ret;
++
++	return ret == sizeof(buf) ? 0 : -EIO;
++}
++
++static int lc898128_read(struct lc898128 *ois, u16 reg, u32 *val)
++{
++	u8 addr[2], data[4];
++	struct i2c_msg msgs[] = {
++		{
++			.addr = ois->client->addr,
++			.len = sizeof(addr),
++			.buf = addr,
++		}, {
++			.addr = ois->client->addr,
++			.flags = I2C_M_RD,
++			.len = sizeof(data),
++			.buf = data,
++		},
++	};
++	int ret;
++
++	put_unaligned_be16(reg, addr);
++
++	ret = i2c_transfer(ois->client->adapter, msgs, ARRAY_SIZE(msgs));
++	if (ret < 0)
++		return ret;
++	if (ret != ARRAY_SIZE(msgs))
++		return -EIO;
++
++	*val = get_unaligned_be32(data);
++
++	return 0;
++}
++
++/* The first transfers after the bus supply comes up can fail */
++static int lc898128_wait_ready(struct lc898128 *ois, u32 *version)
++{
++	int i, ret;
++
++	for (i = 0; i < LC898128_READY_RETRIES; i++) {
++		ret = lc898128_read(ois, LC898128_REG_FW_VERSION, version);
++		if (!ret)
++			return 0;
++		usleep_range(2000, 2500);
++	}
++
++	return ret;
++}
++
++static int lc898128_start(struct lc898128 *ois)
++{
++	u32 val;
++	int ret;
++
++	ret = lc898128_write(ois, LC898128_CMD_GYRO_INIT, ois->gyro);
++	if (ret)
++		return ret;
++	usleep_range(5000, 6000);
++
++	ret = lc898128_write(ois, LC898128_CMD_SERVO, LC898128_SERVO_BOTH_ON);
++	if (ret)
++		return ret;
++
++	/* The servo takes about 50 ms to settle, earlier OIS commands are lost */
++	msleep(100);
++
++	ret = lc898128_write(ois, LC898128_CMD_OIS_ENABLE, enable);
++	if (ret)
++		return ret;
++
++	ret = lc898128_read(ois, LC898128_CMD_OIS_ENABLE, &val);
++	if (ret)
++		return ret;
++	if (val != enable)
++		dev_warn(&ois->client->dev, "OIS enable not taken: %u\n", val);
++
++	return 0;
++}
++
++static int lc898128_runtime_resume(struct device *dev)
++{
++	struct lc898128 *ois = dev_get_drvdata(dev);
++	u32 version;
++	int ret;
++
++	ret = regulator_bulk_enable(ARRAY_SIZE(ois->supplies), ois->supplies);
++	if (ret)
++		return ret;
++
++	usleep_range(5000, 6000);
++
++	ret = lc898128_wait_ready(ois, &version);
++	if (!ret)
++		ret = lc898128_start(ois);
++	if (ret) {
++		dev_err(dev, "failed to start: %d\n", ret);
++		regulator_bulk_disable(ARRAY_SIZE(ois->supplies), ois->supplies);
++		return ret;
++	}
++
++	return 0;
++}
++
++static int lc898128_runtime_suspend(struct device *dev)
++{
++	struct lc898128 *ois = dev_get_drvdata(dev);
++
++	/* Let the lens settle before the power goes */
++	lc898128_write(ois, LC898128_CMD_OIS_ENABLE, 0);
++	lc898128_write(ois, LC898128_CMD_SERVO, LC898128_SERVO_OFF);
++	regulator_bulk_disable(ARRAY_SIZE(ois->supplies), ois->supplies);
++
++	return 0;
++}
++
++static int lc898128_probe(struct i2c_client *client)
++{
++	struct device *dev = &client->dev;
++	struct i2c_client *sensor;
++	struct device_node *np;
++	struct lc898128 *ois;
++	u32 flags, version;
++	unsigned int i;
++	int ret;
++
++	ois = devm_kzalloc(dev, sizeof(*ois), GFP_KERNEL);
++	if (!ois)
++		return -ENOMEM;
++
++	ois->client = client;
++	i2c_set_clientdata(client, ois);
++
++	/* 2: LSM6DSM, the value the vendor kernel uses on this phone */
++	ois->gyro = 2;
++	of_property_read_u32(dev->of_node, "onnn,gyro", &ois->gyro);
++
++	for (i = 0; i < ARRAY_SIZE(lc898128_supply_names); i++)
++		ois->supplies[i].supply = lc898128_supply_names[i];
++
++	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ois->supplies),
++				      ois->supplies);
++	if (ret)
++		return dev_err_probe(dev, ret, "failed to get regulators\n");
++
++	np = of_parse_phandle(dev->of_node, "onnn,camera", 0);
++	if (!np)
++		return dev_err_probe(dev, -EINVAL, "no onnn,camera\n");
++	sensor = of_find_i2c_device_by_node(np);
++	of_node_put(np);
++	if (!sensor)
++		return -EPROBE_DEFER;
++
++	/* Check that the controller is there, without moving the lens */
++	ret = regulator_bulk_enable(ARRAY_SIZE(ois->supplies), ois->supplies);
++	if (ret) {
++		put_device(&sensor->dev);
++		return dev_err_probe(dev, ret, "failed to power up\n");
++	}
++	usleep_range(5000, 6000);
++	ret = lc898128_wait_ready(ois, &version);
++	regulator_bulk_disable(ARRAY_SIZE(ois->supplies), ois->supplies);
++	if (ret) {
++		put_device(&sensor->dev);
++		return dev_err_probe(dev, ret, "failed to read the version\n");
++	}
++
++	pm_runtime_set_suspended(dev);
++	ret = devm_pm_runtime_enable(dev);
++	if (ret) {
++		put_device(&sensor->dev);
++		return ret;
++	}
++
++	flags = DL_FLAG_STATELESS | DL_FLAG_PM_RUNTIME;
++	if (pm_runtime_active(&sensor->dev))
++		flags |= DL_FLAG_RPM_ACTIVE;
++	ois->link = device_link_add(&sensor->dev, dev, flags);
++	put_device(&sensor->dev);
++	if (!ois->link)
++		return dev_err_probe(dev, -EINVAL, "failed to link to the camera\n");
++
++	dev_info(dev, "firmware %08x, follows %s\n", version,
++		 dev_name(ois->link->consumer));
++
++	return 0;
++}
++
++static void lc898128_remove(struct i2c_client *client)
++{
++	struct lc898128 *ois = i2c_get_clientdata(client);
++
++	device_link_del(ois->link);
++}
++
++static const struct of_device_id lc898128_of_match[] = {
++	{ .compatible = "onnn,lc898128" },
++	{ }
++};
++MODULE_DEVICE_TABLE(of, lc898128_of_match);
++
++static DEFINE_RUNTIME_DEV_PM_OPS(lc898128_pm_ops, lc898128_runtime_suspend,
++				 lc898128_runtime_resume, NULL);
++
++static struct i2c_driver lc898128_driver = {
++	.driver = {
++		.name = "lc898128",
++		.of_match_table = lc898128_of_match,
++		.pm = pm_ptr(&lc898128_pm_ops),
++	},
++	.probe = lc898128_probe,
++	.remove = lc898128_remove,
++};
++module_i2c_driver(lc898128_driver);
++
++MODULE_DESCRIPTION("onsemi LC898128 optical image stabilisation controller");
++MODULE_LICENSE("GPL");
+-- 
+2.43.0
+
