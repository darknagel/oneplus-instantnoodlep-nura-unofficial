diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0094-usb-typec-qcom-program-the-CC-mode-in-set_cc.patch b/device/testing/linux-postmarketos-qcom-sm8250/0094-usb-typec-qcom-program-the-CC-mode-in-set_cc.patch
new file mode 100644
index 0000000000..9fce4eed7e
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0094-usb-typec-qcom-program-the-CC-mode-in-set_cc.patch
@@ -0,0 +1,68 @@
+From 70861ad386a4e74ce37173350deac11ac006cd20 Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Mon, 9 Nov 2026 22:50:44 +0000
+Subject: [PATCH] usb: typec: qcom: program the CC mode in set_cc
+
+set_cc() works out the source or sink mode for the requested CC state
+but never writes it: TYPEC_MODE_CFG is only programmed when toggling
+starts. Rp and Rd changes that TCPM requests through set_cc(), such as
+during a power-role swap, therefore never reach the PMIC.
+
+Write the computed mode, and disable the CC block for TYPEC_CC_OPEN.
+Initialize the values the debug message prints so that error paths do
+not log uninitialized data.
+
+Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
+---
+ drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port.c | 14 +++++++++++---
+ 1 file changed, 11 insertions(+), 3 deletions(-)
+
+diff --git a/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port.c b/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port.c
+index bf985efe1..29d9f4c8b 100644
+--- a/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port.c
++++ b/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port.c
+@@ -461,8 +461,8 @@ static int qcom_pmic_typec_port_set_cc(struct tcpc_dev *tcpc,
+ 	struct pmic_typec *tcpm = tcpc_to_tcpm(tcpc);
+ 	struct pmic_typec_port *pmic_typec_port = tcpm->pmic_typec_port;
+ 	struct device *dev = pmic_typec_port->dev;
+-	unsigned int mode, currsrc;
+-	unsigned int misc;
++	unsigned int mode = 0, currsrc = 0;
++	unsigned int misc = 0;
+ 	unsigned long flags;
+ 	int ret;
+ 
+@@ -478,6 +478,7 @@ static int qcom_pmic_typec_port_set_cc(struct tcpc_dev *tcpc,
+ 
+ 	switch (cc) {
+ 	case TYPEC_CC_OPEN:
++		mode = TYPEC_DISABLE_CMD;
+ 		currsrc = TYPEC_SRC_RP_SEL_80UA;
+ 		break;
+ 	case TYPEC_CC_RP_DEF:
+@@ -507,6 +508,12 @@ static int qcom_pmic_typec_port_set_cc(struct tcpc_dev *tcpc,
+ 			goto done;
+ 	}
+ 
++	/* Apply Rp/Rd (or open CC), including changes during a power-role swap. */
++	ret = regmap_write(pmic_typec_port->regmap,
++			   pmic_typec_port->base + TYPEC_MODE_CFG_REG, mode);
++	if (ret)
++		goto done;
++
+ 	pmic_typec_port->cc = cc;
+ 	qcom_pmic_set_cc_debounce(pmic_typec_port);
+ 	ret = 0;
+@@ -516,7 +523,8 @@ static int qcom_pmic_typec_port_set_cc(struct tcpc_dev *tcpc,
+ 
+ 	dev_dbg(dev, "set_cc: currsrc=%x %s mode %s debounce %d attached %d cc=%s\n",
+ 		currsrc, rp_sel_to_name(currsrc),
+-		mode == EN_SRC_ONLY ? "EN_SRC_ONLY" : "EN_SNK_ONLY",
++		mode == EN_SRC_ONLY ? "EN_SRC_ONLY" :
++		mode == EN_SNK_ONLY ? "EN_SNK_ONLY" : "DISABLED",
+ 		pmic_typec_port->debouncing_cc, !!(misc & CC_ATTACHED),
+ 		misc_to_cc(misc));
+ 
+-- 
+2.51.2
+
diff --git a/device/testing/linux-postmarketos-qcom-sm8250/0095-arm64-dts-qcom-sm8250-oneplus-instantnoodlep-enable-.patch b/device/testing/linux-postmarketos-qcom-sm8250/0095-arm64-dts-qcom-sm8250-oneplus-instantnoodlep-enable-.patch
new file mode 100644
index 0000000000..2f86e82a44
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8250/0095-arm64-dts-qcom-sm8250-oneplus-instantnoodlep-enable-.patch
@@ -0,0 +1,119 @@
+From 11c71516746b9640e63e7d25d4989f04fca5959a Mon Sep 17 00:00:00 2001
+From: Roman Kuraev <naoru.desu@gmail.com>
+Date: Mon, 9 Nov 2026 20:23:50 +0000
+Subject: [PATCH] arm64: dts: qcom: sm8250-oneplus-instantnoodlep: enable
+ DisplayPort
+
+Enable the DP controller and connect it to the USB/DP combo PHY and
+Type-C connector. Advertise DP Alt Mode, enable PHY mode switching, and
+allow all four DP lanes. Retain the existing FSA4480 SBU routing.
+
+Make the USB controller a mode switch as well, and list its port first
+so that its USB2 clock mux registers before the high-speed PHY mux and
+four-lane DP keeps USB2 alive.
+
+Signed-off-by: Roman Kuraev <naoru.desu@gmail.com>
+---
+ .../qcom/sm8250-oneplus-instantnoodlep.dts    | 48 ++++++++++++++++---
+ 1 file changed, 42 insertions(+), 6 deletions(-)
+
+diff --git a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+index 6c3ae98fe..aac72c44c 100644
+--- a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
++++ b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodlep.dts
+@@ -1285,6 +1285,15 @@ &mdss {
+ 	status = "okay";
+ };
+ 
++&mdss_dp {
++	status = "okay";
++};
++
++&mdss_dp_out {
++	data-lanes = <0 1 2 3>;
++	remote-endpoint = <&usb_1_qmpphy_dp_in>;
++};
++
+ &mdss_dsi0 {
+ 	vdda-supply = <&vreg_l9a_1p2>;
+ 
+@@ -1443,10 +1452,33 @@ PDO_FIXED_DUAL_ROLE |
+                                       PDO_FIXED_USB_COMM |
+                                       PDO_FIXED_DATA_SWAP)>;
+ 
++		altmodes {
++			displayport {
++				svid = /bits/ 16 <0xff01>;
++				vdo = <0x00001c46>;
++			};
++		};
++
+                ports {
+                        #address-cells = <1>;
+                        #size-cells = <0>;
+ 
++			port@0 {
++				reg = <0>;
++
++				pm8150b_hs_in: endpoint {
++					remote-endpoint = <&usb_1_dwc3_hs_out>;
++				};
++			};
++
++			port@1 {
++				reg = <1>;
++				pm8150b_ss_in: endpoint {
++					data-lanes = <0 1 2 3>;
++					remote-endpoint = <&usb_1_qmpphy_out>;
++				};
++			};
++
+ 			port@2 {
+ 				reg = <2>;
+ 				pm8150b_sbu: endpoint {
+@@ -1454,13 +1486,7 @@ pm8150b_sbu: endpoint {
+ 				};
+ 			};
+ 
+-                       port@0 {
+-                               reg = <0>;
+ 
+-                               pm8150b_hs_in: endpoint {
+-                                       remote-endpoint = <&usb_1_dwc3_hs_out>;
+-                               };
+-                       };
+                };
+        };
+ };
+@@ -1795,6 +1821,7 @@ &usb_1 {
+ &usb_1_dwc3 {
+ 	dr_mode = "otg";
+ 	usb-role-switch;
++	mode-switch;
+ };
+ 
+ &usb_1_hsphy {
+@@ -1809,11 +1836,20 @@ &usb_1_dwc3_hs_out {
+ };
+ 
+ &usb_1_qmpphy {
++	mode-switch;
+        status = "okay";
+        vdda-phy-supply = <&vreg_l9a_1p2>;
+        vdda-pll-supply = <&vreg_l18a_0p92>;
+ };
+ 
++&usb_1_qmpphy_out {
++	remote-endpoint = <&pm8150b_ss_in>;
++};
++
++&usb_1_qmpphy_dp_in {
++	remote-endpoint = <&mdss_dp_out>;
++};
++
+ &usb_2 {
+ 	status = "okay";
+ };
+-- 
+2.51.2
+
