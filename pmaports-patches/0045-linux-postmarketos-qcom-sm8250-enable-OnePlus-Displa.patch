 51584c620a04a8a390edb7b858fb58e159115dd921a64e0c048273b5e2222ccd04215a91dc950b3816a00cafb6951602e1582752c4f7fcf5e3a2e6dbdaa9a9ce  0086-arm64-dts-qcom-pm8150b-add-the-charger-source-change.patch
 78732ef745acd6865647aecfb668bd35fced71b657ebc569a838f282937a153d38cefffaa189390e257d93c65e0a1c8ee62a77788fe6592fd0b43a2ee2c1b9ca  0087-arm64-dts-qcom-instantnoodlep-link-the-charger-to-th.patch
