+ /* Retrieve all source pads connected to a sink pad through active routes. */
++/*
++ * Find the second RDI of the CSID the image goes through, and its video node,
++ * for a sensor that sends phase detection data.
++ */
++void SimpleCameraData::initPdaf()
++{
++	SimplePipelineHandler *pipe = SimpleCameraData::pipe();
++
++	if (!swIsp_)
++		return;
++
++	const PdafSensorInfo *info = nullptr;
++	for (const PdafSensorInfo &s : pdafSensors) {
++		if (sensor_->model() == s.model)
++			info = &s;
++	}
++	if (!info)
++		return;
++
++	for (const Entity &e : entities_) {
++		if (!e.source || !e.sourceLink ||
++		    e.entity->name().rfind("msm_csid", 0) != 0)
++			continue;
++
++		const MediaPad *pad = e.entity->getPadByIndex(e.source->index() + 1);
++		if (!pad)
++			break;
++
++		/* The RDI after the one of the image, on the same VFE. */
++		std::string name = e.sourceLink->sink()->entity()->name();
++		name.back() = static_cast<char>(name.back() + 1);
++
++		for (MediaLink *link : pad->links()) {
++			MediaEntity *line = link->sink()->entity();
++			if (line->name() != name)
++				continue;
++
++			for (const MediaPad *linePad : line->pads()) {
++				if (!(linePad->flags() & MEDIA_PAD_FL_SOURCE))
++					continue;
++
++				for (MediaLink *videoLink : linePad->links()) {
++					MediaEntity *node = videoLink->sink()->entity();
++					if (node->function() != MEDIA_ENT_F_IO_V4L)
++						continue;
++
++					pdaf_.video = std::make_unique<V4L2VideoDevice>(node);
++					pdaf_.line = std::make_unique<V4L2Subdevice>(line);
++					pdaf_.pad = pad;
++					pdaf_.link = link;
++					pdaf_.csid = pipe->subdev(e.entity);
++				}
++			}
++		}
++		break;
++	}
++
++	if (!pdaf_.video || !pdaf_.csid || pdaf_.video->open() || pdaf_.line->open()) {
++		pdaf_.video.reset();
++		pdaf_.line.reset();
++		return;
++	}
++
++	pdaf_.info = info;
++	LOG(SimplePipeline, Info)
++		<< "Phase detection data on " << pdaf_.video->deviceNode();
++}
