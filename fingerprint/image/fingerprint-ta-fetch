#!/usr/bin/env python3
"""Fetch the Goodix fingerprint trusted application from OnePlus' official OTA.

The trusted application (TA) is proprietary OnePlus/Goodix firmware and is not
distributed with this image. This script downloads it on the phone, straight
from the official OxygenOS 13 full OTA for the OnePlus 8 Pro on Google's OTA
server, and installs it:

  - only the odm partition is fetched, with HTTP range requests (~133 MB of the
    4.4 GB package); every chunk is checked against the SHA-256 in the OTA
    manifest, and the assembled image against a known hash,
  - odm (EROFS) is mounted read-only, the split TA (<name>.mdt/.bNN) is joined
    into /lib/firmware/<name>.mbn and checked against a known hash,
  - the TA loader is started.

Run without arguments (fingerprint-ta-fetch.service does this at boot until the
TA is present). Nothing happens when /lib/firmware/<name>.mbn already exists.
"""
import bz2
import hashlib
import lzma
import os
import struct
import subprocess
import sys
import tempfile
import urllib.request

# OnePlus 8 Pro OxygenOS 13 IN2025_11.F.13_2130_202211142346 (full OTA)
OTA_URL = ('https://android.googleapis.com/packages/ota-api/package/'
           '055f1d0089a2a397bebd5882a9a63bdb779f4834.zip')
OTA_SIZE = 4653394422
ODM_SHA256 = '6a648ca51af6738a8fea4fd2c54d1f3ab7e6674b80dca4b6830d477950a1164f'
TA_SHA256 = {
    'gfp9608': '858399168360e7145283eb2b1f372ad474b36bbee6fa6ae35d5c64662abfce2a',
    'gfp9638': 'ea080a62bb01a401b5d0638f825ff3601b916d087d5d6bbee0c8f6570f00b7cd',
}
FIRMWARE_DIR = '/lib/firmware'
SYSFS_NAME = '/sys/class/misc/goodix_fp/device/firmware_name'
WORK_DIR = '/var/tmp'


def log(msg):
    print('fingerprint-ta-fetch: ' + msg, flush=True)


def get(start, length):
    req = urllib.request.Request(OTA_URL, headers={
        'Range': 'bytes=%d-%d' % (start, start + length - 1),
        'User-Agent': 'fingerprint-ta-fetch'})
    with urllib.request.urlopen(req, timeout=120) as r:
        if r.status != 206:
            raise RuntimeError('server ignored the range request (HTTP %d)' % r.status)
        total = int(r.headers['Content-Range'].split('/')[1])
        if total != OTA_SIZE:
            raise RuntimeError('unexpected OTA size %d' % total)
        data = r.read()
    if len(data) != length:
        raise RuntimeError('short read')
    return data


def payload_offset():
    """Offset of payload.bin (stored, uncompressed) inside the zip."""
    tail = get(OTA_SIZE - 65536, 65536)
    eocd = tail.rfind(b'PK\x05\x06')
    cd_size, cd_off = struct.unpack_from('<II', tail, eocd + 12)
    if cd_off == 0xffffffff:
        loc = tail.rfind(b'PK\x06\x07')
        z64, = struct.unpack_from('<Q', tail, loc + 8)
        cd_size, cd_off = struct.unpack_from('<QQ', get(z64, 56), 40)
    cd = get(cd_off, cd_size)
    i = 0
    while cd[i:i + 4] == b'PK\x01\x02':
        method, = struct.unpack_from('<H', cd, i + 10)
        nlen, elen, clen = struct.unpack_from('<HHH', cd, i + 28)
        lho, = struct.unpack_from('<I', cd, i + 42)
        name = cd[i + 46:i + 46 + nlen]
        extra = cd[i + 46 + nlen:i + 46 + nlen + elen]
        if name == b'payload.bin':
            if method != 0:
                raise RuntimeError('payload.bin is compressed')
            if lho == 0xffffffff:
                j = 0
                while j + 4 <= len(extra):
                    hid, hsz = struct.unpack_from('<HH', extra, j)
                    if hid == 1:
                        lho = struct.unpack_from('<Q', extra, j + 4 + hsz - 8)[0]
                    j += 4 + hsz
            lh = get(lho, 30)
            n, e = struct.unpack_from('<HH', lh, 26)
            return lho + 30 + n + e
        i += 46 + nlen + elen + clen
    raise RuntimeError('payload.bin not found')


def varint(b, i):
    v = s = 0
    while True:
        c = b[i]
        i += 1
        v |= (c & 0x7f) << s
        s += 7
        if not c & 0x80:
            return v, i


def fields(b):
    i = 0
    while i < len(b):
        key, i = varint(b, i)
        f, t = key >> 3, key & 7
        if t == 0:
            v, i = varint(b, i)
        elif t == 2:
            n, i = varint(b, i)
            v = b[i:i + n]
            i += n
        elif t == 1:
            v, i = b[i:i + 8], i + 8
        elif t == 5:
            v, i = b[i:i + 4], i + 4
        else:
            raise RuntimeError('bad manifest')
        yield f, v


def partition(manifest, wanted):
    block = 4096
    for f, v in fields(manifest):
        if f == 3:
            block = v
    for f, v in fields(manifest):
        if f != 13:
            continue
        name, size, ops = None, 0, []
        for pf, pv in fields(v):
            if pf == 1:
                name = pv.decode()
            elif pf == 7:
                size = dict(fields(pv)).get(1, 0)
            elif pf == 8:
                op = {'type': 0, 'off': 0, 'len': 0, 'dst': [], 'sha': None}
                for of, ov in fields(pv):
                    if of == 1:
                        op['type'] = ov
                    elif of == 2:
                        op['off'] = ov
                    elif of == 3:
                        op['len'] = ov
                    elif of == 6:
                        e = dict(fields(ov))
                        op['dst'].append((e.get(1, 0), e.get(2, 0)))
                    elif of == 8:
                        op['sha'] = ov
                ops.append(op)
        if name == wanted:
            return block, size, ops
    raise RuntimeError('partition %s not in the OTA' % wanted)


def fetch_odm(path):
    pstart = payload_offset()
    hdr = get(pstart, 24)
    if hdr[:4] != b'CrAU':
        raise RuntimeError('not an update_engine payload')
    msize, = struct.unpack_from('>Q', hdr, 12)
    sigsize, = struct.unpack_from('>I', hdr, 20)
    block, size, ops = partition(get(pstart + 24, msize), 'odm')
    base = pstart + 24 + msize + sigsize
    total = sum(op['len'] for op in ops)
    done = 0
    with open(path, 'wb') as f:
        f.truncate(size)
        for n, op in enumerate(ops, 1):
            raw = get(base + op['off'], op['len']) if op['len'] else b''
            if op['sha'] and hashlib.sha256(raw).digest() != op['sha']:
                raise RuntimeError('checksum mismatch in the download')
            if op['type'] == 0:
                out = raw
            elif op['type'] == 1:
                out = bz2.decompress(raw)
            elif op['type'] == 8:
                out = lzma.decompress(raw)
            else:
                raise RuntimeError('unsupported operation %d' % op['type'])
            pos = 0
            for start, num in op['dst']:
                f.seek(start * block)
                f.write(out[pos:pos + num * block])
                pos += num * block
            done += op['len']
            if n == len(ops) or n % 20 == 0:
                log('odm %d of %d MB' % (done >> 20, total >> 20))
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for chunk in iter(lambda: f.read(1 << 20), b''):
            h.update(chunk)
    if h.hexdigest() != ODM_SHA256:
        raise RuntimeError('odm image hash mismatch')


def squash(mdt_path, out_path):
    """Join <name>.mdt + <name>.bNN into one ELF; segment i goes to its p_offset."""
    with open(mdt_path, 'rb') as f:
        mdt = f.read()
    if mdt[4] == 2:
        phoff, = struct.unpack_from('<Q', mdt, 0x20)
        phentsize, phnum = struct.unpack_from('<HH', mdt, 0x36)
        fmt, pick = '<IIQQQQQQ', (lambda p: (p[2], p[5]))
    else:
        phoff, = struct.unpack_from('<I', mdt, 0x1c)
        phentsize, phnum = struct.unpack_from('<HH', mdt, 0x2a)
        fmt, pick = '<IIIIIIII', (lambda p: (p[1], p[4]))
    segs = [pick(struct.unpack_from(fmt, mdt, phoff + i * phentsize)) for i in range(phnum)]
    image = bytearray(max(o + s for o, s in segs))
    image[:len(mdt)] = mdt
    for i, (off, size) in enumerate(segs):
        if not size:
            continue
        seg = '%s.b%02d' % (mdt_path[:-4], i)
        if not os.path.exists(seg):
            if off + size <= len(mdt):
                continue
            raise RuntimeError('missing ' + seg)
        with open(seg, 'rb') as f:
            data = f.read()
        if len(data) != size:
            raise RuntimeError('bad segment size ' + seg)
        image[off:off + size] = data
    with open(out_path, 'wb') as f:
        f.write(image)


def main():
    try:
        with open(SYSFS_NAME) as f:
            name = f.read().strip()
    except OSError:
        log('no Goodix fingerprint device, nothing to do')
        return 0
    target = os.path.join(FIRMWARE_DIR, name + '.mbn')
    if os.path.exists(target):
        return 0
    if name not in TA_SHA256:
        log('unknown TA %s, install it with fingerprint-ta-install' % name)
        return 0
    with tempfile.TemporaryDirectory(dir=WORK_DIR, prefix='fingerprint-ta.') as tmp:
        odm = os.path.join(tmp, 'odm.img')
        mnt = os.path.join(tmp, 'odm')
        out = os.path.join(tmp, name + '.mbn')
        os.mkdir(mnt)
        log('downloading the odm partition of the official OxygenOS 13 OTA')
        fetch_odm(odm)
        subprocess.run(['modprobe', 'erofs'], check=False)
        subprocess.run(['mount', '-t', 'erofs', '-o', 'loop,ro', odm, mnt], check=True)
        try:
            squash(os.path.join(mnt, 'vendor', 'firmware', name + '.mdt'), out)
        finally:
            subprocess.run(['umount', mnt], check=False)
        with open(out, 'rb') as f:
            if hashlib.sha256(f.read()).hexdigest() != TA_SHA256[name]:
                raise RuntimeError('TA hash mismatch')
        tmp_target = target + '.new'
        with open(out, 'rb') as src, open(tmp_target, 'wb') as dst:
            dst.write(src.read())
        os.chmod(tmp_target, 0o644)
        os.replace(tmp_target, target)
    log('installed %s' % target)
    subprocess.run(['systemctl', '--no-block', 'restart', 'qsee-app-loader@%s.service' % name], check=False)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except Exception as e:  # retried by the service
        log('failed: %s' % e)
        sys.exit(1)
