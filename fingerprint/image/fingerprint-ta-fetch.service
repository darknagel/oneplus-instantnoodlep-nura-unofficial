[Unit]
Description=Fetch the fingerprint trusted application from OnePlus' official OTA
Documentation=file:///usr/local/bin/fingerprint-ta-fetch
Wants=network-online.target
After=network-online.target
ConditionPathExists=/sys/class/misc/goodix_fp

[Service]
Type=oneshot
ExecStart=/usr/local/bin/fingerprint-ta-fetch
# no network yet, or a broken download: try again later
Restart=on-failure
RestartSec=10min
Nice=10

[Install]
WantedBy=multi-user.target
