From: Timo <1788603+darknagel@users.noreply.github.com>
Subject: [PATCH] avcodec/v4l2_buffers: copy frames into padded buffers

A V4L2 encoder may pad its raw buffers: Iris aligns the plane height to
32 lines, so a 1280x720 NV12 frame goes into a 1280x736 buffer with the
chroma plane at line 736. v4l2_buffer_swframe_to_buf() copied every
plane with the buffer's height and the frame's linesize, which reads
past the end of the frame (segfault in memcpy) and puts the chroma at
the frame's height.

Copy the frame's rows only, with the buffer's stride, and start every
plane where the padded layout puts it.
---
--- a/libavcodec/v4l2_buffers.c
+++ b/libavcodec/v4l2_buffers.c
@@ -29,6 +29,7 @@
 #include <poll.h>
 #include "libavcodec/avcodec.h"
 #include "libavutil/attributes.h"
+#include "libavutil/imgutils.h"
 #include "libavutil/pixdesc.h"
 #include "libavutil/refstruct.h"
 #include "v4l2_context.h"
@@ -401,6 +402,51 @@
 
         for (i = 0; i < desc->nb_components; i++)
             planes_nb = FFMAX(planes_nb, desc->comp[i].plane + 1);
+
+        int bytesperline = V4L2_TYPE_IS_MULTIPLANAR(fmt.type) ?
+                           fmt.fmt.pix_mp.plane_fmt[0].bytesperline :
+                           fmt.fmt.pix.bytesperline;
+        int luma_row = av_image_get_linesize(frame->format, frame->width, 0);
+
+        /*
+         * The driver may pad the buffer: bytesperline wider than the frame
+         * and height (e.g. aligned to 32 lines) taller than the frame.
+         * Copy the frame's rows only, and place each plane at the offset
+         * the padded layout gives it.
+         */
+        if (bytesperline > 0 && luma_row > 0 &&
+            (bytesperline != frame->linesize[0] || height != frame->height)) {
+            unsigned int length = out->plane_info[0].length;
+            uint8_t *dst = out->plane_info[0].mm_addr;
+
+            for (i = 0; i < planes_nb; i++) {
+                int row = av_image_get_linesize(frame->format, frame->width, i);
+                int stride = (int)((int64_t)bytesperline * row / luma_row);
+                int h = height, fh = frame->height, y;
+
+                if (i == 1 || i == 2) {
+                    h  = AV_CEIL_RSHIFT(h,  desc->log2_chroma_h);
+                    fh = AV_CEIL_RSHIFT(fh, desc->log2_chroma_h);
+                }
+                fh = FFMIN(fh, h);
+                for (y = 0; y < fh; y++) {
+                    int pos = offset + y * stride;
+                    if (pos >= length)
+                        break;
+                    memcpy(dst + pos, frame->data[i] + y * frame->linesize[i],
+                           FFMIN(FFMIN(row, stride), length - pos));
+                }
+                offset += stride * h;
+            }
+            if (V4L2_TYPE_IS_MULTIPLANAR(out->buf.type)) {
+                out->planes[0].bytesused = FFMIN(offset, length);
+                out->planes[0].length = length;
+            } else {
+                out->buf.bytesused = FFMIN(offset, length);
+                out->buf.length = length;
+            }
+            return 0;
+        }
 
         for (i = 0; i < planes_nb; i++) {
             int size, h = height;
